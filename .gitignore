# Local connection settings and runtime state. Never commit these.
.env
.env.*
# An example file is a template with no secrets in it, and it is the only
# record of which settings an environment needs. `.env.*` would swallow it.
!.env.example
!**/.env.example
.runtime/
.data/

# Reproducible dependency and build outputs.
node_modules/
dist/
coverage/
.turbo/

# Operating-system noise.
.DS_Store
__pycache__/
.uav-last-dive
.uav-app.log

# Places built by tools/make-site. They are derived from public bathymetry and
# published to object storage by digest; a copy in git would be a second origin
# for the same bytes, and a large one.
catalog/cities/*/seabed.usda
catalog/cities/*/seabed.f32
