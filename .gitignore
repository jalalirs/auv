# Local connection settings and runtime state. Never commit these.
.env
.env.*
# An example file is a template with no secrets in it, and it is the only
# record of which settings an environment needs. `.env.*` would swallow it.
!.env.example
!**/.env.example
.runtime/
.data/

# Reproducible dependency and build outputs.
node_modules/
dist/
coverage/
.turbo/

# Operating-system noise.
.DS_Store
__pycache__/
.uav-last-dive
.uav-app.log
.uav-frame.png
.uav-map.mp4
.uav-ground*.mp4
.uav-terrain.mp4
.uav-terrain.png
.uav-exposure.png
.uav-exposure/

# Build output from running the tests, which is not the runtime.
#
# `just test-python` used to run `uv run` inside services/sim-runtime, where
# there is a pyproject, so uv installed the package and left an egg-info and a
# lock behind. `git add -A` committed them, the tree hash of the runtime moved,
# and tools/look correctly refused to render against an image that no longer
# matched a checkout whose *code* had not changed at all. Two renders were
# refused and both sheets read as the run before them.
#
# The recipe passes --no-project now, so these should not appear again.
services/sim-runtime/coral_city_runtime.egg-info/
services/sim-runtime/uv.lock

# Places built from data, kept beside the code: metadata and small pictures
# are tracked; rasters, meshes, videos and colony inventories are not.
places/*/renders/
places/*/*.usda
places/*/*.f32
places/*/*.mdl
places/*/textures/
places/*/reference/*.f32
places/*/reference/*.npy
places/*/reference/*_4096.png
places/*/deliverables/colonies.*

# TypeScript's own build output, which belongs beside nothing.
#
# apps/console's `check` script ran `tsc -b --noEmit false`, overriding the
# noEmit its own tsconfig sets, so every run scattered a .js beside each .tsx
# in src/ — twelve of them, committed, shadowing the sources they came from.
# The script no longer does that; this is so the next thing that tries cannot.
apps/console/tsconfig.tsbuildinfo
apps/console/src/**/*.js

# Things dropped in the working directory that are not the repository's.
# The symposium badge landed here and a `git add -A` swept it into a commit
# about removing leftovers, which is the joke telling itself.
*.pdf
catalog/vehicles/mini-hoot/mini-hoot.usd
data/videos/
