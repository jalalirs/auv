# Copy to .env. Nothing here is a secret: the tool never sees your Amazon
# password. It drives a browser profile you have signed into yourself, once,
# and Amazon's own cookies do the rest.

# Which Amazon. sa, com, de ...
AMAZON_DOMAIN=amazon.sa

# A directory the tool creates and keeps a Chromium profile in. The first
# `procure login` opens a window; you sign in; the profile remembers it.
AMAZON_PROFILE_DIR=~/.cache/procure/amazon-profile
