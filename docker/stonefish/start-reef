#!/usr/bin/env bash
set -eo pipefail

source /opt/ros/jazzy/setup.bash
source /opt/reef_ws/install/setup.bash
set -u

package_share="$(ros2 pkg prefix --share mola_auv_sim)"

# Xpra starts with a very large virtual desktop and later resizes it to the
# browser. Stonefish centers its SDL window on that initial desktop, which can
# leave it completely off-screen after the resize.
/usr/local/bin/place-stonefish-window &

# Capture driving keys from the streamed X desktop and publish them to MOLA's
# joystick allocator. Passive X11 grabs keep those keys away from the camera.
ros2 run auv_control reef_x11_teleop \
    > /data/logs/reef/x11-teleop.log 2>&1 &

# Eight-core affinity avoids a Stonefish 1.6 physics-worker memory race seen
# when all 24 host cores run concurrently, while retaining parallel physics.
exec taskset -c "${REEF_CPUSET:-0-7}" \
    /opt/VirtualGL/bin/vglrun -d egl \
    ros2 launch stonefish_ros2 stonefish_simulator.launch.py \
    simulation_data:="${package_share}/data" \
    scenario_desc:="${package_share}/scenarios/living_reef.scn" \
    simulation_rate:=100.0 \
    window_res_x:=1440 \
    window_res_y:=900 \
    rendering_quality:=high
