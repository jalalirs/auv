<?xml version="1.0"?>
<scenario>
  <environment>
    <ned latitude="36.7990" longitude="-121.9018"/>
    <ocean>
      <water density="1027.0" jerlov="0.15"/>
      <waves height="0.25"/>
      <particles enabled="true"/>
      <current type="uniform">
        <velocity xyz="0.20 0.05 0.0"/>
      </current>
      <current type="jet">
        <center xyz="4.0 -1.0 5.0"/>
        <outlet radius="1.5"/>
        <velocity xyz="0.0 0.40 0.0"/>
      </current>
    </ocean>
    <atmosphere>
      <sun azimuth="25.0" elevation="55.0"/>
    </atmosphere>
  </environment>

  <include file="$(find mola_auv_sim)/scenarios/materials_looks.scn"/>

  <static name="SandFloor" type="model">
    <physical>
      <mesh filename="sand_floor/mesh/sand_floor.obj" scale="0.3" convex="false"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </physical>
    <material name="Neutral"/>
    <look name="sand_floor"/>
    <world_transform xyz="0.0 0.0 8.0" rpy="0.0 0.0 0.0"/>
  </static>

  <static name="CalibrationMarker" type="model">
    <physical>
      <mesh filename="calibration_marker/mesh/supportA4.obj" scale="1.0" convex="false"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </physical>
    <material name="Neutral"/>
    <look name="calibChess14x10"/>
    <world_transform xyz="2.0 0.0 7.4" rpy="0.0 0.0 0.0"/>
  </static>

  <include file="$(find mola_auv_sim)/scenarios/corals.scn"/>
  <include file="$(find mola_auv_sim)/scenarios/fish_school.scn"/>
  <include file="$(find mola_auv_sim)/scenarios/mola_auv.scn"/>
</scenario>
