+void OpenGLTrackball::FollowMoving(MovingEntity* ent,
+                                   glm::vec3 localDirection_,
+                                   glm::vec3 localUp_,
+                                   GLfloat orbitRadius,
+                                   glm::vec3 localCenterOffset_)
+{
+    holdingEntity = ent;
+    followOrientation = ent != nullptr;
+    localDirection = glm::normalize(localDirection_);
+    localUp = glm::normalize(localUp_);
+    localCenterOffset = localCenterOffset_;
+    radius = glm::max(orbitRadius, 0.05f);
+    UpdateCenterPos();
+    UpdateTransform();
+
+    Ocean* ocean = ((GraphicalSimulationApp*)SimulationApp::getApp())->getSimulationManager()->getOcean();
+    if(ocean != nullptr && ocean->hasWaves())
+        ((OpenGLRealOcean*)ocean->getOpenGLOcean())->ResetSurface(this);
+}
