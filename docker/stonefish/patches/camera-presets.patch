+void GraphicalSimulationApp::SetCameraPreset(unsigned int preset)
+{
+    OpenGLTrackball* trackball = getSimulationManager()->getTrackball();
+    if(trackball == nullptr)
+        return;
+
+    if(preset == 5)
+    {
+        trackballCenter = nullptr;
+        trackball->GlueToMoving(nullptr);
+        cameraPreset = preset;
+        return;
+    }
+
+    Robot* robot = getSimulationManager()->getRobot(0);
+    if(robot == nullptr)
+        return;
+
+    trackballCenter = robot->getBaseLink();
+    switch(preset)
+    {
+        case 1: // Chase from behind and slightly above.
+            trackball->FollowMoving(trackballCenter,
+                                    glm::vec3(1.f, 0.f, 0.22f),
+                                    glm::vec3(0.f, 0.f, -1.f), 4.5f);
+            break;
+        case 2: // Top-down, with the vehicle nose pointing up-screen.
+            trackball->FollowMoving(trackballCenter,
+                                    glm::vec3(0.f, 0.f, 1.f),
+                                    glm::vec3(1.f, 0.f, 0.f), 7.f);
+            break;
+        case 3: // Look at the vehicle head-on.
+            trackball->FollowMoving(trackballCenter,
+                                    glm::vec3(-1.f, 0.f, 0.f),
+                                    glm::vec3(0.f, 0.f, -1.f), 4.f);
+            break;
+        case 4: // Nose-mounted first-person view.
+            trackball->FollowMoving(trackballCenter,
+                                    glm::vec3(1.f, 0.f, 0.f),
+                                    glm::vec3(0.f, 0.f, -1.f), 0.05f,
+                                    glm::vec3(0.65f, 0.f, 0.f));
+            break;
+        default:
+            return;
+    }
+    cameraPreset = preset;
 }

