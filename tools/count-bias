#!/usr/bin/env python3
"""How much a vehicle's own presence costs the fish count it makes.

    tools/count-bias --place looe-key --vehicles mini-hoot,boxfish-luna --seeds 0,1,2

Every survey that counts fish from a vehicle has the same flaw: the fish see
the vehicle too, and the ones that leave are the ones it does not count. The
literature measures it with divers and submersibles (Laidig 2013: 57% of fish
reacted to an ROV; Lindfield 2014: a silent diver counts up to 2.6 times more
in fished areas) and cannot measure it for a vehicle that has not been built.

This flies the same transect twice on the same seed — once with fish that see
the vehicle (Hein's looming rule, systems/fish.py) and once with fish that do
not — and counts what the camera saw each time, each fish once. The second is
what was there to be counted; the first is what the vehicle got. Their ratio is
its count bias, and it is a property of the vehicle: its size, its speed, how
hard its thrusters work, where its camera looks. Undrawn, on this machine.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "services/sim-runtime/coral"))


def a_dive(place: str, vehicle: str, seed: int, objective: dict):
    from hydrodynamics import Allocator, Body, Hydrodynamics
    from runner import Dive

    package = ROOT / "catalog/vehicles" / vehicle / "dynamics.json"
    model = Hydrodynamics.from_package(package)
    brief = {"seed": seed, "durationSeconds": 400.0, "vehiclePath": str(package.parent),
             # Untethered, both: what is compared is the vehicle, not the
             # length of its cable.
             "initialState": {"tetherOutM": 0.0},
             "objective": objective,
             "cityPath": str(pathlib.Path.home() / "coral-city/places" / place),
             "conditions": {"kind": "constructed", "name": "count-bias", "parameters": {}}}
    dive = Dive(brief, Body(model), Allocator(model), pathlib.Path("nowhere.usda"), lambda k, **d: None)
    if not dive.open_dry():
        raise SystemExit(f"{place} would not open undrawn")
    return dive


def over_the_nearest_school(place: str, seed: int, beyond: float, altitude: float = 1.5) -> dict:
    """A transect from where the dive starts, through the nearest school and
    on past it: a fish survey goes where the fish are."""
    import numpy as np

    os.environ["CORAL_CITY_FISH_BLIND"] = "1"
    dive = a_dive(place, "boxfish-luna", seed, {"kind": "hold", "seconds": 1})
    school, start = dive.shoal, dive.position[:2]
    best = None
    for group in np.unique(school.school):
        members = np.flatnonzero(school.school == group)
        if len(members) < 4:
            continue
        centre = school.at[members, :2].mean(axis=0)
        far = float(np.linalg.norm(centre - start))
        if best is None or far < best[0]:
            best = (far, centre)
    far, centre = best
    way = (centre - start) / far
    reach = way * (far + beyond)
    # dx ahead, dy to starboard of a vehicle facing +x: starboard is -y.
    # At a survey's height over the bottom, not at a depth: a reef's spurs
    # stand up into a fixed depth, and a vehicle held against one counts
    # nothing either way.
    return {"kind": "reach", "dx": round(float(reach[0]), 2), "dy": round(float(-reach[1]), 2),
            "altitudeM": altitude, "radiusM": 1.5, "timeLimitS": 380.0}


def fly(place: str, vehicle: str, seed: int, objective: dict, blind: bool) -> dict:
    os.environ["CORAL_CITY_FISH_BLIND"] = "1" if blind else "0"
    dive = a_dive(place, vehicle, seed, objective)
    while not dive.done:
        dive.step()
    said = dive.shoal.said() if dive.shoal is not None else {}
    coral = dive.ocean.coral.said() if len(dive.ocean.coral) else {}
    sediment = dive.ocean.sediment
    return {"counted": said.get("countedByTheCamera", 0), "inViewMean": said.get("inViewMean", 0.0),
            "bumped": said.get("bumped", 0), "seconds": round(dive.simulated, 1),
            "ground": dive.what_it_hit().get("ground"),
            "coralStruck": coral.get("struck", 0), "coralBroken": len(coral.get("broken", [])),
            "sandLiftedG": round(sediment.lifted_kg * 1000.0, 3),
            "worstVisibilityM": None if sediment.worst_visibility_m is None else round(float(sediment.worst_visibility_m), 2),
            "arrived": bool((dive.task.result() or {}).get("arrived")) if dive.task else None,
            "disturbance": dive.disturbance()}


def together(per_seed: list[list[dict]]) -> list[dict]:
    """One vehicle's disturbance over its seeds: each row summed, with the
    range it took from seed to seed. "of N" units are summed too, so a share
    stays a share of what was there across all of them."""
    import re

    out: dict[str, dict] = {}
    for rows in per_seed:
        for r in rows:
            one = out.setdefault(r["what"], dict(r, value=0.0, seen=[], of=0))
            one["value"] += float(r["value"])
            one["seen"].append(float(r["value"]))
            m = re.match(r"of (\d+)", r.get("unit", ""))
            if m:
                one["of"] += int(m.group(1))
    rows = []
    for one in out.values():
        low, high = min(one["seen"]), max(one["seen"])
        unit = f"of {one['of']}" if one["of"] else one["unit"]
        value = round(one["value"], 2) if isinstance(one["value"], float) and one["value"] % 1 else int(one["value"])
        rows.append({"what": one["what"], "value": value, "kind": one["kind"], "from": one["from"],
                     "unit": f"{unit} over {len(one['seen'])} seeds (each {low:g}–{high:g})"})
    return rows


def interval(pairs: list[tuple[int, int]], draws: int = 4000, seed: int = 0) -> tuple[float, float]:
    """A 95% bootstrap interval for the share counted, resampling seeds."""
    import numpy as np

    rng = np.random.default_rng(seed)
    a = np.array(pairs, dtype=float)
    picks = rng.integers(0, len(a), size=(draws, len(a)))
    seeing, blind = a[picks, 0].sum(axis=1), a[picks, 1].sum(axis=1)
    shares = seeing[blind > 0] / blind[blind > 0]
    return float(np.percentile(shares, 2.5)), float(np.percentile(shares, 97.5))


def reports(rows: list[dict], place: str, into: pathlib.Path) -> None:
    """One page a vehicle, and one putting them side by side: what each did to
    the reef and how far it biased its own count, every figure tagged."""
    sys.path.insert(0, str(ROOT / "tools"))
    import importlib.machinery
    import importlib.util

    import disturbance

    def tool(name):
        loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(ROOT / "tools" / name))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return module

    deliver, prov = tool("deliver"), tool("provenance")
    into.mkdir(parents=True, exist_ok=True)
    summary = {}
    for vehicle in dict.fromkeys(r["vehicle"] for r in rows):
        mine = [r for r in rows if r["vehicle"] == vehicle and r["blind"]["counted"]]
        if not mine:
            continue
        pairs = [(r["seeing"]["counted"], r["blind"]["counted"]) for r in mine]
        share = disturbance.counted_share(sum(a for a, _ in pairs), sum(b for _, b in pairs))
        low, high = interval(pairs)
        share["unit"] += f" over {len(mine)} seeds (95% interval {low:.0%}–{high:.0%})"
        reef = together([r["seeing"]["disturbance"] for r in mine])
        summary[vehicle] = {"countedShare": share, "interval": [round(low, 3), round(high, 3)],
                            "disturbance": reef, "seeds": [r["seed"] for r in mine],
                            "transects": [r["transect"] for r in mine]}
        body = deliver.disturbance_section(reef, share, prov)
        (into / f"{vehicle}.html").write_text(prov.frame(
            title=f"{vehicle} at {place} — what it did and what it missed", name=html.escape(vehicle),
            where=html.escape(f"{place} · the same transects, {len(mine)} seeds, flown undrawn"),
            says=SAYS, body=body,
            footer="Built by tools/count-bias. Not one figure here is an observation of a real reef."))
    (into / "count-bias.json").write_text(json.dumps({"place": place, "vehicles": summary}, indent=1) + "\n")
    # And side by side, which is the comparison the report exists for.
    names = list(summary)
    whats = list(dict.fromkeys(r["what"] for v in summary.values() for r in v["disturbance"]))
    head = "".join(f"<th>{html.escape(n)}</th>" for n in names)

    def cell(vehicle, what):
        got = [r for r in summary[vehicle]["disturbance"] if r["what"] == what]
        return f"<td>{got[0]['value']:g}</td>" if got else "<td>—</td>"

    lines = [f"<tr><td class=\"what\">share of the fish there that the camera counted</td>"
             + "".join(f"<td><b>{summary[n]['countedShare']['value']:.0%}</b> "
                       f"({summary[n]['interval'][0]:.0%}–{summary[n]['interval'][1]:.0%})</td>" for n in names)
             + "</tr>"]
    lines += [f"<tr><td class=\"what\">{html.escape(w)}</td>" + "".join(cell(n, w) for n in names) + "</tr>"
              for w in whats]
    (into / "compare.html").write_text(prov.frame(
        title=f"{' and '.join(names)} at {place}", name=html.escape(" and ".join(names)),
        where=html.escape(f"{place} · the same transects and seeds for each"), says=SAYS,
        body=f"<table><tr><th></th>{head}</tr>{''.join(lines)}</table>"
             + "".join(f'<p><a href="{html.escape(n)}.html">{html.escape(n)}: every figure and where it came from</a></p>'
                       for n in names),
        footer="Built by tools/count-bias. Not one figure here is an observation of a real reef."))


SAYS = """<p class="says"><strong>What this is.</strong> The same survey flown by
each vehicle on the same seeds, twice a seed: once with fish that see the vehicle and
once with fish that cannot. The second is what was there to be counted; the first is
what the vehicle got. Beside it, what the vehicle did to the reef on the way. Every
figure is what a model computed, and says from what.</p>"""


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--place", default="looe-key")
    ap.add_argument("--vehicles", default="mini-hoot,boxfish-luna")
    ap.add_argument("--seeds", default="0,1,2")
    ap.add_argument("--metres", type=float, default=25.0)
    ap.add_argument("--altitude", type=float, default=1.5, help="metres over the bottom the transect is flown at")
    ap.add_argument("--into", type=pathlib.Path, help="write a report a vehicle and one comparing them here")
    ap.add_argument("--merge", nargs="+", type=pathlib.Path,
                    help="fly nothing: build the reports from rows other runs printed (split seeds across processes)")
    args = ap.parse_args()
    if args.merge:
        rows = [json.loads(line) for f in args.merge for line in f.read_text().splitlines()
                if line.startswith('{"vehicle"')]
        rows.sort(key=lambda r: (args.vehicles.split(",").index(r["vehicle"]), r["seed"]))
        reports(rows, f"{args.place}, {args.altitude:g} m over the bottom", args.into)
        print(f"{len(rows)} rows → {args.into}")
        return 0
    rows = []
    transects = {seed: over_the_nearest_school(args.place, seed, 10.0, args.altitude)
                 for seed in (int(s) for s in args.seeds.split(","))}
    for vehicle in args.vehicles.split(","):
        for seed, objective in transects.items():
            seeing = fly(args.place, vehicle, seed, objective, blind=False)
            blind = fly(args.place, vehicle, seed, objective, blind=True)
            ratio = seeing["counted"] / blind["counted"] if blind["counted"] else None
            rows.append({"vehicle": vehicle, "seed": seed, "transect": objective, "seeing": seeing, "blind": blind,
                         "countedShare": None if ratio is None else round(ratio, 3)})
            print(json.dumps(rows[-1]), flush=True)
    print("\nvehicle          counted (fish see it / fish blind to it)   share of what was there")
    for vehicle in args.vehicles.split(","):
        mine = [r for r in rows if r["vehicle"] == vehicle and r["countedShare"] is not None]
        if not mine:
            continue
        a = sum(r["seeing"]["counted"] for r in mine)
        b = sum(r["blind"]["counted"] for r in mine)
        print(f"{vehicle:<16} {a:>6} / {b:<6} over {len(mine)} seeds              {a / b:.0%}")
    # And what it did to the place getting there, from the runs where the fish
    # could see it: the same transects, the same seeds.
    print("\nvehicle          fish struck  ground touched  coral struck / broken  sand lifted g  worst visibility m")
    for vehicle in args.vehicles.split(","):
        mine = [r["seeing"] for r in rows if r["vehicle"] == vehicle]
        if not mine:
            continue
        seen = [m["worstVisibilityM"] for m in mine if m.get("worstVisibilityM") is not None]
        print(f"{vehicle:<16} {sum(m['bumped'] for m in mine):>11}  {sum(m['ground'] or 0 for m in mine):>14}"
              f"  {sum(m.get('coralStruck', 0) for m in mine):>12} / {sum(m.get('coralBroken', 0) for m in mine):<7}"
              f"  {sum(m.get('sandLiftedG', 0.0) for m in mine):>13.2f}  {min(seen) if seen else float('nan'):>18.1f}")
    if args.into:
        reports(rows, f"{args.place}, {args.altitude:g} m over the bottom", args.into)
        print(f"\nreports in {args.into}: compare.html, " + ", ".join(f"{v}.html" for v in args.vehicles.split(",")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
