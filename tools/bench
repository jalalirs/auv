#!/usr/bin/env python3
"""The bench: the same dives, flown by different controllers, compared.

  ./tools/bench run --controller pursue
  ./tools/bench run --controller ponder
  ./tools/bench show
  ./tools/bench compare pursue ponder

Everything that is not the controller is held still. The same eight tasks, the
same water, the same fit, and — the part that is easy to forget — the same
seed, so that the compass is wrong in exactly the same way for everyone. A
bench that gives one controller a favourable draw of noise is not a bench, it
is an anecdote with a table.

What is reported is not only the score. A controller that scores five per cent
better while spending twice the energy is not obviously better, and one that
scores better by thinking for four seconds a step is not better at all on a
vehicle with a battery. So: score, how far its navigation drifted, energy,
time in the water, and what it cost to think — how many thoughts, and how long
the slowest took.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import pathlib
import statistics
import sys

HERE = pathlib.Path(__file__).resolve().parent
MATRIX = (HERE / "matrix").read_text().split("def run_matrix")[0]
mod: dict = {}
exec(compile(MATRIX, "matrix", "exec"), mod)

Platform = mod["Platform"]
TASKS, WATERS, POSITIONING = mod["TASKS"], mod["WATERS"], mod["POSITIONING"]

BOLD, DIM, OFF = "\033[1m", "\033[2m", "\033[0m"
GREEN, RED, AMBER = "\033[32m", "\033[31m", "\033[33m"

# The suite. Eight of the eleven tasks: the ones a controller can be judged on
# rather than the ones that judge the water. Held here rather than taken from a
# flag, because a benchmark whose contents move is not one.
SUITES = {
    "standard": ["reach", "waypoints", "transect", "survey", "search",
                 "treat", "inspect", "dock"],
    "quick": ["reach", "transect", "dock"],
}

# The conditions the suite is flown in. One water, one fit, so that what is
# being compared is the controller and nothing else.
WATER = "gentle"
TECHNOLOGY = "dead-reckoning"


def seed_for(suite: str, task: str) -> int:
    """The same number for the same dive, whoever is flying it, forever.

    Not Python's hash: that is salted per process, so the same task would draw
    different water on Tuesday than it did on Monday and every comparison
    across days would be quietly worthless. A digest is the same number on
    every machine and every run, which is the entire requirement.
    """
    return int(hashlib.sha256(f"{suite}/{task}".encode()).hexdigest()[:8], 16) % 100000


# The hull the suite is flown on unless somebody says otherwise. Named here
# because a row's name has to say when it was *not* that one.
THE_USUAL_HULL = "bluerov2"
# And the reef a bench is flown over unless somebody says otherwise.
THE_USUAL_PLACE = "looe-key"


# What a bench can and cannot tell apart, and the one thing that decides it.
#
# `wary` is `pursue` with the imaging sonar on. Flown over a floor pinned flat
# at twelve metres the two came out identical to the last decimal, and the
# obvious reading was that a dry bench cannot compare controllers that differ in
# seeing. That reading was wrong twice over. What a vehicle can run into comes
# from the brief's **layout** and not from the renderer — `World(brief["layout"])`
# — so a dive with nothing to see can still have things in the water; and the
# reason the bench had none was simply that its brief carried no layout.
#
# A place package does not ship one either: a survey holds a seabed and its
# coral, and everything somebody *arranged* — a frame here, a block there — is a
# separate thing the platform keeps. So for a dry bench the layout is made here,
# from the task's own geometry, which is the only way to be sure the things are
# actually in the way rather than somewhere the vehicle was never going.
#
# It is opt-in and it is in the row's name, because a row flown through things
# and a row flown through open water are not comparable and every row already in
# the record was flown through open water.
THINGS_IN_THE_WAY = 3

# What stands in the water, and how big it is when nobody says.
#
# From the runtime's own palette, and a test holds these numbers against it. A
# nursery frame is two metres across and 1.2 m tall; a marker post is three
# metres tall and **0.2 m** across. That combination is why the first two
# attempts at this failed — the tall thing is thin and the wide thing is short —
# and it is also why the answer is to state the height rather than to pick a
# taller kind. A layout may give any thing its own `heightM` and `radiusM`, and a
# coral tree nursery genuinely is a frame two metres across and three to five
# metres tall. A marker post genuinely is a stick, and a vehicle that missed one
# by half a metre was right to.
FRAME = ("nursery-frame", 2.0)
# Taller than this is not a structure anybody has in the water, and a bench that
# grew its obstacles until they were unavoidable would be measuring nothing.
TALLEST_HONEST_FRAME = 6.0


def something_in_the_way(objective: dict) -> dict:
    """A thing the vehicle would actually meet, at the altitude it is holding.

    Two measured failures are behind this, both of them the same failure — a row
    that said "flown through things" about a dive that passed nothing:

      A frame is 1.2 m tall and a transect holds 3 m of altitude, so three frames
      on the line are three frames flown a metre and a half over.
      Choosing the marker post instead fixed the height and broke the width: a
      post is 0.2 m across, so a vehicle a quarter of a metre wide has to pass
      within half a metre of its centre to touch it, and measured, none of them
      did — `struck=0`, and the two controllers tied at 0.407 again.

    So it is the wide thing, given the height it needs: a frame two metres across
    standing tall enough to reach into the band the task flies in. Refused above
    six metres, because at that point the arrangement is being grown until
    nothing could avoid it, which measures the arrangement and not the
    controller.
    """
    kind, radius = FRAME
    altitude = objective.get("altitudeM")
    if altitude is None:
        # No stated altitude: the vehicle holds the depth it started at and the
        # bottom under it is unknown from here, so the frame is as tall as an
        # honest one gets and the dive meets it or does not.
        return {"kind": kind, "radiusM": radius, "heightM": TALLEST_HONEST_FRAME}
    # Into the band rather than up to it: a vehicle flying the task correctly is
    # anywhere within the band, and a frame that stopped at its lower edge would
    # be met only by a dive already flying low.
    reach = float(altitude) + float(objective.get("altitudeBandM", 0.0)) / 2.0 + 0.3
    if reach > TALLEST_HONEST_FRAME:
        raise SystemExit(
            f"a {objective.get('kind')} holds {altitude:g} m of altitude, so a frame "
            f"would have to stand {reach:.1f} m to be in its way and the tallest "
            f"honest one is {TALLEST_HONEST_FRAME:g} m. Nothing anybody has in the "
            "water would be met by this dive, and a row claiming otherwise would "
            "make a bench that rewards flying high")
    return {"kind": kind, "radiusM": radius, "heightM": round(reach, 2)}


def how_far_the_task_goes(objective: dict) -> tuple[float, float]:
    """The furthest point the task states, which is the line to put things on.

    Read off whatever that task calls it rather than special-cased by kind: a
    task that stated its geometry in a field this does not know about would
    otherwise get its frames dropped in open water behind the vehicle, and a
    bench that says "flown through things" while the vehicle passed nothing is
    worse than one that never claimed it.
    """
    if "dx" in objective or "dy" in objective:
        return float(objective.get("dx", 0.0)), float(objective.get("dy", 0.0))
    marks = objective.get("marks")
    if isinstance(marks, list) and marks:
        last = marks[-1]
        return float(last.get("dx", 0.0)), float(last.get("dy", 0.0))
    for key in ("lengthM", "widthM", "awayM", "radiusM"):
        if key in objective:
            return float(objective[key]), 0.0
    raise SystemExit(f"a {objective.get('kind')} does not say how far it goes, so "
                     "there is nowhere to put things that would be in the way")


def things_in_the_way(objective: dict, seed: int, ground, begins_at=(0.0, 0.0)) -> dict:
    """Things standing on the line the task walks, tall enough to be met.

    Reef furniture rather than mooring blocks because this is reef work and a
    frame or a plot marker is what is actually in the way on a restoration site.
    Which of them it is comes from the altitude the task holds — see
    `something_in_the_way`, which is where the first two attempts went wrong.

    Offset from the line by a seeded amount smaller than the thing, so some are
    dead ahead and some are a near miss. Seeded from the task's own seed, so the
    two controllers being compared meet the same three in the same places —
    which is the whole point of a bench.

    Each one carries the depth of the bottom under it, which is the second thing
    this got wrong. A thing that lands on the ground and does not say where the
    ground is **sits at zero** — `world.py` says so plainly — so three posts
    three metres tall stood from the surface down, in the air above a vehicle
    fifteen metres under, and a bench would have called that flying through
    things. `ground` answers where the bottom is at a point, out of the same
    heightfield the dive itself flies over.

    And `begins_at` is the fourth thing this got wrong, which took four measured
    runs to see because the first three all looked like geometry. **A task's
    geometry is relative to where the dive starts and a layout is in the world's
    own coordinates.** Over a real reef the place decides where the vehicle goes
    in — an Al Fahal dive starts around (854, -1106) — so three frames placed
    fifty, a hundred and a hundred and fifty metres from the *origin* are three
    frames a kilometre and a half behind the vehicle, and `struck` was 0 for the
    fourth time. Everything below is offset by where the dive actually begins.
    """
    import random

    thing = something_in_the_way(objective)
    far_x, far_y = how_far_the_task_goes(objective)
    reach = math.hypot(far_x, far_y)
    if reach < 10.0:
        raise SystemExit(f"a {objective.get('kind')} covers {reach:.0f} m, which is "
                         "too little ground to put anything in the way of")
    along = (far_x / reach, far_y / reach)
    across = (-along[1], along[0])
    draw = random.Random(f"things/{seed}/{objective.get('kind')}")
    things = []
    # Off the line by less than the thing is wide, so every one of them is in
    # the way of a vehicle flying the line and none is dead centre on it. A fixed
    # offset in metres was the third version of this bug: 1.2 m is inside a frame
    # and half a metre outside a post.
    room = float(thing["radiusM"]) * 0.6
    for i in range(THINGS_IN_THE_WAY):
        at = reach * (i + 1) / (THINGS_IN_THE_WAY + 1)
        off = draw.uniform(-room, room)
        x = round(float(begins_at[0]) + along[0] * at + across[0] * off, 2)
        y = round(float(begins_at[1]) + along[1] * at + across[1] * off, 2)
        # Positive metres down, which is how a layout states it.
        things.append({"id": f"thing-{i + 1}", **thing, "x": x, "y": y,
                       "groundM": round(-float(ground(x, y)), 2)})
    return {"things": things}


def named(suite: str, controller: str, task: str, vehicle: str = THE_USUAL_HULL,
          place: str = THE_USUAL_PLACE, through: bool = False) -> str:
    """What a row is called, and it has to name everything being compared.

    The hull was not in it. Fly `pursue` on a BlueROV2 and then on a Heavy
    and both rows are called "bench · quick · pursue · reach" — two
    different things under one name, which the bench then reads as one and
    reports whichever came back first. A Heavy has eight thrusters and half
    again the surge; that is not the same controller doing better.

    Nor was the reef, for the same reason and with the same consequence. A
    transect over Looe Key and a transect over Al Fahal are the same task over
    a four-percent-coral reef in eighteen metres and a Red Sea fore-reef in
    thirty: a controller holding altitude over one is not doing what a
    controller holding altitude over the other is doing. Both rows were called
    "bench · quick · pursue · transect", so the second was reported as already
    flown and never ran.

    Put in the controller's own field rather than as a fifth part, so every
    row already in the record still parses and reads as it did.
    """
    whose = controller
    if vehicle != THE_USUAL_HULL:
        whose = f"{whose} on {vehicle}"
    if place != THE_USUAL_PLACE:
        whose = f"{whose} over {place}"
    if through:
        whose = f"{whose} through things"
    return f"bench · {suite} · {whose} · {task}"


# The controllers that live inside the runtime. Everything else named on the
# command line is somebody's own, deployed through the SDK, and is flown by
# attaching it to the dive rather than by asking the helm for it by name.
BUILT_IN = ("pursue", "wary", "ponder", "asking", "hold", "glide")


def deployed(platform, slug: str) -> dict | None:
    """Somebody's own controller, by the handle they deployed it under.

    The bench selected a controller by name out of the helm's registry, which
    only ever holds the built-ins and one entry called `stack` — so there was
    no way to bench a customer's controller, and no way to bench two of them
    against each other, because both were `stack`. A bench that can only rank
    our own baselines is ranking the wrong thing.

    The newest build of that slug, not the first the listing happens to hand
    back. Every `coral-city deploy` registers another build under the same
    handle — `learned-hold` already has two — and benching whichever came
    back first means a change verified against the build it replaced. That
    exact mistake has been made here before, with dives rather than stacks.
    """
    listed = platform.call("GET", f"/api/v1/organisations/{platform.org}/autonomy")
    theirs = [one for one in listed.get("autonomy", [])
              if one.get("slug") == slug or one.get("name") == slug]
    if not theirs:
        return None
    return max(theirs, key=lambda one: one.get("createdAt") or "")


def whose(platform, slug: str) -> dict:
    """What it takes to fly this controller: a built-in by name, or a stack.

    Refuses a name that is neither, rather than quietly falling back to the
    hold — a bench row attributed to a controller that never flew is worse
    than a bench that would not run.
    """
    if slug in BUILT_IN:
        return {"builtIn": slug}
    stack = deployed(platform, slug)
    if stack is None:
        listed = platform.call("GET", f"/api/v1/organisations/{platform.org}/autonomy")
        theirs = ", ".join(sorted(one.get("slug", "") for one in listed.get("autonomy", [])))
        raise SystemExit(
            f"no controller called '{slug}'. Built in: {', '.join(BUILT_IN)}."
            + (f" Deployed here: {theirs}." if theirs else
               " Nothing has been deployed to this organisation; "
               "`coral-city deploy` puts one there."))
    return {"stack": stack}


def built_or_built_by(flying: dict) -> str:
    """Which controller this actually is, said where somebody will read it.

    The digest, because a slug is a handle and a handle is not a build: two
    runs of the bench under one name are only comparable if they were the
    same image, and the only way anybody can check that afterwards is if the
    run said which one it flew.
    """
    if "builtIn" in flying:
        return "built in"
    stack = flying["stack"]
    digest = (stack.get("imageDigest") or "")[7:19]
    return f"deployed {stack.get('createdAt', '')[:10]} · {digest}"


# ── flying it ────────────────────────────────────────────────────────────────

def command_run(args) -> int:
    platform = Platform()
    tasks = SUITES[args.suite]
    if args.tasks:
        # A subset, on purpose and named on the command line. The suite is
        # held still because a benchmark whose contents move is not one; this
        # is for getting one dive through the whole path, and `show` says
        # underneath each controller how much of the suite it actually flew,
        # so a partial run cannot be read as a result.
        asked_for = [t.strip() for t in args.tasks.split(",") if t.strip()]
        unknown = [t for t in asked_for if t not in tasks]
        if unknown:
            raise SystemExit(f"{args.suite} has no task called {', '.join(unknown)}. "
                             f"It has {', '.join(tasks)}.")
        tasks = asked_for
    city = mod["newest_version"](platform, "cities", args.place)
    vehicle = mod["newest_version"](platform, "vehicles", args.vehicle)
    queue = platform.call("GET", "/api/v1/queues")["queues"][0]
    runtime = queue["runtimes"][0]
    water_name, water = WATERS[WATER]
    technology_name, technology = POSITIONING[TECHNOLOGY]
    conditions = platform.call("POST", f"/api/v1/organisations/{platform.org}/conditions", {
        "kind": "constructed", "name": f"the bench · {water_name} · {technology_name}",
        "parameters": {**water, **technology}})

    # Whose controller this is, before anything is flown: a built-in by name,
    # or one somebody deployed, attached to every dive in the suite.
    flying = whose(platform, args.controller)
    already = {row["name"] for row in flown(platform)} if not args.again else set()
    asked = []
    print(f"{BOLD}{args.suite}{OFF} flown by {BOLD}{args.controller}{OFF} "
          f"{DIM}· {built_or_built_by(flying)}"
          f" · {water_name} · {technology_name}{OFF}")
    for task in tasks:
        name = named(args.suite, args.controller, task, args.vehicle, args.place)
        if name in already:
            print(f"{DIM}  {task} — already flown{OFF}")
            continue
        objective = dict(TASKS[task])
        # What makes the comparison a comparison: the controller by name, and
        # the same seed for the same task whoever is flying it.
        objective["seed"] = seed_for(args.suite, task)
        # And what makes it affordable: nobody watches a bench.
        #
        # A rendered dive runs at 0.17 times real time and an undrawn one at
        # fifteen, on the same brief and the same card, and the two write the
        # same poses file to the byte — so this suite costs about a quarter of
        # an hour rather than a day, and does not need a GPU. The score comes
        # from the numbers; if somebody wants to see one of these flights, they
        # fly it again by hand and get a video.
        objective["pictures"] = False
        defined = {"name": name, "cityVersionId": city, "vehicleVersionId": vehicle,
                   "conditionsId": conditions["id"], "objective": objective}
        if "builtIn" in flying:
            objective["controller"] = flying["builtIn"]
        else:
            # Somebody else's, in a container. It is not named in the
            # objective because the helm has no such entry to look up: the
            # dive carries the stack, the agent starts it, and it arrives
            # over ROS 2 — under its own name, now that the dive says so.
            defined["autonomyStackId"] = flying["stack"]["id"]
        dive = platform.call("POST", f"/api/v1/organisations/{platform.org}/dives", defined)
        run = platform.call("POST", f"/api/v1/dives/{dive['id']}/runs", {
            "queueId": queue["id"], "mode": "batch", "runtimeVersion": runtime})
        asked.append({"dive": dive["id"], "run": run["id"], "name": name})
        print(f"  {task}")
        if len(asked) % args.at_once == 0:
            mod["wait_for"](platform, asked[-args.at_once:])
    if asked:
        mod["wait_for"](platform, asked)
    print(f"{GREEN}flown{OFF}")
    return command_show(args)


# ── flying it here, with no simulator at all ─────────────────────────────────

def hit_by(dive) -> dict:
    """What a dive struck, in the shape the bench keeps rows in.

    Asked of the dive rather than counted here, because the runtime already
    counts each thing once however long the vehicle was held against it.
    """
    said = dive.what_it_hit() if hasattr(dive, "what_it_hit") else {}
    return {"struck": int(said.get("things", 0)),
            "grounded": int(said.get("ground", 0)),
            "whatItStruck": said.get("which", [])}


def command_dry(args) -> int:
    """Fly the suite in this process: no Isaac, no graphics card, no queue.

    The physics is the same integrator the simulator steps, and everything a
    controller is judged on — where it went, what it spent, how far its
    navigation wandered — comes out of that rather than out of the picture. So
    a controller can be written and benched in the time it takes to run this,
    which is the difference between benchmarking as a ritual and as a habit.

    What it cannot tell you is anything about seeing: no camera, no frames.
    A survey is scored on where the vehicle went, which is honest, and a
    controller that would have looked somewhere is not asked to.
    """
    sys.path.insert(0, str(HERE.parent / "services/sim-runtime/coral"))
    import pathlib as _pathlib

    from hydrodynamics import Allocator, Body, Hydrodynamics
    from runner import Dive

    package = HERE.parent / "catalog/vehicles" / args.vehicle / "dynamics.json"
    model = Hydrodynamics.from_package(package)
    water_name, water = WATERS[WATER]
    technology_name, technology = POSITIONING[TECHNOLOGY]
    # What the reef is called, from the reef. A row named after the directory a
    # package happens to sit in would say `ver_01M2NCG…`, which names a build
    # and not a place, and two builds of one reef would read as two reefs.
    over = THE_USUAL_PLACE
    if args.over:
        try:
            over = json.loads((pathlib.Path(args.over).expanduser()
                               / "site.json").read_text())["name"]
        except Exception:
            raise SystemExit(f"{args.over} does not say what place it is: a row "
                             "has to name the reef it was flown over")
    # Where the bottom is, for standing things on.
    #
    # The same heightfield the dive flies over, read here rather than taken from
    # the dive because a layout has to be complete before the dive exists — the
    # world is built from the brief in the constructor. Over a flat floor it is
    # the flat floor, which is the one case where a constant is the truth.
    THE_FLAT_FLOOR = -12.0
    bottom = lambda x, y: THE_FLAT_FLOOR
    if args.over:
        from runner import Seabed

        seabed = Seabed.of(_pathlib.Path("nowhere.usda"),
                           _pathlib.Path(args.over).expanduser())
        if seabed is None:
            raise SystemExit(f"{args.over} carries no heightfield, so there is no "
                             "bottom to fly over or to stand anything on")
        bottom = seabed.under

    rows = []
    print(f"{BOLD}{args.suite}{OFF} flown here by {BOLD}{args.controller}{OFF} "
          f"{DIM}· {water_name} · {technology_name} · "
          f"{'over ' + over if args.over else 'a flat bottom'} · "
          f"{'through things' if args.through else 'open water'} · no simulator{OFF}")
    for task in SUITES[args.suite]:
        objective = dict(TASKS[task])
        objective["controller"] = args.controller
        objective["seed"] = seed_for(args.suite, task)
        seconds = float(objective.get("timeLimitS") or objective.get("seconds") or 600.0)
        brief = {"durationSeconds": seconds + 60.0,
                 "initialState": {"positionM": [0.0, 0.0, -6.0]},
                 "vehiclePath": str(package.parent),
                 "objective": objective,
                 "conditions": {**water, **technology}}
        if args.over:
            brief["cityPath"] = str(pathlib.Path(args.over).expanduser())
            # Over a real place the vehicle starts where the place says, not at
            # a depth this picked: six metres down is the surface on one reef
            # and inside the bottom on another.
            brief.pop("initialState")
        dive = Dive(brief,
                    Body(model), Allocator(model), _pathlib.Path("nowhere.usda"),
                    lambda kind, **said: None)
        if args.over:
            # A real bottom, and the same code that gives a platform dive its
            # bottom rather than a second one that would agree until it did not.
            # This is what a dive costs with nothing to see: no renderer, no
            # stage, no card — and the place's heightfield all the same, which
            # is what both the multibeam and the imaging sonar march against.
            #
            # It matters for what the bench can compare. Over a floor pinned
            # flat at twelve metres, `wary` is `pursue` with the sonar on and
            # nothing for the sonar to find, so the two came out identical to
            # the last decimal — a bench that could not tell apart the one
            # difference between them. Over a real reef they are two
            # controllers.
            if not dive.open_dry():
                raise SystemExit(f"{args.over} does not describe itself: a place "
                                 "to fly over needs its site.json and the "
                                 "heightfield that names")
        else:
            dive.floor = -12.0
            dive.begin_task(objective)
        if args.through:
            # Put in after opening, because until the place is open nobody knows
            # where the dive begins — and a task's geometry is relative to that
            # while a layout is in the world's own coordinates. Frames placed off
            # the origin instead sat a kilometre and a half behind an Al Fahal
            # dive, which is how this read `struck=0` four times while looking
            # like a geometry problem.
            from world import World

            dive.world = World(things_in_the_way(
                objective, objective["seed"], bottom, dive.position[:2]))
        # A controller's own knobs, moved before it flies. Two settings of one
        # controller are two controllers as far as a bench is concerned, and
        # the interesting question about a thinking one is what its thinking
        # costs — which you cannot ask without being able to make it slower.
        for change in args.tune:
            name, value = change.split("=", 1)
            flying = dive.helm.controllers.get(args.controller)
            if flying is None or not flying.tune(name, float(value)):
                raise SystemExit(f"{args.controller} has no parameter called {name}")
        for _ in range(int((seconds + 30.0) / dive.dt)):
            dive.step()
            if dive.done:
                break
        dive.close()
        said = dive.task.result() if dive.task else {}
        # Who flew it and what it thought come from the helm, not the task:
        # the task knows what was achieved, the helm knows who was flying and
        # what it cost them to decide.
        thought = dive.helm.thought()
        who = dive.helm.who_flew()
        called = args.called or args.controller
        # The hull here too: `bench dry` takes --vehicle and a dry row that
        # did not name it would collide with the flown one exactly as the
        # flown ones collided with each other.
        on = named(args.suite, called, task, args.vehicle, over, args.through)
        rows.append({
            "name": on, "suite": args.suite,
            "controller": on.split("·")[2].strip(), "task": task,
            "score": said.get("score", 0.0),
            "ended": dive.ended or "time",
            "seconds": said.get("seconds", 0.0),
            "energyWh": round(dive.battery.spent_wh, 3) if dive.battery else 0.0,
            "driftM": round(float(dive.navigation.drift(dive.position)), 3)
                      if dive.navigation else 0.0,
            "flownBy": who.get("mostly", "?"),
            "thoughts": sum((t or {}).get("thoughts") or 0 for t in thought.values()),
            "slowestThoughtS": max([(t or {}).get("slowestS") or 0.0
                                    for t in thought.values()], default=0.0),
            # What it hit. The benchmark asks for "energy, time, closing
            # navigation error, things struck" and this was the one of the
            # four nothing reported — which is the whole difference between
            # `wary`, which arrives five metres short and hits nothing, and
            # `pursue`, which arrives exactly and ploughs through three
            # nursery frames.
            **hit_by(dive),
        })
        print(f"  {task:<12} {rows[-1]['score'] * 100:5.0f}%  "
              f"{rows[-1]['driftM']:6.2f} m drift  {rows[-1]['energyWh']:6.2f} Wh  "
              f"{rows[-1]['struck'] + rows[-1]['grounded']:2d} hit  "
              f"{DIM}flown by {rows[-1]['flownBy']}{OFF}")
    kept = _bench_file(args.suite)
    called = args.called or args.controller
    held = [r for r in _read_rows(args.suite) if r["controller"] != called]
    kept.write_text(json.dumps(held + rows, indent=2))
    print(f"{GREEN}on the bench{OFF}{DIM} · kept in {kept}{OFF}")
    return command_show(args)


def _bench_file(suite: str) -> pathlib.Path:
    where = HERE.parent / "docs/bench"
    where.mkdir(parents=True, exist_ok=True)
    return where / f"{suite}.json"


def _read_rows(suite: str) -> list[dict]:
    kept = _bench_file(suite)
    if not kept.exists():
        return []
    try:
        return json.loads(kept.read_text())
    except Exception:
        return []


# ── reading it back ──────────────────────────────────────────────────────────

# What a failure is about, by what the platform said when it gave up. A dive
# that never reached the water is not a controller flying badly, and the two
# must not be averaged together.
THE_CONTROLLERS = ("the controller started and then stopped",
                   "defined with a controller and it would not start",
                   "defined with a controller and the vehicle never came up")


def whose_fault(why: str) -> str:
    """"theirs" when the reason names the controller, "the platform's"
    otherwise. Unknown counts as the platform's: attributing a failure to
    somebody's controller on a guess is the one direction that must not be
    guessed."""
    said = (why or "").lower()
    return "theirs" if any(one in said for one in THE_CONTROLLERS) else "the platform's"


def failed_row(dive: dict, parts: list[str], run: dict) -> dict:
    why = str(run.get("failureReason") or "no reason given")
    return {"name": dive["name"], "suite": parts[1], "controller": parts[2],
            "task": parts[3], "score": 0.0, "ended": "failed",
            "failed": True, "why": why, "fault": whose_fault(why),
            "seconds": 0.0, "energyWh": 0.0, "driftM": 0.0, "flownBy": "—",
            "thoughts": 0, "slowestThoughtS": 0.0,
            "struck": 0, "grounded": 0, "whatItStruck": [],
            "dive": dive["id"], "run": run["id"]}


def flown(platform) -> list[dict]:
    """Every bench dive in the record, as rows."""
    rows = []
    for dive in platform.call("GET", f"/api/v1/organisations/{platform.org}/dives")["dives"]:
        if not dive["name"].startswith("bench · "):
            continue
        parts = [p.strip() for p in dive["name"].split("·")]
        if len(parts) != 4:
            continue
        for run in platform.call("GET", f"/api/v1/dives/{dive['id']}/runs").get("runs", []):
            if run["state"] not in ("succeeded", "failed"):
                continue
            # A failed run is a row too. It used to be skipped, so a
            # controller whose every dive fell over had no rows at all and
            # the bench said "nothing on the bench yet" — a bench that hides
            # failures is a bench that flatters.
            #
            # But not every failure is the controller's. A dive the platform
            # could not start says so, and counting that against somebody's
            # controller is worse than not showing it: it is a number with
            # the wrong name on it.
            if run["state"] == "failed":
                rows.append(failed_row(dive, parts, run))
                break
            out = run.get("outcome") or {}
            task_said = out.get("task") or {}
            thought = task_said.get("thought") or {}
            slowest = max([(t or {}).get("slowestS") or 0.0 for t in thought.values()], default=0.0)
            thoughts = sum([(t or {}).get("thoughts") or 0 for t in thought.values()])
            rows.append({
                "name": dive["name"], "suite": parts[1], "controller": parts[2], "task": parts[3],
                "score": task_said.get("score", 0.0),
                "ended": out.get("ended", "?"),
                "seconds": task_said.get("seconds", 0.0),
                "energyWh": task_said.get("energyWh", 0.0),
                "driftM": (out.get("navigation") or {}).get("driftM", 0.0),
                "flownBy": (task_said.get("flownBy") or {}).get("mostly", "?"),
                "thoughts": thoughts, "slowestThoughtS": slowest,
                "struck": int((out.get("hit") or {}).get("things", 0)),
                "grounded": int((out.get("hit") or {}).get("ground", 0)),
                "whatItStruck": (out.get("hit") or {}).get("which", []),
                "dive": dive["id"], "run": run["id"],
            })
            break
    return rows


def summarise(rows: list[dict]) -> dict:
    # A dive the platform could not start is not a zero — it is an absence,
    # and averaging it in would report somebody's controller as worse than
    # anything it actually did.
    rows = [r for r in rows if r.get("fault") != "the platform's"]

    def mean(key):
        values = [r[key] for r in rows if r.get(key) is not None]
        return statistics.fmean(values) if values else 0.0
    return {"dives": len(rows), "score": mean("score"), "energyWh": mean("energyWh"),
            "driftM": mean("driftM"), "seconds": mean("seconds"),
            "thoughts": sum(r["thoughts"] for r in rows),
            "slowestThoughtS": max([r["slowestThoughtS"] for r in rows], default=0.0),
            # Summed, not averaged. A controller that ploughed through three
            # nursery frames on one dive and nothing on seven did not hit
            # three-eighths of a frame.
            "struck": sum(r.get("struck") or 0 for r in rows),
            "grounded": sum(r.get("grounded") or 0 for r in rows),
            "achieved": sum(1 for r in rows if r["ended"] == "achieved")}


def rows_for(args) -> list[dict]:
    """What is on the bench: what was flown here, and what was flown for real."""
    if args.here:
        return [r for r in _read_rows(args.suite) if r["suite"] == args.suite]
    return [r for r in flown(Platform()) if r["suite"] == args.suite]


def command_show(args) -> int:
    rows = rows_for(args)
    if not rows:
        print("nothing on the bench yet")
        return 0
    controllers = sorted({r["controller"] for r in rows})
    tasks = [t for t in SUITES[args.suite] if any(r["task"] == t for r in rows)]
    print(f"{BOLD}{args.suite}{OFF}{DIM} · {len(rows)} dives{OFF}\n")
    def column(name: str) -> str:
        return (name if len(name) <= 15 else name[:14] + "…").rjust(17)

    print(f"{'':<14}" + "".join(column(c) for c in controllers))
    for task in tasks:
        line = f"{task:<14}"
        for controller in controllers:
            found = next((r for r in rows if r["task"] == task and r["controller"] == controller), None)
            line += f"{('%.0f%%' % (found['score'] * 100)) if found else '—':>17}"
        print(line)
    print()
    print(f"{'':<14}" + "".join(column(c) for c in controllers))
    # How much of the suite each of them actually flew. Every average below
    # is over that many dives, and a mean over one task beside a mean over
    # eight is not a comparison.
    whole = len(SUITES[args.suite])
    line = f"{DIM}{'of the suite':<14}{OFF}"
    for controller in controllers:
        flew = len({r["task"] for r in rows if r["controller"] == controller})
        ink = "" if flew == whole else AMBER
        line += f"{ink}{f'{flew} of {whole}':>17}{OFF if ink else ''}"
    print(line)
    # And what fell over, kept apart by whose fault it was. A dive the
    # platform could not start is not a controller flying badly, and it is
    # not in the averages below either.
    for label, fault, ink in (("failed", "theirs", RED),
                              ("never flew", "the platform's", AMBER)):
        if not any(r.get("fault") == fault for r in rows):
            continue
        line = f"{DIM}{label:<14}{OFF}"
        for controller in controllers:
            count = sum(1 for r in rows
                        if r["controller"] == controller and r.get("fault") == fault)
            line += f"{ink if count else DIM}{count if count else '—':>17}{OFF}"
        print(line)
    for label, key, form in (("score", "score", lambda v: f"{v * 100:.1f}%"),
                             ("achieved", "achieved", lambda v: f"{v:.0f}"),
                             ("drift", "driftM", lambda v: f"{v:.2f} m"),
                             ("energy", "energyWh", lambda v: f"{v:.2f} Wh"),
                             ("in the water", "seconds", lambda v: f"{v:.0f} s"),
                             ("struck", "struck", lambda v: f"{v:.0f}"),
                             ("grounded", "grounded", lambda v: f"{v:.0f}"),
                             ("thoughts", "thoughts", lambda v: f"{v:.0f}"),
                             ("slowest thought", "slowestThoughtS", lambda v: f"{v:.2f} s")):
        line = f"{DIM}{label:<14}{OFF}"
        for controller in controllers:
            said = summarise([r for r in rows if r["controller"] == controller])
            line += f"{form(said[key]):>17}"
        print(line)
    return 0


def command_compare(args) -> int:
    rows = rows_for(args)
    # A dive the platform could not start is an absence on both sides. Shown
    # separately below rather than compared: a comparison against a dive
    # that never happened is not a comparison.
    ours = {r["task"]: r for r in rows
            if r["controller"] == args.left and r.get("fault") != "the platform's"}
    theirs = {r["task"]: r for r in rows
              if r["controller"] == args.right and r.get("fault") != "the platform's"}
    missing = sorted({r["task"] for r in rows
                      if r["controller"] in (args.left, args.right)
                      and r.get("fault") == "the platform's"})
    both = [t for t in SUITES[args.suite] if t in ours and t in theirs]
    if not both:
        print(f"{args.left} and {args.right} have no task in common on this bench")
        if missing:
            print(f"{AMBER}  {', '.join(missing)} never flew — the platform "
                  f"could not start them{OFF}")
        return 1
    print(f"{BOLD}{args.left}{OFF} against {BOLD}{args.right}{OFF}"
          f"{DIM} · {len(both)} tasks, the same water and the same seeds{OFF}\n")
    # Trimmed to the column, like the table in `show`. Two controllers
    # with twelve-character names ran together into one word:
    # "station-holdlearned-hold".
    def column(name: str) -> str:
        return (name if len(name) <= 10 else name[:9] + "…").rjust(10)

    print(f"{'':<14}{column(args.left)}{column(args.right)}{'':>4}{'energy':>16}"
          f"{'hit':>10}{'thinking':>12}")
    for task in both:
        mine, yours = ours[task], theirs[task]
        gap = (yours["score"] - mine["score"]) * 100
        ink = GREEN if gap > 1 else RED if gap < -1 else DIM
        energy = yours["energyWh"] - mine["energyWh"]
        # Things struck, which is the column this bench exists for. A
        # controller that scores five points better by driving through a
        # nursery frame has not scored five points better.
        hit = f"{_hit(mine)}/{_hit(yours)}"
        print(f"{task:<14}{mine['score'] * 100:9.0f}%{yours['score'] * 100:9.0f}%"
              f"{ink}{gap:+8.0f}{OFF}"
              f"{energy:+11.2f} Wh{hit:>10}{yours['slowestThoughtS']:9.2f} s")
    mine, yours = summarise(list(ours.values())), summarise(list(theirs.values()))
    gap = (yours["score"] - mine["score"]) * 100
    print()
    if missing:
        print(f"{AMBER}{'never flew':<14}{', '.join(missing)} — the platform could "
              f"not start them, so they are in neither column{OFF}")
    print(f"{BOLD}{'overall':<14}{mine['score'] * 100:9.1f}%{yours['score'] * 100:9.1f}%"
          f"{gap:+8.1f}{OFF}"
          f"{yours['energyWh'] - mine['energyWh']:+11.2f} Wh"
          # Right-aligned in the same width as the column above it. It was
          # the pair left-aligned after the Wh, so the overall row read
          # "-5.36 Wh0/0" with the two columns run together.
          f"{f'{_hit(mine)}/{_hit(yours)}':>10}"
          f"{yours['slowestThoughtS']:11.2f} s")
    print()
    print(_attribution(mine, yours, args.left, args.right))
    return 0


def _hit(row: dict) -> int:
    """Everything a dive ran into: what somebody placed, and the place."""
    return int(row.get("struck") or 0) + int(row.get("grounded") or 0)


def _attribution(mine: dict, yours: dict, left: str, right: str) -> str:
    """What the difference is, said in a sentence rather than left to the eye."""
    gap = (yours["score"] - mine["score"]) * 100
    if abs(gap) < 1.0:
        said = f"{right} and {left} score the same on this bench"
    else:
        better, worse = (right, left) if gap > 0 else (left, right)
        said = f"{better} scores {abs(gap):.1f} points better than {worse}"
    energy = yours["energyWh"] - mine["energyWh"]
    if abs(energy) > 0.05:
        said += (f". {right} spends {abs(energy):.2f} Wh "
                 f"{'more' if energy > 0 else 'less'} than {left} doing it")
    if yours["thoughts"] or mine["thoughts"]:
        said += (f". {right} thought {yours['thoughts']} times, the slowest taking "
                 f"{yours['slowestThoughtS']:.2f} s")
    # Said before the drift and after the score, because it is the one thing
    # on this bench that can turn a better score into a worse controller.
    if _hit(mine) or _hit(yours):
        said += (f". {left} hit {_hit(mine)} thing{'' if _hit(mine) == 1 else 's'} "
                 f"and {right} hit {_hit(yours)}")
        if _hit(yours) > _hit(mine) and (yours["score"] - mine["score"]) > 0:
            said += (f", so whatever {right} gained in score it gained partly "
                     f"by going through things")
    drift = yours["driftM"] - mine["driftM"]
    if abs(drift) > 0.2:
        said += (f". Its navigation ended {abs(drift):.2f} m "
                 f"{'further out' if drift > 0 else 'closer in'}, which is the same water "
                 f"and the same seeds, so it is the flying")
    return said + "."


def command_rows(args) -> int:
    print(json.dumps(rows_for(args), indent=2))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--suite", default="standard", choices=sorted(SUITES))
    parser.add_argument("--here", action="store_true",
                        help="what was flown here with no simulator, rather than on the platform")
    doing = parser.add_subparsers(dest="doing", required=True)

    running = doing.add_parser("run", help="fly the suite with one controller")
    running.add_argument("--controller", required=True)
    running.add_argument("--tasks", default="",
                         help="a comma-separated subset, for walking the path rather "
                              "than for a comparison; the suite is what a comparison is")
    running.add_argument("--place", default="looe-key")
    running.add_argument("--vehicle", default="bluerov2")
    running.add_argument("--at-once", type=int, default=2)
    running.add_argument("--again", action="store_true", help="re-fly what is already there")
    running.set_defaults(run=command_run)

    drying = doing.add_parser("dry", help="fly the suite here, with no simulator")
    drying.add_argument("--controller", required=True)
    drying.add_argument("--vehicle", default="bluerov2")
    drying.add_argument("--through", action="store_true",
                        help="put nursery frames on the line the task walks, so a "
                             "controller that looks has something to look at")
    drying.add_argument("--over", default="", metavar="PLACE",
                        help="a packaged place to fly over, so the bottom is a "
                             "real bottom and a controller that looks has "
                             "something to see")
    drying.add_argument("--tune", action="append", default=[], metavar="NAME=VALUE",
                        help="move one of the controller's own parameters")
    drying.add_argument("--as", dest="called", default="",
                        help="record it under this name, so two settings of one "
                             "controller can be compared as two controllers")
    drying.set_defaults(run=command_dry, here=True)

    showing = doing.add_parser("show", help="the table")
    showing.set_defaults(run=command_show)

    comparing = doing.add_parser("compare", help="two controllers, side by side")
    comparing.add_argument("left")
    comparing.add_argument("right")
    comparing.set_defaults(run=command_compare)

    rows = doing.add_parser("rows", help="every row, as JSON")
    rows.set_defaults(run=command_rows)

    args = parser.parse_args()
    return args.run(args)


if __name__ == "__main__":
    raise SystemExit(main())
