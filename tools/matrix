# ── talking to the platform ──────────────────────────────────────────────────

def on_box(command: str) -> str:
    return over_the_wire(command)


class Platform:
    def __init__(self) -> None:
        env = on_box(f"grep -E '^CORAL_CITY_(ADMIN_EMAIL|ADMIN_SECRET|BIND_ADDRESS)=' "
                     f"~/{REMOTE}/deployments/box/.env")
        said = dict(line.split("=", 1) for line in env.splitlines() if "=" in line)
        self.where = f"http://{said.get('CORAL_CITY_BIND_ADDRESS', '127.0.0.1')}:18080"
        # Kept, because a session does not last as long as a matrix does.
        self.who = (said["CORAL_CITY_ADMIN_EMAIL"], said["CORAL_CITY_ADMIN_SECRET"])
        self.token = ""
        self.sign_in()
        me = self.call("GET", "/api/v1/me")
        self.org = me["organisations"][0]["id"]

    def sign_in(self) -> None:
        email, secret = self.who
        self.token = self.call("POST", "/api/v1/sessions",
                               {"email": email, "secret": secret}, signed=False)["token"]

    def call(self, method: str, path: str, body=None, signed: bool = True):
        """One request, made from the box because that is where the platform
        listens. The body goes over stdin rather than the command line, so
        nothing has to survive two levels of shell quoting."""
        command = ["curl", "-sS", "-X", method, f"{self.where}{path}",
                   "-H", "content-type: application/json"]
        if signed:
            command += ["-H", f"authorization: Bearer {self.token}"]
        if body is not None:
            command += ["-d", "@-"]
        out = over_the_wire(" ".join(
            part if part.startswith("-") or part.startswith("http") or part in (
                "curl", "-sS", method) else f"'{part}'" for part in command),
            feed=None if body is None else json.dumps(body))
        if not out:
            return {}
        answer = json.loads(out)
        if isinstance(answer, dict) and "error" in answer:
            said = str(answer["error"].get("message", ""))
            # A session runs out long before a matrix does. Signing in again is
            # not an error to stop on; it is what the token being temporary
            # means.
            if signed and ("sign in" in said or answer["error"].get("code") == "unauthenticated"):
                self.sign_in()
                return self.call(method, path, body, signed=True)
            raise RuntimeError(f"{path}: {said}")
        return answer


def newest_version(platform: Platform, kind: str, slug: str) -> str:
    listed = platform.call("GET", f"/api/v1/{kind}")[kind]
    asset = next(one for one in listed if one["slug"] == slug)
    versions = platform.call("GET", f"/api/v1/{kind}/{asset['id']}/versions")["versions"]
    published = [v for v in versions if v.get("publishedAt")]
    return max(published or versions, key=lambda v: v["ordinal"])["id"]


# ── the matrix ───────────────────────────────────────────────────────────────

def name_of(task: str, water: str, technology: str) -> str:
    return f"{task} · {WATERS[water][0]} · {POSITIONING[technology][0]}"


def flown(platform: Platform) -> dict:
    """What is already in the record, by the name the matrix gives it."""
    already = {}
    for dive in platform.call("GET", f"/api/v1/organisations/{platform.org}/dives")["dives"]:
        if " · " not in dive["name"]:
            continue
        runs = platform.call("GET", f"/api/v1/dives/{dive['id']}/runs")["runs"]
        for run in runs:
            if run["state"] in ("succeeded", "failed"):
                already[dive["name"]] = {"dive": dive["id"], "run": run["id"],
                                         "state": run["state"], "outcome": run.get("outcome") or {}}
                break
    return already


def fly(platform: Platform, city: str, vehicle: str, queue: str, runtime: str,
        task: str, water: str, technology: str) -> dict:
    water_name, water_parameters = WATERS[water]
    technology_name, technology_parameters = POSITIONING[technology]
    objective = dict(TASKS[task])
    parameters = {**water_parameters, **technology_parameters}
    # An array and a ship are somewhere: put them where the dive begins, which
    # is where a vessel would hold station and where an array would be laid.
    conditions = platform.call("POST", f"/api/v1/organisations/{platform.org}/conditions", {
        "kind": "constructed", "name": f"{water_name} · {technology_name}",
        "parameters": parameters})
    dive = platform.call("POST", f"/api/v1/organisations/{platform.org}/dives", {
        "name": name_of(task, water, technology),
        "cityVersionId": city, "vehicleVersionId": vehicle,
        "conditionsId": conditions["id"], "objective": objective})
    run = platform.call("POST", f"/api/v1/dives/{dive['id']}/runs", {
        "queueId": queue, "mode": "batch", "runtimeVersion": runtime})
    return {"dive": dive["id"], "run": run["id"], "name": dive["name"]}


def still_going(platform: Platform, asked: list) -> list:
    """Which of these have not finished yet."""
    left = []
    for one in asked:
        runs = platform.call("GET", f"/api/v1/dives/{one['dive']}/runs")["runs"]
        state = next((r["state"] for r in runs if r["id"] == one["run"]), "gone")
        if state in ("queued", "preparing", "running"):
            left.append(one)
    return left


def wait_for(platform: Platform, asked: list, patience: int = 3600) -> None:
    began = time.monotonic()
    while asked and time.monotonic() - began < patience:
        asked = still_going(platform, asked)
        if asked:
            time.sleep(15)


def run_matrix(args) -> None:
    platform = Platform()
    city = newest_version(platform, "cities", args.place)
    vehicle = newest_version(platform, "vehicles", args.vehicle)
    queues = platform.call("GET", "/api/v1/queues")["queues"]
    queue = queues[0]
    runtime = queue["runtimes"][0]

    tasks = args.tasks.split(",") if args.tasks else list(TASKS)
    waters = args.waters.split(",") if args.waters else list(WATERS)
    technologies = args.technologies.split(",") if args.technologies else GENERAL

    already = {} if args.again else flown(platform)
    wanted = [(t, w, p) for t in tasks for w in waters for p in technologies
              if args.again or name_of(t, w, p) not in already]
    print(f"{len(tasks)} tasks × {len(waters)} waters × {len(technologies)} technologies "
          f"= {len(tasks) * len(waters) * len(technologies)}; {len(wanted)} still to fly",
          flush=True)

    # Kept full rather than drained: with a batch at a time both machines sit
    # idle while the last of the batch finishes. One asked for as soon as one
    # finishes keeps every card working, and one spare in the queue means a
    # machine never waits for this script to notice.
    # As many as the institution is allowed to have in the water at once. The
    # platform refuses the rest, and rightly: a quota is a quota whoever is
    # asking. What this must not do is treat that refusal as a failure.
    at_once = int(args.at_once)
    asked: list = []
    began = time.monotonic()
    for i, (task, water, technology) in enumerate(wanted, start=1):
        while len(asked) >= at_once:
            time.sleep(10)
            asked = still_going(platform, asked)
        while True:
            try:
                asked.append(fly(platform, city, vehicle, queue["id"], runtime,
                                 task, water, technology))
                break
            except RuntimeError as refused:
                if "in flight" not in str(refused):
                    raise
                # The quota is full. Wait for one to come out of the water.
                time.sleep(15)
                asked = still_going(platform, asked)
        each = (time.monotonic() - began) / max(1, i - 1) if i > 1 else 0
        left = (len(wanted) - i) * each / 60.0
        print(f"  [{i}/{len(wanted)}] {name_of(task, water, technology)}"
              f"{'' if i < 3 else f'   about {left:.0f} min left'}", flush=True)
    wait_for(platform, asked)
    print("all flown", flush=True)
    show_matrix(args)


def grid(rows, args) -> None:
    """The matrix as a grid, which is the only way to read it.

    Two of them, because there are three dimensions and a page has two: every
    task against every technology in one body of water, and every task against
    every water on one technology. Averaging over a dimension instead would
    hide the thing that matters — the water dominates everything, and a
    technology compared across all waters looks like every other technology.
    """
    got = {}
    for row in rows:
        parts = [part.strip() for part in row["name"].split("·")]
        if len(parts) == 3:
            got[tuple(parts)] = row

    def table(title, columns, cell, note) -> None:
        print(f"\n{title}")
        print(f"{'':<14}" + "".join(f"{c[:13]:>14}" for c in columns))
        for task in TASKS:
            line = f"{task:<14}"
            for column in columns:
                row = cell(task, column)
                line += f"{'—' if row is None or row['score'] is None else f'{row[chr(115)+chr(99)+chr(111)+chr(114)+chr(101)]*100:.0f}%':>14}"
            print(line)
        print(f"  {note}")

    water = WATERS[args.water][0] if args.water in WATERS else WATERS["still"][0]
    technology = (POSITIONING[args.technology][0] if args.technology in POSITIONING
                  else POSITIONING["dead-reckoning"][0])
    table(f"every technology, in {water.lower()}",
          [POSITIONING[k][0] for k in GENERAL],
          lambda task, column: got.get((task, water, column)),
          "the water is held still so the technology is what differs")
    table(f"every water, on {technology.lower()}",
          [WATERS[k][0] for k in WATERS],
          lambda task, column: got.get((task, column, technology)),
          "the technology is held so the water is what differs")


def show_matrix(args) -> None:
    platform = Platform()
    already = flown(platform)
    rows = []
    for name, one in sorted(already.items()):
        task = one["outcome"].get("task") or {}
        navigation = one["outcome"].get("navigation") or {}
        rows.append({
            "name": name,
            "state": one["state"],
            "ended": one["outcome"].get("ended", ""),
            "score": task.get("score"),
            "seconds": task.get("seconds"),
            "energyWh": task.get("energyWh"),
            "driftM": navigation.get("driftM"),
            "fixes": navigation.get("fixes"),
            "dive": one["dive"], "run": one["run"],
        })
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    if args.grid:
        grid(rows, args)
        return
    print(f"{'task · water · technology':<62}{'score':>7}{'drift':>8}{'Wh':>7}  ended")
    for row in rows:
        score = "—" if row["score"] is None else f"{row['score'] * 100:.0f}%"
        drift = "—" if row["driftM"] is None else f"{row['driftM']:.2f}"
        energy = "—" if row["energyWh"] is None else f"{row['energyWh']:.2f}"
        print(f"{row['name']:<62}{score:>7}{drift:>8}{energy:>7}  {row['ended']}")
    print(f"\n{len(rows)} runs in the record")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="what", required=True)
    for what in ("run", "show"):
        one = sub.add_parser(what)
        one.add_argument("--place", default="looe-key")
        one.add_argument("--vehicle", default="bluerov2")
        one.add_argument("--tasks", default="")
        one.add_argument("--waters", default="")
        one.add_argument("--technologies", default="")
        one.add_argument("--again", action="store_true")
        one.add_argument("--at-once", dest="at_once", default=4,
                         help="how many dives to have in the water at a time")
        one.add_argument("--json", action="store_true")
        one.add_argument("--grid", action="store_true", help="as a table rather than a list")
        one.add_argument("--water", default="still", help="which water the technology grid holds")
        one.add_argument("--technology", default="dead-reckoning",
                         help="which technology the water grid holds")
    args = parser.parse_args()
    try:
        (run_matrix if args.what == "run" else show_matrix)(args)
    except (urllib.error.URLError, RuntimeError, subprocess.CalledProcessError) as trouble:
        print(f"stopped: {trouble}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
