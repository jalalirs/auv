#!/usr/bin/env python3
"""Fly every task, in every water, on every positioning technology.

One dive is an anecdote. What this platform is for is the crossing: the same
task on dead reckoning and inside an array, the same controller in still water
and in a knot of current, and the difference between them as a number rather
than an impression.

So this defines a dive for every combination and runs it as a batch through
the platform itself — the same path the application uses, so every one of them
lands in the record with its recording, and every one can be replayed in the
app afterwards. Nothing here reaches into the simulator.

    ./tools/matrix run            fly everything that has not been flown
    ./tools/matrix run --tasks reach,dock --waters still
    ./tools/matrix show           the matrix as it stands

It is resumable: a combination that already has a run in the record is left
alone unless --again is given, so a machine that fell over halfway is picked
up by running it again.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

BOX = os.environ.get("AUV_GPU_HOST", "jalalirs@100.76.65.1")
REMOTE = os.environ.get("AUV_REMOTE_DIR", "code/auv")

# One connection, held open, rather than one per request. Every call here is a
# curl on the box, and opening an SSH session for each of them cost more than
# the request did — the machines sat idle while this script shook hands.
SSH = ["ssh", "-o", "ControlMaster=auto", "-o", "ControlPersist=600",
       "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4",
       "-o", "ControlPath=/tmp/coral-matrix-%r@%h:%p", BOX]


def over_the_wire(command: str, feed: str | None = None, tries: int = 9) -> str:
    """Run something on the box, and do not give up on a dropped connection.

    A matrix takes hours and a link that never blinks in that time does not
    exist. Losing one request is not losing the run.

    How long to wait before giving up is the whole question. The box is shared
    and it is not always ours: a heavy build, somebody else's job, four
    simulators at once, and it stops answering ssh entirely for a minute or
    two — this run has already been killed once by exactly that, eighteen
    seconds of patience against a two-minute outage. So the waiting grows to
    minutes and the total is the better part of ten, which is longer than the
    box has ever been away and still shorter than the hours a matrix takes.

    The shared connection is dropped on the way, because a master socket whose
    connection died is a socket every later attempt fails on instantly; the
    next attempt then opens a fresh one.
    """
    trouble = None
    for attempt in range(tries):
        try:
            done = subprocess.run([*SSH, f"export LC_ALL=C; {command}"], input=feed,
                                  capture_output=True, text=True, check=True)
            return done.stdout.strip()
        except subprocess.CalledProcessError as failed:
            trouble = failed
            subprocess.run([*SSH[:-1], "-O", "exit", SSH[-1]],
                           capture_output=True, text=True)
            time.sleep(min(90, 4 * 2 ** attempt))
    raise RuntimeError(f"the box stopped answering: {trouble}")

