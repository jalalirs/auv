#!/usr/bin/env bash
# One way in.
#
# Everything anybody does with this platform, under one name. Not because a
# wrapper is elegant, but because the alternative is what it replaced: pages of
# ad-hoc curl and ssh, retyped slightly differently every time, each carrying
# its own copy of an address or a port that had since moved. Half the failures
# of an afternoon were a command that was right yesterday.
#
#   uav deploy              build and bring the platform up on the box
#   uav status              what is running, and where to reach it
#   uav logs [service]      follow a service
#   uav agent [lines]       what the agent has been doing
#
#   uav app [open|close]    build and open Coral City on this machine
#   uav dive [mode]         ask for a dive; interactive unless told otherwise
#   uav runs                recent runs, and what became of them
#   uav watch [run]         what a dive reported, as it reported it
#   uav stop                end the dive that is running
#   uav clear               withdraw everything running or waiting
#   uav frames [seconds]    connect to the running dive and say what arrives
#   uav fly <keys> [secs]   hold keys on the running dive and say what happened
#   uav look [seconds]      dive, wait, and bring back the frame it took
#   uav map [place]         fly over a place and bring back a video of it
#   uav sim <logs|said|opened|grep|shell>   the simulator, and what it said
#
#   uav check               the end-to-end checks, against the box
#   uav clean               remove what the checks leave behind
#   uav api <method> <path> [body]   one request, signed in
#
# Nothing here holds a secret. Credentials come from the box's own .env, which
# is where they were generated and where they stay.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${HERE}/.." && pwd)"
[ -f "${ROOT}/.env" ] && { set -a; . "${ROOT}/.env"; set +a; }

GPU_HOST="${AUV_GPU_HOST:-jalalirs@100.76.65.1}"
REMOTE_DIR="${AUV_REMOTE_DIR:-code/auv}"

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
dim()  { printf '\033[2m%s\033[0m\n' "$1"; }
die()  { printf '\033[31m%s\033[0m\n' "$1" >&2; exit 1; }

on_box() { LC_ALL=C ssh "${GPU_HOST}" "export LC_ALL=C LANG=C; $*"; }

# ── Where the platform is, and who we are to it ──────────────────────────────
#
# Asked of the box every time rather than kept here. The address it listens on
# and the secret it was given are facts about that machine, and a copy in this
# script is a second place for them to be wrong.

remote_env() { on_box "sed -n 's/^$1=//p' ~/${REMOTE_DIR}/deployments/box/.env"; }

platform() {
    local bind port
    bind="$(remote_env CORAL_CITY_BIND_ADDRESS)"
    port="$(remote_env CORAL_CITY_API_PORT)"
    printf 'http://%s:%s' "${bind:-127.0.0.1}" "${port:-18080}"
}

token() {
    local email secret answer
    email="$(remote_env CORAL_CITY_ADMIN_EMAIL)"
    secret="$(remote_env CORAL_CITY_ADMIN_SECRET)"
    answer="$(curl --silent --max-time 15 -X POST "$(platform)/api/v1/sessions" \
        -H 'content-type: application/json' \
        -d "{\"email\":\"${email}\",\"secret\":\"${secret}\"}")"
    printf '%s' "${answer}" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin)["token"])
except Exception:
    sys.exit("could not sign in to the platform")'
}

# api <method> <path> [body] — one request, signed in, answer on stdout.
api() {
    local method="$1" path="$2" body="${3:-}"
    local args=(--silent --max-time 60 -X "${method}"
                -H "Authorization: Bearer ${TOKEN:-$(token)}")
    [ -n "${body}" ] && args+=(-H 'content-type: application/json' -d "${body}")
    curl "${args[@]}" "$(platform)${path}"
}

# json <expression> — read the answer on stdin with python, so that nothing here
# has to parse JSON with sed.
json() { python3 -c "
import json, sys
try:
    document = json.load(sys.stdin)
except Exception:
    sys.exit('the platform did not answer with JSON')
print($1)"; }

# ── What it does ─────────────────────────────────────────────────────────────

# Send the code, then build it there.
#
# The sync was a separate step, and forgetting it deployed whatever the box
# happened to have — which looked exactly like deploying: it built, it started,
# it answered. A fix made here and "deployed" was simply not on that machine,
# and the bug it fixed went on happening for another hour.
command_deploy() {
    "${HERE}/gpu" sync "${1:-deploy}" || die "could not send the code to the box"
    "${HERE}/box" up
}

# What the agent has been doing.
command_agent() {
    on_box "docker logs --tail ${1:-25} coral-city-agent-1 2>&1" | python3 -c '
import json, sys
for line in sys.stdin:
    try:
        said = json.loads(line)
    except Exception:
        continue
    detail = {k: v for k, v in said.items()
              if k in ("runId", "image", "host", "signalPort", "failure",
                       "error", "state", "device", "mode")}
    print(f"  {said.get("time", "")[11:19]}  {said.get("msg", ""):<34} "
          f"{detail if detail else ""}")'
}
command_status() { "${HERE}/box" status; }
command_logs()   { "${HERE}/box" logs "${1:-}"; }
command_check()  {
    on_box "cd ~/${REMOTE_DIR} \
        && export CORAL_CITY_API=$(platform) \
        && export CORAL_CITY_ADMIN_EMAIL=\$(sed -n 's/^CORAL_CITY_ADMIN_EMAIL=//p' deployments/box/.env) \
        && export CORAL_CITY_ADMIN_SECRET=\$(sed -n 's/^CORAL_CITY_ADMIN_SECRET=//p' deployments/box/.env) \
        && ./tools/e2e"
}
command_clean() { "${HERE}/clear-check-data" "${1:---confirm}"; }

# The application, on this machine.
#
# Built and opened, and then this returns. It used to hold the terminal until
# the window closed, which meant nobody could open the application and then look
# at anything — so it got done by hand instead, differently every time, which is
# the whole thing this tool exists to stop.
command_app() {
    command -v mise >/dev/null || die "mise is not on the path"
    case "${1:-open}" in
        close) pkill -f "electron \.$" 2>/dev/null || true; dim "closed"; return ;;
        open) ;;
        *) die "uav app [open|close]" ;;
    esac

    pkill -f "electron \.$" 2>/dev/null || true
    ( cd "${ROOT}/apps/client" && mise exec -- pnpm build >/dev/null ) \
        || die "the application would not build"
    ( cd "${ROOT}/apps/client" && mise exec -- npx electron . \
        > "${ROOT}/.uav-app.log" 2>&1 & )
    bold "Coral City"
    dim  "$(platform)"
}

# Ask for a dive, the way the application does.
command_dive() {
    local mode="${1:-interactive}"
    TOKEN="$(token)"

    local org dive queue runtime run
    org="$(api GET /api/v1/me | json 'document["organisations"][0]["id"]')"
    dive="$(api GET "/api/v1/organisations/${org}/dives" \
        | json 'document["dives"][0]["id"] if document["dives"] else ""')"
    [ -n "${dive}" ] || die "there is no dive defined yet — make one in the application"

    queue="$(api GET /api/v1/queues | json 'document["queues"][0]["id"]')"
    runtime="$(api GET /api/v1/queues | json 'document["queues"][0]["runtimes"][0]')"
    [ -n "${runtime}" ] || die "no host on that queue has said what it can run"

    run="$(api POST "/api/v1/dives/${dive}/runs" \
        "{\"queueId\":\"${queue}\",\"mode\":\"${mode}\",\"runtimeVersion\":\"${runtime}\"}" \
        | json 'document.get("id") or document.get("error", {}).get("message", "")')"
    case "${run}" in
        run_*) ;;
        *) die "${run:-the platform refused the dive}" ;;
    esac

    printf '%s %s\n' "${dive}" "${run}" > "${ROOT}/.uav-last-dive"
    bold "${run}"
    dim  "${mode} · $(platform)"
    command_watch
}

# What a dive reported, as it reported it.
command_watch() {
    local dive run
    if [ -n "${1:-}" ]; then
        read -r dive run <<< "$(cat "${ROOT}/.uav-last-dive")"
        run="$1"
    else
        [ -f "${ROOT}/.uav-last-dive" ] || die "no dive has been asked for yet"
        read -r dive run < "${ROOT}/.uav-last-dive"
    fi
    TOKEN="${TOKEN:-$(token)}"

    local seen=0
    while :; do
        api GET "/api/v1/dives/${dive}/runs/${run}/events" | python3 -c "
import json, sys
events = json.load(sys.stdin)['events']
for event in events[${seen}:]:
    when = event.get('simulatedSeconds')
    at = f'{when:6.1f}s' if when is not None else '       '
    detail = {k: v for k, v in (event.get('detail') or {}).items()
              if k in ('depthM', 'speedMs', 'commanded', 'byHand', 'host',
                       'signalPort', 'why', 'commandsReceived', 'state',
                       'watching', 'port', 'metresAcross')}
    print(f'  {at} {event[\"kind\"]:<22} {detail if detail else \"\"}')
print('SEEN', len(events), file=sys.stderr)
" 2> >(read -r _ n; seen="$n") || true
        # Ends when the run does, which the platform says plainly.
        local state
        state="$(api GET "/api/v1/dives/${dive}/runs" \
            | json "next((r['state'] for r in document['runs'] if r['id'] == '${run}'), '')")"
        case "${state}" in
            succeeded|failed|cancelled|expired) bold "${state}"; return ;;
        esac
        sleep 3
    done
}

# Recent runs, whoever asked for them.
command_runs() {
    TOKEN="${TOKEN:-$(token)}"
    local org dives
    org="$(api GET /api/v1/me | json 'document["organisations"][0]["id"]')"
    dives="$(api GET "/api/v1/organisations/${org}/dives" \
        | json '" ".join(d["id"] for d in document["dives"][:6])')"
    for dive in ${dives}; do
        api GET "/api/v1/dives/${dive}/runs" | python3 -c '
import json, sys
for run in json.load(sys.stdin)["runs"][:4]:
    why = run.get("failureReason") or ""
    print("  %s  %-10s %-12s %s" % (run["id"], run["state"], run["mode"], why[:70]))'
    done
}

# Watch the running dive for a moment and say what actually arrives.
#
# The application is the real client, but "is anything coming down this socket"
# is a question worth being able to ask without a window open — most of the ways
# this has been broken looked identical from outside, and every one of them was
# a different answer to exactly this.
command_frames() {
    local seconds="${1:-12}"
    TOKEN="${TOKEN:-$(token)}"
    local host port
    host="$(remote_env CORAL_CITY_STREAM_HOST)"
    port="$(remote_env CORAL_CITY_STREAM_SIGNAL_PORT)"
    host="${host:-127.0.0.1}"; port="${port:-18100}"
    bold "watching ws://${host}:${port}/watch for ${seconds}s"
    mise exec -- node --input-type=module -e "
const socket = new WebSocket('ws://${host}:${port}/watch');
let frames = 0, readings = 0, bytes = 0, last = null;
socket.binaryType = 'arraybuffer';
socket.onopen = () => console.log('  connected');
socket.onerror = (e) => console.log('  could not connect');
socket.onmessage = (m) => {
  if (typeof m.data === 'string') { readings += 1; last = JSON.parse(m.data); }
  else { frames += 1; bytes += m.data.byteLength; }
};
setTimeout(() => {
  console.log('  frames   ', frames, frames ? '(' + Math.round(bytes / frames / 1024) + ' KB each)' : '');
  console.log('  readings ', readings);
  if (last) console.log('  depth    ', last.depthM, ' topics', (last.topics ?? []).length);
  process.exit(0);
}, ${seconds} * 1000);
"
}

# Fly the running dive from here, and say what the vehicle did.
#
#   uav fly SPACE 6      hold the rise key for six seconds
#
# Because "can a person fly this" is the milestone, and clicking at a window is
# not a way to find out whether the answer stayed yes.
command_fly() {
    local keys="${1:-SPACE}" seconds="${2:-6}"
    local host port
    host="$(remote_env CORAL_CITY_STREAM_HOST)"; host="${host:-127.0.0.1}"
    port="$(remote_env CORAL_CITY_STREAM_SIGNAL_PORT)"; port="${port:-18100}"
    bold "holding ${keys} for ${seconds}s"
    mise exec -- node --input-type=module -e "
const held = '${keys}'.split(',').filter(Boolean);
const socket = new WebSocket('ws://${host}:${port}/watch');
socket.binaryType = 'arraybuffer';
let first = null, last = null;
socket.onmessage = (m) => {
  if (typeof m.data !== 'string') return;
  const said = JSON.parse(m.data);
  if (first === null) first = said;
  last = said;
};
socket.onopen = () => {
  setInterval(() => socket.send(JSON.stringify({ held })), 40);
};
setTimeout(() => {
  if (last === null) { console.log('  nothing arrived'); process.exit(1); }
  console.log('  depth    ', first.depthM, '→', last.depthM);
  console.log('  speed    ', last.speedMs);
  console.log('  thrust   ', JSON.stringify(last.thrust));
  console.log('  by hand  ', last.byHand);
  process.exit(0);
}, ${seconds} * 1000);
"
}

# Dive, wait, and bring back a picture.
#
#   uav look            start an interactive dive and fetch the frame it took
#
# This exists because looking at a change to how the water is rendered was
# eleven commands every time — clear what is running, find the newest dive, ask
# for a run on it, sleep long enough for Isaac to open the scene, find the
# container, copy the frame out, and measure it. Done by hand each time it was
# also done slightly differently each time.
command_look() {
    local seconds="${1:-195}"
    TOKEN="$(token)"
    command_clear >/dev/null 2>&1 || true

    local org dive queue runtime run
    org="$(api GET /api/v1/me | json 'document["organisations"][0]["id"]')"
    dive="$(api GET "/api/v1/organisations/${org}/dives" \
        | json 'document["dives"][0]["id"] if document["dives"] else ""')"
    [ -n "${dive}" ] || die "no dive is defined"
    queue="$(api GET /api/v1/queues | json 'document["queues"][0]["id"]')"
    runtime="$(api GET /api/v1/queues | json 'document["queues"][0]["runtimes"][0]')"
    run="$(api POST "/api/v1/dives/${dive}/runs" \
        "{\"queueId\":\"${queue}\",\"mode\":\"interactive\",\"runtimeVersion\":\"${runtime}\"}" \
        | json 'document.get("id", "")')"
    case "${run}" in run_*) ;; *) die "the platform refused the dive" ;; esac
    printf '%s %s\n' "${dive}" "${run}" > "${ROOT}/.uav-last-dive"

    bold "${run}"
    dim  "opening the scene; ${seconds}s"
    sleep "${seconds}"

    local container
    container="$(on_box "docker ps --format '{{.Names}}' | grep coral-sim | head -1")"
    [ -n "${container}" ] || die "the dive is no longer running"

    on_box "docker logs ${container} 2>&1 | grep -E '\"event\": \"(water_made|spawned|seabed_known)\"'" \
        | sed 's/^/  /' || true

    on_box "docker exec ${container} cat /dive/frame-30s.png" > "${ROOT}/.uav-frame.png" 2>/dev/null
    [ -s "${ROOT}/.uav-frame.png" ] || die "the dive took no photograph"

    python3 -c "
from PIL import Image
import numpy as np
a = np.asarray(Image.open('${ROOT}/.uav-frame.png').convert('RGB'))
r, g, b = [int(c) for c in a.reshape(-1, 3).mean(0)]
print('  brightness %d   red %d  green %d  blue %d' % (int(a.mean()), r, g, b))
" 2>/dev/null || true
    bold "${ROOT}/.uav-frame.png"
}

# Fly over a place and bring back a video of it.
#
#   uav map                 fly over the newest place
#   uav map red-sea         fly over that one
#
# Because every judgement about a map so far has been made from one frame, three
# metres off the bottom, pointing one way — which is the worst possible view for
# asking whether the coral is in the right places, and is why that question kept
# being answered wrong.
command_map() {
    local place="${1:-}"
    local where
    where="$(on_box "ls -dt ~/coral-city/places/*/ 2>/dev/null | head -20")"
    if [ -n "${place}" ]; then
        where="$(on_box "echo ~/coral-city/places/${place}")"
    else
        where="$(printf '%s\n' "${where}" | head -1)"
    fi
    where="${where%/}"
    [ -n "${where}" ] || die "no place to fly over"

    bold "flying over ${where##*/}"

    on_box "docker rm -f coral-tour >/dev/null 2>&1
        rm -rf ${where}/tour && mkdir -p ${where}/tour && chmod 777 ${where}/tour
        printf '%s' '{\"cityPath\":\"/dive/city\",\"vehiclePath\":\"/dive/vehicle\",\"mode\":\"interactive\",\"seed\":1,\"durationSeconds\":600}' > ${where}/dive.json
        docker run -d --name coral-tour --gpus '\"device=0\"' \
            -e ACCEPT_EULA=Y -e PRIVACY_CONSENT=Y \
            -e CORAL_CITY_BRIEF=/dive/dive.json \
            -e CORAL_CITY_TOUR=1 -e CORAL_CITY_TOUR_INTO=/dive/tour \
            -e ROS_LOG_DIR=/tmp/ros \
            -v ${where}:/dive:rw \
            -v ${where}:/dive/city:ro \
            -v \$(ls -d ~/coral-city/work/packages/*/ | head -1):/dive/vehicle:ro \
            --entrypoint /isaac-sim/kit/kit \
            127.0.0.1:18081/sim-runtime:r1 /isaac-sim/apps/coral_city.kit --no-window >/dev/null"

    dim "opening the place and flying the path"
    local frames=0
    for i in $(seq 1 90); do
        sleep 10
        frames="$(on_box "ls ${where}/tour/*.png 2>/dev/null | wc -l")"
        on_box "docker logs coral-tour 2>&1 | grep -q '\"event\": \"tour_done\"'" && break
        on_box "docker logs coral-tour 2>&1 | grep -qE '\"event\": \"(tour_failed|failed)\"'" && break
        printf '\r  %s frames' "${frames}"
    done
    printf '\n'
    on_box "docker logs coral-tour 2>&1 | grep -E '\"event\": \"(tour_|place_open|spawned|water_made|failed)' | tail -5" | sed 's/^/  /'

    frames="$(on_box "ls ${where}/tour/*.png 2>/dev/null | wc -l")"
    [ "${frames}" -gt 10 ] || { on_box "docker rm -f coral-tour >/dev/null 2>&1"; die "the flight produced ${frames} frames"; }

    dim "making the video from ${frames} frames"
    on_box "ffmpeg -y -loglevel error -framerate 24 -pattern_type glob \
        -i '${where}/tour/frame_*.png' -c:v libx264 -pix_fmt yuv420p -crf 22 \
        ${where}/tour.mp4"
    on_box "docker rm -f coral-tour >/dev/null 2>&1"
    on_box "cat ${where}/tour.mp4" > "${ROOT}/.uav-map.mp4"
    bold "${ROOT}/.uav-map.mp4"
    ls -lh "${ROOT}/.uav-map.mp4" | awk '{print "  " $5}'
}

# The simulator a dive is running in.
command_sim() {
    local what="${1:-logs}"
    local container
    container="$(on_box "docker ps --format '{{.Names}}' | grep coral-sim | head -1")"
    [ -n "${container}" ] || die "no dive is running"
    case "${what}" in
        logs)  on_box "docker logs --tail 200 --follow ${container}" ;;
        said)  on_box "docker logs ${container} 2>&1 | grep -E '^\\{' | tail -40" ;;
        opened) on_box "docker logs ${container} 2>&1 | grep -E '^\\{' | head -12" ;;
        # Because the alternative was writing the same forty-character ssh
        # pipeline by hand every time, slightly differently, and reading the
        # result wrong when it came back empty for the wrong reason.
        grep)  [ -n "${2:-}" ] || die "uav sim grep <pattern>"
               on_box "docker logs ${container} 2>&1 | grep -iE '$2' | head -30" ;;
        shell) ssh -t "${GPU_HOST}" "docker exec -it ${container} bash" ;;
        *)     die "uav sim [logs|said|opened|grep <pattern>|shell]" ;;
    esac
}

# End the dive that is running, and give the machine back.
#
# By stopping the simulator, which is blunt: the agent notices, finishes the run
# and releases the device. There is no way for a person to end their own dive
# through the platform yet, which is a gap — you can ask for a machine and not
# hand it back — and this is what stands in until there is.
command_stop() {
    local container
    container="$(on_box "docker ps --format '{{.Names}}' | grep -E 'coral-(sim|autonomy)' | tr '\n' ' '")"
    [ -n "${container// /}" ] || { dim "nothing is running"; return; }
    on_box "docker stop ${container} >/dev/null"
    bold "stopped"
    dim "${container}"
}

# Withdraw everything outstanding: what is running, and what is waiting.
command_clear() {
    TOKEN="${TOKEN:-$(token)}"
    local org dives cleared=0
    org="$(api GET /api/v1/me | json 'document["organisations"][0]["id"]')"
    dives="$(api GET "/api/v1/organisations/${org}/dives" \
        | json '" ".join(d["id"] for d in document["dives"])')"
    for dive in ${dives}; do
        for run in $(api GET "/api/v1/dives/${dive}/runs" | json '" ".join(
            r["id"] for r in document["runs"]
            if r["state"] in ("queued", "preparing", "running"))'); do
            api POST "/api/v1/dives/${dive}/runs/${run}/cancel" >/dev/null
            dim "  withdrew ${run}"
            cleared=$((cleared + 1))
        done
    done
    bold "${cleared} withdrawn"
}

command_api() {
    [ $# -ge 2 ] || die "uav api <method> <path> [body]"
    api "$1" "$2" "${3:-}"
    printf '\n'
}

case "${1:-}" in
    deploy) shift; command_deploy "$@" ;;
    status) shift; command_status "$@" ;;
    logs)   shift; command_logs "$@" ;;
    agent)  shift; command_agent "$@" ;;
    app)    shift; command_app "$@" ;;
    dive)   shift; command_dive "$@" ;;
    watch)  shift; command_watch "$@" ;;
    runs)   shift; command_runs "$@" ;;
    frames) shift; command_frames "$@" ;;
    fly)    shift; command_fly "$@" ;;
    look)   shift; command_look "$@" ;;
    map)    shift; command_map "$@" ;;
    sim)    shift; command_sim "$@" ;;
    check)  shift; command_check "$@" ;;
    clean)  shift; command_clean "$@" ;;
    stop)   shift; command_stop "$@" ;;
    clear)  shift; command_clear "$@" ;;
    api)    shift; command_api "$@" ;;
    ""|help|-h|--help)
        sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *) die "no such thing as 'uav $1' — try 'uav help'" ;;
esac
