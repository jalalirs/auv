def a_picture(grid: dict, covered: dict | None = None) -> tuple[str, str, str]:
    """The grid, drawn: worked cells against the rest.

    Small and plain, because the point is the shape of the work — where the
    reef is in the site and how much of the site it is.

    Once something has been flown the same picture says what was actually
    reached, on the same cells, which is the only way the plan and the
    outcome are comparable. A cell that was worked and missed is red: the
    page must not let a gap look like water.
    """
    n = grid["across"]
    by = {(one["row"], one["column"]): one for one in grid["cells"]}
    working = {(one["row"], one["column"]) for one in grid["working"]}
    hit = (covered or {}).get("hit") or {}
    most = max([one["colonies"] for one in grid["working"]] or [1])
    out = ['<div class="grid" style="grid-template-columns:repeat(%d,1fr)">' % n]
    # Row 0 is the south edge; a page reads from the north down.
    for row in range(n - 1, -1, -1):
        for column in range(n):
            one = by[(row, column)]
            at = (row, column)
            title = "%.0f m, %d colonies" % (one["depthM"], one["colonies"])
            if one["wetShare"] <= 0.5:
                colour = "#efe6d8"                       # land
            elif covered is not None and at in working:
                if at in hit:
                    colour = "#1a6b2a"
                    title += ", covered"
                else:
                    colour = "#b04a4a"
                    title += ", MISSED"
            elif covered is not None and at in hit:
                colour = "#cfe0cf"                       # passed over, not planned
                title += ", passed over"
            elif at in working:
                weight = 0.25 + 0.75 * (one["colonies"] / most if most else 0)
                colour = "rgba(26,107,42,%.2f)" % weight
            else:
                colour = "#dfe7ee"                       # water, nothing to work
            out.append('<i style="background:%s" title="%s"></i>' % (colour, title))
    out.append("</div>")
    legend = "".join(
        '<span><i style="background:%s"></i>%s</span>&nbsp;&nbsp;' % (colour, what)
        for colour, what in (
            (("#1a6b2a", "covered"), ("#b04a4a", "planned and missed"),
             ("#cfe0cf", "passed over, not planned"), ("#dfe7ee", "not in the plan"))
            if covered is not None else
            (("#1a6b2a", "to work, darker where there is more coral"),
             ("#dfe7ee", "water with nothing to work"), ("#efe6d8", "land"))))
    if covered is None:
        caption = ("%d cells of %.0f m · %d to work, shaded by how many colonies are "
                   "in them · %d dry, %d wet with nothing to work"
                   % (n * n, grid["cellM"], len(grid["working"]), grid["dry"],
                      grid["wet"] - len(grid["working"])))
    else:
        caption = ("%d of %d cells covered, %d missed"
                   % (covered["cellsCovered"], len(grid["working"]),
                      covered["cellsMissed"])
                   + (", %d cells passed over that were not in the plan"
                      % covered["cellsOutsideThePlan"]
                      if covered["cellsOutsideThePlan"] else ""))
    return "".join(out), caption, legend


def rows_of(said: dict, cost: dict, grid: dict) -> list[tuple]:
    rows = [("Cells to work", PLACE, "%d of %.0f m" % (said["cells"], grid["cellM"]),
             "the place's own seabed, wet cells with colonies in them"),
            ("Colonies in them", PLACE, f"{grid['colonies']:,}",
             "counted out of the place's own reef")]
    if "divesPerCell" in said:
        rows.append(("Dives a cell takes", said["divesPerCellFrom"],
                     "%.2f" % said["divesPerCell"],
                     ("a cell of %.0f m against the %.0f m2 the flown survey "
                      "actually covered, by %s"
                      % (grid["cellM"], said["coveredM2"],
                         cost.get("coveredBy") or "what it produced"))
                     if said["divesPerCellFrom"] != CHOSEN
                     else "nothing flown here says how much ground a dive covers, "
                          "so one cell is one dive"))
        rows.append(("Dives, all of it", "derived", "%d" % said["dives"],
                     "cells times the dives above"))
    if "hoursPerCell" in said:
        rows.append(("A cell takes", cost.get("from", FLOWN),
                     "%.2f h" % said["hoursPerCell"],
                     "what the dive actually spent in the water, end to end"))
        rows.append(("Vehicle hours, all of it", "derived",
                     "%.0f h" % said["vehicleHours"], "cells times the hour above"))
    if "energyWh" in said:
        rows.append(("Energy, all of it", "derived", "%.0f Wh" % said["energyWh"],
                     "cells times what one dive spent"))
    if "charges" in said:
        rows.append(("Battery changes", cost.get("from", FLOWN),
                     "%d" % said["charges"],
                     "how many cells fit on a charge, from the vehicle's own capacity"))
    rows.append(("Vehicles", CHOSEN, "%d" % said["vehicles"], "what the fleet is"))
    rows.append(("A working day", CHOSEN, "%.0f h" % said["workingDayHours"],
                 "how long a day on the water is"))
    if "workingDays" in said:
        rows.append(("Working days", "derived", "%d" % said["workingDays"],
                     "the hours above, divided by what the fleet does in a day"))
    if "survives" in said:
        rows.append(("Attempts that come off", SWEEP, "%d%%" % round(100 * said["survives"]),
                     "the share of a sweep's stated doubts the mission survived"))
        rows.append(("Ship days", "derived", "%d" % said["shipDays"],
                     "working days, divided by the share above"))
    return rows


def proof_of(covered: dict | None, grid: dict) -> str:
    """What was flown, and what it reached. Absent until something has."""
    if covered is None:
        return ""
    rows = "".join(
        "<tr><td class='what'>%s</td><td>%s</td><td class='n'>%s</td></tr>"
        % (html.escape(one["from"]), html.escape(one["what"]), f"{one['points']:,}")
        for one in covered["missions"])
    if not rows:
        rows = ("<tr><td class='what'>nothing</td><td colspan=2>none of those "
                "folders holds what a mission produced</td></tr>")
    return ("<h2>What was flown</h2><table>"
            "<tr><th>Mission</th><th>Produced</th><th class='n'>Points</th></tr>"
            + rows + "</table>"
            + ("<p class=\"says warn\"><strong>%d of the cells you planned to "
               "work were not reached.</strong> They are the red ones above. A "
               "gap must not be allowed to look like water.</p>"
               % covered["cellsMissed"] if covered["cellsMissed"] else ""))


def page(grid: dict, said: dict, cost: dict, order: list[dict],
         covered: dict | None = None, how: str = "lanes",
         band: tuple[float, float] = (3.0, 12.0), room: float = 0.25) -> str:
    provenance = a_tool("provenance")
    ink = dict(INK, derived=provenance.INK["derived"])
    wash = dict(WASH, derived=provenance.WASH["derived"])
    centre = grid["centre"]
    where = ["%.5f, %.5f" % (centre["latitude"], centre["longitude"]),
             "%.0f m across" % grid["acrossMetres"]]

    big = [("%d" % said["cells"], "cells to work"),
           ("%s" % f"{grid['colonies']:,}", "colonies in them")]
    if "workingDays" in said:
        big.append(("%d" % said["workingDays"], "working days"))
    if "shipDays" in said:
        big.append(("%d" % said["shipDays"], "ship days, with the weather"))
    headline = "".join("<div><b>%s</b><span>%s</span></div>"
                       % (html.escape(v), html.escape(w)) for v, w in big)

    warning = ""
    if "cannotSay" in said:
        warning = ('<p class="says warn"><strong>No days here, and that is the '
                   'point.</strong> %s. Fly one and give it to this with '
                   '<code>--cost</code>.</p>' % html.escape(said["cannotSay"]))

    picture, caption, legend = a_picture(grid, covered)
    if covered is not None:
        share = covered["cellsCovered"] / max(1, len(grid["working"]))
        big.append(("%d%%" % round(100 * share), "of the grid covered"))
        headline = "".join("<div><b>%s</b><span>%s</span></div>"
                           % (html.escape(v), html.escape(w)) for v, w in big)
    rows = "".join(
        '<tr><td class="what">%s</td>'
        '<td><span class="tag" style="color:%s;background:%s">%s</span></td>'
        '<td class="value">%s</td><td class="from">%s</td></tr>'
        % (html.escape(what), ink.get(kind, "#555"), wash.get(kind, "#eee"),
           html.escape(kind), html.escape(value), html.escape(whence))
        for what, kind, value, whence in rows_of(said, cost, grid))

    first = order[:3]
    if how == "lanes":
        order_said = ("Worked in lanes, not nearest-first: a boat that hops to the "
                      "densest cell and then the next spends the day moving. ")
    else:
        order_said = ("Ranked for planting: between %.0f and %.0f m, where coral "
                      "already grows — which is the substrate demonstrated rather "
                      "than inferred — and emptiest first past %.2f colonies a "
                      "square metre, because a cell that is full has nowhere to "
                      "put anything. The current is the third thing that decides "
                      "this and nothing in the place records it, so it is not in "
                      "the ranking. " % (band[0], band[1], room))
    order_said += ("First three: "
                   + ", ".join("row %d column %d (%.0f m, %d colonies)"
                               % (one["row"], one["column"], one["depthM"],
                                  one["colonies"]) for one in first)
                   if first else "")
    name = html.escape(str(centre.get("name", "a place")))
    return provenance.frame(
        title=name + " — working the whole grid", name=name,
        where=html.escape(" · ".join(where)),
        says=PAGE_SAYS, extra=PAGE_EXTRA,
        body=PAGE_BODY % {
            "warning": warning, "headline": headline,
            "ground": "What was covered" if covered is not None else "The ground",
            "picture": picture, "caption": html.escape(caption), "legend": legend,
            "rows": rows, "order": html.escape(order_said),
            "order_head": "Where to plant next" if how != "lanes" else "The order",
            "proof": proof_of(covered, grid)},
        footer=PAGE_FOOTER % {
            "source": html.escape(cost.get("from", "no flown dive at all"))})


def main() -> int:
    parse = argparse.ArgumentParser(
        description="a grid of cells, and what it would take to work all of them")
    parse.add_argument("place")
    parse.add_argument("--cell", type=float, default=20.0, help="cell size in metres")
    parse.add_argument("--where", choices=("reef", "all"), default="reef",
                       help="reef: only cells with colonies in them")
    parse.add_argument("--order", choices=("lanes", "suitability"), default="lanes",
                       help="lanes: work the ground, which is how a survey goes. "
                            "suitability: plant where coral already grows and "
                            "there is room, which is how an outplant goes")
    parse.add_argument("--band", type=float, nargs=2, default=(3.0, 12.0),
                       metavar=("SHALLOW", "DEEP"),
                       help="the depths outplanting is done between")
    parse.add_argument("--room", type=float, default=0.25,
                       help="colonies a square metre past which a cell is full")
    parse.add_argument("--cost", default=None,
                       help="a flown mission's mission.json, or a sweep's findings.json")
    parse.add_argument("--vehicles", type=int, default=1)
    parse.add_argument("--day-hours", dest="day_hours", type=float, default=10.0)
    parse.add_argument("--survives", type=float, default=None,
                       help="share of attempts that come off, if no sweep says")
    parse.add_argument("--flown", default=None,
                       help="a directory of what tools/deliver --dive produced, "
                            "one folder per mission, for what was actually covered")
    parse.add_argument("--into", default=None)
    asked = parse.parse_args()

    place = pathlib.Path(asked.place).expanduser()
    if not (place / "site.json").is_file():
        print(f"no place at {place}", file=sys.stderr)
        return 1
    grid = cells_over(place, asked.cell, asked.where)
    if not grid["working"]:
        print(f"  no cells to work in {place.name}", file=sys.stderr)
        return 1
    cost = cost_from(None if asked.cost is None
                     else pathlib.Path(asked.cost).expanduser())
    said = a_campaign(grid, cost, asked.vehicles, asked.day_hours, asked.survives)
    order = (in_lanes(grid["working"]) if asked.order == "lanes"
             else by_suitability(grid["working"], grid["cellM"],
                                 tuple(asked.band), asked.room))
    covered = None
    if asked.flown:
        flown = pathlib.Path(asked.flown).expanduser()
        if not flown.is_dir():
            print(f"no flown missions at {flown}", file=sys.stderr)
            return 1
        covered = covered_by(flown, grid)

    into = pathlib.Path(asked.into).expanduser() if asked.into else place / "campaign"
    into.mkdir(parents=True, exist_ok=True)
    deliver = a_tool("deliver")
    features = [{"type": "Feature",
                 "properties": {"n": n + 1, "depthM": one["depthM"],
                                "colonies": one["colonies"]},
                 "geometry": {"type": "Point", "coordinates": list(reversed(
                     [round(v, 8) for v in deliver.where_on_earth(
                         grid["centre"], one["x"], one["y"])]))}}
                for n, one in enumerate(order)]
    (into / "cells.geojson").write_text(json.dumps(
        {"type": "FeatureCollection", "features": features}, indent=1) + "\n")
    (into / "campaign.json").write_text(json.dumps(
        {"place": place.name, "grid": {k: v for k, v in grid.items() if k != "cells"},
         "cost": cost, "campaign": said,
         **({} if covered is None else {"covered": {
             k: v for k, v in covered.items() if k != "hit"}})},
        indent=2, default=float) + "\n")
    (into / "campaign.html").write_text(
        page(grid, said, cost, order, covered, asked.order,
             tuple(asked.band), asked.room))

    print(f"  {place.name}")
    print(f"    {said['cells']} cells of {grid['cellM']:.0f} m to work, "
          f"{grid['colonies']:,} colonies in them")
    if "workingDays" in said:
        print(f"    {said['vehicleHours']:.0f} vehicle hours · "
              f"{said['workingDays']} working days on {said['vehicles']} vehicle(s)"
              + (f" · {said['shipDays']} ship days with the weather"
                 if "shipDays" in said else ""))
    else:
        print(f"    {said['cannotSay']}")
    if covered is not None:
        print(f"    covered {covered['cellsCovered']} of {said['cells']} cells, "
              f"missed {covered['cellsMissed']}")
    for one in sorted(p.name for p in into.iterdir()):
        print(f"    {into / one}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
