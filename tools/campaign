#!/usr/bin/env python3
"""A grid of cells, and what it would take to work all of them.

    tools/campaign ~/coral-city/places/looe-key --cell 20
    tools/campaign ~/coral-city/places/al-fahal --cell 25 --cost run/mission.json

One dive is a demonstration. Nobody at a reef programme has the problem of
one dive: KCRI is putting two million corals into a hundred hectares by
2030, Red Sea Global monitors three hundred sites on a repeat cycle, Beacon
has relocated two hundred and twenty-five thousand colonies by diver, and
NCW has four hundred sites to visit a second time in a way that can be
compared with the first. What all four have is **a grid, a fleet and a boat
calendar**, and no way to turn one into the others.

This turns a place into that arithmetic, off the place's own record — the
seabed it was built from and the colonies that were planted or surveyed into
it — and off a dive that was actually flown, rather than off an estimate
somebody typed.

**It refuses to invent the cost.** Cells times a number nobody measured is a
spreadsheet, and a spreadsheet about ship time is worse than nothing: it is
a promise. Give it a flown mission (`mission.json`, from `tools/deliver
--dive`) or a sweep's findings, and every figure on the page says which of
those it came from. Give it neither and it will describe the grid and stop
where the arithmetic would start.
"""

from __future__ import annotations

import argparse
import html
import importlib.machinery
import importlib.util
import json
import math
import pathlib
import sys

import numpy as np

HERE = pathlib.Path(__file__).resolve().parent

# The tasks that work ground. A cell's cost has to come from a dive that
# did the work a cell needs — a survey covers it, an outplant plants it, a
# transect runs a line over it. A dive that went somewhere and held
# station tells you what going somewhere costs and nothing about a cell,
# and 94 cells times a station-keeping dive is a number with the wrong
# name on it.
WORKS_GROUND = ("survey", "search", "outplant", "transect", "section", "monitor",
                "treat", "profile", "mission")

# Where each figure came from, in the words this page uses. Not the place
# pages' vocabulary and deliberately so: nothing here is a measurement of a
# real reef, and the useful distinction is between a number a dive produced
# and a number somebody supplied.
FLOWN, PLACE, SWEEP, CHOSEN = "from a flown dive", "from the place", "from a sweep", "chosen"

INK = {FLOWN: "#1a6b2a", PLACE: "#1a4f8a", SWEEP: "#8a5a00", CHOSEN: "#8a2a2a"}
WASH = {FLOWN: "#e8f4ea", PLACE: "#e9eff6", SWEEP: "#fbf1de", CHOSEN: "#f9e9e9"}


def a_tool(name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(HERE / name))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# ── the grid ─────────────────────────────────────────────────────────────────

def cells_over(place: pathlib.Path, cell_m: float, where: str) -> dict:
    """The place, cut into cells, each knowing its depth and its colonies.

    Off the place's own heightfield and its own colony positions, so a cell
    that is described as twelve metres deep with four hundred colonies in it
    is describing the reef that would actually be flown.
    """
    deliver = a_tool("deliver")
    site = json.loads((place / "site.json").read_text())
    came = site.get("from") or {}
    across = float(came["acrossMetres"])
    centre = dict(came["centre"], name=site.get("name", "site"))

    field = site["mesh"]["heightfield"]
    heights = np.fromfile(place / field["file"], dtype="<f4").reshape(
        field["rows"], field["columns"])

    colonies = deliver.colonies_of(place)
    at = np.array(colonies["at"], dtype=float) if colonies["at"] else np.zeros((0, 3))

    n = max(1, int(round(across / cell_m)))
    step = across / n
    # Row 0 of the heightfield is the south edge, which is the same flip
    # every raster on this platform needs.
    made = []
    for row in range(n):
        for column in range(n):
            x0 = -across / 2 + column * step
            y0 = -across / 2 + row * step
            # The heightfield samples that fall inside this cell.
            a = int(row * field["rows"] / n)
            b = max(a + 1, int((row + 1) * field["rows"] / n))
            c = int(column * field["columns"] / n)
            d = max(c + 1, int((column + 1) * field["columns"] / n))
            patch = heights[a:b, c:d]
            deepest = float(-patch.min())
            shallowest = float(-patch.max())
            mean_depth = float(-patch.mean())
            # Wet enough to work, rather than wet anywhere. A cell with a
            # corner in the water is not a cell a vehicle can be flown over,
            # and counting it would put beach in the boat calendar.
            wet_share = float(np.count_nonzero(patch < 0.0)) / patch.size
            inside = 0
            if len(at):
                inside = int(np.count_nonzero(
                    (at[:, 0] >= x0) & (at[:, 0] < x0 + step)
                    & (at[:, 1] >= y0) & (at[:, 1] < y0 + step)))
            made.append({
                "row": row, "column": column,
                "x": round(x0 + step / 2, 2), "y": round(y0 + step / 2, 2),
                "depthM": round(mean_depth, 2),
                "shallowestM": round(shallowest, 2), "deepestM": round(deepest, 2),
                "wetShare": round(wet_share, 3),
                "colonies": inside,
            })

    dry = [one for one in made if one["wetShare"] <= 0.5]
    wet = [one for one in made if one["wetShare"] > 0.5]
    if where == "reef":
        working = [one for one in wet if one["colonies"] > 0]
    else:
        working = wet
    return {"cellM": round(step, 3), "across": n, "cells": made,
            "wet": len(wet), "dry": len(dry), "working": working,
            "centre": centre, "acrossMetres": across,
            "colonies": int(sum(one["colonies"] for one in working))}


def by_suitability(working: list[dict], cell_m: float,
                   band: tuple[float, float], room: float) -> list[dict]:
    """Which cell to plant next, and it is a ranking rather than a model.

    KCRI's gap, in their words: which cell to plant next given depth,
    substrate and current. Two of those three this can answer off the
    place, and it should say plainly which.

    **Depth** is straight out of the place's own seabed. A band, because
    outplanting is done in one — too shallow and it bleaches and gets
    broken, too deep and there is not the light.

    **Substrate** is not inferred; it is *demonstrated*. A cell with four
    hundred colonies already in it has hard bottom at a survivable depth,
    proven by the coral that is on it — which is better evidence than a
    hardness field computed off the shape of the ground, and it is the
    answer a reef ecologist gives when you ask where to plant.

    **Current** it cannot answer. Nothing in a place records it, and a
    number invented for it would be the kind of claim the rest of this
    platform exists to refuse. It is the third thing a survey would add.

    And the obvious caveat, because it is not obvious to a spreadsheet: a
    cell that is already full has nowhere to put anything. Cells past
    `room` colonies a square metre rank below emptier ones with the same
    depth, so the work goes where coral grows *and there is space*.
    """
    shallow, deep = band
    area = max(1e-9, cell_m ** 2)

    def how_good(one: dict) -> tuple:
        depth = one["depthM"]
        if not shallow <= depth <= deep:
            return (2, 0.0, depth)                 # outside the band at all
        density = one["colonies"] / area
        if density > room:
            return (1, -density, depth)            # proven, and full
        return (0, -density, depth)                # proven, and room left

    return sorted(working, key=how_good)


def in_lanes(working: list[dict]) -> list[dict]:
    """The order to work them in: up and down the grid, not nearest-first.

    A boat that hops to the densest cell, then the next densest, spends the
    day moving. Lanes are how ground is actually worked, and they are what
    makes a day's plan something a coxswain can follow.
    """
    ordered = sorted(working, key=lambda one: (one["row"], one["column"]))
    out = []
    for row in sorted({one["row"] for one in ordered}):
        lane = [one for one in ordered if one["row"] == row]
        out.extend(lane if row % 2 == 0 else list(reversed(lane)))
    return out


# ── what a cell costs ────────────────────────────────────────────────────────

def cost_from(path: pathlib.Path | None) -> dict:
    """What one cell takes, from something that was flown.

    A mission's own record says what that dive spent and how long it was in
    the water. A sweep's findings say the same across a stated list of
    doubts, and only a sweep can say what share of attempts survive, because
    a sweep flies a list once each — a mission's past runs are whatever
    happened to be flown, which is not a sample of anything.
    """
    if path is None:
        return {}
    said = json.loads(path.read_text())
    # A sweep's findings.
    if "cost" in said and isinstance(said["cost"], dict):
        cost = said["cost"]
        return {"energyWh": cost.get("diveEnergyWh"), "hours": cost.get("diveHours"),
                "perCharge": cost.get("perCharge"), "perDay": cost.get("perDay"),
                "heldBackBy": cost.get("heldBackBy"),
                "survives": cost.get("survives"),
                "workingDayHours": cost.get("workingDayHours"),
                "from": SWEEP, "runs": cost.get("runs")}
    # A single flown mission.
    task = said.get("task") or {}
    seconds = said.get("seconds")
    achieved = task.get("achieved") or {}
    coverage = said.get("coverage") or {}
    chart = said.get("bathymetry") or {}
    # How much ground that dive actually covered, when it said. Without it
    # a campaign has to assume one dive covers one cell, which is an
    # assumption wearing the clothes of arithmetic.
    #
    # Two instruments can answer, and they answer about different ground.
    # The camera's coverage is what was *seen* — which is what a photo
    # survey is for. The multibeam's is what was *sounded*, which is a
    # wider strip from the same altitude and the right answer when the
    # product is a chart. The camera wins when both are there, because a
    # dive that charted more than it photographed has not photographed it.
    covered, by = coverage.get("seenM2"), "the camera's footprint"
    if not covered and chart.get("cellsWithASounding"):
        covered = chart["cellsWithASounding"] * float(chart.get("cellM", 0.5)) ** 2
        by = "the multibeam's soundings"
    return {"energyWh": achieved.get("energyWh") or task.get("energyWh"),
            "hours": None if not seconds else round(float(seconds) / 3600.0, 4),
            "from": FLOWN, "runs": 1, "task": task.get("kind"),
            "coveredM2": covered, "coveredBy": by if covered else None}


def a_campaign(grid: dict, cost: dict, vehicles: int, day_hours: float,
               survives: float | None) -> dict:
    """Cells, crossed with what a cell costs, into days."""
    cells = len(grid["working"])
    said = {"cells": cells, "colonies": grid["colonies"], "vehicles": vehicles,
            "workingDayHours": day_hours}
    hours = cost.get("hours")
    if not hours:
        said["cannotSay"] = ("nothing has been flown here, so there is no "
                             "figure for what a cell takes")
        return said
    # And it has to have been a dive that worked a cell. A `reach` that
    # went somewhere and held station for twenty minutes will happily
    # multiply out to four working days over ninety-four cells, and every
    # figure in that column would be a number with the wrong name on it.
    kind = cost.get("task")
    if kind is not None and kind not in WORKS_GROUND:
        said["cannotSay"] = (
            "the dive this was costed from was a '%s', which does not work a "
            "cell — it says what going somewhere costs, not what covering "
            "ground costs. Fly a survey or an outplant here" % kind)
        return said
    # How many dives a cell takes, from the ground the flown survey actually
    # covered. Without that figure it is one, and the page says so as an
    # assumption rather than letting it look like arithmetic — a cell four
    # times the size of what a dive covers is four dives, and a plan that
    # quietly called it one is out by a factor of four.
    covered = cost.get("coveredM2")
    if covered and float(covered) > 0:
        said["divesPerCell"] = round(float(grid["cellM"]) ** 2 / float(covered), 3)
        said["divesPerCellFrom"] = cost.get("from", FLOWN)
        said["coveredM2"] = float(covered)
    else:
        said["divesPerCell"] = 1.0
        said["divesPerCellFrom"] = CHOSEN
    said["dives"] = math.ceil(cells * said["divesPerCell"])
    said["hoursPerCell"] = round(float(hours) * said["divesPerCell"], 3)
    said["vehicleHours"] = round(cells * said["hoursPerCell"], 1)
    # A day is what the fleet can do in it, and a fleet is vehicles times
    # hours — not vehicles times cells, which would let half a dive count.
    a_day = max(1e-9, day_hours * vehicles)
    said["workingDays"] = math.ceil(said["vehicleHours"] / a_day)
    if cost.get("energyWh"):
        said["energyWh"] = round(said["dives"] * float(cost["energyWh"]), 1)
    if cost.get("perCharge"):
        said["charges"] = math.ceil(said["dives"] / max(1e-9, float(cost["perCharge"])))
    share = survives if survives is not None else cost.get("survives")
    if share:
        said["survives"] = round(float(share), 3)
        # What the weather costs: a day of work takes more than a day of ship
        # time when only some attempts come off.
        said["shipDays"] = math.ceil(said["workingDays"] / max(1e-9, float(share)))
    return said


# ── and afterwards, what was actually covered ────────────────────────────────
#
# The half that makes a campaign a product rather than a calculator. Every
# one of these programmes can tell you what they set out to do; none of them
# can hand a regulator a map of what they actually covered, because the
# vehicle does not know where it was and the divers were counting.
#
# Read back out of what the missions themselves produced — the ground a
# survey's camera actually passed over, the corals that actually went in —
# and binned onto the same grid the plan was made on. Same cells, before and
# after, which is the only way the two are comparable.


def back_to_metres(centre: dict, latitude: float, longitude: float) -> tuple:
    """WGS84 back to site-local metres: the inverse of what `deliver` wrote."""
    deliver = a_tool("deliver")
    east, north = deliver.metres_per_degree(float(centre["latitude"]))
    return ((longitude - float(centre["longitude"])) * east,
            (latitude - float(centre["latitude"])) * north)


def covered_by(flown: pathlib.Path, grid: dict) -> dict:
    """Which cells the flown missions actually reached.

    A cell counts as covered when something a mission *produced* fell in it:
    ground a survey's camera passed over, or a coral that actually went in.
    Not where the plan said to go, and not where the vehicle believed it
    was — the two columns a dive keeps apart, kept apart here too.
    """
    centre = grid["centre"]
    across = grid["acrossMetres"]
    n = grid["across"]
    step = across / n
    hit: dict[tuple, int] = {}
    read = []
    for folder in sorted(p for p in flown.iterdir() if p.is_dir()):
        for name, what in (("coverage.geojson", "seen"),
                           ("planting.geojson", "planted")):
            where = folder / name
            if not where.is_file():
                continue
            try:
                drawn = json.loads(where.read_text())
            except ValueError:
                continue
            points = 0
            for feature in drawn.get("features") or []:
                geometry = feature.get("geometry") or {}
                if geometry.get("type") != "Point":
                    continue
                longitude, latitude = geometry["coordinates"][:2]
                x, y = back_to_metres(centre, latitude, longitude)
                column = int((x + across / 2) // step)
                row = int((y + across / 2) // step)
                if 0 <= row < n and 0 <= column < n:
                    hit[(row, column)] = hit.get((row, column), 0) + 1
                    points += 1
            read.append({"from": folder.name, "what": what, "points": points})
    working = {(one["row"], one["column"]) for one in grid["working"]}
    touched = set(hit)
    return {"missions": read,
            "cellsCovered": len(working & touched),
            "cellsMissed": len(working - touched),
            # Ground covered that nobody planned to work. Not an error — a
            # transit passes over cells on its way — but it is not coverage
            # of the grid either, and calling it that would inflate the
            # number the whole page exists to be honest about.
            "cellsOutsideThePlan": len(touched - working),
            "hit": hit}


