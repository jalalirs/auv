#!/usr/bin/env python3
"""What every place claims, and whether it can back it up.

    tools/check-places
    tools/check-places ~/coral-city/places

A reef's density is the number most likely to be quoted out of a render and
the least likely to be questioned. Looe Key holds 83,055 colonies a square
kilometre because somebody went and counted them; three other places on this
platform held 44,000, 500,000 and 1,400,000, all worked out from a model of
depth and hardness, and nothing anywhere said which was which.

So this walks the built places and reports, for each, where its density came
from. It exits non-zero if any of them cannot say — not because an unmeasured
reef is wrong, but because an unlabelled one is.
"""

from __future__ import annotations

import json
import pathlib
import sys


def about(place: pathlib.Path) -> dict | None:
    said = place / "site.json"
    if not said.is_file():
        return None
    described = json.loads(said.read_text())
    reef = described.get("reef") or {}
    cover = reef.get("cover") or {}
    ground = described.get("from") or {}
    return {
        "name": described.get("name", place.name),
        "colonies": reef.get("colonies"),
        "perSquareKm": cover.get("perSquareKm"),
        "from": cover.get("from"),
        "measured": cover.get("measured"),
        "surveyed": ground.get("surveyed"),
        "life": (described.get("life") or {}).get("source"),
    }


def water_of(place: pathlib.Path, site: dict) -> tuple[str, str | None]:
    """Whether this place's medium was baked, and whether it was aimed right.

    The map says how much of each colour survives the swim from every point on
    the site to the camera, and it is measured from one point: where dives
    begin. If `beginAt` moves and nobody runs `tools/aim-water` again, the map
    still loads, the frame still renders, and the water is now measured from
    somewhere the vehicle never goes. Nothing about that looks wrong.

    So the check is the one thing that can be verified from the file itself:
    the brightest texel is the camera, and it has to be where the record says
    the dive starts.
    """
    # A place where no dive begins has nothing to measure water from, and
    # that is a fact about the place rather than a gap in it. Thuwal Deep is
    # five hundred metres down with no reef on it and no dive start: the
    # medium has no camera to be measured to.
    if site.get("beginAt") is None:
        return "no dive", "nothing begins here, so there is nowhere to measure from"
    ground = (site.get("ground") or {}).get("waterBakedFrom")
    if ground is None:
        return "NOT BAKED", "tools/aim-water has not been run on it"
    map_file = place / ground.get("file", "")
    if not map_file.is_file():
        return "MISSING", f"{ground.get('file')} is not there"
    # PNG, checked by its own first bytes rather than its name. Written as a
    # JPEG this map came back flat: what survives falls to nothing over tens
    # of metres, so the part that carries the signal is a small bright disc on
    # a black field, which is exactly what a DCT discards.
    if map_file.read_bytes()[:8] != b"\x89PNG\r\n\x1a\n":
        return "NOT PNG", "a lossy codec destroys this particular image"

    begins = site.get("beginAt")
    across = float((site.get("from") or {}).get("acrossMetres") or 0) or None
    if begins is None or across is None:
        return "baked", None
    try:
        import numpy as np
        from PIL import Image
    except ImportError:
        return "baked", None

    got = np.asarray(Image.open(map_file).convert("RGB"))
    rows = got.shape[0]
    y, x = np.unravel_index(got[:, :, 1].argmax(), got.shape[:2])
    # North is at the top of a map and v = 0 is the south edge of the mesh.
    aimed = ((x + 0.5) / rows - 0.5) * across, (0.5 - (y + 0.5) / rows) * across
    off = max(abs(aimed[0] - float(begins[0])), abs(aimed[1] - float(begins[1])))
    if off > 2 * across / rows:
        return "MIS-AIMED", (f"brightest at {aimed[0]:.0f}, {aimed[1]:.0f} m "
                             f"but dives begin at {begins[0]:.0f}, "
                             f"{begins[1]:.0f} m — run tools/aim-water again")
    return "baked", None


def main() -> int:
    where = pathlib.Path(sys.argv[1] if len(sys.argv) > 1
                         else pathlib.Path.home() / "coral-city" / "places")
    if not where.is_dir():
        print(f"no places at {where}", file=sys.stderr)
        return 2

    unsourced = []
    unwatered = []
    unsourced_sea = []
    unsourced_reef = []
    print("%-14s %11s  %-9s %s" % ("place", "per km²", "density", "from"))
    for place in sorted(where.iterdir()):
        # Not the working copies somebody left beside the real ones. A
        # `.looe-key-before` kept for a comparison reported itself as
        # "looe-key" and showed up in this table twice, once with the truth
        # and once without it.
        if place.name.startswith("."):
            continue
        said = about(place)
        if said is None:
            continue
        if said["from"] is None:
            mark, source = "UNSOURCED", "— nothing recorded —"
            unsourced.append(said["name"])
        else:
            mark = "measured" if said["measured"] else "chosen"
            source = said["from"]
        print("%-14s %11s  %-9s %s" % (
            said["name"],
            "—" if said["perSquareKm"] is None else f"{said['perSquareKm']:,}",
            mark, source[:70]))

    print()
    print("%-14s %-11s %s" % ("place", "grown as", "where that mix comes from"))
    for place in sorted(where.iterdir()):
        if place.name.startswith(".") or not (place / "site.json").is_file():
            continue
        site = json.loads((place / "site.json").read_text())
        reef = site.get("reef") or {}
        if not reef.get("colonies"):
            continue
        # The same rule as the density and the sea. A reef drawn as the wrong
        # ocean is exactly as convincing as one drawn as the right one, and
        # every place on this platform was grown from a Caribbean mix until
        # somebody looked.
        mix = reef.get("assemblage") or {}
        named = mix.get("name") or "caribbean?"
        if not mix.get("from"):
            unsourced_reef.append(site.get("name", place.name))
        print("%-14s %-11s %s" % (site.get("name", place.name), named,
                                  (mix.get("from") or "— nothing recorded —")[:56]))
    if unsourced_reef:
        print()
        print("These are grown from the mix this platform started with and "
              "nobody has said it is theirs: " + ", ".join(unsourced_reef))
        print("tools/make-site --assemblage and --assemblage-from say which "
              "reef a place is.")

    print()
    print("%-14s %-6s %-10s %s" % ("place", "sea", "water", "how it was aimed"))
    for place in sorted(where.iterdir()):
        if place.name.startswith(".") or not (place / "site.json").is_file():
            continue
        site = json.loads((place / "site.json").read_text())
        mark, why = water_of(place, site)
        if mark not in ("baked", "no dive"):
            unwatered.append(f"{site.get('name', place.name)}: {why}")
        baked = (site.get("ground") or {}).get("waterBakedFrom") or {}
        at = baked.get("at")
        # Which sea, and whether anybody can say why.
        #
        # The same rule as the density above it: an unmeasured reef is not
        # wrong, an unlabelled one is. Everything here was rendered through
        # Jerlov 1C — clear coastal water — because that was the default in
        # three separate tools, and nothing anywhere said whether that was a
        # decision about the place or a number nobody had got to yet.
        sea = (site.get("water") or {})
        told = sea.get("type") or "1C"
        if not sea.get("from"):
            told += "?"
            unsourced_sea.append(site.get("name", place.name))
        print("%-14s %-6s %-10s %s" % (
            site.get("name", place.name), told, mark,
            why if why else
            f"{baked.get('waterType', '?')} from {at[0]:.0f}, {at[1]:.0f}, "
            f"{at[2]:.0f} m" if at else ""))

    print()
    if unwatered:
        print("These have no medium, or one aimed somewhere else:",
              file=sys.stderr)
        for one in unwatered:
            print(f"  {one}", file=sys.stderr)
        return 1
    if unsourced:
        print("These claim a density with nothing behind it: "
              + ", ".join(unsourced), file=sys.stderr)
        print("Rebuild them with --cover-from, saying the survey or saying "
              "it was chosen.", file=sys.stderr)
        return 1
    if unsourced_sea:
        print("A `?` beside the sea means nobody has said which water that "
              "place is in, so it is being rendered through Jerlov 1C — "
              "clear coastal — by default: " + ", ".join(unsourced_sea))
        print("Give it one with tools/make-site --water and --water-from. "
              "This is not a failure: a sea nobody has measured is a fair "
              "thing to have, and a sea nobody has labelled is not.")
        print()
    print("Every place says where its density comes from, and every one "
          "carries a medium aimed at its own dive start.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
