#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${REPO_ROOT}/.env" ]; then
    set -a
    source "${REPO_ROOT}/.env"
    set +a
fi

REMOTE_DIR="${AUV_REMOTE_DIR:-code/auv}"
DATA_DIR="${AUV_DATA_DIR:-/home/jalalirs/code/auv-data}"
GPU_DEVICE="${AUV_GPU_DEVICE:-0}"
DOMAIN_ID="${ROS_DOMAIN_ID:-42}"
USER_UID_VALUE="${AUV_USER_UID:-1000}"
USER_GID_VALUE="${AUV_USER_GID:-1000}"

if [[ ! "${REMOTE_DIR}" =~ ^[A-Za-z0-9._/-]+$ ]] \
    || [[ "${REMOTE_DIR}" = /* ]] \
    || [[ "${REMOTE_DIR}" == *..* ]]; then
    printf 'Refusing unsafe AUV_REMOTE_DIR: %s\n' "${REMOTE_DIR}" >&2
    exit 1
fi

if [[ ! "${GPU_DEVICE}" =~ ^[0-9]+$ ]] \
    || [[ ! "${DOMAIN_ID}" =~ ^[0-9]+$ ]] \
    || [[ ! "${USER_UID_VALUE}" =~ ^[0-9]+$ ]] \
    || [[ ! "${USER_GID_VALUE}" =~ ^[0-9]+$ ]]; then
    printf 'GPU, ROS domain, UID, and GID values must be non-negative integers.\n' >&2
    exit 1
fi

printf -v COMPOSE_ENV \
    'AUV_DATA_DIR=%q AUV_GPU_DEVICE=%q ROS_DOMAIN_ID=%q AUV_USER_UID=%q AUV_USER_GID=%q' \
    "${DATA_DIR}" "${GPU_DEVICE}" "${DOMAIN_ID}" "${USER_UID_VALUE}" "${USER_GID_VALUE}"
printf -v QUOTED_DATA_DIR '%q' "${DATA_DIR}"

remote() {
    "${SCRIPT_DIR}/gpu" "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} $1"
}

require_synced_checkout() {
    local local_head
    local remote_head

    if [ -n "$(git -C "${REPO_ROOT}" status --porcelain)" ]; then
        printf 'Local files are not synchronized. Run:\n' >&2
        printf '  tools/gpu sync "describe the change"\n' >&2
        exit 1
    fi

    local_head="$(git -C "${REPO_ROOT}" rev-parse HEAD)"
    if ! remote_head="$("${SCRIPT_DIR}/gpu" "git -C '${REMOTE_DIR}' rev-parse HEAD")"; then
        printf 'The GPU checkout is unavailable. Run tools/gpu sync first.\n' >&2
        exit 1
    fi

    if [ "${local_head}" != "${remote_head}" ]; then
        printf 'Mac and GPU commits differ; refusing to run stale code.\n' >&2
        printf 'Run tools/gpu sync to reconcile them.\n' >&2
        printf '  Mac: %s\n  GPU: %s\n' "${local_head}" "${remote_head}" >&2
        exit 1
    fi
}

case "${1:-status}" in
    build)
        require_synced_checkout
        remote "docker compose build auv-dev"
        ;;
    up)
        require_synced_checkout
        "${SCRIPT_DIR}/gpu" "mkdir -p ${QUOTED_DATA_DIR} && cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose up -d auv-dev"
        ;;
    down)
        remote "docker compose down"
        ;;
    restart)
        require_synced_checkout
        remote "docker compose restart auv-dev"
        ;;
    status)
        remote "docker compose ps"
        ;;
    logs)
        "${SCRIPT_DIR}/gpu" -s "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose logs --follow auv-dev"
        ;;
    shell)
        "${SCRIPT_DIR}/gpu" -s "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose exec auv-dev bash"
        ;;
    test)
        require_synced_checkout
        remote "docker compose run --rm auv-dev bash -lc 'cd ros2_ws && colcon build --symlink-install && colcon test --event-handlers console_direct+ && colcon test-result --verbose'"
        ;;
    dive)
        require_synced_checkout
        "${SCRIPT_DIR}/assets" first-dive
        "${SCRIPT_DIR}/gpu" "mkdir -p ${QUOTED_DATA_DIR}/logs/ros && cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose up --build --detach --force-recreate first-dive"
        ;;
    dive-stop)
        remote "docker compose stop first-dive"
        ;;
    dive-status)
        remote "docker compose ps first-dive"
        ;;
    dive-logs)
        "${SCRIPT_DIR}/gpu" -s "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose logs --follow first-dive"
        ;;
    dive-topics)
        remote "docker compose exec -T first-dive bash -lc 'source ros2_ws/install/setup.bash && ros2 topic list | sort'"
        ;;
    keyboard)
        require_synced_checkout
        "${SCRIPT_DIR}/gpu" -s "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose exec first-dive bash -lc 'source ros2_ws/install/setup.bash && exec ros2 run auv_control keyboard_teleop'"
        ;;
    *)
        printf 'Usage: %s {build|up|down|restart|status|logs|shell|test|dive|dive-stop|dive-status|dive-logs|dive-topics|keyboard}\n' "$0" >&2
        exit 2
        ;;
esac
