#!/usr/bin/env bash
# Operate the box environment.
#
# Everything runs on the GPU host: the record, stored bytes, the registry, the
# control plane, and the agent that will run dives. This drives that host over
# the tailnet rather than reaching into it by hand.
#
#   ./tools/box init -email you@example.org -name "Your Name"
#   ./tools/box up
#   ./tools/box status
#   ./tools/box logs control-plane
#   ./tools/box tunnel
#   ./tools/box down
#
# Secrets are generated on the box and stay there. They are never written to
# this checkout, so they cannot be committed by accident and do not need to
# travel over SSH on every deploy.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${REPO_ROOT}/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/.env"
    set +a
fi

GPU_HOST="${AUV_GPU_HOST:-jalalirs@100.76.65.1}"
REMOTE_DIR="${AUV_REMOTE_DIR:-code/auv}"
COMPOSE="cd ~/${REMOTE_DIR}/deployments/box && docker compose --env-file .env"

API_PORT="${CORAL_CITY_API_PORT:-18080}"
REGISTRY_PORT="${CORAL_CITY_REGISTRY_PORT:-18081}"
# Where the platform listens, on the box. Loopback by default, because a
# platform reachable from every network a machine happens to be on is a
# platform somebody else can find. Set it to one address — a Tailscale address,
# say — to let the application on somebody's own machine reach it, and it stays
# unreachable from everywhere else.
# Storage and the registry are the host talking to itself — the agent pulls
# through the daemon on this machine, and presigned URLs are followed down a
# tunnel — so they stay on loopback whatever the platform is reachable at.
INTERNAL="127.0.0.1"
# Where the simulation runtime lives. Through the registry, so that it survives
# anything that tidies up local tags, and so that a second host needs only to
# pull rather than to build twenty-one gigabytes of it.
SIM_IMAGE="${INTERNAL}:${REGISTRY_PORT}/sim-runtime:${CORAL_CITY_IMAGE_TAG:-r1}"
CONSOLE_PORT="${CORAL_CITY_CONSOLE_PORT:-18082}"
STORAGE_PORT="${CORAL_CITY_STORAGE_PORT:-19000}"
STORAGE_CONSOLE_PORT="${CORAL_CITY_STORAGE_CONSOLE_PORT:-19001}"

on_box() { LC_ALL=C ssh "${GPU_HOST}" "export LC_ALL=C LANG=C; $*"; }

# Where the platform listens, asked of the box rather than assumed here.
#
# It is a fact about that machine, kept in its own .env beside its secrets, and
# a copy of it in this shell is a second place for it to be wrong — which it
# was: this reported loopback while the platform was listening somewhere else
# entirely, so the one line telling somebody where to connect was the one line
# that was false.
bind_address() {
    local said
    said="$(on_box "sed -n 's/^CORAL_CITY_BIND_ADDRESS=//p' ~/${REMOTE_DIR}/deployments/box/.env" 2>/dev/null || true)"
    printf '%s' "${said:-127.0.0.1}"
}
on_box_tty() { LC_ALL=C ssh -t "${GPU_HOST}" "export LC_ALL=C LANG=C; $*"; }

die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
say() { printf '\033[1m%s\033[0m\n' "$*"; }

# The box serves what is in its checkout, so a deploy from a checkout that has
# moved on would be a lie about what is running.
warn_if_out_of_step() {
    local here there
    here="$(git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || echo unknown)"
    there="$(on_box "git -C ~/${REMOTE_DIR} rev-parse HEAD 2>/dev/null" || echo unknown)"
    if [ "${here}" != "${there}" ]; then
        printf '\033[33mThe box is at %s; this checkout is at %s.\n' \
            "${there:0:12}" "${here:0:12}"
        printf 'Run  ./tools/gpu sync "message"  to bring them together.\033[0m\n\n'
    fi
}

command_init() {
    local email="" name="" org="coral" org_name="Coral City"
    while [ $# -gt 0 ]; do
        case "$1" in
            -email|--email) email="$2"; shift 2 ;;
            -name|--name) name="$2"; shift 2 ;;
            -org|--org) org="$2"; shift 2 ;;
            -org-name|--org-name) org_name="$2"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [ -n "${email}" ] || die "an administrator email is required: ./tools/box init -email you@example.org -name 'Your Name'"
    [ -n "${name}" ] || die "an administrator name is required"

    if on_box "test -f ~/${REMOTE_DIR}/deployments/box/.env"; then
        die "the box already has deployments/box/.env — remove it there first if you mean to start over"
    fi

    say "Generating secrets on the box…"
    on_box "cd ~/${REMOTE_DIR}/deployments/box && \
        db=\$(openssl rand -hex 32) && \
        sk=\$(openssl rand -hex 32) && \
        ak=coral-\$(openssl rand -hex 8) && \
        admin=\$(openssl rand -hex 24) && \
        sed -e \"s|^CORAL_CITY_DATABASE_PASSWORD=.*|CORAL_CITY_DATABASE_PASSWORD=\$db|\" \
            -e \"s|^CORAL_CITY_STORAGE_ACCESS_KEY=.*|CORAL_CITY_STORAGE_ACCESS_KEY=\$ak|\" \
            -e \"s|^CORAL_CITY_STORAGE_SECRET_KEY=.*|CORAL_CITY_STORAGE_SECRET_KEY=\$sk|\" \
            -e \"s|^CORAL_CITY_ADMIN_SECRET=.*|CORAL_CITY_ADMIN_SECRET=\$admin|\" \
            -e \"s|^CORAL_CITY_ADMIN_EMAIL=.*|CORAL_CITY_ADMIN_EMAIL=${email}|\" \
            -e \"s|^CORAL_CITY_ADMIN_NAME=.*|CORAL_CITY_ADMIN_NAME=${name}|\" \
            -e \"s|^CORAL_CITY_ADMIN_ORG=.*|CORAL_CITY_ADMIN_ORG=${org}|\" \
            -e \"s|^CORAL_CITY_ADMIN_ORG_NAME=.*|CORAL_CITY_ADMIN_ORG_NAME=${org_name}|\" \
            .env.example > .env && \
        chmod 600 .env"

    say "Creating the directories it names…"
    # Read rather than sourced: this file is compose's format, not the shell's,
    # and a value with a space in it is legal there and a command here.
    on_box "cd ~/${REMOTE_DIR}/deployments/box && \
        for key in CORAL_CITY_STORAGE_PATH CORAL_CITY_AGENT_HOST_WORKDIR; do \
            path=\$(sed -n \"s/^\$key=//p\" .env | tr -d '\"'); \
            mkdir -p \"\$path\" && printf '  %-34s %s\\n' \"\$key\" \"\$path\"; \
        done"

    printf '\n\033[32mInitialised.\033[0m Your administrator secret is on the box:\n'
    printf '  ./tools/box secret\n\n'
    printf 'Then:  ./tools/box up\n'
}

command_secret() {
    on_box "grep -E '^CORAL_CITY_ADMIN_(EMAIL|SECRET)=' ~/${REMOTE_DIR}/deployments/box/.env" \
        || die "no .env on the box — run ./tools/box init first"
}

command_up() {
    on_box "test -f ~/${REMOTE_DIR}/deployments/box/.env" \
        || die "no .env on the box — run ./tools/box init first"
    warn_if_out_of_step

    local commit built_at
    commit="$(on_box "git -C ~/${REMOTE_DIR} rev-parse --short=12 HEAD 2>/dev/null" || echo unknown)"
    built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    say "Building on the box (commit ${commit})…"
    on_box "${COMPOSE} build --build-arg COMMIT=${commit} --build-arg BUILT_AT=${built_at}"

    say "Applying the schema…"
    on_box "${COMPOSE} up --detach --wait record storage registry"

    # The simulation runtime is part of this environment even though nothing in
    # the compose file runs it: the agent starts it per dive, and a host without
    # it accepts dives it cannot perform. Built here so that bringing the
    # environment up brings up all of it.
    #
    # And pushed to the registry rather than left as a local tag. A local tag is
    # a name on one machine that anything with a docker socket can remove, and
    # on a shared box things do; losing it cost a ten-minute rebuild every time,
    # in the middle of whatever was being tested. In the registry it is bytes
    # under a digest, the agent re-fetches it in seconds if it goes, and the
    # same reference works on the next host as it does on this one.
    say "Building the simulation runtime…"
    on_box "cd ~/${REMOTE_DIR} && docker build -q -f services/sim-runtime/Dockerfile \
        -t ${SIM_IMAGE} . | tail -1"
    say "Publishing it to the registry…"
    on_box "docker push --quiet ${SIM_IMAGE}"
    on_box "${COMPOSE} run --rm migrate"

    say "Starting…"
    on_box "${COMPOSE} up --detach --wait"

    say "Checking that it answers…"
    on_box "curl --fail --silent --show-error http://$(bind_address):${API_PORT}/api/v1/platform" || true
    printf '\n\n'
    command_status
}

command_status() {
    say "Services"
    on_box "${COMPOSE} ps --format '  {{.Service}}\t{{.State}}\t{{.Status}}'" 2>/dev/null || true
    printf '\n'
    say "Endpoints on the box"
    printf '  api        %s:%s\n' "$(bind_address)" "${API_PORT}"
    printf '  registry   %s:%s\n' "${INTERNAL}" "${REGISTRY_PORT}"
    printf '  console    %s:%s\n' "$(bind_address)" "${CONSOLE_PORT}"
    printf '  storage    %s:%s  (console %s)\n' "${INTERNAL}" "${STORAGE_PORT}" "${STORAGE_CONSOLE_PORT}"
    printf '\n'
    say "Simulation runtime"
    on_box "docker manifest inspect --insecure ${SIM_IMAGE} >/dev/null 2>&1 \
        && echo '  ${SIM_IMAGE}  in the registry' \
        || echo '  absent from the registry — dives will be refused'"
    printf '\nReach them from here with:  ./tools/box tunnel\n'
}

command_logs() {
    local service="${1:-}"
    on_box_tty "${COMPOSE} logs --tail 200 --follow ${service}"
}

command_down() {
    say "Stopping (volumes are kept)…"
    on_box "${COMPOSE} down"
}

# Ports are published on the box's loopback rather than its network interface,
# so reaching them means forwarding rather than opening a hole.
command_tunnel() {
    printf 'api       http://localhost:%s/api/v1/platform\n' "${API_PORT}"
    printf 'console   http://localhost:%s\n' "${CONSOLE_PORT}"
    printf 'storage   http://localhost:%s   (console http://localhost:%s)\n' \
        "${STORAGE_PORT}" "${STORAGE_CONSOLE_PORT}"
    printf 'registry  localhost:%s\n\n' "${REGISTRY_PORT}"
    printf 'Keep this terminal open; Ctrl-C closes the tunnel.\n'
    exec ssh \
        -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=30 \
        -N \
        -L "${API_PORT}:$(bind_address):${API_PORT}" \
        -L "${CONSOLE_PORT}:$(bind_address):${CONSOLE_PORT}" \
        -L "${REGISTRY_PORT}:${INTERNAL}:${REGISTRY_PORT}" \
        -L "${STORAGE_PORT}:${INTERNAL}:${STORAGE_PORT}" \
        -L "${STORAGE_CONSOLE_PORT}:${INTERNAL}:${STORAGE_CONSOLE_PORT}" \
        "${GPU_HOST}"
}

case "${1:-}" in
    init)    shift; command_init "$@" ;;
    secret)  command_secret ;;
    up)      command_up ;;
    status)  command_status ;;
    logs)    shift; command_logs "$@" ;;
    down)    command_down ;;
    tunnel)  command_tunnel ;;
    ""|help|-h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $1 (try: init, up, status, logs, down, tunnel, secret)" ;;
esac
