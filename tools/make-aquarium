# ── geometry ─────────────────────────────────────────────────────────────────

class Scene:
    """Meshes and their looks, written out as one USD file."""

    def __init__(self):
        self.meshes, self.looks, self.extra = [], {}, []

    def look(self, name, colour, rough=0.6, metal=0.0, opacity=1.0, emissive=None, clearcoat=0.0, ior=1.5,
             mdl=None):
        """A material. `mdl` is (module, {input: value}) for the renderer that
        draws the dive; the preview surface beside it is for everything else."""
        self.looks[name] = dict(colour=colour, rough=rough, metal=metal, opacity=opacity,
                                emissive=emissive, clearcoat=clearcoat, ior=ior, mdl=mdl)
        return name

    def add(self, path, points, faces, look, smooth=False, uv=None):
        self.meshes.append((path, np.asarray(points, float), np.asarray(faces, int), look, smooth,
                            None if uv is None else np.asarray(uv, float)))

    def write(self, where: pathlib.Path, doc: str):
        out = ['#usda 1.0\n(\n    doc = "%s"\n    defaultPrim = "World"\n    metersPerUnit = 1\n    upAxis = "Z"\n)\n\n'
               'def Xform "World"\n{\n' % doc.replace('"', "'")]
        groups: dict = {}
        for path, p, f, look, smooth, uv in self.meshes:
            group, name = path.split("/")
            groups.setdefault(group, []).append((name, p, f, look, smooth, uv))
        for group, items in groups.items():
            out.append('    def Xform "%s"\n    {\n' % group)
            for name, p, f, look, smooth, uv in items:
                out.append(_mesh(name, p, f, look, smooth, uv))
            out.append("    }\n")
        out.extend(self.extra)
        out.append('    def Scope "Looks"\n    {\n')
        for name, l in self.looks.items():
            out.append(_material(name, **l))
        out.append("    }\n}\n")
        where.write_text("".join(out))


def _mesh(name, p, f, look, smooth, uv=None):
    lo, hi = p.min(axis=0), p.max(axis=0)
    st = "" if uv is None else ('            texCoord2f[] primvars:st = [%s] (interpolation = "vertex")\n'
                                % ", ".join("(%.4f, %.4f)" % tuple(v) for v in uv))
    normals = ""
    if smooth:
        n = np.zeros_like(p)
        a, b, c = p[f[:, 0]], p[f[:, 1]], p[f[:, 2]]
        fn = np.cross(b - a, c - a)
        for k in range(3):
            np.add.at(n, f[:, k], fn)
        n /= np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-12)
        normals = '        normal3f[] normals = [%s] (interpolation = "vertex")\n' % ", ".join(
            "(%.4f, %.4f, %.4f)" % tuple(v) for v in n)
    return ('        def Mesh "%s" (prepend apiSchemas = ["MaterialBindingAPI"])\n        {\n'
            '            uniform token subdivisionScheme = "none"\n            uniform bool doubleSided = 1\n'
            '            int[] faceVertexCounts = [%s]\n            int[] faceVertexIndices = [%s]\n'
            '            point3f[] points = [%s]\n%s%s'
            '            float3[] extent = [(%.4f, %.4f, %.4f), (%.4f, %.4f, %.4f)]\n'
            '            rel material:binding = </World/Looks/%s>\n        }\n') % (
        name, ", ".join(["3"] * len(f)), ", ".join(str(i) for i in f.reshape(-1)),
        ", ".join("(%.5f, %.5f, %.5f)" % tuple(v) for v in p), normals.replace("        normal3f", "            normal3f"), st,
        *lo, *hi, look)


def _mdl_input(key, value):
    if isinstance(value, bool):
        return "bool inputs:%s = %d" % (key, int(value))
    if isinstance(value, str):
        return "asset inputs:%s = @%s@" % (key, value)
    if isinstance(value, tuple) and len(value) == 3:
        return "color3f inputs:%s = (%.4f, %.4f, %.4f)" % (key, *value)
    if isinstance(value, tuple) and len(value) == 2:
        return "float2 inputs:%s = (%.4f, %.4f)" % (key, *value)
    return "float inputs:%s = %.4f" % (key, float(value))


def _material(name, colour, rough, metal, opacity, emissive, clearcoat, ior, mdl=None):
    em = "" if emissive is None else "\n                color3f inputs:emissiveColor = (%.3f, %.3f, %.3f)" % tuple(emissive)
    physical = ""
    if mdl is not None:
        module, inputs = mdl
        physical = ('            token outputs:mdl:surface.connect = </World/Looks/%s/M.outputs:out>\n'
                    '            token outputs:mdl:volume.connect = </World/Looks/%s/M.outputs:out>\n'
                    '            token outputs:mdl:displacement.connect = </World/Looks/%s/M.outputs:out>\n'
                    '            def Shader "M"\n            {\n'
                    '                uniform token info:implementationSource = "sourceAsset"\n'
                    '                uniform asset info:mdl:sourceAsset = @%s.mdl@\n'
                    '                uniform token info:mdl:sourceAsset:subIdentifier = "%s"\n%s'
                    '                token outputs:out\n            }\n') % (
            name, name, name, module, module,
            "".join("                %s\n" % _mdl_input(k, v) for k, v in inputs.items()))
    return ('        def Material "%s"\n        {\n'
            '            token outputs:surface.connect = </World/Looks/%s/S.outputs:surface>\n%s'
            '            def Shader "S"\n            {\n'
            '                uniform token info:id = "UsdPreviewSurface"\n'
            '                color3f inputs:diffuseColor = (%.3f, %.3f, %.3f)\n'
            '                float inputs:roughness = %.3f\n                float inputs:metallic = %.3f\n'
            '                float inputs:opacity = %.3f\n                float inputs:clearcoat = %.3f\n'
            '                float inputs:ior = %.3f%s\n                token outputs:surface\n            }\n        }\n') % (
        name, name, physical, *colour, rough, metal, opacity, clearcoat, ior, em)


# ── textures, grown rather than fetched ──────────────────────────────────────

def _noise(n: int, rng, slope: float = 2.0) -> np.ndarray:
    """Tileable fractal noise, 0..1: white noise shaped in frequency, so it
    wraps at the edges and a texture repeats without a seam."""
    f = np.fft.fftfreq(n)
    k = np.sqrt(f[:, None] ** 2 + f[None, :] ** 2)
    k[0, 0] = 1.0
    field = np.real(np.fft.ifft2(np.fft.fft2(rng.normal(size=(n, n))) / k ** (slope / 2)))
    field -= field.min()
    return field / max(field.max(), 1e-9)


def _normal_map(height: np.ndarray, strength: float) -> np.ndarray:
    gy, gx = np.gradient(height)
    n = np.dstack([-gx * strength, -gy * strength, np.ones_like(height)])
    n /= np.linalg.norm(n, axis=2, keepdims=True)
    return ((n * 0.5 + 0.5) * 255).astype(np.uint8)


def textures(into: pathlib.Path, seed: int = 11, n: int = 1024) -> dict:
    """Sand and live rock as colour, normal and roughness maps.

    Not photographs: noise shaped the way each surface is. Sand is grains, a
    few shell fragments and a fine ripple; live rock is pitted limestone under
    patches of pink and purple coralline algae, which is what makes rock in a
    reef tank look alive rather than like concrete.
    """
    from PIL import Image

    rng = np.random.default_rng(seed)
    out = into / "textures"
    out.mkdir(parents=True, exist_ok=True)
    made = {}
    # Sand.
    grain = rng.random((n, n))
    broad = _noise(n, rng, 2.6)
    shell = rng.random((n, n)) > 0.9985
    base = np.array([0.80, 0.74, 0.62])
    albedo = base[None, None, :] * (0.88 + 0.16 * broad[..., None]) * (0.86 + 0.24 * grain[..., None])
    albedo[shell] = (0.96, 0.94, 0.90)
    height = 0.6 * _noise(n, rng, 1.2) + 0.4 * grain
    Image.fromarray((np.clip(albedo, 0, 1) ** (1 / 2.2) * 255).astype(np.uint8)).save(out / "sand_albedo.png")
    Image.fromarray(_normal_map(height, 6.0)).save(out / "sand_normal.png")
    Image.fromarray((np.clip(0.82 + 0.15 * grain, 0, 1) * 255).astype(np.uint8)).save(out / "sand_rough.png")
    made["sand"] = ("textures/sand_albedo.png", "textures/sand_normal.png", "textures/sand_rough.png")
    # Live rock: grey-brown limestone, darker in its pits, under soft-edged
    # crusts of coralline algae that are speckled rather than painted on.
    pits = _noise(n, rng, 1.6)
    lumps = _noise(n, rng, 3.0)
    fine = _noise(n, rng, 0.8)
    algae = _noise(n, rng, 3.2)
    smooth = lambda v, a, b: np.clip((v - a) / (b - a), 0, 1) ** 2 * (3 - 2 * np.clip((v - a) / (b - a), 0, 1))  # noqa: E731
    stone = np.array([0.42, 0.38, 0.33])[None, None, :] * (0.7 + 0.45 * lumps[..., None]) * (0.85 + 0.25 * fine[..., None])
    crust = smooth(algae, 0.55, 0.72)[..., None] * (0.55 + 0.45 * smooth(fine, 0.25, 0.7)[..., None])
    pink = np.array([0.72, 0.46, 0.56])[None, None, :] * (0.8 + 0.3 * lumps[..., None])
    purple = np.array([0.42, 0.30, 0.46])[None, None, :]
    lilac = smooth(1 - algae, 0.78, 0.9)[..., None] * 0.6
    albedo = stone * (1 - crust - lilac) + pink * crust + purple * lilac
    hollow = smooth(0.3 - pits, 0.0, 0.12)[..., None]
    albedo = albedo * (1 - 0.6 * hollow)
    height = 0.5 * lumps + 0.3 * fine + 0.2 * pits - 0.25 * hollow[..., 0]
    Image.fromarray((np.clip(albedo, 0, 1) ** (1 / 2.2) * 255).astype(np.uint8)).save(out / "rock_albedo.png")
    Image.fromarray(_normal_map(height, 16.0)).save(out / "rock_normal.png")
    Image.fromarray((np.clip(0.72 + 0.2 * pits - 0.15 * crust[..., 0], 0, 1) * 255).astype(np.uint8)).save(out / "rock_rough.png")
    made["rock"] = ("textures/rock_albedo.png", "textures/rock_normal.png", "textures/rock_rough.png")
    return made


def box(lo, hi):
    """A box with its own vertices per face, so it shades flat."""
    (x0, y0, z0), (x1, y1, z1) = lo, hi
    c = np.array([(x0, y0, z0), (x1, y0, z0), (x1, y1, z0), (x0, y1, z0),
                  (x0, y0, z1), (x1, y0, z1), (x1, y1, z1), (x0, y1, z1)])
    quads = [(0, 3, 2, 1), (4, 5, 6, 7), (0, 1, 5, 4), (1, 2, 6, 5), (2, 3, 7, 6), (3, 0, 4, 7)]
    pts, faces = [], []
    for q in quads:
        k = len(pts)
        pts += [c[i] for i in q]
        faces += [(k, k + 1, k + 2), (k, k + 2, k + 3)]
    return np.array(pts), np.array(faces)


def cylinder(a, b, r, sides=28, caps=True):
    a, b = np.asarray(a, float), np.asarray(b, float)
    p, f = coral._cylinder(a, b, r, r, sides)
    if caps and len(p):
        k = len(p)
        p = np.vstack([p, a, b])
        cap = []
        for i in range(sides):
            j = (i + 1) % sides
            cap += [(k, j, i), (k + 1, sides + i, sides + j)]
        f = np.vstack([f, np.array(cap)])
    return p, f


def tube(path_points, r, sides=10):
    """A cable along a polyline."""
    pieces = [coral._cylinder(np.asarray(a, float), np.asarray(b, float), r, r, sides)
              for a, b in zip(path_points[:-1], path_points[1:])]
    return coral._join(pieces)


def join(*pieces):
    return coral._join(list(pieces))


def curve(a, b, sag, n=16):
    a, b = np.asarray(a, float), np.asarray(b, float)
    t = np.linspace(0, 1, n)[:, None]
    return a + (b - a) * t - np.array([0, 0, sag]) * (4 * t * (1 - t))


# ── the inside ───────────────────────────────────────────────────────────────

def ground(rng):
    """Sand with ripples, and the rock on it, as one heightfield.

    The vehicle's floor is this field, so it rests on the rock rather than in
    it; the rock is also drawn as its own mesh, which is what it looks like."""
    line = np.linspace(-LONG / 2, LONG / 2, GRID)
    X, Y = np.meshgrid(line, line)
    sand = (FLOOR_Z + SAND + 0.006 * np.sin(X * 31 + 0.7 * np.sin(Y * 9)) + 0.004 * np.sin(Y * 23 + 1.3)
            + 0.015 * np.sin(X * 2.2 + 0.4))
    rock = np.full_like(sand, -9.0)
    for x, y, r, h, lean in ROCKS:
        d = np.hypot(X - x, (Y - y) * (1 + 0.25 * lean))
        top = sand + h * np.sqrt(np.clip(1 - (d / r) ** 2, 0, 1)) * (1 + 0.15 * np.sin(X * 47 + Y * 37))
        rock = np.where(d < r, np.maximum(rock, top), rock)
    heights = np.maximum(sand, rock)
    return line, sand, rock, heights


def field_mesh(xs, ys, z):
    """A grid of heights as triangles; z is indexed [y, x]."""
    n, m = len(xs), len(ys)
    X, Y = np.meshgrid(xs, ys)
    p = np.stack([X.ravel(), Y.ravel(), z.ravel()], axis=1)
    faces = []
    for j in range(m - 1):
        for i in range(n - 1):
            a = j * n + i
            faces += [(a, a + 1, a + n + 1), (a, a + n + 1, a + n)]
    return p, np.array(faces)


def rock_mesh(rng, x, y, r, h, lean, sand_at):
    """Live rock: a lumpy dome, fine enough to be smooth where it is smooth and
    pitted where it is not. Three octaves of bumps, each a sum of random waves
    over the surface, so no two rocks share a profile and none shows facets."""
    rows, sides = 44, 112
    waves = []
    for octave, (count, size, depth) in enumerate(((5, 2.0, 0.22), (9, 5.0, 0.08), (14, 12.0, 0.03))):
        for _ in range(count):
            direction = rng.normal(size=3)
            direction /= np.linalg.norm(direction)
            waves.append((direction * size, rng.uniform(0, 2 * np.pi), depth / np.sqrt(count) * 1.6))
    pts = []
    for i in range(rows + 1):
        phi = (math.pi / 2) * i / rows
        for k in range(sides):
            th = 2 * math.pi * k / sides
            unit = np.array([math.cos(phi) * math.cos(th), math.cos(phi) * math.sin(th), math.sin(phi)])
            bump = 1.0 + sum(a * math.sin(float(d @ unit) + ph) for d, ph, a in waves)
            # Undercut a little at the foot, which is what makes a rock sit on
            # sand rather than melt into it.
            foot = 1.0 - 0.12 * math.exp(-(phi / 0.12) ** 2)
            rr = r * math.cos(phi) * bump * foot
            pts.append((x + rr * math.cos(th), y + rr * math.sin(th) / (1 + 0.25 * lean), h * math.sin(phi) * bump))
    faces = []
    for i in range(rows):
        for k in range(sides):
            a, b = i * sides + k, i * sides + (k + 1) % sides
            faces += [(a, b, b + sides), (a, b + sides, a + sides)]
    # Close the top.
    top = len(pts)
    pts.append((x, y, h * (1.0 + sum(a * math.sin(float(d @ np.array([0, 0, 1.0])) + ph) for d, ph, a in waves))))
    for k in range(sides):
        faces.append((rows * sides + k, rows * sides + (k + 1) % sides, top))
    p = np.array(pts)
    p[:, 2] += sand_at(x, y) - 0.02
    return p, np.array(faces)


def build(name: str, into: pathlib.Path, seed: int = 7) -> dict:
    rng = np.random.default_rng(seed)
    s = Scene()
    # Looks.
    # Dark, not pale. A translucent surface's own colour is lit like any
    # other, so pale glass under a fill light glows and the tank goes milky;
    # dark glass tints what is behind it and only its reflections show.
    tex = textures(into)
    pbr = lambda colour, rough=0.5, metal=0.0, **more: ("OmniPBR", dict(  # noqa: E731
        diffuse_color_constant=tuple(colour), reflection_roughness_constant=rough, metallic_constant=metal, **more))
    # Real glass: it refracts and it reflects, which is what a tank's front
    # pane does and what a translucent sheet never could.
    glass = s.look("Glass", (0.02, 0.03, 0.03), rough=0.0, opacity=0.06, clearcoat=1.0, ior=1.52,
                   mdl=("OmniGlass", dict(glass_color=(0.94, 0.98, 0.96), glass_ior=1.52, thin_walled=False,
                                          frosting_roughness=0.0)))
    water = s.look("WaterBody", (0.0, 0.05, 0.07), rough=0.0, opacity=0.04, ior=1.33)
    trim = s.look("Trim", (0.02, 0.02, 0.02), rough=0.35, mdl=pbr((0.02, 0.02, 0.02), 0.3))
    steel = s.look("Steel", (0.05, 0.05, 0.055), rough=0.45, metal=0.6, mdl=pbr((0.06, 0.06, 0.065), 0.35, 0.8))
    oak = s.look("Oak", (0.55, 0.40, 0.26), rough=0.55, mdl=pbr((0.55, 0.40, 0.26), 0.5))
    floor = s.look("RoomFloor", (0.32, 0.24, 0.18), rough=0.6, mdl=pbr((0.28, 0.20, 0.14), 0.4))
    # Mid grey, not white: white walls behind the glass set the camera's
    # exposure, and everything in the water came out as a silhouette.
    # A tank is shown in a dim room: the water is the brightest thing in it,
    # which is what makes a reef tank glow and a lit lab look like a lab.
    wall = s.look("Wall", (0.20, 0.22, 0.26), rough=0.9, mdl=pbr((0.16, 0.18, 0.22), 0.85))
    sand = s.look("Sand", (0.86, 0.80, 0.68), rough=0.95, mdl=("OmniPBR", dict(
        diffuse_texture=tex["sand"][0], normalmap_texture=tex["sand"][1], reflectionroughness_texture=tex["sand"][2],
        reflection_roughness_texture_influence=1.0, bump_factor=0.6)))
    rockl = s.look("LiveRock", (0.52, 0.42, 0.44), rough=0.9, mdl=("OmniPBR", dict(
        diffuse_texture=tex["rock"][0], normalmap_texture=tex["rock"][1], reflectionroughness_texture=tex["rock"][2],
        reflection_roughness_texture_influence=1.0, bump_factor=1.4)))
    desk = s.look("Desk", (0.93, 0.93, 0.92), rough=0.5, mdl=pbr((0.90, 0.90, 0.89), 0.35))
    gold = s.look("DgxSpark", (0.78, 0.68, 0.50), rough=0.3, metal=0.9, mdl=pbr((0.80, 0.68, 0.48), 0.28, 1.0))
    black = s.look("Device", (0.03, 0.03, 0.035), rough=0.4, mdl=pbr((0.03, 0.03, 0.035), 0.35))
    glow = lambda colour, nits: ("OmniPBR", dict(diffuse_color_constant=tuple(colour), enable_emission=True,  # noqa: E731
                                                 emissive_color=tuple(colour), emissive_intensity=nits))
    screen = s.look("Screen", (0.02, 0.05, 0.10), rough=0.1, emissive=(0.05, 0.25, 0.45), mdl=glow((0.12, 0.45, 0.85), 600))
    led = s.look("LedPanel", (0.9, 0.95, 1.0), rough=0.3, emissive=(4.0, 4.6, 5.5), mdl=glow((0.72, 0.84, 1.0), 14000))
    cable = s.look("Cable", (0.95, 0.45, 0.05), rough=0.5, mdl=pbr((0.95, 0.42, 0.04), 0.4))
    grey = s.look("Grey", (0.35, 0.36, 0.38), rough=0.5, metal=0.3, mdl=pbr((0.35, 0.36, 0.38), 0.4, 0.4))
    green = s.look("Status", (0.1, 0.9, 0.3), rough=0.3, emissive=(0.1, 1.2, 0.3), mdl=glow((0.1, 1.0, 0.3), 2000))

    hx, hy = LONG / 2, WIDE / 2
    ox, oy = hx + GLASS, hy + GLASS
    top = FREEBOARD
    bottom = FLOOR_Z - GLASS

    # Room: a floor and two walls, open towards the cameras.
    s.add("Room/Floor", *box((-2.6, -2.2, ROOM_FLOOR - 0.02), (4.0, 3.0, ROOM_FLOOR)), floor)
    s.add("Room/BackWall", *box((-1.65, -2.2, ROOM_FLOOR), (-1.60, 3.0, ROOM_FLOOR + 2.8)), wall)
    s.add("Room/SideWall", *box((-1.65, -1.75, ROOM_FLOOR), (4.0, -1.70, ROOM_FLOOR + 2.8)), wall)

    # Stand: a steel frame and an oak board.
    # Two tonnes of water: six legs, not four.
    legs = []
    for cx in (-(ox - 0.02), 0.0, ox - 0.02):
        for sy in (-1, 1):
            cy = sy * (oy - 0.02)
            legs.append(box((cx - 0.025, cy - 0.025, ROOM_FLOOR), (cx + 0.025, cy + 0.025, bottom - BOARD)))
    for zc in (ROOM_FLOOR + 0.06, bottom - BOARD - 0.025):
        for sy in (-1, 1):
            legs.append(box((-ox, sy * (oy - 0.02) - 0.025, zc - 0.025), (ox, sy * (oy - 0.02) + 0.025, zc + 0.025)))
        for cx in (-(ox - 0.02), 0.0, ox - 0.02):
            legs.append(box((cx - 0.025, -oy, zc - 0.025), (cx + 0.025, oy, zc + 0.025)))
    s.add("Stand/Frame", *join(*legs), steel)
    s.add("Stand/Board", *box((-ox - 0.01, -oy - 0.01, bottom - BOARD), (ox + 0.01, oy + 0.01, bottom)), oak)

    # The glass: five panes, black trim along the top and the bottom.
    panes = [box((-ox, -oy, bottom), (ox, oy, FLOOR_Z)),
             box((-ox, -oy, FLOOR_Z), (-hx, oy, top)), box((hx, -oy, FLOOR_Z), (ox, oy, top)),
             box((-hx, -oy, FLOOR_Z), (hx, -hy, top)), box((-hx, hy, FLOOR_Z), (hx, oy, top))]
    s.add("Tank/Glass", *join(*panes), glass)
    rims = []
    for z0, z1 in ((top - 0.025, top), (bottom, bottom + 0.03)):
        rims += [box((-ox - 0.002, -oy - 0.002, z0), (ox + 0.002, -oy + 0.03, z1)),
                 box((-ox - 0.002, oy - 0.03, z0), (ox + 0.002, oy + 0.002, z1)),
                 box((-ox - 0.002, -oy, z0), (-ox + 0.03, oy, z1)),
                 box((ox - 0.03, -oy, z0), (ox + 0.002, oy, z1))]
    # A euro-brace across the middle of the top, which a two-metre tank needs.
    rims.append(box((-0.03, -oy, top - 0.025), (0.03, oy, top)))
    s.add("Tank/Trim", *join(*rims), trim)
    # The water as a body, for looking at the tank from outside. Hidden when
    # the camera is in it: the medium inside is the renderer's, not a box's.
    if WATER_BODY:
        s.add("Tank/WaterBody", *box((-hx + 0.001, -hy + 0.001, FLOOR_Z), (hx - 0.001, hy - 0.001, -0.002)), water)

    # Sand and rock.
    line, sand_z, rock_z, heights = ground(rng)

    def cell(x, y):
        return (int(np.clip((x + LONG / 2) / LONG * (GRID - 1), 0, GRID - 1)),
                int(np.clip((y + LONG / 2) / LONG * (GRID - 1), 0, GRID - 1)))

    def sand_at(x, y):
        i, j = cell(x, y)
        return float(sand_z[j, i])

    def ground_at(x, y):
        i, j = cell(x, y)
        return float(heights[j, i])

    # The sand is drawn only inside the glass; the field runs wider so the
    # runtime can read it as one square.
    inside_y = np.flatnonzero(np.abs(line) <= hy + 1e-9)
    sand_points, sand_faces = field_mesh(line, line[inside_y], sand_z[inside_y])
    s.add("Tank/Sand", sand_points, sand_faces, sand, smooth=True, uv=sand_points[:, :2] * 2.5)
    for i, (x, y, r, h, lean) in enumerate(ROCKS):
        rock_points, rock_faces = rock_mesh(rng, x, y, r, h, lean, sand_at)
        # Wrapped round it like a globe: three times round, twice up.
        around = np.arctan2(rock_points[:, 1] - y, rock_points[:, 0] - x) / (2 * np.pi) + 0.5
        up = (rock_points[:, 2] - rock_points[:, 2].min()) / max(1e-6, np.ptp(rock_points[:, 2]))
        scale = max(1.0, 2 * np.pi * r / 0.25)
        s.add(f"Tank/Rock{i}", rock_points, rock_faces, rockl, smooth=True,
              uv=np.stack([around * scale, up * max(1.0, h / 0.25)], axis=1))

    # Coral, on the rock where there is rock and on the sand where there is not.
    import corallite
    coral_tile_m = corallite.TILE_MM / 1000.0
    coralline = {}
    for form in sorted(set(CORALLITE_OF.values())):
        corallite.write(form, into / "textures", pixels=512)
        coralline[form] = f"textures/corallite_{form}_normal.png"
    placed = []
    spots = [(x + rng.uniform(-0.5, 0.5) * r, y + rng.uniform(-0.5, 0.5) * r) for x, y, r, h, lean in ROCKS for _ in range(2)]
    spots += [(rng.uniform(-0.85, 0.85), rng.uniform(-0.4, 0.4)) for _ in range(8)]
    for i, (kind, size, colour) in enumerate(CORALS):
        x, y = spots[i % len(spots)]
        p, f = coral.grow_one(kind, rng, size)
        if not len(p):
            continue
        p = p + np.array([x, y, ground_at(x, y) - 0.01])
        tint = TANK_COLOURS[colour]
        surface = CORALLITE_OF.get(kind)
        if surface is not None:
            # Stony coral: its skeleton's surface is the look, so the corallite
            # normal map — cups, or a brain coral's meandering valleys — and
            # UVs wrapped round the colony at the map's own scale.
            look = s.look(f"Coral{i}", tint, rough=0.55, mdl=("OmniPBR", dict(
                diffuse_color_constant=tuple(tint), reflection_roughness_constant=0.5,
                normalmap_texture=coralline[surface], bump_factor=1.6)))
            centre = p.mean(axis=0)
            around = np.arctan2(p[:, 1] - centre[1], p[:, 0] - centre[0]) / (2 * np.pi) + 0.5
            tile = coral_tile_m
            girth = 2 * np.pi * max(0.02, float(np.median(np.hypot(p[:, 0] - centre[0], p[:, 1] - centre[1]))))
            s.add(f"Tank/Coral{i}", p, f, look, smooth=True,
                  uv=np.stack([around * girth / tile, (p[:, 2] - p[:, 2].min()) / tile], axis=1))
        else:
            # Soft coral and sponge: living tissue a light goes into and comes
            # back out of coloured, which is why it glows under a reef light.
            look = s.look(f"Coral{i}", tint, rough=0.55, mdl=("OmniSurface", dict(
                diffuse_reflection_color=tuple(tint), diffuse_reflection_roughness=0.4,
                specular_reflection_roughness=0.42, specular_reflection_weight=0.6,
                subsurface_weight=0.45, subsurface_scattering_color=tuple(tint),
                subsurface_transmission_color=tuple(min(1.0, c * 1.25 + 0.1) for c in tint), subsurface_scale=0.015)))
            s.add(f"Tank/Coral{i}", p, f, look, smooth=True)
        placed.append({"kind": kind, "sizeM": size, "colour": colour, "at": [round(x, 3), round(y, 3)],
                       # Which prim is this colony, so a dive can draw what happened to it.
                       "prim": f"Tank/Coral{i}"})

    # The pump, on the back glass, and the fan on the rim.
    s.add("Tank/Pump", *join(cylinder((-hx + 0.005, -0.30, -0.35), (-hx + 0.07, -0.30, -0.35), 0.03),
                             cylinder((-hx + 0.07, -0.30, -0.35), (-hx + 0.10, -0.30, -0.35), 0.015)), black)
    out = ox
    fan_at = np.array([out + 0.06, 0.0, top + 0.10])
    ring = []
    for k in range(48):
        a0, a1 = 2 * math.pi * k / 48, 2 * math.pi * (k + 1) / 48
        ring.append(coral._cylinder(fan_at + np.array([0, 0.08 * math.cos(a0), 0.08 * math.sin(a0)]),
                                    fan_at + np.array([0, 0.08 * math.cos(a1), 0.08 * math.sin(a1)]), 0.004, 0.004, 6))
    blades = [box(fan_at + np.array([-0.005, -0.065, -0.012]), fan_at + np.array([0.005, 0.065, 0.012]))]
    blades.append(box(fan_at + np.array([-0.005, -0.012, -0.065]), fan_at + np.array([0.005, 0.012, 0.065])))
    s.add("Room/Fan", *join(*ring, *blades, cylinder(fan_at + [0.02, 0, 0], fan_at + [0.05, 0, 0], 0.03),
                            box((out - 0.01, -0.03, top - 0.06), (out + 0.10, 0.03, top + 0.02))), black)

    # The gantry over the middle, the overhead camera on it, and two LED bars
    # along the tank's length. The camera sits high enough to see both ends.
    # Its two posts stand at the back corners, not across the middle of the
    # long glass, where one cut every picture of the tank in half.
    cam_z = 1.45
    post_y = -(oy + 0.12)
    post_x = ox + 0.08
    g = [box((sx * post_x - 0.02, post_y - 0.02, bottom - BOARD), (sx * post_x + 0.02, post_y + 0.02, cam_z + 0.15))
         for sx in (-1, 1)]
    g.append(box((-post_x, post_y - 0.02, cam_z + 0.11), (post_x, post_y + 0.02, cam_z + 0.15)))
    g.append(box((-0.02, post_y, cam_z + 0.11), (0.02, 0.0, cam_z + 0.15)))
    for by in (-0.25, 0.25):
        g += [box((sx - 0.01, by - 0.01, 0.42), (sx + 0.01, by + 0.01, cam_z + 0.11)) for sx in (-0.7, 0.7)]
        g.append(box((-0.72, by - 0.01, cam_z + 0.09), (0.72, by + 0.01, cam_z + 0.11)))
    g.append(box((-0.02, -0.26, cam_z + 0.09), (0.02, 0.26, cam_z + 0.11)))
    g.append(box((-0.72, post_y, cam_z + 0.11), (-0.68, -0.25, cam_z + 0.13)))
    g.append(box((0.68, post_y, cam_z + 0.11), (0.72, -0.25, cam_z + 0.13)))
    s.add("Rig/Gantry", *join(*g), steel)
    s.add("Rig/OverheadCamera", *join(box((-0.035, -0.035, cam_z + 0.02), (0.035, 0.035, cam_z + 0.11)),
                                      cylinder((0, 0, cam_z + 0.02), (0, 0, cam_z), 0.015)), black)
    s.add("Rig/LedBars", *join(box((-0.85, -0.29, 0.40), (0.85, -0.21, 0.42)), box((-0.85, 0.21, 0.40), (0.85, 0.29, 0.42))), led)
    for by in (-0.25, 0.25):
        s.extra.append(
            '    def RectLight "Led%s"\n    {\n        float inputs:width = 1.7\n        float inputs:height = 0.08\n'
            '        float inputs:intensity = 14000\n        color3f inputs:color = (0.72, 0.84, 1.0)\n'
            '        double3 xformOp:translate = (0, %.3f, 0.395)\n        uniform token[] xformOpOrder = ["xformOp:translate"]\n    }\n'
            % ("South" if by < 0 else "North", by))
    # A soft ceiling light for the room.
    s.extra.append('    def RectLight "Ceiling"\n    {\n        float inputs:width = 2.5\n        float inputs:height = 2.5\n'
                   '        float inputs:intensity = 500\n        color3f inputs:color = (1.0, 0.96, 0.9)\n'
                   '        double3 xformOp:translate = (0.5, -0.2, %.3f)\n        uniform token[] xformOpOrder = ["xformOp:translate"]\n    }\n'
                   % (ROOM_FLOOR + 2.75))

    # The balance matters as much as the amount: the camera exposes for the
    # brightest thing, and LED bars four times the daylight left every side
    # surface in the tank dim beside the tops of things.
    # Daylight. A room by day is lit from everywhere at once — windows, sky,
    # the walls throwing it back — and that is why nothing in a daylit room
    # is dark on one side. Without it the only light on the vehicle's flanks
    # was two fill panels, and its black sides rendered as a silhouette
    # however the panels were turned. A dome is that light: even, from every
    # direction, white.
    s.extra.append('    def DomeLight "Daylight"\n    {\n        float inputs:intensity = 450\n'
                   '        color3f inputs:color = (1.0, 0.98, 0.95)\n    }\n')

    # Fill light from the room's side and from the far end, the way a tank is
    # lit to be looked at: the LED bars light the top of what is in the water
    # and nothing of its sides, and a black-sided vehicle lit only from above
    # is a shape with no surface. Soft and wide, aimed at the glass.
    # High and angled down, not level behind the cameras: glass is a mirror,
    # and a bright panel at the camera's height reflected straight back over
    # the middle of the tank as a grey veil exactly where the vehicle swims.
    # From up here the reflection lands above the glass.
    for name, at, turn in (("FillRoom", (0.0, 2.0, 1.1), "float3 xformOp:rotateXYZ = (-53.13, 0, 0)"),
                           ("FillEnd", (2.4, 0.0, 1.1), "float3 xformOp:rotateXYZ = (0, 53.13, 0)")):
        s.extra.append(
            '    def RectLight "%s"\n    {\n        float inputs:width = 1.8\n        float inputs:height = 1.0\n'
            '        float inputs:intensity = 1100\n        color3f inputs:color = (1.0, 0.97, 0.92)\n'
            '        double3 xformOp:translate = (%.3f, %.3f, %.3f)\n        %s\n'
            '        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]\n    }\n'
            % (name, at[0], at[1], at[2], turn))

    # The desk, the DGX Spark, the switch, a monitor and a keyboard.
    # Beyond the tank's end, against the side wall, so the room camera sees
    # the tank's long side and the desk in one picture.
    dz = ROOM_FLOOR + 0.75
    dx = 0.85
    d0, d1 = (0.45 + dx, -1.68), (1.85 + dx, -1.05)
    parts = [box((d0[0], d0[1], dz - 0.03), (d1[0], d1[1], dz))]
    for lx in (d0[0] + 0.04, d1[0] - 0.04):
        for ly in (d0[1] + 0.04, d1[1] - 0.04):
            parts.append(box((lx - 0.02, ly - 0.02, ROOM_FLOOR), (lx + 0.02, ly + 0.02, dz - 0.03)))
    s.add("Desk/Desk", *join(*parts), desk)
    s.add("Desk/DgxSpark", *box((1.30 + dx, -1.45, dz), (1.45 + dx, -1.30, dz + 0.0505)), gold)
    s.add("Desk/Switch", *box((0.70 + dx, -1.40, dz), (0.92 + dx, -1.28, dz + 0.035)), black)
    s.add("Desk/SwitchLights", *join(*[box((0.92 + dx, -1.39 + 0.02 * k, dz + 0.012), (0.9225 + dx, -1.38 + 0.02 * k, dz + 0.02)) for k in range(5)]), green)
    s.add("Desk/MonitorStand", *join(box((1.00 + dx, -1.62, dz), (1.20 + dx, -1.52, dz + 0.01)), box((1.08 + dx, -1.60, dz), (1.12 + dx, -1.57, dz + 0.32))), grey)
    s.add("Desk/Monitor", *box((0.82 + dx, -1.60, dz + 0.17), (1.38 + dx, -1.57, dz + 0.50)), black)
    s.add("Desk/MonitorScreen", *box((0.835 + dx, -1.5705, dz + 0.185), (1.365 + dx, -1.568, dz + 0.485)), screen)
    s.add("Desk/Keyboard", *box((0.95 + dx, -1.35, dz), (1.32 + dx, -1.22, dz + 0.015)), grey)

    # Cables: the tether from the switch over the rim, and the switch to the DGX.
    tether = list(curve((0.92 + dx, -1.32, dz + 0.02), (0.90, -0.62, top + 0.02), -0.25, 18))
    tether += [(0.85, -oy + 0.02, top + 0.03), (0.80, -hy + 0.10, top - 0.08)]
    s.add("Rig/Tether", *tube(tether, 0.0035), cable)
    s.add("Desk/Patch", *tube(list(curve((0.92 + dx, -1.36, dz + 0.01), (1.30 + dx, -1.40, dz + 0.02), -0.01, 8)), 0.003), black)
    s.add("Rig/CameraCable", *tube([(0.03, 0.0, cam_z + 0.12), (0.03, post_y, cam_z + 0.12), (post_x, post_y + 0.03, cam_z + 0.12),
                                    (post_x + 0.03, post_y + 0.03, bottom),
                                    (0.6 + dx, -1.2, ROOM_FLOOR + 0.01), (0.8 + dx, -1.38, dz + 0.01)], 0.003), black)

    into.mkdir(parents=True, exist_ok=True)
    s.write(into / "tank.usda", f"{name}: a {LONG:g} x {WIDE:g} m glass tank in a room. Metres, Z up, z = 0 at the water surface. Chosen, not measured.")
    heights.astype("<f4").tofile(into / "seabed.f32")
    return {"corals": placed, "lowest": float(heights.min()), "highest": float(heights.max()),
            "meshes": len(s.meshes)}


def a_place(name: str, made: dict) -> dict:
    hx, hy = LONG / 2, WIDE / 2
    return {
        "name": name,
        "from": {"surveyed": False, "measured": False, "fetched": False,
                 "source": "chosen: the tank its owner asked for, two cubic metres as 2 x 1 x 1 m of glass, and a room built round it",
                 "acrossMetres": LONG, "lengthM": LONG, "widthM": WIDE, "depthM": round(-FLOOR_Z, 3),
                 "sampleMetres": round(LONG / (GRID - 1), 4), "decimatedBy": 1},
        "datum": "still water; z = 0 is the free surface and depth is negative z",
        "enclosed": True,
        # Inside the glass, which is what the vehicle is kept within.
        "interior": {"min": [-hx, -hy, FLOOR_Z], "max": [hx, hy, 0.0],
                     "why": "the glass is a wall: a vehicle stops at it rather than passing through"},
        "deepestM": round(-made["lowest"], 3),
        "shallowestM": round(-made["highest"], 3),
        "underwater": 1.0,
        "mesh": {"heightfield": {"file": "seabed.f32", "rows": GRID, "columns": GRID,
                                 "what": "the sand and the rock on it, which the vehicle rests on"}},
        "reef": {"colonies": len(made["corals"]), "prototypes": len(made["corals"]),
                 "from": "chosen: a reef tank's aquascape, coloured as aquarium corals are under blue light",
                 "colonies_at": made["corals"]},
        "layers": {"terrain": "tank.usda"},
        "beginAt": [0.0, 0.0, -0.4],
        "beginBecause": "in open water in the middle of the tank, over the sand between the two reefs",
        "life": {"tank": True, "count": FISH, "scale": 0.14,
                 "from": "chosen: what a two-cubic-metre reef tank holds, by species"},
        # The live rock, which is where the fish that hide in crevices hide.
        "rocks": [{"at": [x, y], "radiusM": r, "heightM": h} for x, y, r, h, lean in ROCKS],
        "water": {"type": "I", "from": "chosen: a filtered tank is clearer than the open ocean"},
        # How the cameras sit in a place two metres long. The built-in views
        # are sized for a reef and every one of them would be outside the glass.
        "cameras": {
            "chase": {"behind": 0.7, "above": 0.2},
            "top": {"above": 0.85},
            "orbit": {"radius": 0.45, "above": 0.12},
            "front": {"ahead": 0.19, "aim": 1.5},
            "down": {"below": 0.07, "aim": 1.0},
            "keepInside": True,
            "fixed": {
                "room": {"eye": [2.7, 3.0, -0.25], "aim": [0.55, -0.55, -0.75],
                         "what": "the whole bench from the room: tank, stand, rig, desk"},
                "glass": {"eye": [0.0, 2.15, -0.45], "aim": [0.0, 0.0, -0.5],
                          "what": "face to the long glass, the tank filling the frame"},
                "end": {"eye": [2.3, 0.0, -0.45], "aim": [0.0, 0.0, -0.5],
                        "what": "down the length of the tank from its end, past the fan"},
                "overhead": {"eye": [0.0, 0.0, 1.43], "aim": [0.0, 0.0, -0.9], "up": [1.0, 0.0, 0.0],
                             "what": "the gantry camera, which is how the tank knows where the vehicle is"},
                "desk": {"eye": [2.6, -0.35, -0.25], "aim": [1.95, -1.4, -0.8],
                         "what": "the desk: the DGX Spark, the switch, the tether going to the tank"},
            },
        },
        "rig": {
            "fan": {"at": [round(LONG / 2 + GLASS + 0.06, 3), 0.0, round(FREEBOARD + 0.10, 3)], "blowsTowardsDeg": 270,
                    "what": "blows the length of the surface: conditions windMetresPerSecond"},
            "pump": {"at": [round(-LONG / 2 + 0.07, 3), -0.30, -0.35], "pushesTowardsDeg": 90,
                     "what": "the circulation pump: conditions currentMetresPerSecond"},
            # The vehicle's cable comes off the switch, over the rim at the
            # desk end, and 1.8 m of it is paid out: enough to reach the
            # far end of the tank, not so much it piles on the sand.
            "tether": {"at": [0.80, round(-WIDE / 2 + 0.10, 3), round(FREEBOARD - 0.08, 3)], "outM": 1.8,
                       "what": "over the rim at the desk end of the tank, from the switch"},
            "overheadCamera": {"at": [0.0, 0.0, 1.45], "lookingDown": True},
            "waterTonnes": round(LONG * WIDE * -FLOOR_Z, 2),
            "computer": {"kind": "dgx-spark", "at": [2.225, -1.375]},
        },
        "ground": {"hardnessFrom": "sand and rock", "colourFrom": "chosen", "surveyed": False},
    }


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("name")
    ap.add_argument("--into", type=pathlib.Path)
    ap.add_argument("--seed", type=int, default=7)
    args = ap.parse_args()
    into = args.into or pathlib.Path.home() / "coral-city" / "places" / args.name
    t0 = time.time()
    made = build(args.name, into, args.seed)
    place = a_place(args.name, made)
    place["builtBy"] = [{"tool": "make-aquarium", "args": {"name": args.name, "seed": args.seed},
                         "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}]
    (into / "site.json").write_text(json.dumps(place, indent=1) + "\n")
    print(f"{args.name}: {made['meshes']} meshes, {len(made['corals'])} corals, ground {made['lowest']:.3f}..{made['highest']:.3f} m "
          f"→ {into} in {time.time() - t0:.1f} s")
    return 0


if __name__ == "__main__":
    sys.exit(main())
