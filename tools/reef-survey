#!/usr/bin/env python3
"""Write a surveyed reef into a place.

tools/benthos read the survey and listed every colony standing on the seabed.
This turns that list into the place's coral layer — the USD a dive opens — and
says in site.json where a dive on this reef should begin. The grown reef the
place used to carry is replaced, not merged: a colony is either where the survey
saw one or it is not there.

    tools/reef-survey ~/iocean/places/looe-key ~/iocean/reference/looe-key

The layer is a point instancer over a few dozen prototypes, the same shape the
grown reef used, so the runtime that draws it does not change. Prototypes are
grown from tools/coral.py by kind — a boulder for a stony colony or a head, a
lower lump for rock, a fan and a plume for the octocorals — in three shades
each, and every colony picks the prototype of its kind whose shade is nearest
the brightness the orthomosaic gave it. The hue is the reef's, from the
photographs; the survey decides only how light or dark.

Also copies picture.jpg into the place when the reference has one, so the
platform can show the reef it will open.
"""

from __future__ import annotations

import argparse
import json
import math
import pathlib
import shutil
import sys

# Next to this script, which is where python looks first.
import built

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

# What these things reflect, with the hue from the Looe Key photographs (see
# docs/plan/looe-key-reality.md) and the level from what the material is.
#
# Not the pixel values off the photographs. A picture of a reef taken through
# ten metres of water is not the reef's albedo, and handing one to a renderer
# as if it were gets it lit twice: the photograph already contains the light
# that fell on the reef, and then the renderer shines a sun on it.
# tools/make-site says exactly this about the ground and fixed it there in
# September. The coral kept the raw numbers, so a reef 70% covered in
# turf-grown rock at a claimed 0.36 reflectance rendered as a field of white
# pebbles scattered on a correctly-coloured seabed.
#
# Levels are what these surfaces actually reflect in the blue-green:
#   rock and pavement under turf algae   0.10 - 0.18, and it is most of a reef
#   mustard Orbicella, Porites           0.25 - 0.40
#   brain corals                         0.25 - 0.35
#   purple sea fans                      0.10 - 0.20, they are dark and thin
#   tan sea plumes                       0.20 - 0.30
HUE = {
    "low": (0.17, 0.165, 0.13),
    "stony": (0.38, 0.30, 0.12),
    "head": (0.34, 0.27, 0.13),
    "fan": (0.19, 0.12, 0.21),
    "plume": (0.28, 0.23, 0.13),
}
SHADES = (0.72, 1.0, 1.28)
KINDS = ("low", "stony", "head", "fan", "plume")


# Which of these kinds is confidently a stony coral, and so can be drawn from a
# scan of one. "low" is not on this list on purpose: tools/benthos calls a low
# grey lump "low" precisely because it cannot tell rock from Siderastrea, and
# drawing 58,000 uncertain lumps as a named coral would be asserting an
# identification the survey did not make.
FROM_A_SCAN = {"stony": "massive", "head": "brain"}

# And which can be drawn from the reef's coral library (tools/coral-library):
# the survey's kind, and the library's kind of the same growth form. "low" is
# left grown, for the reason above.
FROM_THE_LIBRARY = {"stony": "massive", "head": "brain", "fan": "fan", "plume": "plume"}


def _normalised(points, faces, np):
    """A scale of (w/2, w/2, h) gives a colony w across and h tall.

    Measured on what is above z = 0, and what is below z = 0 is kept. A grown
    prototype has nothing below; a scan has its buried base there, and dividing
    by the full span would shrink the colony by however much of the specimen is
    under the sand.
    """
    showing = points[:, 2] >= 0.0
    if showing.sum() < 3:
        showing = np.ones(len(points), dtype=bool)
    up = points[showing]
    span = max(float(np.ptp(up[:, 0])), float(np.ptp(up[:, 1])), 1e-3)
    tall = max(float(up[:, 2].max()), 1e-3)
    points = points / np.array([span / 2, span / 2, tall])
    points = points - np.array([points[showing, 0].mean(), points[showing, 1].mean(), 0.0])
    return points, faces


def grow(kind: str, rng):
    """One prototype of a kind, one metre tall, sitting on z = 0."""
    import numpy as np

    import coral

    if kind in ("low", "stony", "head"):
        points, faces = coral.massive(rng, height=1.0)
        if kind == "low":
            points = points * np.array([1.0, 1.0, 0.7])
    elif kind == "fan":
        points, faces = coral.fan(rng, height=1.0)
    else:
        points, faces = coral.plume(rng, height=1.0)
    points[:, 2] -= points[:, 2].min()
    return _normalised(points, faces, np)


def from_a_scan(kind: str, ref: pathlib.Path, which: int = 0):
    """The same prototype, taken off a museum scan instead of grown.

    Returns None where nobody has scanned this growth form, which is still true
    of the gorgonians: the Smithsonian has no CC0 3D scan of a sea fan or a sea
    plume, and those are the silhouette of this reef.

    `which` picks among the specimens of that form, so a reef stands several
    different colonies rather than several copies of one. A scan carries
    corallites and growth banding that no amount of noise on a blob produces;
    that is the whole difference between a colony and a painted stone, and it
    only shows once the water is out of the way.
    """
    import numpy as np

    import scanned

    have = scanned.found_in(ref).get(FROM_A_SCAN.get(kind) or "", [])
    if not have:
        return None
    points, faces = scanned.as_a_colony(have[which % len(have)], 1.0)
    return _normalised(points, faces, np)


def main() -> int:
    parse = argparse.ArgumentParser(description="write a surveyed reef into a place")
    parse.add_argument("place", help="the place directory (site.json, seabed.f32)")
    parse.add_argument("reference", help="the reference directory, with colonies.json")
    parse.add_argument("--seed", type=int, default=3)
    parse.add_argument("--assemblage", default="caribbean",
                       help="whose coral library the colonies are drawn from")
    parse.add_argument("--begin-depth", type=float, nargs=2, default=(6.0, 12.0),
                       metavar=("SHALLOW", "DEEP"),
                       help="the depth band a dive should begin in, metres")
    asked = parse.parse_args()

    import numpy as np

    place, ref = pathlib.Path(asked.place), pathlib.Path(asked.reference)
    site = json.loads((place / "site.json").read_text())
    listed = json.loads((ref / "colonies.json").read_text())
    colonies = listed["colonies"]
    if not colonies:
        raise SystemExit("the survey lists no colonies")
    field = site["mesh"]["heightfield"]
    heights = np.fromfile(place / field["file"], dtype="<f4").reshape(field["rows"], field["columns"])
    across = float(site["from"]["acrossMetres"])
    rng = np.random.default_rng(asked.seed)
    print(f"{site['name']}: {len(colonies):,} surveyed colonies")

    # ── prototypes: kind × shade × form ──────────────────────────────────────
    # Every prototype gets its own draw. The first version grew one shape per
    # kind and reused it across the three shades, so fifteen prototypes were
    # five shapes in three colours, and 58,000 instances of one lump is what a
    # field of painted stones looks like.
    #
    # Where a growth form has been scanned, both the scan and a grown shape are
    # kept and a colony picks between them. One specimen is one colony somebody
    # collected; a reef is variation, and sixty thousand copies of a museum
    # piece would be as wrong as sixty thousand blobs, in a way that is harder
    # to notice.
    # Where the reef's coral library has a kind, its colonies stand in for the
    # grown shape: made at the detail of a photograph, each with a colour at
    # every point. That colour keeps its pattern and is brought to this kind's
    # level and hue (HUE, times the shade), which is what this reef reflects.
    import coral_hd
    import reef
    library, library_dir = reef._library(asked.assemblage)
    prototypes, colours, index, scans = [], [], {}, 0
    kind_of, forms, painted, from_library = [], [], {}, 0
    for kind in KINDS:
        shelf = (library or {}).get("kinds", {}).get(FROM_THE_LIBRARY.get(kind, ""), [])
        for s, shade in enumerate(SHADES):
            # A different specimen for each shade, so the scans on a reef are
            # several colonies and not several copies of one.
            scan = from_a_scan(kind, ref, which=s)
            target = np.array([min(1.0, c * shade) for c in HUE[kind]])
            if shelf:
                shapes = []
                for entry in shelf[s::len(SHADES)]:
                    points, faces, per_point = coral_hd.read_ply(library_dir / entry["file"])
                    shapes.append((_normalised(points, faces, np),
                                   np.clip(per_point * target / np.maximum(per_point.mean(0), 1e-3), 0, 1),
                                   entry.get("corallite")))
            else:
                shapes = [(grow(kind, rng), None, reef.corallite_for(kind))]
            if scan is not None:
                shapes.append((scan, None, reef.corallite_for(kind)))
            index[(kind, s)] = []
            for shape, per_point, form in shapes:
                index[(kind, s)].append(len(prototypes))
                if per_point is not None:
                    painted[len(prototypes)] = per_point
                    from_library += 1
                prototypes.append(shape)
                kind_of.append(kind)
                forms.append(form)
                colours.append(tuple(target))
            scans += scan is not None
    if from_library:
        print(f"  prototypes from the {library['assemblage']} coral library: {from_library}")
    print(f"  prototypes: {len(prototypes)} over {len(KINDS)} kinds, "
          f"{scans} of them from scans ({', '.join(sorted(FROM_A_SCAN)) or 'none'})"
          if scans else f"  prototypes: {len(prototypes)}, none from scans")

    # ── every colony: which prototype, where, how big ────────────────────────
    kinds = np.array([c["kind"] for c in colonies])
    coin = rng.random(len(colonies)) < 0.5
    drawn = np.where(kinds == "octocoral", np.where(coin, "fan", "plume"), kinds)
    lum = np.array([np.mean(c["colour"]) if c.get("colour") else 0.5 for c in colonies])
    reference = float(np.median(lum[lum > 0])) if (lum > 0).any() else 0.5
    shade = np.clip(np.round((lum / max(reference, 1e-3) - 0.72) / 0.28), 0, 2).astype(int)
    # Which prototypes are the scan: the last form of any kind that has one.
    from_scans = np.array([choices[-1] for (kind, _), choices in index.items()
                           if kind in FROM_A_SCAN and from_a_scan(kind, ref) is not None],
                          dtype=int)
    # Which of the forms available for that kind and shade, chosen per colony so
    # that shape does not correlate with brightness.
    pick = rng.random(len(colonies))
    which = np.array([choices[min(len(choices) - 1, int(p * len(choices)))]
                      for choices, p in
                      ((index[(k, s)], p) for k, s, p in zip(drawn, shade, pick))])

    d = np.array([c["diameterM"] for c in colonies]); h = np.array([c["heightM"] for c in colonies])
    standing = np.isin(drawn, ("fan", "plume"))
    # A boulder is never taller than it is wide; a spur edge the detector
    # caught as a colony would otherwise stand as a pillar. Gorgonians do stand.
    sx = np.where(standing, np.maximum(d, 0.3) / 2, d / 2)
    sz = np.where(standing, np.clip(h * 1.6, 0.35, 1.4), np.clip(h, 0.04, 0.7 * np.maximum(d, 0.08)))
    x = np.array([c["x"] for c in colonies]); y = np.array([c["y"] for c in colonies])
    z = _floor(heights, across, x, y) - 0.02          # a little into the ground, no floating bases
    turn = rng.uniform(0, 2 * math.pi, len(colonies))

    # The surface of a coral at the scale of its polyps, and the material that
    # reads it. Both live with the place: a published package has to carry
    # everything it is drawn from.
    import corallite
    for form in sorted({f for f in forms if f}):
        made = corallite.write(form, place / "textures")
        print(f"  corallites: {form}, {made['corallliteMm']:.1f} mm, "
              f"{made['reliefMm']:.2f} mm of relief ({made['says']})")
    shutil.copy(pathlib.Path(__file__).resolve().parent.parent
                / "catalog" / "materials" / "coral_tissue.mdl",
                place / "coral_tissue.mdl")

    # The reef's framework, as tools/reef.py lays it, where the survey says
    # the reef is: the dead rock between the colonies, following their own
    # density. Not coral, and not in any cover figure here.
    framework, drawn_at = None, (prototypes, colours, kind_of, x, y, z, which, sx, sz, turn, forms, painted)
    if (library or {}).get("kinds", {}).get("rock"):
        share = _framework_share(heights, across, x, y, math.pi * sx * sx)
        laid = reef.lay_framework(share, heights, across, rng, library, library_dir)
        first = len(prototypes)
        drawn_at = (prototypes + laid["prototypes"], colours + laid["colours"],
                    kind_of + ["rock"] * len(laid["prototypes"]),
                    np.concatenate([x, laid["x"]]), np.concatenate([y, laid["y"]]), np.concatenate([z, laid["z"]]),
                    np.concatenate([which, first + laid["which"]]), np.concatenate([sx, laid["scale"]]),
                    np.concatenate([sz, laid["scale"]]), np.concatenate([turn, laid["turn"]]),
                    forms + [None] * len(laid["prototypes"]),
                    {**painted, **{first + k: c for k, c in laid["painted"].items()}})
        framework = {**laid["record"], "firstPrototype": first}
        print(f"  {laid['record']['pieces']:,} pieces of reef framework where the survey found reef")
    (place / "coral.usda").write_text(_instancer(*drawn_at))
    size = (place / "coral.usda").stat().st_size
    print(f"  coral.usda: {len(prototypes)} prototypes, {len(colonies):,} instances, {size / 1e6:.1f} MB")

    # ── where a dive begins: the densest surveyed reef in the working band ───
    begin = _begin(x, y, -_floor(heights, across, x, y), asked.begin_depth, across)
    picture = ref / "picture.jpg"
    if picture.exists():
        shutil.copy(picture, place / "picture.jpg")

    # What this reef covers, by the one definition — `reef.cover_over` — that
    # `tools/reef.py` and `tools/deliver` also use. A surveyed reef measured
    # its cover a different way from a grown one until now, which meant the
    # two could not be put in the same column of a table without somebody
    # quietly comparing a median of one-metre cells with a saturated mean.
    #
    # Here the colony areas are the survey's own: every one of these is a
    # circle of the diameter something was detected at.
    on_the_ground = math.pi * sx * sx
    # The reef this is cover of: the ground the survey actually flew.
    #
    # A grown place passes its habitat map; a surveyed one has no habitat map
    # because it has real detections instead, and the right denominator is the
    # extent of the survey. Looe Key's photogrammetry covers about an eighth
    # of the square kilometre the place is drawn over, and quoting cover over
    # the whole site would put it at a fifth of what its own transects say.
    flown = _how_much_was_flown(ref, across)
    measured = reef.cover_over(
        x, y, on_the_ground, across, ground_m2=flown,
        ground_is=("the ground the survey actually flew, which for this "
                   "release is about an eighth of the square kilometre the "
                   "place is drawn over. Nothing was planted here: every "
                   "colony is one the survey detected"))

    site["reef"] = {
        "source": listed.get("source"), "method": listed.get("method"),
        # This one *is* measured: every colony here is one the survey saw,
        # which is the whole difference between this tool and tools/reef.py.
        "cover": {
            "colonies": len(colonies),
            "perSquareKm": round(len(colonies) / max(1e-9, (across / 1000) ** 2)),
            "from": listed.get("source", "a survey of this reef"),
            "measured": True,
        },
        "colonies": len(colonies), "prototypes": len(prototypes),
        "kinds": {k: int((drawn == k).sum()) for k in KINDS},
        # What each prototype is, by its index in the instancer. Said rather
        # than left to be worked out: `reef.kinds` above is a *histogram* of
        # what the survey counted, and the first version of `tools/deliver`
        # read it as a list of growth forms and labelled every colony in a
        # published CSV "low" or "unknown".
        "prototypeKinds": list(kind_of) + (["rock"] * framework["prototypes"] if framework else []),
        "framework": framework,
        # And how to read a colony's scale, which is not the same on a
        # surveyed reef as on a grown one. Here the scale *is* the
        # measurement — the survey recorded a diameter for every colony and
        # the instancer carries half of it — so a colony inventory out of this
        # place has real sizes in it and may say so. A grown reef's scale is a
        # draw against a prototype and must not.
        "sizesAre": "surveyed",
        "sizesFrom": (listed.get("source")
                      or "the survey this reef was built from"),
        "coverWhereItGrows": round(measured["cover"], 5),
        "reefAreaM2": int(round(measured["reefGroundM2"])),
        "denseAreaM2": int(round(measured["thicketM2"])),
        "coverMeasuredBy": {
            "cellM": measured["cellM"],
            "over": measured["groundFrom"],
            "statistic": "all the colony area over all the surveyed ground, "
                         "saturated as 1 - exp(-A/G) because colonies are "
                         "scattered rather than tiled",
            "localCover": round(measured["localCover"], 5),
            "medianCover": round(measured["medianCover"], 5),
            "occupiedM2": int(round(measured["occupiedM2"])),
            "piledUp": round(measured["piledUp"], 5),
            # The number `tools/deliver` holds the published file against.
            # It has no threshold in it, which cover does, so it is the one
            # that can be checked rather than merely compared.
            "colonyAreaM2": round(measured["colonyAreaM2"], 1),
            "biggerThanACell": measured["biggerThanACell"],
        },
        # What the colonies are made of, so a place's page can say it rather
        # than leaving a reader to assume every shape here was invented.
        # Which prototypes are rooted and bend in the water. The gorgonians
        # are most of the silhouette of this reef and a still one looks
        # stuffed; the runtime rewrites their orientations as the surge goes
        # back and forth, and this is how it knows which they are.
        "swaysWith": {kind: sorted({i for i, k in enumerate(kind_of) if k == kind})
                      for kind in ("fan", "plume")},
        "fromLibrary": ({"prototypes": int(from_library), "path": str(library_dir),
                         "made": library.get("made"), "how": library.get("how"),
                         "colourIs": "the library colony's pattern, brought to HUE times the shade"}
                        if from_library else None),
        "fromScans": {"prototypes": int(scans),
                      "colonies": int(np.isin(which, from_scans).sum()),
                      "forms": sorted(set(FROM_A_SCAN.values())) if scans else []},
        "beginAt": begin,
    }
    # What lives here is tools/fauna's business, not this tool's. A
    # photogrammetric survey counts colonies and cannot count fish; an
    # observation record counts fish and says nothing about coral. Tying them
    # together here meant a place could only have fish if somebody had flown a
    # survey over it, which is how Al Fahal — the site two thirds of the dives
    # are in — had none.

    site["beginAt"] = begin["at"]
    site["beginBecause"] = ("the densest surveyed reef between %.0f and %.0f m, three metres off the bottom "
                            "(%d colonies within 10 m, %.1f m deep)"
                            % (asked.begin_depth[0], asked.begin_depth[1], begin["colonies"], begin["depthM"]))
    site["layers"]["coral"] = "coral.usda"
    if picture.exists():
        site["picture"] = "picture.jpg"
    built.record_call(site, "reef-survey")
    (place / "site.json").write_text(json.dumps(site, indent=2) + "\n")
    print(f"  begins at {begin['at']} — {site['beginBecause']}")
    print(f"  {place / 'site.json'}")
    return 0


def _framework_share(heights, across, x, y, area):
    """How much of each cell is dead framework, from the surveyed colonies:
    four times their own cover over a few metres around, at most 0.6, so the
    rock goes where the reef is and not onto the sand between spurs. Four,
    because a Florida reef is a few per cent living coral on hard bottom:
    at one and a half the spurs came out as sand. Chosen."""
    import numpy as np
    from scipy import ndimage

    rows, cols = heights.shape
    step = across / (cols - 1)
    j = np.clip(((x + across / 2) / step).astype(int), 0, cols - 1)
    i = np.clip(((y + across / 2) / step).astype(int), 0, rows - 1)
    covered = np.zeros(heights.shape)
    np.add.at(covered, (i, j), area)
    covered = ndimage.gaussian_filter(covered, max(1.0, 3.0 / step))
    return np.clip(4.0 * (1 - np.exp(-covered / (step * step))), 0.0, 0.6)


def _floor(heights, across, x, y):
    """Seabed height under each colony, bilinear off the place's own grid."""
    import numpy as np

    rows, cols = heights.shape
    fx = (x + across / 2) / (across / (cols - 1)); fy = (y + across / 2) / (across / (rows - 1))
    j = np.clip(np.floor(fx).astype(int), 0, cols - 2); i = np.clip(np.floor(fy).astype(int), 0, rows - 2)
    tx = np.clip(fx - j, 0, 1); ty = np.clip(fy - i, 0, 1)
    return ((heights[i, j] * (1 - tx) + heights[i, j + 1] * tx) * (1 - ty)
            + (heights[i + 1, j] * (1 - tx) + heights[i + 1, j + 1] * tx) * ty)


def _begin(x, y, depth, band, across):
    """The colony-densest point in the depth band, away from the edges, 3 m up."""
    import numpy as np

    cell = 10.0
    n = int(across / cell)
    ix = np.clip(((x + across / 2) / cell).astype(int), 0, n - 1)
    iy = np.clip(((y + across / 2) / cell).astype(int), 0, n - 1)
    ok = (depth >= band[0]) & (depth <= band[1])
    counts = np.zeros((n, n)); np.add.at(counts, (iy[ok], ix[ok]), 1)
    margin = int(0.1 * n)
    counts[:margin, :] = counts[-margin:, :] = counts[:, :margin] = counts[:, -margin:] = 0
    # Judged over a 30 m neighbourhood, so it is a good area and not one lucky cell.
    k = np.ones((3, 3)); smooth = np.zeros_like(counts)
    for dy in (-1, 0, 1):
        for dx in (-1, 0, 1):
            smooth += np.roll(np.roll(counts, dy, 0), dx, 1) * k[dy + 1, dx + 1]
    r, c = np.unravel_index(int(smooth.argmax()), smooth.shape)
    here = (ix == c) & (iy == r) & ok
    floor = float(np.median(-depth[here])) if here.any() else float(-np.median(depth[ok]))
    return {"at": [round(float(-across / 2 + (c + 0.5) * cell), 1), round(float(-across / 2 + (r + 0.5) * cell), 1),
                   round(float(floor + 3.0), 1)],
            "depthM": round(-floor, 1), "colonies": int(smooth[r, c])}


def _how_much_was_flown(ref, across: float) -> float | None:
    """How much ground the survey this reef came from actually covers.

    The reference keeps it: the photogrammetry is tiled and only some of the
    site has tiles. Without it there is no honest denominator for cover on a
    surveyed reef — the site is the wrong one, because most of a site nobody
    flew has no colonies for want of anybody having looked.
    """
    for name in ("seabed_1m.json", "seabed_1m_merged.json"):
        try:
            said = json.loads((ref / name).read_text())
        except Exception:
            continue
        share = said.get("surveyFraction") or said.get("surveyedFraction")
        if share:
            return float(share) * float(across) * float(across)
    return None


def _instancer(prototypes, colours, kind_of, x, y, z, which, sx, sz, turn, forms=None, painted=None) -> str:
    """The reef as one point instancer, in the shape the runtime already draws.
    A prototype in `painted` carries a colour at every point (a vertex
    displayColor, which coral_tissue.mdl reads); the rest carry their one."""
    import numpy as np

    import reef

    half = turn / 2.0
    orient = np.stack([np.cos(half), np.zeros_like(half), np.zeros_like(half), np.sin(half)], -1)
    grown = []
    painted = painted or {}
    for i, ((points, faces), colour) in enumerate(zip(prototypes, colours)):
        grown.append(
            '\n        def Mesh "Coral_%d" (\n'
            '            prepend apiSchemas = ["MaterialBindingAPI"]\n'
            "        )\n        {\n"
            '            uniform token subdivisionScheme = "none"\n'
            "            int[] faceVertexCounts = [%s]\n"
            "            int[] faceVertexIndices = [%s]\n"
            "            point3f[] points = [%s]\n"
            "            normal3f[] normals = [%s] (\n"
            '                interpolation = "vertex"\n'
            "            )\n"
            "            color3f[] primvars:displayColor = [%s] (\n"
            '                interpolation = "%s"\n'
            "            )\n"
            "            rel material:binding = </Coral/Skins/Skin_%d>\n"
            "        }\n" % (i, ", ".join(["3"] * len(faces)), ", ".join(str(v) for v in faces.reshape(-1)),
                             reef._triples(points), reef._triples(reef._smooth_normals(points, faces)),
                             reef._triples(painted[i]) if i in painted else "(%.3g, %.3g, %.3g)" % tuple(colour[:3]),
                             "vertex" if i in painted else "constant", i))
    return (
        "#usda 1.0\n(\n"
        '    doc = "Coral, where a survey saw it. Metres, Z up. Source in site.json."\n'
        '    defaultPrim = "Coral"\n    metersPerUnit = 1\n    upAxis = "Z"\n)\n\n'
        'def PointInstancer "Coral"\n{\n%s\n'
        "    point3f[] positions = [%s]\n    int[] protoIndices = [%s]\n"
        "    float3[] scales = [%s]\n    quath[] orientations = [%s]\n"
        "    rel prototypes = [%s]\n\n    def Scope \"Grown\"\n    {%s    }\n}\n" % (
            reef._skins(colours, kind_of, forms=forms),
            reef._triples(np.stack([x, y, z], -1)),
            ", ".join(str(int(i)) for i in which),
            reef._triples(np.stack([sx, sx, sz], -1)),
            ", ".join("(%.5g, %.5g, %.5g, %.5g)" % tuple(q) for q in orient),
            ", ".join("</Coral/Grown/Coral_%d>" % i for i in range(len(prototypes))),
            "".join(grown)))


