#!/usr/bin/env bash
# Build the platform's workflow images and report their content identities.
#
# A workflow image is named by its content — `sha256:…` — and never by a tag,
# because a tag can be moved and every version these produce names the image
# that produced it. Nothing is pushed: images reach hosts the same way the
# platform's own do, by being streamed over an existing connection.

set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "${script_directory}/.." && pwd)"
platform="${CORAL_CITY_WORKFLOW_PLATFORM:-}"

workflows=("$@")
if [ ${#workflows[@]} -eq 0 ]; then
    for path in "${repository_root}"/workflows/*/Dockerfile; do
        workflows+=("$(basename "$(dirname "${path}")")")
    done
fi

for workflow in "${workflows[@]}"; do
    dockerfile="${repository_root}/workflows/${workflow}/Dockerfile"
    if [ ! -f "${dockerfile}" ]; then
        echo "there is no workflow called ${workflow}" >&2
        exit 1
    fi

    echo "Building ${workflow}…" >&2
    docker buildx build \
      ${platform:+--platform "${platform}"} \
      --file "${dockerfile}" \
      --tag "coral-city/${workflow}:latest" \
      --load \
      "${repository_root}" >&2

    identity="$(docker image inspect --format '{{.Id}}' "coral-city/${workflow}:latest")"
    printf '%s %s\n' "${workflow}" "${identity}"
done
