#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

require_local() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'missing local command: %s\n' "$1" >&2
        return 1
    fi
    printf 'local %-12s ok\n' "$1"
}

require_local ssh
require_local git
require_local make

if command -v open >/dev/null 2>&1; then
    printf 'local %-12s ok\n' open
else
    printf 'local %-12s optional (used to open Foxglove)\n' open
fi

printf '\nremote GPU box\n'
"${SCRIPT_DIR}/gpu" '
set -e
printf "host: "
hostname
printf "docker: "
docker --version
printf "compose: "
docker compose version
printf "filesystem: "
df -h / | tail -n 1
printf "memory: "
free -h | awk "/^Mem:/ {print \$2 \" total, \" \$7 \" available\"}"
printf "gpus:\n"
nvidia-smi --query-gpu=index,name,memory.used,memory.free,utilization.gpu --format=csv,noheader
'
