#!/usr/bin/env bash
# Publish a directory as a package for a place or a vehicle.
#
# The bytes go to object storage addressed by their own digest, the manifest
# records what the package contains, and the version's digest is over the
# manifest — so pinning one digest pins every byte, and a node that already
# holds a file does not fetch it again.
#
# Nothing here trusts itself: every digest is computed from the file, the
# platform verifies what arrives against what was declared, and a version whose
# files were never uploaded is refused rather than recorded.
#
#   ./tools/publish city    mhl-tank  ./scene   [--label v1] [--publish]
#   ./tools/publish vehicle bluerov2  ./vehicle [--label v1] [--publish]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
[ -f "${REPO_ROOT}/.env" ] && { set -a; . "${REPO_ROOT}/.env"; set +a; }

API="${CORAL_CITY_API:-http://localhost:18080}"
KIND="${1:?say whether this is a city or a vehicle}"
SLUG="${2:?name the place or vehicle by its handle}"
SOURCE="${3:?give the directory to publish}"
shift 3

LABEL=""
PUBLISH=false
while [ $# -gt 0 ]; do
    case "$1" in
        --label) LABEL="$2"; shift 2 ;;
        --publish) PUBLISH=true; shift ;;
        *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
done

case "$KIND" in city|vehicle) ;; *) echo "kind is 'city' or 'vehicle'" >&2; exit 1 ;; esac
[ -d "$SOURCE" ] || { echo "not a directory: $SOURCE" >&2; exit 1; }

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
step() { printf '  %s\n' "$*"; }
die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

json() { python3 -c "
import json,sys
try: document = json.load(sys.stdin)
except Exception: print(''); raise SystemExit
try: print(document$1)
except Exception: print('')
"; }

TOKEN="${CORAL_CITY_TOKEN:-}"
if [ -z "$TOKEN" ]; then
    [ -n "${CORAL_CITY_ADMIN_EMAIL:-}" ] && [ -n "${CORAL_CITY_ADMIN_SECRET:-}" ] \
        || die "set CORAL_CITY_ADMIN_EMAIL and CORAL_CITY_ADMIN_SECRET, or CORAL_CITY_TOKEN"
    TOKEN=$(curl -sS -X POST "$API/api/v1/sessions" -H 'content-type: application/json' \
        -d "{\"email\":\"$CORAL_CITY_ADMIN_EMAIL\",\"secret\":\"$CORAL_CITY_ADMIN_SECRET\"}" \
        | json "['token']")
    [ -n "$TOKEN" ] || die "could not sign in"
fi

api() {
    local method="$1" path="$2" body="${3:-}"
    if [ -n "$body" ]; then
        curl -sS -X "$method" "$API$path" -H "Authorization: Bearer $TOKEN" \
            -H 'content-type: application/json' -d "$body"
    else
        curl -sS -X "$method" "$API$path" -H "Authorization: Bearer $TOKEN"
    fi
}

ORG=$(api GET /api/v1/me | json "['organisations'][0]['id']")
[ -n "$ORG" ] || die "you belong to no institution, and bytes are uploaded on behalf of one"

# The asset must already exist; publishing a package is not how a place is
# founded, because a package without a place to belong to is not a thing.
if [ "$KIND" = city ]; then
    ASSET=$(api GET /api/v1/cities | python3 -c "
import json,sys
for c in json.load(sys.stdin)['cities']:
    if c['slug'] == '$SLUG': print(c['id']); break
")
else
    ASSET=$(api GET /api/v1/vehicles | python3 -c "
import json,sys
for v in json.load(sys.stdin)['vehicles']:
    if v['slug'] == '$SLUG': print(v['id']); break
")
fi
[ -n "$ASSET" ] || die "no $KIND with the handle '$SLUG' is visible to you"

say "Reading $SOURCE"
FILES=$(cd "$SOURCE" && find . -type f -not -name '.DS_Store' | sed 's|^\./||' | sort)
[ -n "$FILES" ] || die "$SOURCE holds no files"
step "$(printf '%s\n' "$FILES" | wc -l | tr -d ' ') files"

media_type() {
    case "${1##*.}" in
        usd|usda|usdc|usdz) echo "model/vnd.usd" ;;
        png) echo "image/png" ;;
        jpg|jpeg) echo "image/jpeg" ;;
        exr) echo "image/x-exr" ;;
        json) echo "application/json" ;;
        yaml|yml) echo "application/yaml" ;;
        mdl) echo "text/plain" ;;
        *) echo "application/octet-stream" ;;
    esac
}

say "Uploading what the platform does not already hold"
MANIFEST_ENTRIES=""
UPLOADED=0
ALREADY=0
SEEN=""

while IFS= read -r relative; do
    absolute="$SOURCE/$relative"
    digest=$(shasum -a 256 "$absolute" 2>/dev/null | cut -d' ' -f1 \
             || sha256sum "$absolute" | cut -d' ' -f1)
    size=$(stat -f%z "$absolute" 2>/dev/null || stat -c%s "$absolute")
    media=$(media_type "$relative")

    grant=$(api POST "/api/v1/organisations/$ORG/uploads" \
        "{\"bucket\":\"evidence\",\"sha256\":\"$digest\",\"sizeBytes\":$size,\"mediaType\":\"$media\"}")
    grant_id=$(printf '%s' "$grant" | json "['id']")
    url=$(printf '%s' "$grant" | json "['uploadUrl']")
    [ -n "$url" ] \
        || die "no grant for $relative: $(printf '%s' "$grant" | head -c 220)"

    curl -sS -X PUT --upload-file "$absolute" -H "content-type: $media" "$url" >/dev/null \
        || die "could not upload $relative"

    # The platform hashes what arrived and refuses it if it is not what was
    # declared, so a corrupted upload is caught here rather than by whatever
    # tries to load the package later. The same bytes in the same bucket are
    # one object however many times they are sent, so re-publishing an
    # unchanged file costs the transfer and adds nothing to storage.
    object=$(api POST "/api/v1/organisations/$ORG/uploads/$grant_id/confirm" '{}')
    object_id=$(printf '%s' "$object" | json "['id']")
    [ -n "$object_id" ] \
        || die "the platform did not accept $relative: $(printf '%s' "$object" | head -c 220)"

    case "$SEEN" in
        *"$object_id"*) ALREADY=$((ALREADY + 1)) ;;
        *) UPLOADED=$((UPLOADED + 1)); SEEN="$SEEN $object_id" ;;
    esac

    MANIFEST_ENTRIES="${MANIFEST_ENTRIES}{\"path\":\"$relative\",\"digest\":\"$digest\",\"sizeBytes\":$size,\"mediaType\":\"$media\"},"
done <<< "$FILES"

step "$UPLOADED distinct objects, $ALREADY duplicate files sharing bytes already sent"

say "Recording the package"
BODY="{\"label\":\"${LABEL}\",\"files\":[${MANIFEST_ENTRIES%,}]}"
VERSION=$(api POST "/api/v1/${KIND}s/$ASSET/versions" "$BODY")
VERSION_ID=$(printf '%s' "$VERSION" | json "['id']")
[ -n "$VERSION_ID" ] \
    || die "the platform refused the package: $(printf '%s' "$VERSION" | head -c 300)"
step "version $(printf '%s' "$VERSION" | json "['ordinal']")  $VERSION_ID"
step "digest $(printf '%s' "$VERSION" | json "['digest']")"

if $PUBLISH; then
    say "Publishing"
    published=$(api POST "/api/v1/versions/$VERSION_ID/publish")
    if [ -n "$(printf '%s' "$published" | json "['publishedAt']")" ]; then
        step "published; anything may now pin it, and nothing may change it"
    else
        die "refused: $(printf '%s' "$published" | head -c 300)"
    fi
else
    printf '\nRecorded as a draft. Publish it with:\n'
    printf '  curl -X POST %s/api/v1/versions/%s/publish\n' "$API" "$VERSION_ID"
fi
