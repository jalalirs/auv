#!/usr/bin/env python3
"""A synthetic place made from a reef rebuilt out of a dive video.

    tools/video-reef REBUILT NAME [--across 80] [--most 1024] [--depth 8]
                     [--centre LAT LON] [--into ~/iocean/places]

REBUILT is an `iocean-reconstruct drm` output (seabed.npz, colonies.json,
patch/patch.json). The place is built from it, nothing else:

  the seabed   the rebuilt seabed where the video saw it, at its own size, in
               the middle of the square; past the edge of what was seen, the
               ground carried out from it and eased down to a plain, said to
               be constructed (make-site paints it as the sediment apron)
  the corals   every rebuilt colony as an instance of the coral library's
               colony it was fitted with: at its place, turned as it was
               turned, as wide and as tall as the rebuild made it (its height
               the measured one and the library's weighed together). Planted
               as instances rather than baked into one mesh, so they are drawn
               with the library's own surfaces, like any planted reef
  the water    Red Sea (Jerlov IB), chosen: the video is from the Red Sea

What is not known is said: where the video was filmed and how deep. The
square's position is a nominal one and its depth is chosen, and the place is
marked synthetic. The colonies' own surface pull (the few centimetres the
rebuild moved each library surface towards the points) is not carried: an
instance is the library's shape.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import shutil
import subprocess
import sys
import zipfile

import numpy as np

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))


def _fill(grid: np.ndarray, known: np.ndarray, rounds: int = 2000) -> np.ndarray:
    """Unknown cells taken from their known neighbours, outward, until none is left."""
    g, k = grid.copy(), known.copy()
    for _ in range(rounds):
        if k.all():
            break
        total, count = np.zeros_like(g), np.zeros_like(g)
        for dy, dx in ((0, 1), (0, -1), (1, 0), (-1, 0)):
            total += np.roll(np.roll(np.where(k, g, 0), dy, 0), dx, 1)
            count += np.roll(np.roll(k, dy, 0), dx, 1)
        fresh = ~k & (count > 0)
        g[fresh] = total[fresh] / count[fresh]
        k |= fresh
    return g


def _distance(known: np.ndarray, cell: float, most_m: float) -> np.ndarray:
    """How far each cell is from the known ones, in metres, up to `most_m`."""
    d = np.where(known, 0.0, np.inf)
    reach = known.copy()
    steps = int(np.ceil(most_m / cell))
    for k in range(1, steps + 1):
        grown = reach | np.roll(reach, 1, 0) | np.roll(reach, -1, 0) | np.roll(reach, 1, 1) | np.roll(reach, -1, 1)
        d[grown & ~reach] = k * cell
        reach = grown
    d[np.isinf(d)] = most_m
    return d


def _blur(g: np.ndarray, passes: int) -> np.ndarray:
    for _ in range(passes):
        acc = np.zeros_like(g)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                acc += np.roll(np.roll(g, dy, 0), dx, 1)
        g = acc / 9.0
    return g


def seabed(rebuilt: pathlib.Path, across: float, most: int, depth: float):
    """The place's heightfield (rows south to north, columns west to east), what
    of it was seen, and the offset from the rebuild's frame to the place's."""
    sb = np.load(rebuilt / "seabed.npz")
    h, lo, cell, n, seen = sb["height"], sb["lo"], float(sb["cell"]), sb["n"], sb["seen"]
    # The middle of what was seen is the middle of the place.
    rows, cols = np.where(seen)
    xs, ys = lo[0] + cols * cell, lo[1] + rows * cell
    origin = np.array([(xs.min() + xs.max()) / 2, (ys.min() + ys.max()) / 2])
    line = (np.arange(most) / (most - 1) - 0.5) * across
    gx, gy = np.meshgrid(line + origin[0], line + origin[1])
    fi, fj = (gy - lo[1]) / cell, (gx - lo[0]) / cell
    inside = (fi >= 0) & (fi <= n[1] - 1) & (fj >= 0) & (fj <= n[0] - 1)
    i0 = np.clip(np.floor(fi).astype(int), 0, n[1] - 2)
    j0 = np.clip(np.floor(fj).astype(int), 0, n[0] - 2)
    ti, tj = np.clip(fi - i0, 0, 1), np.clip(fj - j0, 0, 1)
    sampled = ((1 - ti) * (1 - tj) * h[i0, j0] + (1 - ti) * tj * h[i0, j0 + 1]
               + ti * (1 - tj) * h[i0 + 1, j0] + ti * tj * h[i0 + 1, j0 + 1])
    # Measured where a point fell within half a metre; the rest is constructed.
    near = seen.copy()
    for _ in range(int(np.ceil(0.5 / cell))):
        near = near | np.roll(near, 1, 0) | np.roll(near, -1, 0) | np.roll(near, 1, 1) | np.roll(near, -1, 1)
    measured = inside & near[np.clip(np.round(fi).astype(int), 0, n[1] - 1),
                             np.clip(np.round(fj).astype(int), 0, n[0] - 1)]
    # Opened: thin lines and specks of seen ground (one camera's stray points
    # far off the swim) are not ground anybody can stand a reef on, and left
    # in they dig pits and dashed trenches across the plain.
    step = across / (most - 1)
    k = max(1, int(round(0.4 / step)))
    measured = _grow(_shrink(measured, k), k) & measured
    shift = -depth - float(np.median(sampled[measured]))
    height = np.where(measured, sampled + shift, 0.0)
    # Past what was seen: the edge carried outward, eased over ten metres down
    # to a plain half a metre under the reef's middle depth.
    carried = _blur(_fill(height, measured), 4)
    plain = -depth - 0.5
    ease = np.clip(_distance(measured, step, 10.0) / 10.0, 0, 1)
    built = _blur(carried * (1 - ease) + plain * ease, 6)
    # And the seen ground feathered into it over its outer metre, so its edge
    # is a slope and not a wall.
    inward = np.clip(_distance(~measured, step, 1.0) / 1.0, 0, 1)
    height = np.where(measured, inward * height + (1 - inward) * built, built)
    return height.astype("<f4"), measured, origin, shift


def _grow(mask: np.ndarray, k: int) -> np.ndarray:
    for _ in range(k):
        mask = mask | np.roll(mask, 1, 0) | np.roll(mask, -1, 0) | np.roll(mask, 1, 1) | np.roll(mask, -1, 1)
    return mask


def _shrink(mask: np.ndarray, k: int) -> np.ndarray:
    return ~_grow(~mask, k)


def ground_colour(rebuilt: pathlib.Path, across: float, origin: np.ndarray, measured: np.ndarray,
                  size: int = 2048, as_seen: bool = False) -> np.ndarray:
    """The ground's colour as the video saw it, where it saw it: the rebuilt
    seabed's own vertex colours, the water's blue cast taken
    out by bringing their mean to carbonate sand's; elsewhere sand."""
    import coral_hd

    sb = np.load(rebuilt / "seabed.npz")
    n, lo, cell = sb["n"], sb["lo"], float(sb["cell"])
    # The seabed is the model's first n by n vertices, in grid order.
    _, _, colours = coral_hd.read_ply(rebuilt / "model.ply")
    c = np.asarray(colours, dtype=float)[: n[0] * n[1]].reshape(n[1], n[0], 3)
    if c.max() > 1.0:
        c = c / 255.0
    sand = np.array([0.74, 0.71, 0.62])
    seen = sb["seen"]
    if as_seen:
        # A place that carries its own light shows its ground as the camera
        # saw it, water and all: the cast is the point, not a fault.
        sand = c[seen].mean(0)
    else:
        c = c * (sand / np.maximum(c[seen].mean(0), 1e-3))
    line = (np.arange(size) / (size - 1) - 0.5) * across
    # Row 0 is the south edge here: make-site turns a ground map over on the
    # way in (a map's top is north, the mesh's v = 0 is south), and this one
    # is built in the mesh's own order.
    gx, gy = np.meshgrid(line + origin[0], line + origin[1])
    i = np.clip(np.round((gy - lo[1]) / cell).astype(int), 0, n[1] - 1)
    j = np.clip(np.round((gx - lo[0]) / cell).astype(int), 0, n[0] - 1)
    m = measured.shape[0]
    mi = np.clip(np.round((gy - origin[1] + across / 2) / (across / (m - 1))).astype(int), 0, m - 1)
    mj = np.clip(np.round((gx - origin[0] + across / 2) / (across / (m - 1))).astype(int), 0, m - 1)
    inside = measured[mi, mj]
    out = np.where(inside[..., None], np.clip(c[i, j], 0, 1), sand)
    # sRGB, as the renderer reads the file.
    enc = np.where(out <= 0.0031308, out * 12.92, 1.055 * np.power(out, 1 / 2.4) - 0.055)
    return (np.clip(enc, 0, 1) * 255).astype(np.uint8)


def plant(place: pathlib.Path, rebuilt: pathlib.Path, library: pathlib.Path, height: np.ndarray,
          across: float, origin: np.ndarray, shift: float) -> dict:
    """The rebuilt colonies as instances of their library colonies."""
    import corallite
    import reef as reef_tool

    told = json.loads((rebuilt / "colonies.json").read_text())
    colonies = told["colonies"]
    kinds = json.loads((library / "library.json").read_text())["kinds"]
    entry_of = {e["file"]: (kind, e) for kind, shelf in kinds.items() for e in shelf}
    files = sorted({c["file"] for c in colonies})
    prototypes, colours, kinds_of, surfaces, painted, tall = [], [], [], [], {}, []
    for i, f in enumerate(files):
        kind, entry = entry_of[f]
        points, faces, per_point = reef_tool._from_library(library / f, 1.0)     # one metre across, base at 0
        prototypes.append((points, faces))
        painted[i] = per_point
        colours.append(tuple(entry["colour"]))
        kinds_of.append(kind)
        surfaces.append((entry.get("corallite"), False))
        tall.append(max(float(points[:, 2].max()), 1e-3))
    index = {f: i for i, f in enumerate(files)}
    m = height.shape[0]
    cell = across / (m - 1)

    def floor(x, y):
        j = np.clip(np.round((x + across / 2) / cell).astype(int), 0, m - 1)
        i = np.clip(np.round((y + across / 2) / cell).astype(int), 0, m - 1)
        return height[i, j]

    x = np.array([c["centre"][0] for c in colonies]) - origin[0]
    y = np.array([c["centre"][1] for c in colonies]) - origin[1]
    wide = np.array([c["acrossM"] for c in colonies])
    # Standing on the drawn seabed: the lowest of its middle and four points
    # round it, so a colony on a slope is not left floating on its low side.
    ring = [floor(x, y)] + [floor(x + 0.4 * wide * np.cos(a), y + 0.4 * wide * np.sin(a))
                            for a in (0, np.pi / 2, np.pi, 1.5 * np.pi)]
    z = np.min(ring, axis=0) - 0.02
    which = np.array([index[c["file"]] for c in colonies])
    sz = np.array([c["heightM"] for c in colonies]) / np.array([tall[i] for i in which])
    turn = np.array([c["turnRad"] for c in colonies])
    for form in sorted({s for s, _ in surfaces if s}):
        corallite.write(form, place / "textures")
    shutil.copy(HERE.parent / "catalog" / "materials" / "coral_tissue.mdl", place / "coral_tissue.mdl")
    text = reef_tool._instancer(prototypes, colours, kinds_of, x, y, z, which, wide, turn, surfaces, painted)
    # Wide as the rebuild made it and as tall: not one scale for both.
    start = text.index("    float3[] scales = [")
    end = text.index("\n", start)
    text = text[:start] + "    float3[] scales = [%s]" % reef_tool._triples(np.stack([wide, wide, sz], -1)) + text[end:]
    (place / "coral.usda").write_text(text)
    by_class = {}
    for c in colonies:
        by_class[c["class"]] = by_class.get(c["class"], 0) + 1
    return {"colonies": len(colonies), "prototypes": len(files), "byClass": by_class,
            "x": x, "y": y, "z": z}


AS_SEEN = '''
        def Material "AsSeen"
        {
            token outputs:mdl:surface.connect = </World/Looks/AsSeen/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (%.4f, %.4f, %.4f)
                float inputs:reflection_roughness_constant = 1
                token outputs:out
            }
        }
'''


def as_seen(place: pathlib.Path) -> tuple[float, float, float]:
    """The ground's mean colour as the video saw it, linear."""
    from PIL import Image

    rgb = np.asarray(Image.open(place / "textures" / "site_colour.jpg").convert("RGB"), dtype=float) / 255.0
    seen = rgb.reshape(-1, 3)
    seen = seen[seen.sum(1) > 0.05]
    mean = np.median(seen, axis=0) if len(seen) else np.array([0.3, 0.6, 0.65])
    return tuple(float(v) for v in np.where(mean <= 0.04045, mean / 12.92, ((mean + 0.055) / 1.055) ** 2.4))


def _splat_site(place: pathlib.Path, drawn, told: dict, sink: float) -> dict:
    """The seabed under splats and what site.json says of them."""
    seabed = (place / "seabed.usda").read_text()
    # Where the splats are thin the seabed shows, and its own material (stock
    # hard and soft ground, lit by a sun with no water to take the red out)
    # came out as rust-coloured patches. With the light carried by the place,
    # the seabed shows the ground as the video saw it and is not lit: an
    # surface in one colour, the ground's as the video saw it on average, in
    # OmniPBR. (UsdPreviewSurface drew black in Isaac Sim 6.0.1, with a colour
    # map, an emissive or a diffuse colour: sharp black shapes in the dive.)
    # It cannot simply be
    # hidden: the NuRec volume draws nothing where there is no surface behind.
    if "AsSeen" not in seabed:
        seabed = seabed.replace("rel material:binding = </World/Looks/Seabed>",
                                "rel material:binding = </World/Looks/AsSeen>", 1)
        seabed = seabed.replace('def Scope "Looks"\n    {', 'def Scope "Looks"\n    {' + AS_SEEN % as_seen(place), 1)
    # Sunk as a mesh, not as /World: the place's stage is this file, and the
    # reef hangs under /World too, so lowering /World lowered the splats with
    # it and the seabed stayed exactly where it was against them.
    mesh = 'def Mesh "Seabed" (\n        prepend apiSchemas = ["MaterialBindingAPI"]\n    )\n    {'
    if mesh in seabed and "SeabedSunk" not in seabed:
        seabed = seabed.replace(mesh, mesh + '\n        # SeabedSunk\n        double3 xformOp:translate = (0, 0, %g)\n'
                                '        uniform token[] xformOpOrder = ["xformOp:translate"]' % -sink, 1)
    (place / "seabed.usda").write_text(seabed)
    site = json.loads((place / "site.json").read_text())
    site["reef"] = {"colonies": 0, "kind": "measured",
                    "from": ("the dive video itself, as Gaussian splats (3DGRUT): what the camera "
                             "saw, drawn as it saw it, with no colonies grown or planted"),
                    "splats": {"file": drawn, "fitResidualM": told.get("fitResidualMedianM")}}
    site["light"] = {"carriedByThePlace": True,
                     "why": ("the reef is splats trained on the video: they hold the light, the haze and the "
                             "camera's colour it was filmed with, so the water's own effects stay off"),
                     "drawnSeabedSunkM": sink}
    return site


def splat_reef(place: pathlib.Path, splats: list[pathlib.Path], align: pathlib.Path, sink: float,
               sorting: str = "cameraDistance", pieces: list[tuple[int, int]] | None = None) -> dict:
    """The reef as the video's splats: referenced from coral.usda in the
    place's frame, the drawn seabed lowered under them (it stays for what a
    vehicle stands on and to fill their holes), and the place said to carry
    its own light.

    Splats baked into the place's frame (ml/splat/bake_splats.py, align
    "baked": true) and exported as a NuRec volume are referenced as they are.
    That is the way that draws like the video: the same splats as a
    ParticleField under the place's transform came out dark and hazy in Isaac
    Sim 6 (12.8 dB against the video's held-back frames, where 3DGRUT's own
    render is 24.1), and as NuRec 17.7, at the video's brightness."""
    told = json.loads(align.read_text())
    baked = bool(told.get("baked"))
    if baked and len(splats) > 1:
        # Parts cut along the reef (ml/splat/split_splats.py) so each packages
        # under USD's 2 GB: one volume each, side by side, nothing between.
        drawn = []
        for i, part in enumerate(splats):
            shutil.copy(part, place / f"splats-{i}.usdz")
            drawn.append(f"splats-{i}.usdz")
        parts = "".join(f'''
        def Xform "Part{i}" (
            prepend references = @{name}@
        )
        {{
        }}
''' for i, name in enumerate(drawn))
        (place / "coral.usda").write_text(f'''#usda 1.0
(
    doc = "The reef as Gaussian splats trained on the dive video (3DGRUT, NuRec volumes in {len(drawn)} parts, baked into the place's frame). Metres, Z up."
    defaultPrim = "Coral"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Coral"
{{
    def Xform "Splats"
    {{{parts}    }}
}}
''')
        site = _splat_site(place, drawn, told, sink)
        if pieces:
            # Whole pieces, one drawn at a time: the one whose stretch of the
            # swim is nearest the camera (sim-runtime coral/splat_pieces.py).
            if len(pieces) != len(drawn):
                raise SystemExit(f"{len(drawn)} splat files but {len(pieces)} piece ranges")
            frames = sorted(told["frames"], key=lambda f: f["name"])
            site["reef"]["splats"]["pieces"] = [
                {"prim": f"Part{i}", "frames": [lo, hi],
                 "path": [[round(float(v), 3) for v in f["eye"]] for f in frames[lo - 1:hi:2]]}
                for i, (lo, hi) in enumerate(pieces)]
            site["reef"]["splats"]["drawn"] = "the piece nearest the camera, one at a time"
        return site
    if len(splats) > 1:
        raise SystemExit("several splat files only as baked NuRec parts")
    splats = splats[0]
    if splats.stat().st_size < 2**31 - 2**24:
        shutil.copy(splats, place / "splats.usdz")
        drawn = "splats.usdz"
    else:
        # USD reads a usdz only below 2 GB (the whole video's splats are 2.2):
        # a bigger one goes in unpacked, its stage beside its splats.
        with zipfile.ZipFile(splats) as z:
            z.extractall(place / "splats")
        drawn = "splats/default.usda"
    if baked:
        inside = ""
        kind = "3DGRUT, NuRec volume, baked into the place's frame"
    else:
        rows = ", ".join("(%s)" % ", ".join("%.9g" % v for v in r) for r in told["usdMatrix"])
        # rayHitDistance drew nothing at all in Isaac Sim 6.0.1.
        inside = f'''
        matrix4d xformOp:transform = ({rows})
        uniform token[] xformOpOrder = ["xformOp:transform"]

        over "gaussians"
        {{
            over "Gaussians"
            {{
                over "gaussians"
                {{
                    uniform token sortingModeHint = "{sorting}"
                }}
            }}
        }}'''
        kind = "3DGRUT ParticleField, in the place's frame"
    (place / "coral.usda").write_text(f'''#usda 1.0
(
    doc = "The reef as Gaussian splats trained on the dive video ({kind}). Metres, Z up."
    defaultPrim = "Coral"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Coral"
{{
    def Xform "Splats" (
        prepend references = @{drawn}@
    )
    {{{inside}
    }}
}}
''')
    return _splat_site(place, drawn, told, sink)


def main() -> int:
    ap = argparse.ArgumentParser(description="a synthetic place made from a reef rebuilt out of a dive video")
    ap.add_argument("rebuilt", type=pathlib.Path)
    ap.add_argument("name", help="the place's handle, e.g. red-sea-video-reef")
    ap.add_argument("--title", default="")
    ap.add_argument("--across", type=float, default=80.0)
    ap.add_argument("--most", type=int, default=1024)
    ap.add_argument("--depth", type=float, default=8.0, help="the reef's middle depth, chosen")
    ap.add_argument("--centre", nargs=2, type=float, default=(22.30, 38.85), metavar=("LAT", "LON"),
                    help="a nominal position: where the video was filmed is not known")
    ap.add_argument("--library", type=pathlib.Path,
                    default=pathlib.Path.home() / "iocean" / "coral-library" / "red-sea")
    ap.add_argument("--surfaces", type=pathlib.Path, help="a place whose textures/ hold the stock ground maps")
    ap.add_argument("--into", type=pathlib.Path, default=pathlib.Path.home() / "iocean" / "places")
    ap.add_argument("--splat-sorting", default="cameraDistance",
                    choices=["rayHitDistance", "cameraDistance", "zDepth"],
                    help="how the renderer orders splats along a ray (the export says cameraDistance)")
    ap.add_argument("--splats", type=pathlib.Path, nargs="+",
                    help="Gaussian splats trained on the video (3DGRUT USDZ; several when baked NuRec parts): the "
                         "reef is them instead of library colonies, and the place carries its own light")
    ap.add_argument("--splat-pieces", default="",
                    help="with several --splats: each one's frames, 1-based, as FIRST:LAST,FIRST:LAST,...; the "
                         "place then draws one piece at a time, the one trained nearest the camera")
    ap.add_argument("--splat-align", type=pathlib.Path,
                    help="the splats' transform into this place (align.json, usdMatrix), worked out with "
                         "the same rebuild")
    ap.add_argument("--sink", type=float, default=0.15,
                    help="with splats: how far under them the drawn seabed lies, so it fills their holes "
                         "without showing through")
    a = ap.parse_args()

    patch = json.loads((a.rebuilt / "patch" / "patch.json").read_text())
    height, measured, origin, shift = seabed(a.rebuilt, a.across, a.most, a.depth)
    ref = pathlib.Path.home() / "iocean" / "reference" / a.name
    ref.mkdir(parents=True, exist_ok=True)
    height.tofile(ref / "heights.f32")
    (ref / "constructed.bits").write_bytes(np.packbits(~measured.ravel()).tobytes())
    video = patch.get("video") or {}
    note = {
        "heightfield": {"file": "heights.f32", "rows": a.most, "columns": a.most},
        "acrossMetres": a.across,
        "centre": {"latitude": a.centre[0], "longitude": a.centre[1]},
        "surveyed": False,
        "source": ("rebuilt from a dive video: " + patch.get("tool", "") + "; scale " +
                   (patch.get("scale") or {}).get("from", "")),
        "method": ("the seabed DeepReefMap's points saw, as rebuilt by iocean-reconstruct drm, over "
                   f"{100 * float(measured.mean()):.1f}% of the square; its middle put at {a.depth:g} m, chosen"),
        "constructedPastTheSensor": {"mask": "constructed.bits",
                                     "how": "the seen seabed's edge carried outward and eased over 10 m to a "
                                            "plain half a metre under the reef's middle depth"},
    }
    (ref / "heights.json").write_text(json.dumps(note, indent=1) + "\n")
    print(f"  seabed: {100 * float(measured.mean()):.1f}% of the square seen; depth {-height.max():.1f} to "
          f"{-height.min():.1f} m")

    place = a.into / a.name
    if a.surfaces:
        (place / "textures").mkdir(parents=True, exist_ok=True)
        for one in (a.surfaces / "textures").glob("*.jpg"):
            if one.name.split("_")[0] in ("soft", "hard", "seabed"):
                shutil.copy(one, place / "textures" / one.name)
    ground = ref / "ground"
    ground.mkdir(exist_ok=True)
    from PIL import Image
    Image.fromarray(ground_colour(a.rebuilt, a.across, origin, measured, as_seen=bool(a.splats))).save(
        ground / "colour_4096.png")
    said_from = (f"rebuilt from {', '.join(video.get('videos', []))} ({video.get('source', '')}), "
                 f"{video.get('fromSeconds', '?')} to {video.get('toSeconds', '?')} s")
    subprocess.run([sys.executable, str(HERE / "make-site"), a.name, "--heights", str(ref / "heights.json"),
                    "--most", str(a.most), "--coral", "0", "--ground", str(ground),
                    "--cover-from", "the colonies a dive video saw, rebuilt (" + said_from + "), not grown",
                    "--assemblage", "red-sea",
                    "--assemblage-from", "the coral library's Red Sea colonies, each the one fitted to a colony "
                                         "of its class in the video (DeepReefMap's classes)",
                    "--water", "IB",
                    "--water-from", "chosen: the video is from the Red Sea; Jerlov IB as for the platform's "
                                    "other Red Sea places, not measured where it was filmed",
                    "--into", str(a.into)], check=True)
    if a.splats:
        ranges = [tuple(int(v) for v in r.split(":")) for r in a.splat_pieces.split(",") if r]
        site = splat_reef(place, a.splats, a.splat_align, a.sink, a.splat_sorting, ranges or None)
        planted = {"x": np.array([0.0]), "y": np.array([0.0]), "z": np.array([float(height[a.most // 2, a.most // 2])])}
    else:
        planted = plant(place, a.rebuilt, a.library, height, a.across, origin, shift)
        site = json.loads((place / "site.json").read_text())
    site["layers"]["coral"] = "coral.usda"
    site["reef"] = site.get("reef") if a.splats else {
        "colonies": planted["colonies"], "prototypes": planted["prototypes"], "byClass": planted["byClass"],
        "cover": {"from": "the colonies a dive video saw, rebuilt: " + said_from, "measured": False},
        "from": ("each colony found in the video (DeepReefMap's point cloud and classes), given the coral "
                 "library colony of its class, sized and turned to its points by iocean-reconstruct drm; "
                 "planted here as instances of those library colonies"),
        "kind": "derived",
        "fromLibrary": {"path": str(a.library)},
        "assemblage": {"name": "red-sea", "from": "the coral library's Red Sea colonies"},
    }
    if a.title:
        site["title"] = a.title
    # The ground's colour is the video's, not a survey's orthomosaic.
    if site.get("ground"):
        site["ground"]["colourFrom"] = ("the dive video's own colours on the rebuilt seabed, their blue cast "
                                        "taken out to carbonate sand's mean; sand past what it saw")
        site["ground"]["surveyed"] = False
    site["synthetic"] = {
        "is": True,
        "why": ("a place made for a reef rebuilt from a dive video: where the video was filmed and how deep are "
                "not known, so the position is nominal and the depth chosen"),
        "video": video, "scale": patch.get("scale"), "rebuilt": str(a.rebuilt),
        "seenShare": round(float(measured.mean()), 4),
    }
    # A dive begins at the start of the swim, three metres over the reef: on
    # the video's own first camera when the reef is its splats.
    if a.splats and a.splat_align:
        first = json.loads(a.splat_align.read_text())["frames"][0]["eye"]
        site["beginAt"] = [round(float(v), 2) for v in first]
        site["beginBecause"] = "where the video's camera was at its first frame"
    else:
        start_x = float(planted["x"].min()) + 2.0
        i = int(np.argmin(np.abs(planted["x"] - start_x)))
        site["beginAt"] = [round(start_x, 2), round(float(planted["y"][i]), 2),
                           round(float(planted["z"][i]) + 3.0, 2)]
        site["beginBecause"] = "the start of the swim the video was filmed on, three metres over the reef"
    (place / "site.json").write_text(json.dumps(site, indent=2) + "\n")
    subprocess.run([sys.executable, str(HERE / "aim-water"), str(place)], check=True)
    reef_said = ("the video's splats" if a.splats else
                 f"{planted['colonies']} colonies from {planted['prototypes']} library colonies")
    print(f"  {a.name}: {reef_said}; begins at {site['beginAt']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
