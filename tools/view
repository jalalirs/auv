#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${REPO_ROOT}/.env" ]; then
    set -a
    source "${REPO_ROOT}/.env"
    set +a
fi

RUNTIME_DIR="${REPO_ROOT}/.runtime"
CONTROL_SOCKET="${RUNTIME_DIR}/foxglove-ssh.sock"
GPU_HOST="${AUV_GPU_HOST:-jalalirs@100.76.65.1}"
LOCAL_PORT="${FOXGLOVE_LOCAL_PORT:-18765}"
REMOTE_PORT="${FOXGLOVE_REMOTE_PORT:-8765}"
FOXGLOVE_URL="foxglove://open?ds=foxglove-websocket&ds.url=ws://localhost:${LOCAL_PORT}/"
FOXGLOVE_WEB_URL="https://app.foxglove.dev/~/view?ds=foxglove-websocket&ds.url=ws%3A%2F%2Flocalhost%3A${LOCAL_PORT}"

tunnel_running() {
    [ -S "${CONTROL_SOCKET}" ] \
        && ssh -S "${CONTROL_SOCKET}" -O check "${GPU_HOST}" >/dev/null 2>&1
}

start_tunnel() {
    mkdir -p "${RUNTIME_DIR}"

    if tunnel_running; then
        printf 'Foxglove tunnel is already running on localhost:%s.\n' "${LOCAL_PORT}"
    else
        rm -f "${CONTROL_SOCKET}"
        if command -v lsof >/dev/null 2>&1 \
            && lsof -nP -iTCP:"${LOCAL_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
            printf 'Local port %s is already owned by another process:\n' "${LOCAL_PORT}" >&2
            lsof -nP -iTCP:"${LOCAL_PORT}" -sTCP:LISTEN >&2
            printf 'Set FOXGLOVE_LOCAL_PORT to a free port and retry.\n' >&2
            exit 1
        fi
        ssh -M -S "${CONTROL_SOCKET}" -fNT \
            -o ExitOnForwardFailure=yes \
            -L "${LOCAL_PORT}:127.0.0.1:${REMOTE_PORT}" \
            "${GPU_HOST}"
        printf 'Foxglove tunnel started on localhost:%s.\n' "${LOCAL_PORT}"
    fi

    printf 'Foxglove WebSocket: ws://localhost:%s\n' "${LOCAL_PORT}"
    if command -v open >/dev/null 2>&1; then
        if open -Ra 'Foxglove' >/dev/null 2>&1; then
            open "${FOXGLOVE_URL}"
        else
            printf 'Foxglove Desktop is not installed; opening the browser client.\n'
            printf 'Opening a direct Foxglove WebSocket connection.\n'
            open "${FOXGLOVE_WEB_URL}"
        fi
    fi
}

stop_tunnel() {
    if tunnel_running; then
        ssh -S "${CONTROL_SOCKET}" -O exit "${GPU_HOST}" >/dev/null
        printf 'Foxglove tunnel stopped.\n'
    else
        rm -f "${CONTROL_SOCKET}"
        printf 'Foxglove tunnel is not running.\n'
    fi
}

case "${1:-start}" in
    start)
        start_tunnel
        ;;
    stop)
        stop_tunnel
        ;;
    status)
        if tunnel_running; then
            printf 'Foxglove tunnel is running on localhost:%s.\n' "${LOCAL_PORT}"
        else
            printf 'Foxglove tunnel is not running.\n'
            exit 1
        fi
        ;;
    *)
        printf 'Usage: %s {start|stop|status}\n' "$0" >&2
        exit 2
        ;;
esac
