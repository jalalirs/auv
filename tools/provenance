#!/usr/bin/env python3
"""One page per place, saying what anybody actually measured.

    tools/provenance looe-key
    tools/provenance --all

Every number this platform produces already carries where it came from —
`site.json` says whether the ground was surveyed, what the cover was held
against, whether the colony budget could pay for the cover the map asked for,
which part of the seabed was built past a sensor's limit; `provenance.json`
says, column by column, whether anybody went and looked.

All of that is in files nobody reads. This is the page.

**Why it matters more than it sounds.** A cover figure that traces to a
transect is citable and one that came out of a pipeline is not, and most
simulators cannot tell you which they handed you. That distinction is the
thing a research customer buys, and it is worth nothing if the only way to
see it is to open four JSON files and know what they mean.

The page is deliberately plain and self-contained: no fonts to fetch, no
scripts, no styling that needs anything. It is meant to survive being emailed,
printed, and put in a slide.
"""

from __future__ import annotations

import argparse
import html
import json
import pathlib
import sys

# What a thing is, in one word, when it is not a measurement.
#
# These are the only three answers. "Derived" and "chosen" are not the same
# and the difference matters: derived is arithmetic on something real, chosen
# is a person deciding. A page that collapsed them would be doing exactly what
# this page exists to stop.
MEASURED, DERIVED, CHOSEN = "measured", "derived", "chosen"

INK = {MEASURED: "#1a6b2a", DERIVED: "#8a5a00", CHOSEN: "#8a2a2a"}
WASH = {MEASURED: "#e8f4ea", DERIVED: "#fbf1de", CHOSEN: "#f9e9e9"}


def a_row(what: str, kind: str, value: str, whence: str) -> dict:
    return {"what": what, "kind": kind, "value": value, "from": whence}


def about(site: dict, delivered: dict | None) -> list[dict]:
    """Every claim this place makes, and what kind of claim it is."""
    came = site.get("from") or {}
    reef = site.get("reef") or {}
    ground = site.get("ground") or {}
    cover = reef.get("cover") or {}
    rows = []

    # ── the ground ───────────────────────────────────────────────────────────
    surveyed = bool(came.get("surveyed"))
    rows.append(a_row(
        "The seabed", MEASURED if surveyed else DERIVED,
        f"{came.get('acrossMetres', 0):,.0f} m across at "
        f"{came.get('sampleMetres', 0)} m a sample",
        came.get("source") or ("a survey" if surveyed else
                               "constructed, not surveyed — this place says so")))

    fitted = came.get("fittedAgainst")
    if fitted:
        rows.append(a_row(
            "Its depths", MEASURED,
            f"RMS {fitted.get('rmsBeforeM')} m before, "
            f"{fitted.get('rmsAfterM')} m after, over "
            f"{fitted.get('points'):,} points",
            fitted.get("source", "")))

    built = came.get("constructedPastTheSensor")
    if built:
        rows.append(a_row(
            "Where the sensor went blind", CHOSEN,
            f"{100 * built.get('share', 0):.0f}% of the site, continued at "
            f"{built.get('gradient', {}).get('degrees', 0):.2f}° onto a shelf "
            f"at {built.get('shelfM')} m",
            built.get("shelfFrom", "")))

    # ── what it is made of ───────────────────────────────────────────────────
    knows = ground.get("knowsItsOwn") or ground.get("knowsPartOfItself")
    rows.append(a_row(
        "What the ground is made of",
        MEASURED if (ground.get("surveyed") or knows) else DERIVED,
        "habitat classes" if knows else "inferred from slope and relief",
        ground.get("hardnessFrom", "")))

    rows.append(a_row(
        "Its colour", MEASURED if ground.get("surveyed") else DERIVED,
        "an orthomosaic" if ground.get("surveyed") else "reflectances by depth",
        ground.get("colourFrom", "")))

    # ── the reef ─────────────────────────────────────────────────────────────
    rows.append(a_row(
        "How many colonies", MEASURED if cover.get("measured") else CHOSEN,
        f"{reef.get('colonies', 0):,}"
        + (f" ({cover['perSquareKm']:,} a km²)" if cover.get("perSquareKm") else ""),
        cover.get("from") or reef.get("source") or ""))

    if reef.get("sizesAre"):
        rows.append(a_row(
            "How big each one is",
            MEASURED if reef["sizesAre"] == "surveyed" else CHOSEN,
            reef["sizesAre"], reef.get("sizesFrom", "")))

    said = reef.get("coverMeasuredBy") or {}
    if reef.get("coverWhereItGrows") is not None:
        rows.append(a_row(
            "What it covers", DERIVED,
            f"{100 * reef['coverWhereItGrows']:.1f}% over "
            f"{reef.get('reefAreaM2', 0):,} m²",
            said.get("over", "") + (" — " + said["statistic"]
                                    if said.get("statistic") else "")))

    paid = reef.get("coverPaidFor")
    if paid and not paid.get("paid"):
        rows.append(a_row(
            "Whether it got the cover its map asked for", DERIVED,
            f"no — {paid.get('shortBy')}× short",
            f"{paid.get('coloniesNeeded'):,} colonies needed, "
            f"{paid.get('coloniesAsked'):,} given. {paid.get('why', '')}"))

    assemblage = reef.get("assemblage") or {}
    if assemblage.get("name"):
        rows.append(a_row(
            "Which shapes grow here", DERIVED,
            assemblage["name"], assemblage.get("from", "")))

    habitat = reef.get("habitatFrom") or {}
    if habitat and not habitat.get("believable", True):
        rows.append(a_row(
            "Is the habitat believable?", DERIVED, "no", habitat.get("why", "")))

    # ── the water ────────────────────────────────────────────────────────────
    water = site.get("water") or {}
    if water.get("type"):
        rows.append(a_row(
            "The water", MEASURED if water.get("from") else CHOSEN,
            f"Jerlov {water['type']}", water.get("from", "")))

    # ── and what was delivered out of it ─────────────────────────────────────
    if delivered:
        for name, said in (delivered.get("columns") or {}).items():
            rows.append(a_row(
                f"Column “{name}” in colonies.csv",
                MEASURED if said.get("measured") else DERIVED,
                "an observation" if said.get("measured") else "not an observation",
                said.get("from", "")))
    return rows


PAGE = """<!doctype html>
