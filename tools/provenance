PLACE_SAYS = """<p class="says"><strong>What this page is.</strong> Every number this place
carries, and whether anybody went and looked. A cover figure that traces to a
transect can be cited; one that came out of a pipeline cannot, and the
difference is not visible in a render. It is visible here.</p>"""

DIVE_SAYS = """<p class="says"><strong>What this page is.</strong> The water this dive was
flown in, claim by claim, and who said so. A run against a measured sea and a
run against an empty form both report a number for every field; only this says
which is which. Read the grey rows first — those are the ones nobody set.</p>"""

WORD = {
    MEASURED: "an instrument read it, at a stated instant.",
    DERIVED: "arithmetic on something real. Reproducible, not observed.",
    CHOSEN: "a person decided. The reasoning is beside it.",
    ASSUMED: "nobody said, so the runtime's own default stood in.",
}


def a_key(kinds) -> str:
    """The legend, carrying only the words this page actually uses."""
    return "\n  ".join(
        '<div><span class="tag" style="color:%s;background:%s">%s</span> %s</div>'
        % (INK[k], WASH[k], k, WORD[k]) for k in kinds)

ROW = """<tr><td class="what">%(what)s</td>
  <td><span class="tag" style="color:%(ink)s;background:%(wash)s">%(kind)s</span></td>
  <td class="value">%(value)s</td><td class="from">%(from)s</td></tr>"""


def page(site: dict, rows: list[dict]) -> str:
    centre = (site.get("from") or {}).get("centre") or {}
    where = []
    if centre:
        where.append("%.5f, %.5f" % (centre.get("latitude", 0),
                                     centre.get("longitude", 0)))
    if site.get("deepestM") is not None:
        where.append("%.1f to %.1f m deep" % (site.get("shallowestM", 0),
                                              site.get("deepestM", 0)))
    built = ((site.get("builtBy") or {}).get("make-site")
             or (site.get("builtBy") or {}).get("make-tank") or {}).get("at", "")
    return sheet(name=site.get("name", "a place"), where=" · ".join(where),
                 says=PLACE_SAYS, first="What", rows=rows,
                 kinds=(MEASURED, DERIVED, CHOSEN), whose="this place's",
                 built=built)


def sheet(name: str, where: str, says: str, first: str, rows: list[dict],
          kinds, whose: str, built: str) -> str:
    """One table of claims, however it was gathered. A place fills it from
    `site.json`; a dive fills it from what the runtime said it was flown in."""
    counted = ", ".join("%d %s" % (sum(1 for r in rows if r["kind"] == k), k)
                        for k in kinds if any(r["kind"] == k for r in rows))
    return PAGE % {
        "name": html.escape(name),
        "where": html.escape(where),
        "says": says,
        "key": a_key(kinds),
        "first": html.escape(first),
        "counted": html.escape(counted),
        "whose": html.escape(whose),
        "built": (" · " + html.escape(built)) if built else "",
        "rows": "\n  ".join(ROW % {
            "what": html.escape(r["what"]),
            "kind": r["kind"], "ink": INK[r["kind"]], "wash": WASH[r["kind"]],
            "value": html.escape(r["value"]),
            "from": html.escape(r["from"] or "—"),
        } for r in rows),
    }


