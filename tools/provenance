INDEX_ROW = """<tr>
  <td class="place"><a href="%(file)s">%(name)s</a><span>%(about)s</span></td>
  <td class="n">%(m)d</td><td class="n">%(d)d</td><td class="n">%(c)d</td>
  <td><span class="bar">%(bar)s</span></td></tr>"""


def index(places: list[dict]) -> str:
    """The table, which is the thing that goes in the slide.

    Sorted by how much of each place anybody actually measured, because that
    is the order somebody should read them in and because the honest answer
    to "which of these is real" is a ranking rather than a yes.
    """
    rows = []
    for one in sorted(places, key=lambda p: (-p["measured"], p["name"])):
        total = max(one["measured"] + one["derived"] + one["chosen"], 1)
        bar = "".join(
            '<i style="background:%s;width:%.1f%%"></i>' % (INK[kind], 100 * n / total)
            for kind, n in ((MEASURED, one["measured"]), (DERIVED, one["derived"]),
                            (CHOSEN, one["chosen"])) if n)
        rows.append(INDEX_ROW % {
            "file": html.escape(one["name"] + ".html"),
            "name": html.escape(one["name"]),
            "about": html.escape(one["about"]),
            "m": one["measured"], "d": one["derived"], "c": one["chosen"],
            "bar": bar,
        })
    return INDEX % {"count": len(places), "rows": "\n  ".join(rows)}


# ── a dive ───────────────────────────────────────────────────────────────────
#
# The same discipline, applied to a run rather than a place. The control plane
# has always known that conditions are either observed at an instant or
# constructed by a person, and it refuses the ones whose instant disagrees
# with their kind — but nothing showed that to anybody, and the runtime threw
# it away on the way in. A record that says 1025 kg/m3 whether a CTD measured
# it or the default stood in is not a record of what was flown.

# Field by field, what a reader would call it and how to write it down.
FIELDS = [
    ("currentMetresPerSecond", "current", "%.2f m/s"),
    ("currentHeadingDeg", "current heading", "%.0f° true"),
    ("visibilityM", "visibility", "%.1f m"),
    ("waterType", "water type", "Jerlov %s"),
    ("significantWaveHeightM", "wave height", "%.2f m significant"),
    ("waveMeanPeriodS", "wave period", "%.1f s"),
    ("temperatureC", "temperature", "%.1f °C"),
    ("salinityPsu", "salinity", "%.2f PSU"),
    ("densityKgM3", "density", "%.1f kg/m³"),
    ("depthGaugeDensityKgM3", "depth gauge set for", "%.1f kg/m³"),
]


# A field key as the table writes it, for when one claim has to name another.
READS_AS = {key: what for key, what, _ in FIELDS}


def written(shape: str, value) -> str:
    """The number as a person writes it, or the word for not having one."""
    if value is None:
        return "—"
    try:
        return shape % value
    except TypeError:
        return str(value)


def about_dive(came: dict, said: dict) -> list[dict]:
    """Every condition this dive was flown in, and who said so."""
    fields = came.get("fields") or {}
    rows = []
    for key, what, shape in FIELDS:
        told = fields.get(key)
        if told is None:
            continue
        how = told.get("how", ASSUMED)
        number = said.get(key)
        # A gauge nobody calibrated is reported only when it disagrees with
        # the water, which is exactly when it is absent here — and a blank
        # against "assumed" reads as a field with no value rather than one
        # that quietly took the water's own density.
        if key == "depthGaugeDensityKgM3" and number is None:
            number = said.get("densityKgM3")
        value = written(shape, number)
        if how == MEASURED:
            whence = str(told.get("from") or "an instrument")
            # The instant only when it is not the one already in the heading.
            # A buoy read at six and a satellite read at four are two claims;
            # eight rows all repeating the same timestamp are one, said eight
            # times, and it buries the rows that differ.
            if told.get("at") and told["at"] != came.get("observedAt"):
                whence += ", at %s" % told["at"]
            if told.get("through"):
                whence += ", through %s" % told["through"]
        elif how == DERIVED:
            # Named the way the table names them, not the way the JSON does.
            words = [READS_AS.get(one, one) for one in (told.get("fromFields") or [])]
            whence = "%s, from %s" % (told.get("by", "arithmetic"), " and ".join(words))
        elif how == ASSUMED:
            # The value is still printed, because it is what the dive was
            # flown in. What is added is that nobody asked for it.
            whence = "nobody said — %s" % told.get("instead", "the runtime's default")
        else:
            whence = "set on the dive"
        rows.append(a_row(what, how, value, whence))
    return rows


def a_dive(path: pathlib.Path) -> tuple[dict, dict, str]:
    """What a dive said about its own conditions, out of whatever it left.

    A log, because that is what a dive always leaves; a record, because that
    is what the control plane keeps. Either way the two halves are the same:
    the numbers, and where each of them came from.
    """
    text = path.read_text()
    if path.suffix == ".json":
        record = json.loads(text)
        said = record.get("conditions") or {}
        return said, said.get("cameFrom") or {}, record.get("name", path.stem)
    came, said, name = {}, {}, path.parent.name
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("event") == "conditions_from":
            said = event.get("were") or {}
            came = event.get("cameFrom") or {}
    return said, came, name


def dive_page(name: str, came: dict, rows: list[dict]) -> str:
    where = ["%s conditions" % came.get("kind", "constructed")]
    if came.get("observedAt"):
        where.append("as the sea was at %s" % came["observedAt"])
    return sheet(name=name, where=" · ".join(where), says=DIVE_SAYS,
                 first="Condition", rows=rows,
                 kinds=(MEASURED, DERIVED, CHOSEN, ASSUMED),
                 whose="the dive's", built="")


def one_line(site: dict) -> str:
    """What a place is, in the width of a table cell."""
    came = site.get("from") or {}
    reef = site.get("reef") or {}
    said = []
    if came.get("acrossMetres"):
        said.append("%.0f m across" % came["acrossMetres"])
    if came.get("sampleMetres"):
        metres = float(came["sampleMetres"])
        said.append("%.0f cm a sample" % (100 * metres) if metres < 1
                    else "%.1f m a sample" % metres)
    if reef.get("colonies"):
        said.append("%s colonies" % f"{reef['colonies']:,}")
    if site.get("deepestM") is not None:
        said.append("%.0f m deep" % site["deepestM"])
    return " · ".join(said)


def dive_of(path: pathlib.Path, root: pathlib.Path) -> int:
    """One page for one dive. Refuses a dive that never said, rather than
    drawing a page of assumptions and letting it pass for a record."""
    if not path.is_file():
        print(f"  no dive at {path}", file=sys.stderr)
        return 1
    said, came, name = a_dive(path)
    if not came.get("fields"):
        print(f"  {path} says nothing about where its conditions came from — "
              "it was flown before the runtime recorded that", file=sys.stderr)
        return 1
    rows = about_dive(came, said)
    into = root / "provenance"
    into.mkdir(parents=True, exist_ok=True)
    out = into / ("dive-%s.html" % name)
    out.write_text(dive_page(name, came, rows))
    counted = came.get("counted") or {}
    print("  %-18s %s → %s" % (
        name, ", ".join("%d %s" % (counted.get(k, 0), k)
                        for k in (MEASURED, DERIVED, CHOSEN, ASSUMED)), out))
    return 0


def main() -> int:
    parse = argparse.ArgumentParser(
        description="one page per place, saying what anybody measured")
    parse.add_argument("places", nargs="*")
    parse.add_argument("--all", action="store_true")
    parse.add_argument("--dive", metavar="PATH",
                       help="a dive's log or record, for the water it was flown in")
    parse.add_argument("--from", dest="root",
                       default=str(pathlib.Path.home() / "coral-city"))
    asked = parse.parse_args()

    root = pathlib.Path(asked.root).expanduser()
    if asked.dive:
        return dive_of(pathlib.Path(asked.dive).expanduser(), root)
    names = asked.places or (sorted(p.name for p in (root / "places").iterdir()
                                    if (p / "site.json").is_file())
                             if asked.all else [])
    if not names:
        print("name a place, or --all", file=sys.stderr)
        return 1

    into = root / "provenance"
    into.mkdir(parents=True, exist_ok=True)
    made = []
    for name in names:
        site_file = root / "places" / name / "site.json"
        if not site_file.is_file():
            print(f"  {name}: no site.json", file=sys.stderr)
            return 1
        site = json.loads(site_file.read_text())
        delivered = None
        said = root / "deliverables" / name / "provenance.json"
        if said.is_file():
            delivered = json.loads(said.read_text())
        rows = about(site, delivered)
        out = into / f"{name}.html"
        out.write_text(page(site, rows))
        counted = {k: sum(1 for r in rows if r["kind"] == k)
                   for k in (MEASURED, DERIVED, CHOSEN)}
        print(f"  {name:<18} {counted[MEASURED]:2d} measured, "
              f"{counted[DERIVED]:2d} derived, {counted[CHOSEN]:2d} chosen "
              f"→ {out}")
        made.append({"name": name, "about": one_line(site),
                     "measured": counted[MEASURED], "derived": counted[DERIVED],
                     "chosen": counted[CHOSEN]})

    if len(made) > 1:
        front = into / "index.html"
        front.write_text(index(made))
        print(f"\n  {len(made)} places → {front}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
