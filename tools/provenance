%(built)s</footer>
"""

ROW = """<tr><td class="what">%(what)s</td>
  <td><span class="tag" style="color:%(ink)s;background:%(wash)s">%(kind)s</span></td>
  <td class="value">%(value)s</td><td class="from">%(from)s</td></tr>"""


def page(site: dict, rows: list[dict]) -> str:
    centre = (site.get("from") or {}).get("centre") or {}
    where = []
    if centre:
        where.append("%.5f, %.5f" % (centre.get("latitude", 0),
                                     centre.get("longitude", 0)))
    if site.get("deepestM") is not None:
        where.append("%.1f to %.1f m deep" % (site.get("shallowestM", 0),
                                              site.get("deepestM", 0)))
    built = ((site.get("builtBy") or {}).get("make-site")
             or (site.get("builtBy") or {}).get("make-tank") or {}).get("at", "")
    counted = ", ".join(
        "%d %s" % (sum(1 for r in rows if r["kind"] == k), k)
        for k in (MEASURED, DERIVED, CHOSEN)
        if any(r["kind"] == k for r in rows))
    return PAGE % {
        "name": html.escape(site.get("name", "a place")),
        "where": html.escape(" · ".join(where)),
        "mi": INK[MEASURED], "mw": WASH[MEASURED],
        "di": INK[DERIVED], "dw": WASH[DERIVED],
        "ci": INK[CHOSEN], "cw": WASH[CHOSEN],
        "counted": html.escape(counted),
        "built": html.escape(built),
        "rows": "\n  ".join(ROW % {
            "what": html.escape(r["what"]),
            "kind": r["kind"], "ink": INK[r["kind"]], "wash": WASH[r["kind"]],
            "value": html.escape(r["value"]),
            "from": html.escape(r["from"] or "—"),
        } for r in rows),
    }


def main() -> int:
    parse = argparse.ArgumentParser(
        description="one page per place, saying what anybody measured")
    parse.add_argument("places", nargs="*")
    parse.add_argument("--all", action="store_true")
    parse.add_argument("--from", dest="root",
                       default=str(pathlib.Path.home() / "coral-city"))
    asked = parse.parse_args()

    root = pathlib.Path(asked.root).expanduser()
    names = asked.places or (sorted(p.name for p in (root / "places").iterdir()
                                    if (p / "site.json").is_file())
                             if asked.all else [])
    if not names:
        print("name a place, or --all", file=sys.stderr)
        return 1

    into = root / "provenance"
    into.mkdir(parents=True, exist_ok=True)
    for name in names:
        site_file = root / "places" / name / "site.json"
        if not site_file.is_file():
            print(f"  {name}: no site.json", file=sys.stderr)
            return 1
        site = json.loads(site_file.read_text())
        delivered = None
        said = root / "deliverables" / name / "provenance.json"
        if said.is_file():
            delivered = json.loads(said.read_text())
        rows = about(site, delivered)
        out = into / f"{name}.html"
        out.write_text(page(site, rows))
        counted = {k: sum(1 for r in rows if r["kind"] == k)
                   for k in (MEASURED, DERIVED, CHOSEN)}
        print(f"  {name:<18} {counted[MEASURED]:2d} measured, "
              f"{counted[DERIVED]:2d} derived, {counted[CHOSEN]:2d} chosen "
              f"→ {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
