#!/usr/bin/env python3
"""Fetch a data release, and know whether it worked.

    tools/fetch-release ~/iocean/reference/looe-key/usgs
    tools/fetch-release ~/iocean/reference/looe-key/usgs --only DEM

`tools/reference` lists a USGS release and writes `files.json` with every
file's name, URL and **exact byte count**, then generates a shell script to
fetch them:

    [ -s NAME ] || curl -sL --retry 3 -o NAME URL

That line is why this tool exists. `-s` is true of any file that is not empty,
so a download interrupted halfway leaves a file the script will never touch
again; there is no resume and no check afterwards. Looe Key's release came out
of it with three of its eight elevation models truncated and three never
fetched at all — and every one of them the right kind of size in a listing,
raising only on the first read, months later, when somebody tried to build a
place from one.

A tool that cannot do its job must fail rather than report. This one knows
what each file should weigh, resumes what is part-way, refuses to call a
short file done, and exits non-zero if anything is still wrong when it stops.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import subprocess
import sys

# How many times to come back to a file that is still short. A large transfer
# over a long link drops; that is ordinary and is what resuming is for.
TRIES = 4


def wanted(where: pathlib.Path, only: str | None) -> list[dict]:
    """Every file in the manifest, with what it should weigh."""
    said = json.loads((where / "files.json").read_text())
    files = said if isinstance(said, list) else (
        said.get("files") or said.get("items") or [])
    out = []
    for one in files:
        name = one.get("name")
        size = one.get("bytes") or one.get("size")
        url = one.get("url")
        if not (name and url and size):
            continue
        if only and only not in name:
            continue
        out.append({"name": name, "url": url, "bytes": int(size)})
    return out


def size(n: int) -> str:
    """Bytes in a unit that shows them.

    Everything was printed in GB to two places, so a 3 KB metadata file and a
    4 MB one both read "0.00 of 0.00 GB" — which says a file is missing when
    it is there, and says nothing at all about how big it should be.
    """
    for unit, each in (("GB", 1e9), ("MB", 1e6), ("kB", 1e3)):
        if n >= each:
            return f"{n / each:.2f} {unit}"
    return f"{n} B"


def state_of(where: pathlib.Path, one: dict) -> tuple[str, int]:
    here = where / one["name"]
    got = here.stat().st_size if here.is_file() else 0
    if got == one["bytes"]:
        return "complete", got
    if got == 0:
        return "missing", 0
    if got > one["bytes"]:
        # Longer than the manifest says is not "done": it is a different file,
        # or a resume that appended to something. Either way it is not this.
        return "too long", got
    return "part way", got


def start_again(here: pathlib.Path, one: dict, got: int, say) -> None:
    """Put a spoiled part-file aside, so the next try starts from nothing."""
    spoiled = here.with_suffix(here.suffix + ".too-long")
    if spoiled.exists():
        spoiled.unlink()
    here.rename(spoiled)
    say(f"    {one['name']}: {size(got)} against {size(one['bytes'])} wanted "
        f"— moved to {spoiled.name} and fetched from the start")


def fetch(where: pathlib.Path, one: dict, say=print) -> tuple[str, int]:
    """Get one file to its stated size, resuming whatever is there.

    `curl -C -` continues from the end of what exists, which is the whole
    difference between this and the script it replaces.

    Resuming is only safe while the server honours a range. USGS's does not
    always: asked to continue a Looe Key elevation model from 0.46 GB it sent
    the whole body again, curl appended it, and the file passed 0.77 GB on
    its way to 1.07 — at which point every further try resumed *that*, and
    four tries in a row made it worse. So the length is checked after every
    try, not only before the first, and a file that has overshot is put aside
    and fetched from nothing. There is no continuing from a file that is not
    a short copy of the right one.
    """
    here = where / one["name"]
    kind, got = state_of(where, one)
    if kind == "complete":
        return kind, got
    if kind == "too long":
        start_again(here, one, got, say)
        got = 0
    for attempt in range(1, TRIES + 1):
        before = got
        done = subprocess.run(
            ["curl", "-sL", "-C", "-", "--retry", "3", "--retry-delay", "2",
             "-A", "iocean (https://github.com/jalalirs/auv)",
             "-o", str(here), one["url"]])
        kind, got = state_of(where, one)
        if kind == "complete":
            return kind, got
        say(f"    {one['name']}: {size(got)} of {size(one['bytes'])} "
            f"after try {attempt}"
            + (f" (curl exit {done.returncode})" if done.returncode else ""))
        if kind == "too long":
            start_again(here, one, got, say)
            got = 0
            continue
        if done.returncode == 0 and got == before > 0:
            # curl is content and the part-file did not grow: the far end is
            # not resuming, it is answering the range with nothing. Asking
            # again the same way gets the same nothing.
            #
            # Only when there was something to resume. A fetch from nothing
            # that returns nothing is a server having a bad minute, and the
            # answer to that is to ask it again.
            start_again(here, one, got, say)
            got = 0
    # Read again rather than reporting what the last try saw: a try that
    # ended by putting a spoiled file aside leaves nothing there, and saying
    # "too long" about a file that is no longer on disk is a report of a
    # state the caller cannot act on.
    return state_of(where, one)


class Uncheckable(Exception):
    """This reader cannot decode that file — which says nothing about the file."""


def a_reader():
    """Something that can open a GeoTIFF, or nothing.

    `rasterio` for preference and `tifffile` after it, because the second is pure
    Python and handles BigTIFF — which every one of these is, at 40000 × 40000 — and
    a box with no GDAL stack is the ordinary case rather than the exception.
    """
    try:
        import rasterio

        def read(path):
            with rasterio.open(path) as source:
                source.read(1, window=((0, 2), (0, 2)))
        return "rasterio", read
    except ImportError:
        pass
    try:
        import tifffile

        def read(path):
            with tifffile.TiffFile(path) as source:
                page = source.pages[0]
                try:
                    page.asarray(maxworkers=1)[:2, :2]
                except ValueError as exc:
                    # "requires the 'imagecodecs' package" is this reader saying it
                    # has no codec, not the file saying it is broken. Every one of
                    # these DEMs is LZW, and reporting eight good rasters as corrupt
                    # because the decoder is missing is worse than not checking: it
                    # sends somebody re-fetching 9 GB that was already here.
                    if "imagecodecs" in str(exc):
                        raise Uncheckable(str(exc)) from exc
                    raise
        return "tifffile", read
    except ImportError:
        return None, None


def opens(where: pathlib.Path, name: str, read=None) -> bool:
    """Whether a raster will actually read, not merely weigh the right amount.

    The size check is the cheap one and catches every truncation. This catches the
    rest: a file that arrived whole and is corrupt anyway.

    It used to return True when no reader was installed — silently, on the
    reasoning that "a fetcher that refuses to run without a GIS stack is a fetcher
    nobody runs". That reasoning is still right and the silence was not: the box has
    no GDAL, so every raster passed without being read, and this tool printed **"all
    13 complete, and every raster among them opens"** having opened none of them.
    That sentence was then quoted in the plan as the reason to trust the fetch. It
    says what it actually did now.
    """
    if not name.lower().endswith((".tif", ".tiff")):
        return True
    if read is None:
        return True
    try:
        read(where / name)
        return True
    except Uncheckable:
        # Not read, and not condemned either.
        return True
    except Exception as exc:
        # The same judgement, wherever the reader came from: a decoder saying it
        # lacks a codec is not the file saying it is broken. Made here rather than
        # only inside the reader, so swapping the reader cannot lose it.
        if "imagecodecs" in str(exc) or "requires the" in str(exc):
            raise Uncheckable(str(exc)) from exc
        return False


def main() -> int:
    parse = argparse.ArgumentParser(
        description="fetch a data release, and know whether it worked")
    parse.add_argument("where", help="a directory holding files.json")
    parse.add_argument("--only", default=None,
                       help="only files whose name contains this")
    parse.add_argument("--check", action="store_true",
                       help="say what is there and fetch nothing")
    asked = parse.parse_args()

    where = pathlib.Path(asked.where).expanduser()
    if not (where / "files.json").is_file():
        print(f"no files.json in {where}: nothing says what should be here",
              file=sys.stderr)
        return 1

    files = wanted(where, asked.only)
    if not files:
        print("nothing in the manifest matches", file=sys.stderr)
        return 1

    short = [f for f in files if state_of(where, f)[0] != "complete"]
    # What is actually still to come down. A file that overshot owes its
    # whole size, because it is going to be thrown away and fetched again —
    # counting it as bytes-already-there made the total negative, and a
    # release that says it owes minus three hundred megabytes is not saying
    # anything.
    owed = sum(f["bytes"] if state_of(where, f)[0] == "too long"
               else f["bytes"] - state_of(where, f)[1] for f in short)
    print(f"  {where}")
    print(f"    {len(files)} files in the manifest, {len(short)} not complete, "
          f"{size(owed)} owed")

    if asked.check:
        for one in files:
            kind, got = state_of(where, one)
            print(f"    {one['name']:<40} {size(got):>9} of "
                  f"{size(one['bytes']):>9}  {kind}")
        return 0

    for one in short:
        kind, got = state_of(where, one)
        print(f"    {one['name']} — {kind}, {size(got)} of {size(one['bytes'])}")
        fetch(where, one)

    # And say, at the end, what is actually there — because the thing this
    # replaces did not.
    reader, read = a_reader()
    wrong = []
    rasters = uncheckable = 0
    for one in files:
        kind, got = state_of(where, one)
        if kind != "complete":
            wrong.append((one["name"], f"{kind}, {got:,} of {one['bytes']:,}"))
            continue
        if one["name"].lower().endswith((".tif", ".tiff")) and read is not None:
            rasters += 1
        try:
            good = opens(where, one["name"], read)
        except Uncheckable:
            good = True
            uncheckable += 1
        if not good:
            wrong.append((one["name"], "the right size and it does not open"))
    print()
    if wrong:
        print(f"  {len(wrong)} of {len(files)} are still wrong:", file=sys.stderr)
        for name, why in wrong:
            print(f"    {name}: {why}", file=sys.stderr)
        return 1
    # Said exactly, because the version of this that said "every raster among them
    # opens" whether or not one had been read is how a fetch came to be trusted on
    # a check that never ran.
    if read is None:
        print(f"  all {len(files)} complete. **No raster was opened** — neither "
              "rasterio nor tifffile is installed here, so only the sizes were "
              "checked. `pip install tifffile` to read them.")
    else:
        said = (f"  all {len(files)} complete, and every one of the {rasters} rasters "
                f"among them opens ({reader}).")
        if uncheckable:
            said = (f"  all {len(files)} complete. {rasters - uncheckable} of "
                    f"{rasters} rasters open ({reader}); the other {uncheckable} "
                    f"this reader has no codec for, which says nothing about them. "
                    "`pip install imagecodecs` to read those too.")
        print(said)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
