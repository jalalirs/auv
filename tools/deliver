#!/usr/bin/env python3
"""Turn a place into the things a marine department actually asks for.

    tools/deliver ~/coral-city/places/looe-key

A score and a video is not a deliverable. What a reef scientist asks for is a
colony inventory they can open in a spreadsheet, points they can drop on a
map, and a coverage raster they can put under their own layers — with a
coordinate system, so that "this colony" means a place on the Earth and not a
pixel in somebody's render.

**The georeference is exact, not approximate.** Every place here was built by
sampling a raster around a centre latitude and longitude at a stated number of
metres a degree, so a colony at x metres east of the centre is at a longitude
this can compute by inverting the very expression that put it there. It is
the same arithmetic, run backwards, and `provenance.json` writes it out so
that anybody can check it without reading this file.

**And every column says whether it was measured.** A deliverable that does not
distinguish a surveyed cover figure from a grown one is exactly the thing that
gets cited back as though the model had measured it. Looe Key's colony *count*
comes from a CREMP transect; its colony *positions* do not — they are a draw
from a cover map, and a CSV that lets somebody map an individual colony and
go and look for it is a CSV that has to say so on every row.

What comes out:

  colonies.csv       every colony: where, how deep, what shape, how big
  colonies.geojson   the same points, in WGS84, which is what GeoJSON is
  cover.asc          coverage as a real raster — ESRI ASCII grid, no GDAL
  cover.prj          what its coordinates mean
  provenance.json    what each field is, and whether anybody measured it
"""

from __future__ import annotations

import argparse
import csv
import json
import math
import pathlib
import re
import sys

import numpy as np


def metres_per_degree(latitude: float) -> tuple[float, float]:
    """The same expression `tools/make-site` sampled the bathymetry with.

    Copied rather than imported, and that is deliberate: this is the inverse
    of a transform, and a transform whose forward and backward halves share an
    implementation cannot be checked by comparing them. `test_deliver.py`
    holds the two against each other and would not if they were one function.
    """
    radians = math.radians(latitude)
    north = 111_132.92 - 559.82 * math.cos(2 * radians) + 1.175 * math.cos(4 * radians)
    east = 111_412.84 * math.cos(radians) - 93.5 * math.cos(3 * radians)
    return east, north


def where_on_earth(centre: dict, x: float, y: float) -> tuple[float, float]:
    """Site-local metres back to latitude and longitude.

    x is east and y is north of the centre, which is how every place on this
    platform is laid out: the origin is the middle of the site.
    """
    east, north = metres_per_degree(float(centre["latitude"]))
    return (float(centre["latitude"]) + y / north,
            float(centre["longitude"]) + x / east)


def colonies_of(place: pathlib.Path) -> dict:
    """Read the reef out of the place's own USD.

    Parsed rather than opened with USD, because this tool has to run anywhere
    a spreadsheet does and pulling in the whole of OpenUSD to read four arrays
    out of a text file is not a dependency worth having. The file is written
    by `tools/reef.py` in this repository and its shape is known.
    """
    text = (place / "coral.usda").read_text()

    def array(name: str):
        found = re.search(rf"{name} = \[(.*?)\]\n", text, re.S)
        return "" if found is None else found.group(1)

    points = [tuple(float(v) for v in one.split(","))
              for one in re.findall(r"\(([^)]*)\)", array("point3f\\[\\] positions"))]
    which = [int(v) for v in array(r"int\[\] protoIndices").replace("\n", "").split(",")
             if v.strip()]
    scales = [tuple(float(v) for v in one.split(","))
              for one in re.findall(r"\(([^)]*)\)", array("float3\\[\\] scales"))]
    return {"at": points, "which": which, "scale": scales}


def prototypes_in(site: dict) -> tuple[list[str], list[float]]:
    """What each prototype is, and what one of them covers at scale one.

    Read out of the place's own record, because the place says. The first
    version of this worked both out from the USD — the prototype index was
    assumed to be `kind * variants + variant` and the names were taken from
    `reef.kinds`, which on a surveyed place is a *histogram* of what the
    survey counted and not a list of growth forms. Every row of the CSV came
    out labelled "low" or "unknown" and every footprint was a hundred times
    too small, and neither showed up as an error: they showed up as a reef
    with no cover on it.

    A file that has to be reverse-engineered by the tool that ships it is a
    file that will be reverse-engineered wrong, so `tools/reef.py` writes both
    down and this refuses a place that does not have them.
    """
    reef = site.get("reef", {})
    kinds = reef.get("prototypeKinds")
    if not kinds:
        raise SystemExit(
            f"{site.get('name')} does not say what its prototypes are. It was "
            f"built before the reef recorded them; build it again with "
            f"tools/rebuild and the record will have them.")
    areas = reef.get("prototypeAreaM2")
    return list(kinds), None if not areas else [float(one) for one in areas]


# What a coverage raster is drawn at, in metres a cell.
#
# Five metres, which is coarser than the colonies and deliberately so: a
# coverage raster is a statement about *area*, and a cell finer than a colony
# reports the presence of one colony as a hundred per cent cover. Five metres
# is twenty-five square metres, which on a reef holds tens of colonies, and it
# is about the resolution of the satellite-derived habitat maps these places
# are built against.
COVER_CELL_M = 5.0

# An ESRI ASCII grid, which is the most portable raster there is: plain text,
# its georeference in six lines of header, and readable by QGIS, ArcGIS, GDAL,
# R and numpy without any of them needing the others. A GeoTIFF would be
# smaller and would need GDAL to write, which is a dependency this tool would
# then have and a spreadsheet user would then not have.
NODATA = -9999

# How far the reef measured off the published file may be from the reef the
# place's own record claims.
#
# Checked on **colony area**, not on cover, and that took two goes to get
# right. Cover has a threshold in it — a cell counts as reef above two per
# cent — and a threshold is a knife edge: on a sparse reef hundreds of cells
# sit within a rounding of it and flip in or out between two computations that
# agree about every colony. At Al Fahal 968 cells of 79,000 flipped and the
# two covers came out 1.3 per cent apart; at Red Sea, which is dense, one cell
# flipped and they agreed to four decimal places. Nothing was wrong either
# time.
#
# Total colony area has no threshold in it. It matched to 0.2 square metres in
# 216,228 — one part in a million, which is the four decimal places the USD is
# written to — on every place. That is the invariant worth testing: if the
# published file has the colonies the builder planted, at the sizes it planted
# them, then it *is* the reef, and any cover statistic computed from it is a
# question about the statistic rather than about the file.
#
# One part in ten thousand, which is fifty times looser than what was measured
# and still tight enough to catch a single colony going missing from a
# thousand.
AGREES_WITHIN = 1e-4


def write_grid(into: pathlib.Path, grid: np.ndarray, centre: dict,
               across: float, cell_m: float) -> None:
    """The raster and what its coordinates mean."""
    n = grid.shape[0]
    # Row 0 of the array is the south edge; an ASCII grid is written from the
    # north down. This is the same flip every texture on this platform needs
    # and it is the one that puts a reef a mile from where the survey put it.
    lines = ["ncols        %d" % n,
             "nrows        %d" % n,
             "xllcorner    %.4f" % (-across / 2.0),
             "yllcorner    %.4f" % (-across / 2.0),
             "cellsize     %.4f" % cell_m,
             "NODATA_value %d" % NODATA]
    for row in range(n - 1, -1, -1):
        lines.append(" ".join("%.4f" % v for v in grid[row]))
    (into / "cover.asc").write_text("\n".join(lines) + "\n")

    # Metres east and north of the site's centre, on the sphere the place was
    # sampled off. Azimuthal equidistant at the centre is the projection whose
    # distances from that point are true, which is exactly the claim the site
    # makes about itself: a colony at x metres east is x metres from the
    # middle.
    (into / "cover.prj").write_text(
        'PROJCS["%(name)s site-local",'
        'GEOGCS["WGS 84",DATUM["WGS_1984",'
        'SPHEROID["WGS 84",6378137,298.257223563]],'
        'PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433]],'
        'PROJECTION["Azimuthal_Equidistant"],'
        'PARAMETER["latitude_of_center",%(lat).8f],'
        'PARAMETER["longitude_of_center",%(lon).8f],'
        'PARAMETER["false_easting",0],PARAMETER["false_northing",0],'
        'UNIT["metre",1]]\n'
        % {"name": centre.get("name", "site"),
           "lat": float(centre["latitude"]), "lon": float(centre["longitude"])})


def provenance(site: dict) -> dict:  # noqa: C901
    """What each of these numbers is, and whether anybody measured it.

    The most important file in the set. A deliverable that does not
    distinguish a surveyed cover figure from a grown one is exactly the thing
    that gets cited back as though the model had measured it, and a CSV that
    lets somebody map an individual colony and go and look for it will be
    taken at face value unless it says otherwise on every row.
    """
    reef = site.get("reef", {})
    ground = site.get("ground", {})
    cover = reef.get("cover", {})
    surveyed = bool(site.get("from", {}).get("surveyed"))
    surveyed_sizes = reef.get("sizesAre") == "surveyed"
    return {
        "place": site.get("name"),
        "madeBy": "Coral City",
        "readThisFirst": (
            "These are simulation outputs. The seabed is a real survey. "
            + ("Every colony listed here is one a survey detected, at the "
               "position and diameter it recorded, so the positions and sizes "
               "are observations — but the growth form assigned to each one "
               "is not, and neither is anything drawn from it. "
               if surveyed_sizes else
               "The individual colonies are not real colonies: nothing in "
               "colonies.csv or colonies.geojson is an observation of a "
               "living animal, they are a draw from a cover figure. ")
            + "The field `measured` on each column below says which of the "
              "numbers here anybody went and looked at."),
        "georeference": {
            "frame": "metres east and north of the site centre",
            "centre": site.get("from", {}).get("centre"),
            "acrossMetres": site.get("from", {}).get("acrossMetres"),
            # Written out so the transform can be checked without reading the
            # code that performed it.
            "toLatitudeLongitude": (
                "latitude = centre.latitude + northing / N, "
                "longitude = centre.longitude + easting / E, where "
                "N = 111132.92 - 559.82 cos(2 phi) + 1.175 cos(4 phi) and "
                "E = 111412.84 cos(phi) - 93.5 cos(3 phi), phi being the "
                "centre latitude in radians. This is the inverse of the "
                "expression the place was sampled with, so it is exact for "
                "this place rather than a re-projection of it."),
            "datum": "WGS 84",
            "verticalDatum": site.get("datum"),
        },
        "columns": {
            "id": {"measured": False, "from": "an index; the reef has no names"},
            "latitude": {"measured": surveyed_sizes,
                         "from": ("where the survey detected this colony, "
                                  "projected out by the transform above"
                                  if surveyed_sizes else
                                  "the colony's site-local position, projected "
                                  "back out by the transform above. Exact as a "
                                  "transform; the position itself is not an "
                                  "observation")},
            "longitude": {"measured": surveyed_sizes, "from": "as latitude"},
            "eastingM": {"measured": surveyed_sizes,
                         "from": ("where the survey detected this colony"
                                  if surveyed_sizes else
                                  "where the reef builder put this colony")},
            "northingM": {"measured": surveyed_sizes, "from": "as eastingM"},
            "depthM": {"measured": surveyed,
                       "from": (site.get("from", {}).get("source")
                                or "the seabed this place was built from")},
            # Never measured, on any place. A detector that found a colony
            # in an orthomosaic found a blob of a size and a colour; which
            # growth form it is was assigned afterwards from that, and on a
            # surveyed reef it is the one column that is *not* an observation
            # while everything beside it is.
            "growthForm": {"measured": False,
                           "from": (reef.get("assemblage", {}) or {}).get("from")
                                   or reef.get("source")
                                   or "drawn from the assemblage's depth bands"},
            "acrossM": {"measured": surveyed_sizes,
                        "from": reef.get("sizesFrom")
                                or "the prototype's size times its drawn scale"},
            "footprintM2": {"measured": surveyed_sizes,
                            "from": ("a circle of the diameter the survey "
                                     "recorded for this colony"
                                     if surveyed_sizes else
                                     "the prototype's own plan area times the "
                                     "square of its scale")},
        },
        "cover": {
            "cellMetres": COVER_CELL_M,
            "measured": bool(cover.get("measured")),
            "askedFor": cover.get("asked"),
            "from": cover.get("from") or reef.get("source"),
            "howItIsComputed":
                "colony plan areas summed into each cell and saturated as "
                "1 - exp(-A/G): colonies are scattered rather than tiled, so "
                "they land on each other, and a cell whose colonies add to "
                "more than its area is fully covered rather than a hundred "
                "and forty per cent",
        },
        "ground": {"surveyed": bool(ground.get("surveyed")),
                   "colourFrom": ground.get("colourFrom"),
                   "hardnessFrom": ground.get("hardnessFrom")},
        "builtBy": site.get("builtBy"),
    }


def sizes_of(colonies: dict, areas, surveyed: bool) -> dict:
    """How big each colony is, and what that number is worth.

    Two different things, and the place says which it has.

    On a *surveyed* reef the scale is the measurement: the survey recorded a
    diameter for every colony it found and the instancer carries half of it.
    So the size in the inventory is a size somebody measured, and the CSV may
    say so.

    On a *grown* reef the colony is a prototype scaled, so its plan area is
    the prototype's times the square of the scale. The prototype's own area is
    worked out in `tools/reef.py` on the part that stands above the seabed
    with the growth form's solidity applied — a sea fan is a metre and a half
    of height on almost no ground — so this must not try to recompute it.
    """
    across, area = [], []
    for which, scale in zip(colonies["which"], colonies["scale"]):
        grown = float(scale[0])
        if surveyed:
            across.append(2.0 * grown)
            area.append(math.pi * grown * grown)
            continue
        plan = areas[which] if areas and which < len(areas) else 0.0
        area.append(plan * grown * grown)
        # The diameter of a circle of that plan area, which is the one number
        # a person asking "how big is it" wants.
        across.append(2.0 * math.sqrt(max(area[-1], 0.0) / math.pi))
    return {"acrossM": across, "m2": area}


def deliver(place: pathlib.Path, into: pathlib.Path) -> dict:
    site = json.loads((place / "site.json").read_text())
    centre = (site.get("from") or {}).get("centre")
    if not centre:
        raise SystemExit(
            f"{place.name} has no centre latitude and longitude, so nothing it "
            f"contains can be put on a map. A deliverable without a "
            f"georeference is a picture.")
    across = float(site["from"]["acrossMetres"])
    into.mkdir(parents=True, exist_ok=True)

    colonies = colonies_of(place)
    kinds, areas = prototypes_in(site)
    surveyed_sizes = (site.get("reef", {}).get("sizesAre") == "surveyed")
    sized = sizes_of(colonies, areas, surveyed_sizes)

    # Anything already here is from a previous run of this and may describe a
    # place that has since been rebuilt. A refusal that leaves yesterday's CSV
    # sitting in the folder is a refusal nobody sees.
    for old in ("colonies.csv", "colonies.geojson", "cover.asc", "cover.prj",
                "cover-by-form.csv", "provenance.json"):
        (into / old).unlink(missing_ok=True)

    rows = []
    for i, ((x, y, z), which) in enumerate(zip(colonies["at"], colonies["which"])):
        latitude, longitude = where_on_earth(centre, x, y)
        kind = kinds[which] if which < len(kinds) else "unknown"
        rows.append({
            "id": i,
            "latitude": round(latitude, 8),
            "longitude": round(longitude, 8),
            "eastingM": round(x, 3),
            "northingM": round(y, 3),
            "depthM": round(-z, 3),
            "growthForm": kind,
            "acrossM": round(sized["acrossM"][i], 4),
            "footprintM2": round(sized["m2"][i], 5),
        })

    with (into / "colonies.csv").open("w", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=list(rows[0]) if rows else
                                ["id", "latitude", "longitude"])
        writer.writeheader()
        writer.writerows(rows)

    # GeoJSON is WGS84 by definition — RFC 7946 says so and says a file may
    # not carry another one — which is why the points go out in degrees and
    # the raster, which is about area, goes out in metres.
    (into / "colonies.geojson").write_text(json.dumps({
        "type": "FeatureCollection",
        "coralCity": {
            "place": site.get("name"),
            "readThisFirst": provenance(site)["readThisFirst"],
        },
        "features": [
            {"type": "Feature",
             "geometry": {"type": "Point",
                          "coordinates": [one["longitude"], one["latitude"],
                                          -one["depthM"]]},
             "properties": {k: v for k, v in one.items()
                            if k not in ("latitude", "longitude")}}
            for one in rows],
    }) + "\n")

    # What this reef covers, worked out by the same function that worked it
    # out when the place was built — `reef.cover_over` — on colonies read back
    # out of the published USD rather than on the builder's own arrays.
    #
    # Two independent inputs, one definition. If they disagree, the file does
    # not contain the reef its record says it does, and that is the check this
    # tool is for. There used to be two definitions instead: this summed every
    # colony's area and saturated it, the builder took the median of
    # *one-metre* cells clipped at one, and they came out up to half as much
    # again apart with nothing broken and nothing to point at.
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
    import reef as reef_tools

    east = np.array([one["eastingM"] for one in rows], dtype=float)
    north = np.array([one["northingM"] for one in rows], dtype=float)
    plan = np.array([one["footprintM2"] for one in rows], dtype=float)
    # The reef this is cover of, read from the place rather than re-derived:
    # the habitat a grown reef was planted into, or the ground a survey
    # actually flew. Deriving it from where the colonies are does not work in
    # either direction — see `reef.cover_over`.
    measured = reef_tools.cover_over(
        east, north, plan, across,
        ground_m2=(site.get("reef", {}) or {}).get("reefAreaM2"),
        ground_is=((site.get("reef", {}) or {}).get("coverMeasuredBy", {})
                   or {}).get("over"))

    grid = measured["grid"]
    looked_at = measured["reefGroundM2"]
    ground_is = measured["groundFrom"]

    by_form = {}
    for one in rows:
        seen = by_form.setdefault(one["growthForm"], {"colonies": 0, "m2": 0.0})
        seen["colonies"] += 1
        seen["m2"] += one["footprintM2"]
    piled = sum(one["m2"] for one in by_form.values())
    covered = measured["cover"]
    for form, seen in by_form.items():
        seen["m2"] = round(seen["m2"], 2)
        # This form's share of the ground that is covered at all. Not its own
        # area over the ground: that does not saturate, so on a crowded reef
        # the shares add to more than the cover they are shares of.
        seen["coverOfReefGround"] = round(
            covered * seen["m2"] / max(piled, 1e-9), 5)

    with (into / "cover-by-form.csv").open("w", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(["growthForm", "colonies", "footprintM2",
                         "coverOfReefGround"])
        for form in sorted(by_form, key=lambda f: -by_form[f]["m2"]):
            seen = by_form[form]
            writer.writerow([form, seen["colonies"], seen["m2"],
                             seen["coverOfReefGround"]])

    said = provenance(site)
    said["coverByForm"] = {
        "reefGroundM2": round(looked_at, 1),
        "groundIs": ground_is,
        "notTheSite":
            "Cover here is over that ground and not over the whole site. "
            "Quoting the site average instead would put Looe Key at a fifth "
            "of what its own transects say, because seven eighths of its "
            "square kilometre has no colonies for want of anybody having "
            "looked.",
        "forms": by_form,
        "allStanding": round(measured["cover"], 5),
        "localCover": round(measured["localCover"], 5),
        "medianCover": round(measured["medianCover"], 5),
        "occupiedM2": round(measured["occupiedM2"], 1),
        # The raw ratio, because it is the input to the saturation and because
        # a reef carrying more colony area than it has ground is worth being
        # able to see.
        "colonyAreaOverGround": round(measured["piledUp"], 5),
        "thicketM2": round(measured["thicketM2"], 1),
        "colonyAreaM2": round(measured["colonyAreaM2"], 1),
        "biggerThanACell": measured["biggerThanACell"],
        "measuredBy": {
            "cellM": measured["cellM"],
            "statistic": "mean over cells with reef in them, each saturated "
                         "as 1 - exp(-A/G) because colonies are scattered "
                         "rather than tiled",
            "sameAs": "tools/reef.py cover_over, which is where the place's "
                      "own coverWhereItGrows comes from",
        },
        "whatThePlaceSays": (site.get("reef", {}) or {}).get("coverWhereItGrows"),
        "compareWith":
            "A transect's cover figure is the number to hold this against, "
            "and the two are not quite the same measurement: a transect "
            "records what is under a point, this records the plan area of "
            "every object a detector found standing above the seabed. Which "
            "of the growth forms below counts as stony coral is a question "
            "about the *classifier*, not about these numbers.",
    }
    (into / "provenance.json").write_text(json.dumps(said, indent=2) + "\n")

    return {"colonies": len(rows), "coverCells": int(grid.size),
            "meanCover": float(grid.mean()),
            "reefGroundM2": looked_at, "groundIs": ground_is,
            "cover": measured["cover"],
            "medianCover": measured["medianCover"],
            "localCover": measured["localCover"],
            "piledUp": measured["piledUp"],
            "saysItIs": (site.get("reef", {}) or {}).get("coverWhereItGrows"),
            "colonyAreaM2": measured["colonyAreaM2"],
            "builtWith": ((site.get("reef", {}) or {})
                          .get("coverMeasuredBy", {}) or {}).get("colonyAreaM2"),
            "byForm": by_form, "into": into}


# ── a flown mission ──────────────────────────────────────────────────────────
#
# A place is a reef somebody can study. A mission is a piece of work somebody
# actually did, and what it produces is different: where the vehicle went,
# where it believed it was, and what it put down.
#
# The distinction that matters here is not measured-or-not — nothing in a
# simulated mission is measured. It is *truth against belief*. The simulator
# knows where the vehicle was; the vehicle only knows where its navigation
# said it was; the plan knows where it was supposed to be. A restoration that
# plants on dead reckoning plants a reef nobody can find again, and the gap
# between those three columns is the only place that shows up. No real
# vehicle can produce this file, which is the whole argument for the
# simulator producing it.

TRUTH, BELIEVED, PLANNED = "truth", "believed", "planned"


def poses_of(recording: pathlib.Path) -> list[dict]:
    kept = []
    with (recording / "poses.jsonl").open() as lines:
        for line in lines:
            line = line.strip()
            if line.startswith("{"):
                kept.append(json.loads(line))
    return kept


def track_files(into: pathlib.Path, poses: list[dict], centre: dict,
                positioning: dict | None) -> dict:
    """Where it went and where it thought it went, as a table and as a map."""
    rows, flown, thought = [], [], []
    worst, total = 0.0, 0.0
    for pose in poses:
        x, y, z = (float(v) for v in pose["position"])
        latitude, longitude = where_on_earth(centre, x, y)
        flown.append([round(longitude, 8), round(latitude, 8)])
        row = {"t": pose["t"], "x": round(x, 3), "y": round(y, 3),
               "depthM": pose.get("depthM"), "altitudeM": pose.get("altitudeM"),
               "headingDeg": pose.get("headingDeg"),
               "latitude": round(latitude, 8), "longitude": round(longitude, 8),
               "believedLatitude": "", "believedLongitude": "", "fixErrorM": ""}
        believed = pose.get("believed")
        if believed:
            bx, by = float(believed[0]), float(believed[1])
            blat, blon = where_on_earth(centre, bx, by)
            thought.append([round(blon, 8), round(blat, 8)])
            off = math.hypot(bx - x, by - y)
            worst = max(worst, off)
            total += off
            row["believedLatitude"] = round(blat, 8)
            row["believedLongitude"] = round(blon, 8)
            row["fixErrorM"] = round(off, 3)
        rows.append(row)

    with (into / "track.csv").open("w", newline="") as out:
        writer = csv.DictWriter(out, fieldnames=list(rows[0]) if rows else ["t"])
        writer.writeheader()
        writer.writerows(rows)

    says = "its own navigation"
    if positioning and positioning.get("kind") not in (None, "", "none"):
        says = "its navigation, aided by %s" % positioning["kind"].upper()
    features = [{"type": "Feature", "geometry": {"type": "LineString", "coordinates": flown},
                 "properties": {"what": "where the vehicle actually was",
                                "from": "the simulator, which is the only thing that knows"}}]
    if thought:
        features.append({"type": "Feature",
                         "geometry": {"type": "LineString", "coordinates": thought},
                         "properties": {"what": "where the vehicle believed it was",
                                        "from": says}})
    (into / "track.geojson").write_text(json.dumps(
        {"type": "FeatureCollection", "features": features}, indent=1) + "\n")
    return {"poses": len(rows), "worstFixErrorM": round(worst, 3),
            "meanFixErrorM": round(total / len(thought), 3) if thought else None}


def planting_files(into: pathlib.Path, geometry: dict, achieved: dict,
                   centre: dict) -> dict | None:
    """Every coral: where it was meant to go, and where it actually went.

    The file a restoration programme has to be able to produce and mostly
    cannot. Two million corals into the seabed by 2030 is a number nobody can
    check without knowing where each one ended up.
    """
    marks = geometry.get("marks") or []
    planted = geometry.get("planted") or []
    if not planted:
        return None
    tolerance = float(achieved.get("toleranceM") or 0.0)
    rows = []
    for n, put in enumerate(planted):
        mark = marks[n] if n < len(marks) else {}
        px, py = float(put["x"]), float(put["y"])
        plat, plon = where_on_earth(centre, px, py)
        row = {"n": n + 1, "plantedX": round(px, 3), "plantedY": round(py, 3),
               "plantedLatitude": round(plat, 8), "plantedLongitude": round(plon, 8),
               "markX": "", "markY": "", "markLatitude": "", "markLongitude": "",
               "errorM": "", "onTheMark": ""}
        if mark:
            mx, my = float(mark["x"]), float(mark["y"])
            mlat, mlon = where_on_earth(centre, mx, my)
            off = math.hypot(px - mx, py - my)
            row.update({"markX": round(mx, 3), "markY": round(my, 3),
                        "markLatitude": round(mlat, 8), "markLongitude": round(mlon, 8),
                        "errorM": round(off, 3),
                        "onTheMark": "yes" if off <= tolerance else "no"})
        rows.append(row)

    with (into / "planting.csv").open("w", newline="") as out:
        writer = csv.DictWriter(out, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)

    features = []
    for row in rows:
        features.append({"type": "Feature", "properties": {
            "n": row["n"], "errorM": row["errorM"], "onTheMark": row["onTheMark"],
            "what": "where a coral actually went"},
            "geometry": {"type": "Point",
                         "coordinates": [row["plantedLongitude"], row["plantedLatitude"]]}})
        if row["markLatitude"] != "":
            features.append({"type": "Feature", "properties": {
                "n": row["n"], "what": "where it was meant to go"},
                "geometry": {"type": "Point",
                             "coordinates": [row["markLongitude"], row["markLatitude"]]}})
    (into / "planting.geojson").write_text(json.dumps(
        {"type": "FeatureCollection", "features": features}, indent=1) + "\n")
    return {"planted": len(rows),
            "of": len(marks) or len(rows),
            "onTheMark": sum(1 for r in rows if r["onTheMark"] == "yes"),
            "toleranceM": tolerance}


def coverage_file(into: pathlib.Path, geometry: dict, centre: dict) -> dict | None:
    """What a survey actually saw, as ground rather than as a percentage.

    Written as the cells themselves and not as an ESRI grid on purpose: the
    rectangle a survey is flown over is stated along the vehicle's own
    heading, so it is square to the mission and not to north, and an
    axis-aligned raster of it would be a resampling presented as a
    measurement.
    """
    seen = geometry.get("seen") or {}
    corners = geometry.get("rectangle") or []
    cells, rows, columns = seen.get("cells"), seen.get("rows"), seen.get("columns")
    if not cells or not rows or not columns or len(corners) != 4:
        return None
    flags = np.unpackbits(np.array(cells, dtype=np.uint8))[:rows * columns]
    flags = flags.reshape(rows, columns)
    # The rectangle's own axes, from its corners: along the first edge and up
    # the last. A cell's centre is a step along each.
    origin = np.array([corners[0]["x"], corners[0]["y"]])
    along = (np.array([corners[1]["x"], corners[1]["y"]]) - origin) / columns
    up = (np.array([corners[3]["x"], corners[3]["y"]]) - origin) / rows

    features = [{"type": "Feature", "properties": {"what": "the rectangle it was asked to cover"},
                 "geometry": {"type": "Polygon", "coordinates": [[
                     list(reversed([round(v, 8) for v in where_on_earth(centre, c["x"], c["y"])]))
                     for c in corners + [corners[0]]]]}}]
    for row in range(rows):
        for column in range(columns):
            if not flags[row, column]:
                continue
            at = origin + along * (column + 0.5) + up * (row + 0.5)
            latitude, longitude = where_on_earth(centre, float(at[0]), float(at[1]))
            features.append({"type": "Feature", "properties": {"what": "seen"},
                             "geometry": {"type": "Point",
                                          "coordinates": [round(longitude, 8), round(latitude, 8)]}})
    (into / "coverage.geojson").write_text(json.dumps(
        {"type": "FeatureCollection", "features": features}, indent=1) + "\n")
    covered = int(flags.sum())
    return {"cells": rows * columns, "seen": covered,
            "fraction": round(covered / float(rows * columns), 4)}


def mission_provenance(has_planting: bool, has_coverage: bool) -> dict:
    """What each column of a mission's product is. Not one of them is a
    measurement of a real reef, and the file says so first."""
    columns = {
        "latitude / longitude": {"kind": TRUTH,
            "from": "where the vehicle was, from the simulator, put on the Earth by "
                    "inverting the expression the place was sampled with"},
        "depthM / altitudeM / headingDeg": {"kind": TRUTH, "from": "the simulator's own state"},
        "believedLatitude / believedLongitude": {"kind": BELIEVED,
            "from": "the vehicle's navigation — what it would have logged, errors and all"},
        "fixErrorM": {"kind": "derived",
            "from": "the distance between the two above. Only a simulator can write this column"},
    }
    if has_planting:
        columns["markLatitude / markLongitude"] = {"kind": PLANNED,
            "from": "where the plan asked for a coral"}
        columns["plantedLatitude / plantedLongitude"] = {"kind": TRUTH,
            "from": "where the coral actually went, which is where the vehicle actually was"}
        columns["errorM / onTheMark"] = {"kind": "derived",
            "from": "the distance from the mark, against the tolerance the mission stated"}
    if has_coverage:
        columns["coverage.geojson"] = {"kind": TRUTH,
            "from": "the cells the camera's footprint actually passed over"}
    return {
        "about": "A flown mission, in a simulator. Nothing here is an observation of a "
                 "real reef or a real vehicle: it is what happened in a model whose "
                 "own provenance is in the place's provenance.json.",
        "why it is worth having": "Every row carries both where the vehicle was and "
                                  "where it believed it was. A real vehicle cannot "
                                  "produce the first column.",
        "columns": columns,
    }


def deliver_dive(recording: pathlib.Path, into: pathlib.Path) -> dict:
    """Turn one flown mission into files somebody can open."""
    manifest = json.loads((recording / "manifest.json").read_text())
    place = manifest.get("place")
    if not place or not (place.get("centre") or {}).get("latitude"):
        raise SystemExit(
            f"{recording} does not say which place it was flown in or where that "
            f"place is on the Earth, so nothing from it can be put on a map. It "
            f"was recorded before the runtime wrote that down; fly it again.")
    centre = dict(place["centre"], name=place.get("name", "site"))
    into.mkdir(parents=True, exist_ok=True)

    task = manifest.get("task") or {}
    geometry = manifest.get("geometry") or {}
    achieved = task.get("achieved") or {}
    track = track_files(into, poses_of(recording), centre, manifest.get("positioning"))
    planting = planting_files(into, geometry, achieved, centre)
    coverage = coverage_file(into, geometry, centre)

    conditions = manifest.get("conditions") or {}
    came = conditions.get("cameFrom") or {}
    if came.get("fields"):
        # The same page a dive gets from tools/provenance, shipped with the
        # product rather than left on the box.
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
        import importlib.machinery
        import importlib.util
        here = pathlib.Path(__file__).resolve().parent / "provenance"
        loader = importlib.machinery.SourceFileLoader("provenance", str(here))
        spec = importlib.util.spec_from_loader("provenance", loader)
        prov = importlib.util.module_from_spec(spec)
        loader.exec_module(prov)
        rows = prov.about_dive(came, conditions)
        (into / "conditions.html").write_text(
            prov.dive_page(place.get("name", "the dive"), came, rows))

    summary = {"place": place, "task": task, "seconds": manifest.get("seconds"),
               "track": track, "planting": planting, "coverage": coverage,
               "conditions": conditions,
               "files": sorted(p.name for p in into.iterdir())}
    (into / "mission.json").write_text(json.dumps(summary, indent=2) + "\n")
    (into / "provenance.json").write_text(json.dumps(
        mission_provenance(planting is not None, coverage is not None), indent=2) + "\n")
    summary["files"] = sorted(p.name for p in into.iterdir())
    summary["into"] = into
    return summary


def flown(recording: pathlib.Path, into: pathlib.Path | None) -> int:
    """What one mission produced, said the way a person reads it."""
    if not (recording / "manifest.json").is_file():
        print(f"  no recording at {recording}", file=sys.stderr)
        return 1
    run = recording.parent.name
    into = into or recording.parent.parent.parent / "deliverables" / run
    made = deliver_dive(recording, into)
    place = made["place"]
    task = made["task"] or {}
    print(f"  {run}")
    print(f"    {task.get('name', 'a dive')} at {place.get('name')}, "
          f"{made['seconds']:.0f} s, scored {task.get('score')}")
    track = made["track"]
    if track.get("meanFixErrorM") is not None:
        print(f"    {track['poses']:,} poses · navigation was "
              f"{track['meanFixErrorM']:.2f} m out on average, "
              f"{track['worstFixErrorM']:.2f} m at worst")
    if made["planting"]:
        put = made["planting"]
        print(f"    {put['planted']} of {put['of']} corals planted, "
              f"{put['onTheMark']} within {put['toleranceM']:.1f} m of the mark")
    if made["coverage"]:
        seen = made["coverage"]
        print(f"    {seen['seen']:,} of {seen['cells']:,} cells seen "
              f"({100 * seen['fraction']:.1f}%)")
    for one in made["files"]:
        print(f"    {into / one}")
    print()
    print("    provenance.json says what each column is. Nothing here is an")
    print("    observation of a real reef — but every row says both where the")
    print("    vehicle was and where it believed it was, which no real vehicle can.")
    return 0


def main() -> int:
    parse = argparse.ArgumentParser(
        description="turn a place into what a marine department asks for")
    parse.add_argument("place", nargs="?",
                       help="a place, for a reef's own product")
    parse.add_argument("--dive", metavar="RECORDING", default=None,
                       help="a dive's recording, for what a flown mission produced")
    parse.add_argument("--into", default=None,
                       help="where to write them (default: beside the place)")
    asked = parse.parse_args()

    if asked.dive:
        return flown(pathlib.Path(asked.dive).expanduser(),
                     None if asked.into is None else pathlib.Path(asked.into).expanduser())
    if not asked.place:
        print("name a place, or --dive a recording", file=sys.stderr)
        return 1

    place = pathlib.Path(asked.place).expanduser()
    into = (pathlib.Path(asked.into).expanduser() if asked.into
            else place.parent.parent / "deliverables" / place.name)
    made = deliver(place, into)

    print(f"  {place.name}")
    print(f"    {made['colonies']:,} colonies over "
          f"{made['reefGroundM2']:,.0f} m2 of reef ground, "
          f"{100 * made['cover']:.2f}% covered "
          f"({100 * made['localCover']:.0f}% where the colonies are, "
          f"{100 * made['piledUp']:.0f}% piled up)")
    # And what the place itself claims, because the whole point of computing
    # this off the published file is that the two can be held against each
    # other. Silent agreement is worth nothing if nobody is shown it.
    built = made.get("builtWith")
    if built:
        off = abs(made["colonyAreaM2"] - built) / max(built, 1e-9)
        verdict = "is the reef it was built as" if off <= AGREES_WITHIN else "IS NOT"
        print(f"    {made['colonyAreaM2']:,.1f} m2 of colony against "
              f"{built:,.1f} planted — this file {verdict}"
              f" ({off:.1e} apart)")
    says = made.get("saysItIs")
    if says is not None:
        off = abs(made["cover"] - says) / max(says, 1e-9)
        # Not a verdict. Cover has a two-per-cent threshold in it and a
        # threshold is a knife edge on a sparse reef; see AGREES_WITHIN.
        print(f"    cover: {100 * made['cover']:.2f}% here, "
              f"{100 * says:.2f}% in the record "
              f"({100 * off:.1f}% apart — the threshold, not the file)")
    for form in sorted(made["byForm"], key=lambda f: -made["byForm"][f]["m2"]):
        seen = made["byForm"][form]
        print(f"      {form:<12} {seen['colonies']:7,}  "
              f"{100 * seen['coverOfReefGround']:5.2f}%")
    for one in sorted(p.name for p in into.iterdir()):
        print(f"    {into / one}")
    print()
    print("    provenance.json says which of these numbers anybody measured.")
    print("    Nothing in colonies.csv is an observation of a living animal.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
