#!/usr/bin/env python3
"""Put a published measurement into a place's reference, as data.

    tools/cite ~/coral-city/reference/al-fahal --as benthos \\
        --paper "Roberts et al., PeerJ 5:e3410, 2017" \\
        --doi 10.7717/peerj.3410 \\
        --says '{"porites": 34.6, "pocillopora": 22.8}' \\
        --note "line-intercept transects at 2 and 10 m"

`tools/reference` fetches what has an API — habitat polygons, monitoring
tables, photographs, imagery, satellite scenes. Most of what is known about a
reef has no API. It is in a paper, and a number read out of a paper and typed
into a model is exactly the kind of number that later gets cited back as
though the model had measured it.

So a paper goes into the reference the same way a download does: its own file,
its own entry beside the others, the citation with it, and `"fetched": false`
so that nobody mistakes a reading for a fetch. What this buys is that
`tools/check-places` and anybody reading the record can see the difference
between a place that was measured, a place that cites somebody who measured
it, and a place where a number was chosen.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys
import time


def cite(into: pathlib.Path, name: str, paper: str, says: dict,
         doi: str | None = None, note: str | None = None,
         url: str | None = None) -> dict:
    """Write one literature source into a reference directory."""
    into.mkdir(parents=True, exist_ok=True)
    record = {
        "paper": paper,
        "doi": doi,
        "url": url,
        "note": note,
        "says": says,
        "read": time.strftime("%Y-%m-%d"),
        # Said out loud, because it is the whole distinction this tool exists
        # to keep: nobody ran a query for this. Somebody read it.
        "fetched": False,
    }
    (into / f"{name}.json").write_text(json.dumps(record, indent=2) + "\n")

    beside = into / "reference.json"
    whole = json.loads(beside.read_text()) if beside.is_file() else {
        "name": into.name, "sources": {}}
    whole.setdefault("sources", {})[name] = {
        "file": f"{name}.json",
        "source": paper,
        "doi": doi,
        "licence": "cited, not fetched",
        "note": note,
    }
    beside.write_text(json.dumps(whole, indent=2) + "\n")
    return record


def main() -> int:
    parse = argparse.ArgumentParser(
        description="record a published measurement in a place's reference")
    parse.add_argument("reference")
    parse.add_argument("--as", dest="name", required=True,
                       help="what this is a source for, e.g. benthos")
    parse.add_argument("--paper", required=True, help="the citation")
    parse.add_argument("--doi")
    parse.add_argument("--url")
    parse.add_argument("--note")
    parse.add_argument("--says", required=True,
                       help="what it says, as JSON: the numbers themselves, "
                            "so that a later reader can check the model "
                            "against them rather than against a sentence")
    asked = parse.parse_args()

    try:
        says = json.loads(asked.says)
    except ValueError as exc:
        print(f"--says must be JSON: {exc}", file=sys.stderr)
        return 2
    if not isinstance(says, dict):
        print("--says must be a JSON object", file=sys.stderr)
        return 2

    into = pathlib.Path(asked.reference).expanduser()
    got = cite(into, asked.name, asked.paper, says,
               doi=asked.doi, note=asked.note, url=asked.url)
    print(f"{into.name}: {asked.name} cited — {got['paper']}")
    for key, value in says.items():
        print(f"    {key}: {value}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
