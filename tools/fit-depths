#!/usr/bin/env python3
"""Refit a derived seabed against depths somebody measured.

    tools/fit-depths al-fahal
    tools/fit-depths al-fahal --write

Satellite-derived bathymetry reads shape off how much light comes back from
the bottom. The shape is usually good and the *scale* is a fit against an
assumed water column, so when the assumption is wrong the whole seabed is
wrong together — stretched, offset, or both. Al Fahal claimed depths to 60 m
where ICESat-2 measured 24, which is not noise and is not visible in a render,
because a reef at thirteen metres looks like a reef.

So: fit the claimed depths to the measured ones, apply that to the whole
raster, and say what is left over. This does not make the seabed measured. It
makes it a derived seabed with a known error instead of an unknown one, and
that is the whole difference.

It writes a corrected heightfield beside the original rather than over it.
Rebuild the place from it with:

    tools/make-site al-fahal --heights .../seabed_fitted.json --centre ...
"""

from __future__ import annotations

import argparse
import json
import pathlib

# Next to this script, which is where python looks first.
import built

# How far past the measured range the fit may be trusted before it is
# extrapolation. ICESat-2 sees to about 1.5 Secchi depths and no further, so a
# site with a deep edge will always have some; saying how much is the point.
BEYOND_M = 3.0


def sample(field, across: float, x, y):
    """What a heightfield says at a scatter of points."""
    import numpy as np

    rows, columns = field.shape
    u = np.clip((x / across + 0.5) * (columns - 1), 0, columns - 1.001)
    v = np.clip((y / across + 0.5) * (rows - 1), 0, rows - 1.001)
    i, j = u.astype(int), v.astype(int)
    fu, fv = u - i, v - j
    return ((field[j, i] * (1 - fu) + field[j, i + 1] * fu) * (1 - fv)
            + (field[j + 1, i] * (1 - fu) + field[j + 1, i + 1] * fu) * fv)


def spread_of(residual):
    import numpy as np

    middle = float(np.median(residual))
    return middle, float(np.median(np.abs(residual - middle)) * 1.4826)


BANDS = ((0.0, 5.0), (5.0, 10.0), (10.0, 15.0), (15.0, 25.0), (25.0, None))


def what_is_left_by_depth(measured, fitted):
    """The residual by depth band, because one rms hides its own shape.

    Al Fahal fitted to rms 2.00 m from 10.50 m, which reads as solved. It is
    not: 22,430 of its 26,726 measured depths are in the top five metres, so
    the line is theirs, and what is left runs +0.62 m there and -16.35 m
    between fifteen and twenty-five — worse at depth than the seabed it
    replaced. A controller told to fly a transect at twenty metres is the one
    who finds out.

    `measured` and `fitted` are negative-down, as everything here is.
    """
    import numpy as np
    left = np.asarray(measured) - np.asarray(fitted)
    depth = -np.asarray(measured)
    out = []
    for near, far in BANDS:
        inside = (depth >= near) if far is None else ((depth >= near) & (depth < far))
        if not inside.any():
            continue
        out.append({
            "fromM": near, "toM": far,
            "points": int(inside.sum()),
            "medianM": round(float(np.median(left[inside])), 2),
            "rmsM": round(float(np.sqrt(np.mean(left[inside] ** 2))), 2),
        })
    return out


def worst_band(bands):
    """The band furthest out, by median. None when there are no bands."""
    return max(bands, key=lambda b: abs(b["medianM"]), default=None) or None


def band_weights(measured):
    """One weight per point, so each depth band counts for as much as another.

    An unweighted fit over Al Fahal is 22,430 points in the top five metres
    against 56 below fifteen: the line is the shallows' line, and the deep end
    is whatever falls out. Weighting each band to the same total makes the fit
    answer to the whole range it claims to cover.
    """
    import numpy as np
    depth = -np.asarray(measured)
    w = np.ones(len(depth))
    for near, far in BANDS:
        inside = (depth >= near) if far is None else ((depth >= near) & (depth < far))
        if inside.any():
            w[inside] = 1.0 / float(inside.sum())
    return w


def candidate_fits(said, measured, weights):
    """The fits worth trying, each as (name, callable).

    A straight line is the right shape for a log-ratio in principle. In
    practice satellite-derived bathymetry saturates as it approaches its
    optical limit — Al Fahal's is 22 m — so the claimed depth stops growing
    while the real one keeps going, and no single slope can hold both ends.
    A second-order term can, and is still monotone over the range that
    matters as long as it is checked rather than assumed.
    """
    import numpy as np
    out = [("straight line", np.polyfit(said, measured, 1)),
           ("straight line, bands balanced",
            np.polyfit(said, measured, 1, w=np.sqrt(weights)))]
    if len(said) > 12:
        out.append(("curved, bands balanced",
                    np.polyfit(said, measured, 2, w=np.sqrt(weights))))
    return [(name, np.poly1d(c)) for name, c in out]


def rises_with_depth(curve, said):
    """A fit that is not monotone over the claimed range is not a rescaling.

    A quadratic can turn back on itself, which would make two different real
    depths out of one claimed depth. Cheap to check and not safe to assume.
    """
    import numpy as np
    grid = np.linspace(float(np.min(said)), float(np.max(said)), 256)
    step = np.diff(curve(grid))
    return bool(np.all(step >= 0) or np.all(step <= 0))


def how_bad_at_worst(measured, fitted):
    """The score a fit is chosen on: its furthest band, not its overall rms.

    Choosing on rms is what hid Al Fahal's deep end. The overall number is
    owned by whichever band has the most points in it, and that is exactly the
    band that was already fine.
    """
    worst = worst_band(what_is_left_by_depth(measured, fitted))
    return abs(worst["medianM"]) if worst else 0.0


# How much better a more complicated shape has to be before it is worth it.
# Over Al Fahal the curve bought 1.37 m in a band holding 56 points and cost
# 1.34 m in the band holding 22,430 — a worse seabed everywhere anybody flies,
# in exchange for a number that still says fifteen metres out. A margin, so
# that the mechanism for choosing cannot be talked into that trade.
WORTH_IT_M = 2.0
WORTH_IT_SHARE = 0.25

# Where a fit stops holding. A band further out than this is not calibrated,
# whatever the overall rms says.
HOLDS_WITHIN_M = 3.0


def simplest_good_enough(tried):
    """The simplest shape, unless a longer one is meaningfully better.

    `tried` is (name, curve, worst_band_metres, why_not) in increasing order of
    complexity. Scoring on the worst band was the right mechanism and it is not
    a licence to take any improvement at any price.
    """
    usable = [t for t in tried if t[2] is not None]
    if not usable:
        return None
    best = usable[0]
    for other in usable[1:]:
        gain = abs(best[2]) - abs(other[2])
        if gain >= WORTH_IT_M and gain >= WORTH_IT_SHARE * abs(best[2]):
            best = other
    return best


def holds_to(bands):
    """The depth this fit is good to, and what is past it.

    A seabed rescaled against a laser that only reached ten metres is
    calibrated to ten metres. Saying so is the difference between a derived
    seabed with a known limit and one with a number on it.
    """
    good = None
    for band in bands:
        if abs(band["medianM"]) <= HOLDS_WITHIN_M:
            good = band["toM"] if band["toM"] is not None else band["fromM"]
        else:
            break
    past = [b for b in bands
            if abs(b["medianM"]) > HOLDS_WITHIN_M]
    return good, past


def main() -> int:
    parse = argparse.ArgumentParser(description="refit a seabed against measured depths")
    parse.add_argument("place")
    parse.add_argument("--places",
                       default=str(pathlib.Path.home() / "iocean" / "places"))
    parse.add_argument("--reference",
                       default=str(pathlib.Path.home() / "iocean" / "reference"))
    parse.add_argument("--write", action="store_true",
                       help="write the corrected heightfield")
    asked = parse.parse_args()

    import numpy as np

    place = pathlib.Path(asked.places) / asked.place
    ref = pathlib.Path(asked.reference) / asked.place
    site = json.loads((place / "site.json").read_text())
    field = site["mesh"]["heightfield"]
    claims = np.fromfile(place / field["file"], dtype="<f4").reshape(
        field["rows"], field["columns"])
    across = float(site["from"]["acrossMetres"])

    points = np.load(ref / "icesat_depths.npy")
    x, y, measured = points[:, 0], points[:, 1], points[:, 2]
    inside = (np.abs(x) < across / 2) & (np.abs(y) < across / 2) & (measured < -0.5)
    x, y, measured = x[inside], y[inside], measured[inside]
    said = sample(claims, across, x, y)

    was_middle, was_spread = spread_of(measured - said)
    was_rms = float(np.sqrt(np.mean((measured - said) ** 2)))

    # Fit, drop what the fit itself calls an outlier, fit again. A photon on a
    # boat or a fish is a real thing to be rid of and a hand-set threshold is
    # not; three robust sigma from the first pass is.
    slope, offset = np.polyfit(said, measured, 1)
    residual = measured - (slope * said + offset)
    middle, spread = spread_of(residual)
    keep = np.abs(residual - middle) < 3 * spread

    # Then try each shape and keep the one whose *worst band* is smallest,
    # rather than the one with the smallest overall rms. Choosing on rms is
    # what hid Al Fahal's deep end: the summary belongs to whichever band has
    # the most points, and that was the band already fine.
    weights = band_weights(measured[keep])
    tried = []
    for name, curve in candidate_fits(said[keep], measured[keep], weights):
        if not rises_with_depth(curve, said[keep]):
            tried.append((name, curve, None, "turns back on itself"))
            continue
        tried.append((name, curve, how_bad_at_worst(measured, curve(said)), None))
    picked = simplest_good_enough(tried)
    if picked is None:
        print("  no fit holds over this range", file=__import__("sys").stderr)
        return 1
    chosen, curve, _, _ = picked
    print("  shapes tried, scored on their worst depth band:")
    for name, _c, score, why in tried:
        mark = " <- kept" if name == chosen else ""
        print(f"    {name:<32} "
              + (why if why else f"worst band {score:+.2f} m") + mark)

    fitted = curve(said)
    coefficients = [round(float(c), 6) for c in curve.coefficients]
    slope = float(curve.coefficients[-2]) if len(curve.coefficients) >= 2 else 1.0
    offset = float(curve.coefficients[-1])
    now_middle, now_spread = spread_of(measured - fitted)
    now_rms = float(np.sqrt(np.mean((measured - fitted) ** 2)))

    print(f"{asked.place}: {len(x):,} measured depths, "
          f"{-measured.max():.1f} to {-measured.min():.1f} m")
    print(f"  fit: {chosen} — measured = "
          + " + ".join(f"{c:.4g}·claimed^{len(coefficients) - 1 - i}"
                       if len(coefficients) - 1 - i > 1 else
                       (f"{c:.4g}·claimed" if len(coefficients) - 1 - i == 1
                        else f"{c:.4g}")
                       for i, c in enumerate(coefficients)))
    print(f"  before: offset {was_middle:+.2f} m, spread {was_spread:.2f} m, "
          f"rms {was_rms:.2f} m")
    print(f"  after:  offset {now_middle:+.2f} m, spread {now_spread:.2f} m, "
          f"rms {now_rms:.2f} m")
    print(f"  dropped {int((~keep).sum()):,} of {len(x):,} as outliers")

    # What is left over, by depth, and never only as one number.
    #
    # Al Fahal fitted to rms 2.00 m from 10.50 m, which reads as solved. It is
    # not: 22,430 of its 26,726 measured depths are in the top five metres, so
    # the line is theirs, and the residual runs -0.62 m there, +3.24 m by ten,
    # +5.73 m by fifteen and **+16.35 m** between fifteen and twenty-five —
    # worse at depth than the seabed it replaced. One slope cannot hold a
    # log-ratio over a range where a tenth of a percent of the points sit at
    # the far end, and a controller told to fly a transect at twenty metres is
    # the one who finds out.
    #
    # So the bands are printed and recorded beside the rms. A number too good
    # deserves the same suspicion as one too bad.
    bands = what_is_left_by_depth(measured, fitted)
    worst = worst_band(bands)
    print("  what is left, by depth:")
    for b in bands:
        to = "deeper" if b["toM"] is None else f"{b['toM']:.0f} m"
        print(f"    {b['fromM']:>4.0f} to {to:>7}: {b['points']:>6,} points, "
              f"median {b['medianM']:+.2f} m, rms {b['rmsM']:.2f} m")
    good_to, past = holds_to(bands)
    if past:
        deep = sum(b["points"] for b in past)
        print(f"  this seabed is calibrated to "
              + (f"{good_to:.0f} m" if good_to else "no depth at all")
              + f"; below that it is not. {deep:,} of {len(x):,} measured "
              f"points sit there and the fit is "
              f"{past[0]['medianM']:+.2f} m out at {past[0]['fromM']:.0f} m.")
        print(f"  no shape tried fixes it — the claims stop growing while the "
              f"real depth keeps going, which is what an optical limit looks "
              f"like from underneath. A deeper truth needs an instrument that "
              f"went there.")
    elif worst:
        print(f"  holds across the whole measured range; worst band "
              f"{worst['medianM']:+.2f} m at {worst['fromM']:.0f} m")

    if now_rms >= was_rms:
        print("  the fit does not improve this seabed; leaving it alone",
              file=__import__("sys").stderr)
        return 1

    corrected = curve(claims).astype("float32")
    # Where the fit is extrapolating rather than interpolating, and how much of
    # the site that is. A number that is quietly extrapolated over half a
    # place is not a correction, it is a second guess with a decimal point.
    deepest, shallowest = float(measured.min()), float(measured.max())
    beyond = float(((corrected < deepest - BEYOND_M)
                    | (corrected > shallowest + BEYOND_M)).mean())
    print(f"  calibrated between {-shallowest:.1f} and {-deepest:.1f} m; "
          f"{beyond:.0%} of the site is outside that and extrapolated")

    if not asked.write:
        print("\n  nothing written. Pass --write to keep it.")
        return 0

    into = ref / "seabed_fitted.f32"
    corrected.tofile(into)
    (ref / "seabed_fitted.json").write_text(json.dumps({
        "rows": int(corrected.shape[0]), "columns": int(corrected.shape[1]),
        "acrossMetres": across, "file": "seabed_fitted.f32",
        "format": ("little-endian float32, row major, south to north then "
                   "west to east"),
        "centre": site["from"]["centre"],
        # Where this square came from, carried through. A fit rescales a
        # seabed; it does not replace what measured it, and make-site reads
        # this note straight into the place's own provenance. `surveyed` and
        # `fittedAgainst` are this tool's to set, so they are excluded and
        # written below.
        # `toCalibrate` is a standing note that this is still owed — Al
        # Fahal's read "ICESat-2 ATL24 crosses this reef; two granules would
        # pin the scale". Carrying it past the fit that honoured it tells the
        # next reader the calibration has not happened. `fittedAgainst` below
        # says what was done and how well, which is the answer to it.
        **built.where_the_ground_came_from(
            site["from"],
            minus=("surveyed", "fittedAgainst", "toCalibrate")),
        "wasOwed": site["from"].get("toCalibrate"),
        "surveyed": False,
        "fittedAgainst": {
            "source": "ICESat-2 ATL24 v002 seafloor photons",
            "points": int(len(x)),
            "shape": chosen,
            "coefficients": coefficients,
            "chosenOn": ("the worst depth band, not the overall rms: the "
                         "summary belongs to whichever band holds the most "
                         "points, and over Al Fahal that was the one already "
                         "fine"),
            "slope": round(float(slope), 5),
            "offsetM": round(float(offset), 4),
            "rmsBeforeM": round(was_rms, 2),
            "rmsAfterM": round(now_rms, 2),
            "spreadAfterM": round(now_spread, 2),
            # Beside the rms, never instead of it: see the note above.
            "residualByDepth": bands,
            "worstBandMedianM": (worst or {}).get("medianM"),
            # The number that matters to anybody planning a dive: how deep
            # this seabed is actually calibrated. Not the overall rms.
            "calibratedToM": good_to,
            "pastThatUncalibrated": bool(past),
            "calibratedBetweenM": [round(-shallowest, 1), round(-deepest, 1)],
            "extrapolatedShare": round(beyond, 3),
            "note": ("derived from Sentinel-2 and rescaled to measured "
                     "depths. Not a survey: a derived seabed with a known "
                     "error rather than an unknown one."),
        },
    }, indent=1))
    print(f"\n  written to {into}")
    print(f"  rebuild with: tools/make-site {asked.place} "
          f"--heights {ref / 'seabed_fitted.json'} --most {field['rows']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
