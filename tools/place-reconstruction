#!/usr/bin/env python3
"""Put a reef patch reconstructed from a dive video into a place.

    tools/place-reconstruction add PLACE PATCH [--name N] [--at X,Y] [--heading DEG]
                                               [--transect DIR]
    tools/place-reconstruction PLACE

A reconstruction always belongs to a place: it is copied into the place and
the place's record says where it stands and how that was decided. Where it
stands, in this order:

  1. `--at`: coordinates somebody knows (site metres), with `--heading`.
  2. The most likely spot: the video's living coral cover (from its
     transect, ml/cover) matched to the cover this place planted, on 15 m
     windows inside the depth band a diver works; of the equally good, the
     one nearest where dives begin, so a dive can see it. It is laid along
     the depth contour there, because a transect is swum along the reef.
  3. The middle of the site, when there is nothing to match.

`add` (from ~/iocean/venvs/coral, for pyfqmr) writes PLACE/reconstructions/<name>/:

    patch.ply        decimated to `--triangles`, each vertex the mean colour
                     of the points it stands for, graded into the place's
                     coral library (its brightness and tint: the water's cast
                     taken out, since the renderer puts its own water back),
                     the patch's own frame: metres, z up, x along the transect
    placement.json   where, which way, at what height, and how it was decided

Adding a patch again (a new grade) keeps where it was put, and applying to a
place that already has it gives the planted mesh the new colours.

and then applies. Applying is what `tools/rebuild` replays after the reef is
grown again: coral.usda gains the patch as one more prototype with one
instance, and the colonies planted on its footprint are taken out, because
the reconstruction is that ground. The placement is decided once, at `add`,
and kept: a rebuild does not move it.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import re
import shutil
import sys

import numpy as np

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

CELL_M = 5.0                 # the cover map the match is made on
WINDOW_CELLS = 3             # fifteen metres: about a transect patch
BAND_M = (3.0, 20.0)         # where a diver swims a transect video
FOOTPRINT_M = 0.25           # the grid a patch's footprint is drawn on


# ── reading what the reconstruction made ─────────────────────────────────────

def read_open3d_ply(path: pathlib.Path):
    """Vertices, triangles and colours (0 to 1) of a binary PLY as Open3D
    writes one: double xyz, double normals, uchar rgb; triangles only."""
    raw = path.read_bytes()
    end = raw.index(b"end_header\n") + len(b"end_header\n")
    header = raw[:end].decode("ascii").splitlines()
    n_v = int(next(h for h in header if h.startswith("element vertex")).split()[-1])
    n_f = int(next(h for h in header if h.startswith("element face")).split()[-1])
    props = [h.split() for h in header if h.startswith("property") and "list" not in h]
    kind = {"double": "<f8", "float": "<f4", "uchar": "u1", "int": "<i4", "uint": "<u4"}
    vdtype = np.dtype([(p[2], kind[p[1]]) for p in props])
    v = np.frombuffer(raw, vdtype, n_v, end)
    f = np.frombuffer(raw, np.dtype([("n", "u1"), ("i", "<u4", 3)]), n_f, end + n_v * vdtype.itemsize)
    points = np.stack([v["x"], v["y"], v["z"]], -1).astype(np.float64)
    colours = np.stack([v["red"], v["green"], v["blue"]], -1) / 255.0 if "red" in v.dtype.names else None
    return points, f["i"].astype(np.int64), colours


LUMA = np.array([0.2126, 0.7152, 0.0722])


def cell_means(points: np.ndarray, colours: np.ndarray, kept: np.ndarray) -> np.ndarray:
    """Each kept vertex's colour as the mean of the made points nearest it.

    Decimating to a few hundred thousand triangles leaves a vertex for every
    ten or so the reconstruction made; giving it the colour of just the one
    nearest is a sample, and a sample of a photograph's grain is speckle (a
    dark dot here, a bright one there, at a few metres a salt-and-pepper
    sheet). The mean over the points it stands for is what the vertex saw."""
    from scipy.spatial import cKDTree

    nearest = cKDTree(kept).query(points)[1]
    sums = np.zeros((len(kept), 3))
    np.add.at(sums, nearest, colours)
    count = np.bincount(nearest, minlength=len(kept))
    out = sums / np.maximum(count, 1)[:, None]
    lonely = count == 0
    if lonely.any():
        out[lonely] = colours[cKDTree(points).query(kept[lonely])[1]]
    return out


def reef_colours(library_dir: pathlib.Path, per_colony: int = 20000, seed: int = 0) -> dict | None:
    """The colours this place's reef is drawn in: the brightness (mean and
    spread) and the mean tint of the coral library's colonies and rock, every
    piece weighed alike. None when there is no library."""
    import coral_hd

    rng = np.random.default_rng(seed)
    seen = []
    for one in sorted(pathlib.Path(library_dir).glob("*.ply")):
        _, _, c = coral_hd.read_ply(one)
        seen.append(c[rng.choice(len(c), min(per_colony, len(c)), replace=False)])
    if not seen:
        return None
    c = np.concatenate(seen)
    y = c @ LUMA
    return {"luma": float(y.mean()), "lumaSpread": float(y.std()),
            "tint": (c - y[:, None]).mean(0).tolist(), "pieces": len(seen), "from": str(library_dir)}


def to_the_reef(colours: np.ndarray, reef: dict) -> np.ndarray:
    """A photograph's colours put into the reef's own: brightness given the
    library's mean and spread, and the mean tint swapped for the library's.

    The video was shot through water and the renderer puts the water back, so
    whatever cast the photograph still carries is counted twice: the patch came
    back from a dive a dark blue sheet beside the reef it is part of. Taking
    the photograph's mean tint out entirely, rather than most of the way, and
    putting the reef's in, leaves each point's difference from the patch's
    average (its real colour variation, a green colony on grey rock) and makes
    the patch the same stuff as the coral the place grew around it, so the
    same water does the same thing to both."""
    y = colours @ LUMA
    chroma = colours - y[:, None]
    y = reef["luma"] + (y - y.mean()) / max(float(y.std()), 1e-3) * reef["lumaSpread"]
    chroma = chroma - chroma.mean(0) + np.asarray(reef["tint"])
    return np.clip(y[:, None] + chroma, 0, 1)


def living_cover(transect: pathlib.Path, video: str, start: float, stop: float) -> float | None:
    """Living coral (hard, soft, other) as a share of the seabed, over the
    seconds of the video the patch was built from."""
    said = json.loads((transect / "transect.json").read_text())
    if not any(pathlib.Path(v).name == pathlib.Path(video).name for v in said.get("videos", [])):
        return None
    import csv
    rows = [r for r in csv.DictReader(open(transect / "frames.csv")) if start <= float(r["t"]) <= stop]
    if not rows:
        return None
    return float(np.mean([float(r["hard_coral"]) + float(r["soft_coral"]) + float(r["other_coral"])
                          for r in rows]))


# ── reading and writing the place's reef ─────────────────────────────────────

ARRAYS = {"positions": r"^    point3f\[\] positions = \[(.*)\]$",
          "protoIndices": r"^    int\[\] protoIndices = \[(.*)\]$",
          "scales": r"^    float3\[\] scales = \[(.*)\]$",
          "orientations": r"^    quath\[\] orientations = \[(.*)\]$",
          "prototypes": r"^    rel prototypes = \[(.*)\]$"}


def _numbers(text: str) -> np.ndarray:
    return np.array(re.sub(r"[(),]", " ", text).split(), dtype=np.float64)


def read_reef(text: str) -> dict:
    found = {}
    for key, pattern in ARRAYS.items():
        m = re.search(pattern, text, re.M)
        if m is None:
            raise SystemExit(f"coral.usda has no {key} line in the shape this tool reads")
        found[key] = m
    return {
        "positions": _numbers(found["positions"].group(1)).reshape(-1, 3),
        "which": _numbers(found["protoIndices"].group(1)).astype(int),
        "scales": _numbers(found["scales"].group(1)).reshape(-1, 3),
        "orientations": _numbers(found["orientations"].group(1)).reshape(-1, 4),
        "prototypes": re.findall(r"<([^>]+)>", found["prototypes"].group(1)),
        "matches": found,
    }


def planted_cover(reef: dict, area_at_one, across: float):
    """Cover and mean seabed height on CELL_M cells, from the colonies planted."""
    n = int(np.ceil(across / CELL_M))
    x, y, z = reef["positions"].T
    col = np.clip(((x + across / 2) / CELL_M).astype(int), 0, n - 1)
    row = np.clip(((y + across / 2) / CELL_M).astype(int), 0, n - 1)
    sx, sy = reef["scales"][:, 0], reef["scales"][:, 1]
    area = (np.asarray(area_at_one)[reef["which"]] * sx * sy if area_at_one is not None
            else np.pi * sx * sy)
    covered = np.zeros((n, n))
    np.add.at(covered, (row, col), area)
    height = np.zeros((n, n))
    count = np.zeros((n, n))
    np.add.at(height, (row, col), z)
    np.add.at(count, (row, col), 1)
    height = np.where(count > 0, height / np.maximum(count, 1), np.nan)
    return 1 - np.exp(-covered / (CELL_M * CELL_M)), height


def _window(grid: np.ndarray) -> np.ndarray:
    from scipy import ndimage
    return ndimage.uniform_filter(np.nan_to_num(grid), WINDOW_CELLS, mode="constant")


def choose(site: dict, reef: dict, cover_v: float | None, across: float) -> dict:
    """Where the patch most likely is, by the rules in the docstring."""
    middle = {"at": [0.0, 0.0], "headingDeg": 0.0, "how": "the middle of the site",
              "kind": "chosen", "why": "nothing to match the video against"}
    if cover_v is None:
        return middle
    proto_area = (site.get("reef") or {}).get("prototypeAreaM2")
    if proto_area is not None and len(proto_area) != len(reef["prototypes"]):
        proto_area = None
    # Coral only: the framework and other patches are not cover.
    kinds = (site.get("reef") or {}).get("prototypeKinds") or []
    coral = np.array([kinds[w] not in ("rock", "reconstruction") if w < len(kinds) else True
                      for w in range(len(reef["prototypes"]))])[reef["which"]]
    reef = {**reef, "positions": reef["positions"][coral], "which": reef["which"][coral],
            "scales": reef["scales"][coral]}
    cover, height = planted_cover(reef, proto_area, across)
    smooth = _window(cover)
    depth = -height
    inside = np.isfinite(depth) & (depth >= BAND_M[0]) & (depth <= BAND_M[1]) & (smooth > 0.01)
    if not inside.any():
        return middle
    miss = np.where(inside, np.abs(smooth - cover_v), np.inf)
    good = miss <= miss.min() + 0.02
    n = cover.shape[0]
    rows, cols = np.nonzero(good)
    xs = -across / 2 + (cols + 0.5) * CELL_M
    ys = -across / 2 + (rows + 0.5) * CELL_M
    begin = site.get("beginAt") or [0, 0, 0]
    k = int(np.argmin((xs - begin[0]) ** 2 + (ys - begin[1]) ** 2))
    r, c = int(rows[k]), int(cols[k])
    # Along the depth contour: across the slope.
    filled = np.where(np.isfinite(height), height, np.nanmean(height))
    gy, gx = np.gradient(_window(filled))
    heading = float(np.degrees(np.arctan2(gx[r, c], -gy[r, c]))) if (gx[r, c] or gy[r, c]) else 0.0
    return {"at": [round(float(xs[k]), 1), round(float(ys[k]), 1)], "headingDeg": round(heading, 1),
            "how": "the most likely spot: the video's living coral cover matched to the cover this "
                   "place planted, on %g m windows between %g and %g m deep; of the %d equally good, "
                   "the one nearest where dives begin; laid along the depth contour"
                   % (CELL_M * WINDOW_CELLS, BAND_M[0], BAND_M[1], int(good.sum())),
            "kind": "derived",
            "videoCover": round(float(cover_v), 3), "placeCoverThere": round(float(smooth[r, c]), 3),
            "depthM": round(float(depth[r, c]), 1), "cells": n}


# ── add ──────────────────────────────────────────────────────────────────────

def add(asked) -> int:
    import pyfqmr
    place, patch = pathlib.Path(asked.place), pathlib.Path(asked.patch)
    about = json.loads((patch / "patch.json").read_text())
    name = asked.name or about.get("run") or patch.parent.name
    into = place / "reconstructions" / name
    into.mkdir(parents=True, exist_ok=True)

    points, faces, colours = read_open3d_ply(patch / "mesh.ply")
    s = pyfqmr.Simplify()
    s.setMesh(points, faces.astype(np.int32))
    s.simplify_mesh(target_count=asked.triangles, aggressiveness=7, preserve_border=True, verbose=False)
    v, f, _ = s.getMesh()
    v = np.asarray(v)
    c = cell_means(points, colours, v) if colours is not None else np.full((len(v), 3), 0.5)
    site = json.loads((place / "site.json").read_text())
    library_dir = ((site.get("reef") or {}).get("fromLibrary") or {}).get("path")
    reef = reef_colours(pathlib.Path(library_dir)) if library_dir else None
    if reef is None:
        raise SystemExit(f"{place.name} was grown without a coral library: nothing to grade the patch to")
    c = to_the_reef(c, reef)
    import coral_hd
    coral_hd.write_ply(into / "patch.ply", v, np.asarray(f, int), c)
    for extra in ("patch.json", "ortho.png", "preview.png"):
        if (patch / extra).exists():
            shutil.copy(patch / extra, into / extra)

    across = float(site["from"]["acrossMetres"])
    kept = into / "placement.json"
    if kept.exists() and not asked.at:
        # Made again (a new grade, a new decimation): it stays where it was
        # put. The placement is decided once.
        was = json.loads(kept.read_text())
        made = ("name", "from", "video", "scale", "triangles", "trianglesMade", "colours")
        where = {k: x for k, x in was.items() if k not in made}
        if "at" not in where:
            raise SystemExit(f"{kept} says nowhere")
    elif asked.at:
        x, y = (float(t) for t in asked.at.split(","))
        where = {"at": [x, y], "headingDeg": float(asked.heading or 0.0), "how": "coordinates given",
                 "kind": "measured" if asked.at_from else "chosen", "from": asked.at_from}
    else:
        cover_v = None
        if asked.transect:
            video = (about.get("video") or {}).get("videos", [""])[0]
            cover_v = living_cover(pathlib.Path(asked.transect), video,
                                   float(about["video"]["fromSeconds"]), float(about["video"]["toSeconds"]))
        where = choose(site, read_reef((place / "coral.usda").read_text()), cover_v, across)
    placement = {"name": name, "from": str(patch), "video": about.get("video"),
                 "scale": about.get("scale") or {"how": "assumed"},
                 "triangles": int(len(f)), "trianglesMade": int(len(faces)),
                 "colours": {"how": "each vertex the mean of the reconstruction's points nearest it; then "
                                    "brightness given the coral library's mean and spread, and the photograph's "
                                    "mean tint (the water's cast) replaced by the library's",
                             "kind": "derived", "reef": {k: (round(x, 4) if isinstance(x, float) else x)
                                                         for k, x in reef.items() if k != "tint"}
                             | {"tint": [round(x, 4) for x in reef["tint"]]}},
                 **where}
    (into / "placement.json").write_text(json.dumps(placement, indent=1) + "\n")
    print(f"{place.name}: {name} at {where['at']} heading {where['headingDeg']} ({where['how'][:60]})")
    return apply(place)


# ── apply ────────────────────────────────────────────────────────────────────

def _skin(text: str, name: str, colour) -> str:
    """A material for the patch: the reef's own first skin, with no
    corallites (the photograph already has whatever surface there was) and
    no light through it."""
    m = re.search(r'(        def Material "Skin_0"\n.*?\n        }\n)', text, re.S)
    if m is None:
        raise SystemExit("coral.usda has no Skin_0 to model the patch's material on")
    block = m.group(1).replace("Skin_0", f"Skin_{name}")
    block = re.sub(r"\n\s*asset inputs:corallites = [^\n]*", "", block)
    block = re.sub(r"\n\s*float inputs:tile_metres = [^\n]*", "", block)
    block = re.sub(r"float inputs:alive = [\d.]+", "float inputs:alive = 1", block)
    block = re.sub(r"float inputs:through = [\d.]+", "float inputs:through = 0", block)
    block = re.sub(r"color3f inputs:(tissue|diffuseColor) = \([^)]*\)",
                   lambda mm: "color3f inputs:%s = (%.3g, %.3g, %.3g)" % (mm.group(1), *colour), block)
    return block


def _recoloured(text: str, name: str, colours: np.ndarray) -> tuple[str, str]:
    """A patch already planted, given the colours its patch.ply has now (a
    new grade), where the mesh is the one planted: same vertices, same order.
    Its shape and where it stands are left as they are."""
    import reef as reef_tool

    mesh = re.search(r'(        def Mesh "Reconstruction_%s" \(.*?\n        }\n)' % re.escape(name), text, re.S)
    said = re.search(r"(color3f\[\] primvars:displayColor = \[)([^\]]*)(\])", mesh.group(1)) if mesh else None
    if said is None or said.group(2).count("(") != len(colours):
        return text, "its vertices differ from patch.ply's: grow the reef again (tools/rebuild) to plant the new one"
    block = mesh.group(1)[:said.start(2)] + reef_tool._triples(colours) + mesh.group(1)[said.end(2):]
    text = text[:mesh.start(1)] + block + text[mesh.end(1):]
    skin = re.search(r'(        def Material "Skin_%s"\n.*?\n        }\n)' % re.escape(name), text, re.S)
    if skin:
        mean = colours.mean(0)
        block = re.sub(r"color3f inputs:(tissue|diffuseColor) = \([^)]*\)",
                       lambda mm: "color3f inputs:%s = (%.3g, %.3g, %.3g)" % (mm.group(1), *mean), skin.group(1))
        text = text[:skin.start(1)] + block + text[skin.end(1):]
    return text, "recoloured"


DRAPE_M = 1.0


def _to_rim(v, f):
    """Each vertex's distance to the mesh's open edge (edges used by one
    triangle), in the mesh's own metres."""
    from scipy.spatial import cKDTree
    edges = np.sort(np.concatenate([f[:, [0, 1]], f[:, [1, 2]], f[:, [2, 0]]]), axis=1)
    unique, count = np.unique(edges, axis=0, return_counts=True)
    rim = np.unique(unique[count == 1])
    if not len(rim):
        return np.full(len(v), np.inf)
    return cKDTree(v[rim]).query(v)[0]


def _conjugate(q):
    return np.array([q[0], -q[1], -q[2], -q[3]])


def _rotate(q, v):
    """Points `v` turned by the unit quaternion q (w, x, y, z)."""
    w, qv = q[0], np.asarray(q[1:])
    return v + 2 * w * np.cross(qv, v) + 2 * np.cross(qv, np.cross(qv, v))


def seabed_of(place: pathlib.Path, site: dict):
    """The seabed's height at (x, y) as the place draws it, or None."""
    field = (site.get("mesh") or {}).get("heightfield")
    if not field or not (place / field["file"]).is_file():
        return None
    import reef as reef_tool
    h = np.fromfile(place / field["file"], dtype="<f4").reshape(field["rows"], field["columns"])
    across = float(site["from"]["acrossMetres"])
    return lambda x, y: reef_tool.seabed_at(h, across, x, y)


def _times(q, r):
    """Quaternion product q r, (w, x, y, z): r turned first, then q."""
    w1, x1, y1, z1 = q
    w2, x2, y2, z2 = r
    return np.array([w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2, w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2,
                     w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2, w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2])


def apply(place: pathlib.Path) -> int:
    import coral_hd
    import reef as reef_tool

    shelf = sorted((place / "reconstructions").glob("*/placement.json"))
    site_file = place / "site.json"
    site = json.loads(site_file.read_text())
    if not shelf:
        print(f"{place.name}: no reconstructions")
        return 0
    text = (place / "coral.usda").read_text()
    reef = read_reef(text)
    records = []
    for said in shelf:
        p = json.loads(said.read_text())
        name = re.sub(r"[^A-Za-z0-9_]", "_", p["name"])
        v, f, c = coral_hd.read_ply(said.parent / "patch.ply")
        if f"Reconstruction_{name}" in text:
            text, how = _recoloured(text, name, c)
            print(f"  {p['name']}: already in coral.usda, {how}")
            continue
        x0, y0 = p["at"]
        turn = np.radians(p["headingDeg"])
        cos, sin = np.cos(turn), np.sin(turn)
        flat = np.stack([x0 + v[:, 0] * cos - v[:, 1] * sin, y0 + v[:, 0] * sin + v[:, 1] * cos], -1)
        # The footprint, on a fine grid, and the colonies standing on it.
        lo = flat.min(0) - FOOTPRINT_M
        cells = np.floor((flat - lo) / FOOTPRINT_M).astype(int)
        grid = np.zeros(cells.max(0) + 3, bool)
        grid[cells[:, 0], cells[:, 1]] = True
        # Closed over the mesh's own spacing, so a coarse patch is a solid
        # footprint and not a lattice of dots, and its holes filled.
        from scipy import ndimage
        edge = float(np.median(np.linalg.norm(flat[f[:, 0]] - flat[f[:, 1]], axis=1)))
        reach = int(np.ceil(edge / FOOTPRINT_M)) + 1
        grid = ndimage.binary_fill_holes(ndimage.binary_closing(
            np.pad(grid, reach + 2), iterations=reach))[reach + 2:-(reach + 2), reach + 2:-(reach + 2)]
        grid = ndimage.binary_dilation(grid, iterations=2)
        at = np.floor((reef["positions"][:, :2] - lo) / FOOTPRINT_M).astype(int)
        inside = ((at >= 0).all(1) & (at[:, 0] < grid.shape[0]) & (at[:, 1] < grid.shape[1]))
        under = np.zeros(len(at), bool)
        under[inside] = grid[at[inside, 0], at[inside, 1]]
        # Laid on the seabed's own slope there, fitted to the colonies on
        # and around its footprint (they sit on the seabed): a reef slope is
        # tilted, and a patch laid flat on one is buried at one end.
        # Laid on the seabed as it is drawn, under its own footprint: a plane
        # fitted to the drawn surface there gives the slope (a reef slope is
        # tilted, and a patch laid flat on one is buried at one end), and the
        # patch is then raised until nine tenths of it is above that surface.
        # Fitted to the colonies around it instead, on a curving slope, it
        # came out two thirds of a metre under.
        tilt = np.array([1.0, 0.0, 0.0, 0.0])
        downhill = None
        drawn = seabed_of(place, site)
        if drawn is not None:
            pz = drawn(flat[:, 0], flat[:, 1])
        else:
            near_ = np.hypot(reef["positions"][:, 0] - x0, reef["positions"][:, 1] - y0) < 8.0
            pz = np.full(len(flat), float(np.median(reef["positions"][near_, 2])) if near_.any() else 0.0)
        (a, b, c0), *_ = np.linalg.lstsq(np.stack([flat[:, 0], flat[:, 1], np.ones(len(flat))], -1), pz, rcond=None)
        normal = np.array([-a, -b, 1.0]) / np.sqrt(a * a + b * b + 1)
        downhill = [float(-a), float(-b)]
        axis = np.cross([0, 0, 1.0], normal)
        if np.linalg.norm(axis) > 1e-9:
            angle = np.arccos(np.clip(normal[2], -1, 1))
            axis = axis / np.linalg.norm(axis)
            tilt = np.concatenate([[np.cos(angle / 2)], axis * np.sin(angle / 2)])
        turned = _rotate(_times(tilt, np.array([np.cos(turn / 2), 0, 0, np.sin(turn / 2)])), v)
        here = drawn(x0 + turned[:, 0], y0 + turned[:, 1]) if drawn is not None else pz
        ground = float(np.percentile(here - turned[:, 2], 90))
        # Its rim draped onto the seabed: a reconstruction's edge is where
        # the stereo ran out, and left where it was it hung above the ground
        # as a jagged skirt. Within DRAPE_M of the rim each point is pulled
        # down to the drawn surface, fully at the rim.
        if drawn is not None:
            to_rim = _to_rim(v, f)
            pull = np.clip(1 - to_rim / DRAPE_M, 0, 1)[:, None]
            world = turned + [x0, y0, ground]
            target = world.copy()
            target[:, 2] = here + 0.02
            world = world * (1 - pull) + target * pull
            v = _rotate(_conjugate(_times(tilt, np.array([np.cos(turn / 2), 0, 0, np.sin(turn / 2)]))),
                        world - [x0, y0, ground])
        yaw = np.array([np.cos(turn / 2), 0, 0, np.sin(turn / 2)])
        orientation = _times(tilt, yaw)
        keep = ~under
        index = len(reef["prototypes"])
        reef["prototypes"].append(f"/Coral/Grown/Reconstruction_{name}")
        reef["positions"] = np.concatenate([reef["positions"][keep], [[x0, y0, ground]]])
        reef["which"] = np.concatenate([reef["which"][keep], [index]])
        reef["scales"] = np.concatenate([reef["scales"][keep], [[1.0, 1.0, 1.0]]])
        reef["orientations"] = np.concatenate([reef["orientations"][keep], [orientation]])
        mesh = ('\n        def Mesh "Reconstruction_%s" (\n'
                '            prepend apiSchemas = ["MaterialBindingAPI"]\n'
                "        )\n        {\n"
                '            uniform token subdivisionScheme = "none"\n'
                "            int[] faceVertexCounts = [%s]\n"
                "            int[] faceVertexIndices = [%s]\n"
                "            point3f[] points = [%s]\n"
                "            normal3f[] normals = [%s] (\n"
                '                interpolation = "vertex"\n'
                "            )\n"
                "            color3f[] primvars:displayColor = [%s] (\n"
                '                interpolation = "vertex"\n'
                "            )\n"
                "            rel material:binding = </Coral/Skins/Skin_%s>\n"
                "        }\n") % (name, ", ".join(["3"] * len(f)), ", ".join(str(i) for i in f.reshape(-1)),
                                  reef_tool._triples(v), reef_tool._triples(reef_tool._smooth_normals(v, f)),
                                  reef_tool._triples(c), name)
        text = text.replace('    def Scope "Grown"\n    {', '    def Scope "Grown"\n    {' + mesh, 1)
        text = text.replace('    def Scope "Skins"\n    {\n',
                            '    def Scope "Skins"\n    {\n' + _skin(text, name, c.mean(0)), 1)
        records.append({**{k: p[k] for k in ("name", "at", "headingDeg", "how", "kind") if k in p},
                        "groundZ": round(ground, 2),
                        "slopeDeg": round(float(np.degrees(2 * np.arccos(np.clip(tilt[0], -1, 1)))), 1),
                        "downhill": downhill, "coloniesRemoved": int(under.sum()),
                        "prototype": index, "folder": f"reconstructions/{said.parent.name}",
                        "scale": p.get("scale"), "triangles": p.get("triangles")})
        print(f"  {p['name']}: prototype {index}, at {p['at']} z {ground:.2f}, "
              f"{int(under.sum()):,} colonies on its footprint taken out")
    if not records:
        (place / "coral.usda").write_text(text)          # recoloured, if anything
        _cameras(site_file)
        return 0
    m = read_reef(text)["matches"]
    lines = {"positions": "    point3f[] positions = [%s]" % reef_tool._triples(reef["positions"]),
             "protoIndices": "    int[] protoIndices = [%s]" % ", ".join(str(int(i)) for i in reef["which"]),
             "scales": "    float3[] scales = [%s]" % reef_tool._triples(reef["scales"]),
             "orientations": "    quath[] orientations = [%s]" % ", ".join(
                 "(%.5g, %.5g, %.5g, %.5g)" % tuple(q) for q in reef["orientations"]),
             "prototypes": "    rel prototypes = [%s]" % ", ".join(f"<{t}>" for t in reef["prototypes"])}
    for key in sorted(m, key=lambda k: -m[k].start()):
        text = text[:m[key].start()] + lines[key] + text[m[key].end():]
    (place / "coral.usda").write_text(text)
    site = json.loads(site_file.read_text())
    named = {r["name"] for r in records}
    site["reconstructions"] = [r for r in (site.get("reconstructions") or []) if r.get("name") not in named] + records
    # Recorded as the apply, whichever way it was called: `add` decimates
    # with pyfqmr, which the Python a rebuild runs under does not have.
    import datetime
    site.setdefault("builtBy", {})["place-reconstruction"] = {
        "argv": [str(place.resolve())], "cwd": str(pathlib.Path.cwd()),
        "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}
    if site.get("reef"):
        site["reef"]["colonies"] = int(len(reef["which"]))
        kinds = site["reef"].get("prototypeKinds")
        if isinstance(kinds, list):
            kinds += ["reconstruction"] * (len(reef["prototypes"]) - len(kinds))
    site_file.write_text(json.dumps(site, indent=1) + "\n")
    _cameras(site_file)
    return 0


def _cameras(site_file: pathlib.Path) -> None:
    """A fixed camera on each patch, so a dive can be asked to look at it
    (dives_start views ["patch-<name>"]): from the downhill side, twelve
    metres off and six up, aimed at its middle."""
    site = json.loads(site_file.read_text())
    drawn = seabed_of(site_file.parent, site)
    fixed = site.setdefault("cameras", {}).setdefault("fixed", {})
    for r in site.get("reconstructions") or []:
        x0, y0 = r["at"]
        z0 = float(r.get("groundZ", 0.0))
        down = np.radians(float(r.get("headingDeg", 0.0)) + 90.0)
        side = np.array([np.cos(down), np.sin(down)])
        tilt = r.get("downhill")
        if tilt is not None and np.linalg.norm(tilt) > 1e-3:          # level ground has no downhill
            side = np.array(tilt) / np.linalg.norm(tilt)
        # Above the seabed where the camera itself stands, and under the
        # surface: on a reef flat the downhill side can be shallower than
        # the patch, and a camera held at a fixed depth there was inside the
        # reef, looking at it from underneath. The first side, turning round
        # the patch, with room for the camera wins.
        eye = None
        start = np.arctan2(side[1], side[0])
        for turn_by in np.radians([0, 45, -45, 90, -90, 135, -135, 180]):
            ex, ey = x0 + 12 * np.cos(start + turn_by), y0 + 12 * np.sin(start + turn_by)
            floor = float(drawn(np.array([ex]), np.array([ey]))[0]) if drawn is not None else z0
            ez = min(max(floor, z0) + 3.0, -0.5)
            if ez > floor + 1.0:
                eye = [round(float(ex), 2), round(float(ey), 2), round(ez, 2)]
                break
        if eye is None:
            fixed.pop("patch-" + r["name"], None)
            continue
        fixed["patch-" + r["name"]] = {"eye": eye, "aim": [x0, y0, round(z0, 2)],
                                       "what": "the reconstructed patch " + r["name"] + ", from its downhill side"}
    site_file.write_text(json.dumps(site, indent=1) + "\n")


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "add":
        ap = argparse.ArgumentParser(description="put a reconstructed reef patch into a place")
        ap.add_argument("verb")
        ap.add_argument("place")
        ap.add_argument("patch", help="a patch folder from ml/reconstruct (mesh.ply, patch.json)")
        ap.add_argument("--name")
        ap.add_argument("--at", help="X,Y in site metres, where the video is known to be")
        ap.add_argument("--at-from", help="where those coordinates come from")
        ap.add_argument("--heading", type=float)
        ap.add_argument("--transect", help="the video's ml/cover transect folder, for its coral cover")
        ap.add_argument("--triangles", type=int, default=300000)
        return add(ap.parse_args())
    ap = argparse.ArgumentParser(description="apply the reconstructions a place holds")
    ap.add_argument("place")
    asked = ap.parse_args()
    return apply(pathlib.Path(asked.place))


if __name__ == "__main__":
    sys.exit(main())
