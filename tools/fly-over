#!/usr/bin/env bash
# Fly the camera over a place and make a video of it. Runs on the box.
#
# This is not a dive. It opens the same place, the same water and the same
# light a dive gets, and then flies a camera along a path instead of putting a
# vehicle in and integrating anything. What comes back is something somebody
# can look at and say what is wrong with.
#
# It goes around the control plane deliberately: there is no run, no lease and
# no queue here, because there is nothing to schedule — one container, one GPU,
# a couple of minutes, and no autonomy on the other side of a network waiting
# to be introduced.
#
#   fly-over red-sea

set -euo pipefail

place="${1:-}"
# Wait on a flight already in the air, rather than starting one. Opening a
# place takes minutes, and throwing that away to re-run the part after it is
# a bad trade.
collect_only=""
[ "${place}" = "--collect" ] && { collect_only=1; place=""; }
CITY="${HOME}/coral-city"
work="${CITY}/work"

# How many frames have been written. Its own function because `ls` of an empty
# directory fails, and a failing command substitution under `set -e` ends the
# script — which it did, silently, leaving a container flying a path nobody was
# waiting for.
here="${work}/tour"
so_far() { find "${here}/frames" -name 'frame_*.png' 2>/dev/null | wc -l | tr -d ' '; }

if [ -n "${collect_only}" ]; then
    docker ps --format '{{.Names}}' | grep -q '^coral-tour$' \
        || { echo "nothing is flying" >&2; exit 1; }
else

city="$("$(dirname "$0")/newest-place" "${place}")"
[ -n "${city}" ] || { echo "no published place called '${place:-anything}'" >&2; exit 1; }

vehicle=""
for d in "${work}"/packages/*/; do
    [ -f "${d}/dynamics.json" ] && vehicle="${d%/}"
done
[ -n "${vehicle}" ] || { echo "no vehicle package to open the scene with" >&2; exit 1; }

# Named, and pulled. Picking whatever local image matched "sim-runtime" once
# picked a build from two days earlier that had never heard of a tour — it
# opened the place, flew nothing, and ran a full ten-minute dive instead, which
# looks exactly like a tour that produced no frames. The registry is where the
# deploy puts the image and is the only thing that knows which one is current.
image="127.0.0.1:18081/sim-runtime:r1"
docker pull -q "${image}" >/dev/null 2>&1 \
    || { echo "the registry has no ${image}" >&2; exit 1; }

rm -rf "${here}"; mkdir -p "${here}/frames"; chmod -R 777 "${here}"

# No autonomy: nothing is flying the vehicle, and a ROS bridge with nobody on
# the other end is a minute of discovery timeouts for no reason.
cat > "${here}/dive.json" <<JSON
{"cityPath": "/dive/city", "vehiclePath": "/dive/vehicle",
 "durationSeconds": 600, "autonomy": false}
JSON
chmod 666 "${here}/dive.json"

echo "flying over $(python3 -c "import json;print(json.load(open('${city}/site.json'))['name'])") — ${city##*/}"

docker rm -f coral-tour >/dev/null 2>&1 || true
docker run -d --name coral-tour --gpus '"device=0"' \
    -e ACCEPT_EULA=Y -e PRIVACY_CONSENT=Y \
    -e ROS_LOG_DIR=/tmp/ros \
    -e CORAL_CITY_SEED=1 \
    -e CORAL_CITY_BRIEF=/dive/dive.json \
    -e CORAL_CITY_TOUR=1 \
    -e CORAL_CITY_TOUR_INTO=/dive/frames \
    -v "${here}:/dive:rw" \
    -v "${city}:/dive/city:ro" \
    -v "${vehicle}:/dive/vehicle:ro" \
    --entrypoint /isaac-sim/kit/kit \
    "${image}" /isaac-sim/apps/coral_city.kit --no-window >/dev/null
fi

# Opening a hundred million triangles takes minutes, and the flight itself is
# under a minute after that.
for _ in $(seq 1 120); do
    sleep 10
    frames="$(so_far)"
    printf '\r  %s frames' "${frames}"
    docker logs coral-tour 2>&1 | grep -q '"event": "tour_done"' && break
    docker logs coral-tour 2>&1 | grep -qE '"event": "(tour_failed|failed)"' && break
    docker ps --format '{{.Names}}' | grep -q '^coral-tour$' || break
done
printf '\n'
docker logs coral-tour 2>&1 | grep -E '"event": "(tour_|place_open|seabed_known|water_made|failed)' \
    | tail -6 | sed 's/^/  /' || true

frames="$(so_far)"
# Kept, because the container is removed straight after and everything it said
# about what it opened and how far it could see goes with it.
docker logs coral-tour > "${here}/flight.log" 2>&1 || true
docker rm -f coral-tour >/dev/null 2>&1 || true
[ "${frames}" -gt 24 ] || { echo "the flight produced ${frames} frames" >&2; exit 1; }

# Belt and braces. The flight sets a umask that leaves the frames readable, but
# an older image will have written them private to a user that does not exist
# out here, and then nothing can encode them.
docker run --rm -u 0 -v "${here}/frames:/w" --entrypoint chmod "${image}" a+r -R /w/.

ffmpeg -y -loglevel error -framerate 24 -pattern_type glob \
    -i "${here}/frames/frame_*.png" \
    -c:v libx264 -pix_fmt yuv420p -crf 26 -preset slow -vf 'scale=1100:-2' \
    "${here}/tour.mp4"
echo "  ${frames} frames → $(du -h "${here}/tour.mp4" | cut -f1)"
