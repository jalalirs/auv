#!/usr/bin/env python3
"""Bake a place's water into a map, measured from where dives begin.

    tools/aim-water ~/coral-city/places/looe-key

The medium in `coral_ground.mdl` needs to know where the camera is, and in
this renderer an MDL material parameter takes the value it was **built** with
and nothing else. Four ways of setting it at run time were tried and all four
failed identically: written per frame, written before the first compile, with
the `uniform` keyword dropped, and as plain floats rather than a float3. Each
time the USD attribute read back correct and the compiled shader kept its
default, so every frame measured distance from the middle of the site.

The runtime cannot fix it either: a place is mounted read-only into the dive.

But a place already knows where dives start — `site.json` says so, chosen as
the best reef in the working depth band — so the camera can be baked there,
which is the one kind of value this renderer reads. A dive that swims away
from its start carries a medium measured from the start, and that is an
approximation worth its own line in the record rather than a silent one.

Run it after anything that moves `beginAt`, which means after tools/make-site
and after tools/reef-survey.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

# Next to this script, which is where python looks first.
import built


def water_of(kind: str):
    """The attenuation lengths of a Jerlov water, from the runtime's own table."""
    import importlib.util

    where = (pathlib.Path(__file__).resolve().parent.parent / "services"
             / "sim-runtime" / "coral" / "water.py")
    spec = importlib.util.spec_from_file_location("coral_water", where)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.JERLOV[kind], module.veiling_colour(module.JERLOV[kind])


def bake(place: pathlib.Path, site: dict, begins, across: float,
         kind: str = "1C", size: int = 1024) -> dict | None:
    """How much of each colour survives the swim from each point to the camera.

    Worked out here rather than in the shader, because in this renderer no
    per-pixel value reaches an expression — the texture coordinate reads back
    as a constant when it is used in arithmetic, even though the same
    coordinate handed to a texture lookup works perfectly. So the distance is
    computed over the site at build time and written into a map, and the
    material does the one thing it can do: look it up.

    Red is gone in four metres of clear coastal water and green takes
    seventeen, and that is the whole point of doing it per channel. A fog with
    one distance cannot say it.
    """
    import numpy as np
    from PIL import Image

    lengths, _ = water_of(kind)
    field = site.get("mesh", {}).get("heightfield")
    if field is None:
        return None
    floor = np.fromfile(place / field["file"], dtype="<f4").reshape(
        field["rows"], field["columns"])

    # Every texel's own place on the site, and its own depth.
    line = (np.arange(size) + 0.5) / size
    x = (line - 0.5) * across
    y = (line - 0.5) * across
    at = ((np.arange(size) + 0.5) / size * (np.array(floor.shape)[:, None] - 1)
          ).astype(int)
    deep = floor[at[0][:, None], at[1][None, :]]

    swum = np.sqrt((x[None, :] - float(begins[0])) ** 2
                   + (y[:, None] - float(begins[1])) ** 2
                   + (deep - float(begins[2])) ** 2)

    survives = np.exp(-swum[..., None] / np.array(lengths)[None, None, :])
    # PNG, not JPEG, and it matters here more than anywhere else on the
    # platform. What survives falls from one to nothing over a few tens of
    # metres, so on a kilometre-wide map the bright part is a disc twenty
    # texels across on a black field — which is precisely the thing a DCT
    # throws away. Written as a JPEG at quality 95 it came back flat, and the
    # frame with it.
    #
    # North is at the top of a map and v = 0 is the south edge of the mesh.
    Image.fromarray((np.flipud(survives) * 255).astype("uint8")).save(
        place / "textures" / "site_survives.png")
    return {"waterType": kind,
            "attenuationM": [float(v) for v in lengths],
            "nearestM": round(float(swum.min()), 1),
            "farthestM": round(float(swum.max()), 1)}


def aim(place: pathlib.Path) -> dict | None:
    site = json.loads((place / "site.json").read_text())
    begins = site.get("beginAt")
    scene = place / site.get("layers", {}).get("terrain", "seabed.usda")
    if begins is None or not scene.is_file():
        return None
    across = float(site["from"]["acrossMetres"])

    at = {
        "site_eye_u": float(begins[0]) / across + 0.5,
        "site_eye_v": float(begins[1]) / across + 0.5,
        "eye_depth_m": float(begins[2]),
        "site_across": across,
    }

    # Nothing is written into the material.
    #
    # An earlier version of this patched four uniforms into the place's own
    # copy of `coral_ground.mdl`, and that was wrong twice over. It had no
    # effect, because a USD shader input overrides an MDL default and
    # tools/make-site writes all four; and it left the place's material
    # differing from the checkout's, which is exactly the condition tools/look
    # refuses to render on. So every scripted render after this ran quietly
    # refused, the sheet on disk stayed as it was, and four readings were
    # taken off one frame that had not moved since before the change.
    #
    # The map below is the whole output. It is the one thing this renderer
    # will read.
    material = place / "coral_ground.mdl"
    if not material.is_file():
        return None

    baked = bake(place, site, begins, across)
    if baked is None:
        return None
    at.update(baked)

    site.setdefault("ground", {})["waterBakedFrom"] = {
        "at": [round(float(v), 1) for v in begins],
        "waterType": at["waterType"],
        "attenuationM": at["attenuationM"],
        "file": "textures/site_survives.png",
        "why": ("no per-pixel value reaches an expression in this renderer, "
                "so how much of each colour survives the swim to the camera "
                "is worked out here and written into a map. A texture lookup "
                "is the thing that does work. It is measured from where dives "
                "begin: a vehicle that swims far from this point carries "
                "water measured from this point, and a different water type "
                "needs this run again."),
    }
    built.record_call(site, "aim-water")
    (place / "site.json").write_text(json.dumps(site, indent=2) + "\n")
    return at


def main() -> int:
    parse = argparse.ArgumentParser(description="aim a place's water at its dive start")
    parse.add_argument("places", nargs="+")
    asked = parse.parse_args()

    trouble = 0
    for one in asked.places:
        place = pathlib.Path(one).expanduser()
        got = aim(place)
        if got is None:
            print(f"{place.name}: nothing to aim — no beginAt, no terrain, or "
                  f"a ground material without the water in it", file=sys.stderr)
            trouble = 1
            continue
        print(f"{place.name}: water aimed at u {got['site_eye_u']:.4f}, "
              f"v {got['site_eye_v']:.4f}, {-got['eye_depth_m']:.1f} m down")
    return trouble


if __name__ == "__main__":
    raise SystemExit(main())
