def fetch_texture(where: pathlib.Path, name: str, prefix: str = "seabed",
                  disp: bool = False) -> bool:
    """The CC0 maps a seabed is surfaced with, from Poly Haven."""
    import urllib.request

    maps = {"colour": "diff", "rough": "rough", "normal": "nor_gl"}
    if disp:
        # The height a surface stands at, which is what the two surfaces of a
        # reef are blended by.
        maps["disp"] = "disp"
    into = where / "textures"
    into.mkdir(exist_ok=True)
    base = "https://dl.polyhaven.org/file/ph-assets/Textures/jpg/2k"
    for local, kind in maps.items():
        target = into / f"{prefix}_{local}.jpg"
        if target.exists():
            continue
        url = f"{base}/{name}/{name}_{kind}_2k.jpg"
        try:
            with urllib.request.urlopen(url, timeout=120) as answer:
                target.write_bytes(answer.read())
        except Exception as exc:
            print(f"    could not fetch {name} {kind}: {exc}")
            return False
    return True



def _soften(field, texels: float):
    """Blur a field by a width in texels, separably.

    Written out rather than reached for in scipy, because this runs wherever a
    place is built and the one thing it must not do is depend on a GIS stack.
    """
    import numpy as np

    radius = max(1, int(round(2.0 * texels)))
    x = np.arange(-radius, radius + 1, dtype="float64")
    kernel = np.exp(-0.5 * (x / max(texels, 1e-6)) ** 2)
    kernel /= kernel.sum()
    out = field.astype("float64")
    for axis in (0, 1):
        out = np.apply_along_axis(
            lambda row: np.convolve(
                np.pad(row, radius, mode="edge"), kernel, mode="valid"),
            axis, out)
    return out.astype("float32")


def derived_hardness(height, across: float, n: int = 1024):
    """Where the hard ground is, worked out from the shape of the seabed.

    For the four places with no habitat map. Sediment collects where the water
    is slow and the ground is flat; rock stays bare where it is steep, or
    standing proud, or shallow enough that the surf keeps it swept.

    **Asked of `zonation`, not worked out here.** There were two of these.
    This one had its own model — logistic curves on the median and the median
    absolute deviation of the slope and the relief — and `zonation.describe`
    had another, and they decided two different things from the same seabed:
    this one what the ground is *painted* as, that one what the coral *grows*
    on. So a place could be drawn as pavement where its reef was planted on
    sand, and nothing anywhere would disagree with itself.

    Worse, this was the model that could not be wrong. Normalising on the
    median maps the middle of any site to a half whatever the site is, so it
    always found about as much hard ground as soft — on Al Fahal it called 63%
    of the site hard, including the quarter of it that is a Sentinel-2
    detection floor clipped flat at 21.6 m. That is the same fault
    `zonation.describe` had until this week, in the function nobody had
    looked at, and it is the reason this is now four lines instead of forty.

    This is a model, not a survey, and the difference matters — it is written
    into the record as derived so that nobody reads a sand patch here as a
    sand patch somebody mapped.
    """
    import numpy as np

    hard = zonation.describe(height, across)["hard"]
    rows, columns = hard.shape
    at = (np.linspace(0, rows - 1, n).astype(int)[:, None],
          np.linspace(0, columns - 1, n).astype(int)[None, :])
    return hard[at].astype("float32")

def derived_colour(height, hard, across: float, n: int = 1024):
    """What the bottom looks like from above, where nobody has photographed it.

    Carbonate sand is pale and nearly white in the shallows; rock under turf
    algae is dark olive-brown; everything goes bluer and darker with depth
    because that is what the water takes. These are reflectances, not pixels
    off a photograph — a picture of a reef through ten metres of water is not
    the reef's albedo, and this platform has made that mistake once already.
    """
    import numpy as np

    rows, columns = height.shape
    at = (np.linspace(0, rows - 1, n).astype(int)[:, None],
          np.linspace(0, columns - 1, n).astype(int)[None, :])
    deep = -height[at]

    # Hardness to the same grid, rather than assuming it already is.
    #
    # It was assumed, and it held for a year because it was always true: the
    # only caller handed in `derived_hardness(..., n=1024)`. A survey's habitat
    # polygons come in at 4096, and the one place that had those also had an
    # orthomosaic — so it took the photographed branch and never reached here.
    # Al Fahal is the first place with a habitat map and no photograph of
    # itself, and this raised on the shapes the moment it got one.
    if hard.shape != (n, n):
        fine = (np.linspace(0, hard.shape[0] - 1, n).astype(int)[:, None],
                np.linspace(0, hard.shape[1] - 1, n).astype(int)[None, :])
        hard = hard[fine]

    sand = np.array([0.74, 0.71, 0.62])
    rock = np.array([0.20, 0.21, 0.16])
    colour = (sand[None, None, :] * (1 - hard[..., None])
              + rock[None, None, :] * hard[..., None])
    # Deeper ground is dimmer ground, and loses its red first.
    dim = np.exp(-np.clip(deep, 0, None)[..., None]
                 / np.array([26.0, 55.0, 70.0])[None, None, :])
    lit = np.clip(colour * (0.45 + 0.55 * dim), 0.0, 1.0)

    # Encoded, because the renderer reads this file as sRGB.
    #
    # Everything above is a reflectance — 0.74 for carbonate sand, 0.20 for
    # rock under turf — and those numbers went into the file as if they were
    # already sRGB. They are not, and the difference is not small: the
    # material decodes 0.20 back to 0.033, which is six times darker than the
    # rock this says it is drawing, and 0.74 back to 0.51.
    #
    # Al Fahal is the place that showed it. Its ground is a derived one and
    # came out at a third the brightness of Looe Key's, whose ground is an
    # orthomosaic — a photograph, which genuinely is sRGB and so was never
    # wrong. A dark seabed under a bright veil is a washed-out seabed, and Al
    # Fahal held a tenth of its own colour at arm's length where Looe Key held
    # a quarter. It was not the water. It was this.
    encoded = np.where(lit <= 0.0031308, lit * 12.92,
                       1.055 * np.power(lit, 1 / 2.4) - 0.055)
    return np.clip(encoded * 255, 0, 255).astype("uint8")


def where_a_dive_begins(height, across: float, off_bottom: float = 3.0) -> dict:
    """A start on ground that has nothing growing on it.

    Flat, at the depth most of the site is at, and inside the middle half so
    a vehicle can fly in any direction without meeting the edge. Flatness
    matters more than anywhere else down here: there is no reef to look at,
    so what a dive is for is the bottom itself, and a start on the wall of a
    canyon is a start looking at a wall.
    """
    import numpy as np

    rows, columns = height.shape
    # The middle half of the site, so there is room on every side.
    lo_r, hi_r = rows // 4, rows - rows // 4
    lo_c, hi_c = columns // 4, columns - columns // 4
    inside = height[lo_r:hi_r, lo_c:hi_c]

    # How rough each patch is, over about a tenth of the site.
    step = max(1, min(inside.shape) // 24)
    coarse = inside[::step, ::step]
    rough = np.zeros_like(coarse)
    rough[1:-1, 1:-1] = (
        np.abs(coarse[1:-1, 1:-1] - coarse[:-2, 1:-1])
        + np.abs(coarse[1:-1, 1:-1] - coarse[2:, 1:-1])
        + np.abs(coarse[1:-1, 1:-1] - coarse[1:-1, :-2])
        + np.abs(coarse[1:-1, 1:-1] - coarse[1:-1, 2:]))
    rough[0, :] = rough[-1, :] = rough[:, 0] = rough[:, -1] = np.inf

    # And how far from the depth the site mostly sits at.
    typical = float(np.median(inside))
    off = np.abs(coarse - typical)
    scored = rough + off
    if not np.isfinite(scored).any():
        return {}
    r, c = np.unravel_index(int(np.argmin(scored)), scored.shape)

    row = lo_r + r * step
    column = lo_c + c * step
    y = (row / max(1, rows - 1) - 0.5) * across
    x = (column / max(1, columns - 1) - 0.5) * across
    floor = float(height[min(row, rows - 1), min(column, columns - 1)])
    return {
        "beginAt": [round(float(x), 1), round(float(y), 1),
                    round(floor + off_bottom, 2)],
        "beginBecause": ("flat ground at the depth most of this site is at "
                         "(%.0f m), three metres off the bottom, inside the "
                         "middle half so a vehicle can fly any way from it. "
                         "There is no reef here to begin at: this place is "
                         "below the light, and that is what it is for."
                         % abs(floor)),
    }


def average_of(path: pathlib.Path) -> str:
    """What a texture's own colour is, so a material can divide it out.

    In linear, because that is the space the renderer multiplies in. Left in,
    a grain tints the whole seabed towards whatever beach it was photographed
    on, which is a thing nobody notices until the reef is the wrong colour and
    nobody can say why.
    """
    import numpy as np
    from PIL import Image

    grain = np.asarray(Image.open(path).convert("RGB"), dtype="float64") / 255.0
    linear = np.where(grain <= 0.04045, grain / 12.92,
                      ((grain + 0.055) / 1.055) ** 2.4)
    return ", ".join(f"{c:.4f}" for c in linear.reshape(-1, 3).mean(axis=0))


def write_usd(where: pathlib.Path, name: str, height, across: float,
              tile: float, texture: str | None, photograph: bool = False,
              ground: dict | None = None) -> dict:
    """The seabed, as a mesh, in a USD anybody can open."""
    import numpy as np

    rows, columns = height.shape
    # Spaced so the patch spans exactly what was asked for, centred on nothing:
    # the origin is the middle of the site, which is where a dive begins.
    ys = np.linspace(-across / 2, across / 2, rows, dtype="float32")
    xs = np.linspace(-across / 2, across / 2, columns, dtype="float32")
    grid_x, grid_y = np.meshgrid(xs, ys)

    points = np.stack([grid_x, grid_y, height], axis=-1).reshape(-1, 3)

    # Normals from the surface itself rather than from the triangles, so that a
    # seabed reads as a surface with slopes on it instead of a field of facets.
    dy, dx = np.gradient(height.astype("float64"),
                         across / max(1, rows - 1), across / max(1, columns - 1))
    normals = np.stack([-dx, -dy, np.ones_like(dx)], axis=-1)
    normals /= np.linalg.norm(normals, axis=-1, keepdims=True)
    normals = normals.reshape(-1, 3).astype("float32")

    # Two triangles per cell, wound so the outside is up.
    top_left = (np.arange(rows - 1)[:, None] * columns + np.arange(columns - 1)[None, :])
    a = top_left.ravel()
    b, c, d = a + 1, a + columns, a + columns + 1
    faces = np.empty((a.size * 2, 3), dtype="int32")
    faces[0::2] = np.stack([a, c, b], axis=-1)
    faces[1::2] = np.stack([b, c, d], axis=-1)

    # Texture coordinates in metres over a tile, not zero-to-one over the site.
    #
    # A photograph of sand stretched across a kilometre is a kilometre-wide
    # photograph of sand: every grain is three metres across and the seabed
    # reads as a painted backdrop. Repeating it every few metres is what makes
    # it ground.
    #
    # The ground material is the exception, and it is zero-to-one over the
    # site: it has a map of this particular seabed to lay down, which only
    # goes on once, and it does its own tiling of the detail on top. Doing the
    # tiling here and the site map in the shader would work equally well until
    # somebody changed the tile size and moved the reef.
    if ground is not None:
        u = (grid_x / across + 0.5).reshape(-1).astype("float32")
        v = (grid_y / across + 0.5).reshape(-1).astype("float32")
    else:
        u = (grid_x / tile).reshape(-1).astype("float32")
        v = (grid_y / tile).reshape(-1).astype("float32")

    def numbers(values, per):
        out, row = [], []
        for i, value in enumerate(values.reshape(-1)):
            row.append(f"{value:.4g}")
            if (i + 1) % per == 0:
                out.append(", ".join(row)); row = []
        if row:
            out.append(", ".join(row))
        return "\n        ".join(out)

    def triples(values):
        return ", ".join(f"({x:.4g}, {y:.4g}, {z:.4g})" for x, y, z in values)

    def pairs(us, vs):
        return ", ".join(f"({a:.5g}, {b:.5g})" for a, b in zip(us, vs))

    lowest, highest = float(height.min()), float(height.max())
    if ground is not None:
        import numpy as np  # noqa: F811

        # A reef photographed through ten metres of water comes back flat and
        # blue-grey; tools/ground has already taken the water out of the
        # orthomosaic, so this only lifts it, and gently.
        material = GROUND_MATERIAL % dict(
            ground, tile=tile, across=across, repeats=across / max(tile, 1e-6),
            grain=0.85, relief=1.0, lift=1.05,
            floor=float(np.median(height)),
            # The middle of the site until a dive says otherwise. A dive
            # rewrites these when it opens the place, because a parameter of
            # this shape arrives where a per-frame float3 does not.
            eye_u=0.5, eye_v=0.5, eye_z=float(np.median(height)) + 3.0)
    elif texture:
        material = SEABED_MATERIAL
    else:
        material = UNTEXTURED_MATERIAL
    if photograph and ground is None:
        # The sand correction exists because a dry beach photographed in
        # sunlight is the brightest thing in any scene. This is a reef
        # photographed through twenty metres of water, which is the opposite
        # problem, and correcting it again takes it further from the truth.
        material = material.replace("float4 inputs:scale = (1.05, 1.0, 0.92, 1)",
                                    "float4 inputs:scale = (1.25, 1.2, 1.1, 1)")
        material = material.replace('token inputs:wrapS = "repeat"',
                                    'token inputs:wrapS = "clamp"')
        material = material.replace('token inputs:wrapT = "repeat"',
                                    'token inputs:wrapT = "clamp"')
    body = f'''#usda 1.0
(
    doc = "{name}: real seafloor, from a bathymetric survey. Metres, Z up, z=0 at the water surface."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{{
    def Mesh "Seabed" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {{
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [{", ".join(["3"] * len(faces))}]
        int[] faceVertexIndices = [{", ".join(str(i) for i in faces.reshape(-1))}]
        point3f[] points = [{triples(points)}]
        normal3f[] normals = [{triples(normals)}] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st = [{pairs(u, v)}] (
            interpolation = "vertex"
        )
        float3[] extent = [({-across/2:.1f}, {-across/2:.1f}, {lowest:.2f}), ({across/2:.1f}, {across/2:.1f}, {highest:.2f})]
        rel material:binding = </World/Looks/Seabed>
    }}
{material}
}}
'''
    (where / "seabed.usda").write_text(body)

    # The same heights again, as numbers rather than as a mesh.
    #
    # A dive needs to know how deep the bottom is under the vehicle — to land on
    # it, to hold an altitude above it, to score a transect that was supposed to
    # stay two metres off it. Asking the renderer would mean a ray cast into
    # geometry that exists only when somebody is watching; asking physics would
    # mean colliders on a scene that has none. The site knows, so the site says,
    # and a batch dive with nothing drawn gets exactly the same answer as a
    # dive somebody is flying.
    height.astype("<f4").tofile(where / "seabed.f32")
    return {"lowest": lowest, "highest": highest,
            "points": int(points.shape[0]), "triangles": int(faces.shape[0]),
            "heightfield": {"rows": rows, "columns": columns,
                            "format": "little-endian float32, row major, "
                                      "south to north then west to east",
                            "file": "seabed.f32"}}


def main() -> int:
    parse = argparse.ArgumentParser(description="make a place out of seafloor")
    parse.add_argument("name")
    parse.add_argument("--raster",
                       help="a bathymetric survey to cut the terrain from")
    parse.add_argument("--heights",
                       help="a square already cut by tools/get-bathymetry — "
                            "its .json, with the .f32 beside it")
    parse.add_argument("--build", choices=("fringing-reef",),
                       help="construct the terrain instead, where no survey exists")
    parse.add_argument("--centre", nargs=2, type=float,
                       metavar=("LAT", "LON"),
                       help="where this place is, whether surveyed or not")
    parse.add_argument("--across", type=float, default=1000.0,
                       help="metres across, square")
    parse.add_argument("--most", type=int, default=512,
                       help="most samples along a side")
    # Outside the source tree by default. A place is built from public
    # bathymetry and published to object storage by digest; a copy in the
    # repository would be a second origin for the same bytes, and a large one —
    # and an eleven megabyte generated file appearing in a checkout is enough to
    # stop a deploy, which is exactly what it did.
    # A ceiling, not a target. How many colonies a reef needs is decided by the
    # cover the ground can hold and the size the colonies came out at; this is
    # only how many the pipeline is willing to write.
    parse.add_argument("--coral", type=int, default=2400000,
                       help="most coral colonies to write")
    parse.add_argument("--seed", type=int, default=1,
                       help="the same seed grows the same reef")
    parse.add_argument("--cover-from",
                       help="where this reef's density comes from: name the "
                            "survey, or say it was chosen. Required whenever "
                            "coral is grown, because a density with no source "
                            "is a number somebody will cite as a measurement")
    parse.add_argument("--assemblage",
                       help="which reef this is: caribbean or red-sea. The "
                            "shapes are the same everywhere and the mix is "
                            "not — a gorgonian sea fan is a Caribbean "
                            "signature and the Red Sea has Acropora tables "
                            "instead. Everything on this platform was grown "
                            "from the Caribbean mix until Al Fahal, where "
                            "sixty-seven of sixty-eight dives happen")
    parse.add_argument("--assemblage-from",
                       help="where that mix comes from: the survey and the "
                            "paper. Required with --assemblage, for the same "
                            "reason --cover-from is required with coral")
    parse.add_argument("--water",
                       help="which Jerlov water this place is in — I, IA, IB, "
                            "II, III for open ocean, 1C through 9C for "
                            "coastal. Everything on this platform has been "
                            "rendered through 1C, which is clear coastal, and "
                            "for an offshore Red Sea reef that is fog")
    parse.add_argument("--water-from",
                       help="where that water type comes from: the "
                            "measurement and the paper. Required with "
                            "--water, for the same reason --cover-from is "
                            "required with coral — an attenuation length is "
                            "a claim about a real sea and somebody will cite "
                            "it")
    parse.add_argument("--ground",
                       help="a reference directory built by tools/ground, or its "
                            "colour_4096.png: the colour of this actual seabed, "
                            "laid under tiled relief")
    parse.add_argument("--photograph",
                       help="an image of this square to surface it with, "
                            "instead of a tiled stock seabed")
    parse.add_argument("--texture", default="coast_sand_03",
                       help="a Poly Haven CC0 texture to surface the seabed with")
    # Ten metres, not four. A photograph of sand repeating every four metres
    # over a kilometre of seabed reads as a checkerboard — the eye finds the
    # period long before it stops seeing the grain, and once seen it is all
    # anybody sees.
    parse.add_argument("--tile", type=float, default=10.0,
                       help="metres the seabed texture repeats over")
    parse.add_argument("--into",
                       default=str(pathlib.Path.home() / "coral-city" / "places"))
    asked = parse.parse_args()
    if asked.assemblage and not asked.assemblage_from:
        parse.error("--assemblage needs --assemblage-from: say which survey "
                    "it came from. A reef drawn as the wrong ocean is as "
                    "convincing as one drawn as the right one.")
    if asked.water and not asked.water_from:
        parse.error("--water needs --water-from: say which measurement it "
                    "came from. A place rendered through the wrong sea looks "
                    "exactly as convincing as one rendered through the right "
                    "one.")

    where = pathlib.Path(asked.into) / asked.name
    where.mkdir(parents=True, exist_ok=True)
    # Said in the place itself, for as long as it takes to build it.
    #
    # A build that dies halfway leaves a place that is *torn*: some of it new,
    # the rest of it whatever was there before, and a site.json describing
    # neither. Nothing about it looks wrong. Thuwal Deep was rebuilt with a
    # missing dictionary entry, make-site raised after writing the new ground
    # textures and before writing the seabed, and `tools/look` then rendered
    # the old reef on the new mud and said five frames, exit nought — which is
    # four readings off a place that does not exist.
    #
    # So the place says it is being built, and stops saying it when it is.
    # Anything that flies a place refuses one that is still saying it.
    torn = where / "being-built.json"
    torn.write_text(json.dumps({
        "argv": sys.argv[1:], "began": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "why": ("make-site is part way through this place. Until it finishes "
                "this file is here, and a place with it is torn: some of it "
                "is new and the rest is whatever was here before. Nothing "
                "will look wrong. Build it again."),
    }, indent=2) + "\n")

    if asked.build:
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
        import fringing
        height, morphology = fringing.build(asked.across, asked.most, asked.seed)
        step, surveyed = 1, False
        survey_note = None
    elif asked.heights:
        # Already centred, already cut, already square. Nothing here has to know
        # about projections or geotransforms, which is the difference between
        # this and --raster: that path wants a GDAL build on whatever machine
        # runs it, and this one wants numpy.
        import numpy as np
        note = json.loads(pathlib.Path(asked.heights).read_text())
        # tools/get-bathymetry wraps the field; tools/ground writes its 1 m
        # seabed with the same keys at the top level. Both are a square of
        # float32 with a note beside it, and the one worth building from is
        # the second: it has the survey's own metre feathered into the
        # mosaic's two.
        field = note.get("heightfield", note)
        beside = pathlib.Path(asked.heights).parent / field["file"]
        height = np.fromfile(beside, dtype="<f4").reshape(
            field["rows"], field["columns"])
        asked.across = float(note["acrossMetres"])
        if asked.centre is None:
            asked.centre = (note["centre"]["latitude"], note["centre"]["longitude"])
        # What the heights say about themselves, rather than an assumption.
        # This was hardcoded True, which meant a square derived from a
        # satellite picture — shape from the light coming off the bottom,
        # depths scaled against the reef's own geomorphology — was recorded as
        # a survey. It is not one, it says so, and the site has to carry that
        # through rather than launder it.
        morphology, step = None, 1
        surveyed = bool(note.get("surveyed", True))
        survey_note = note
    elif asked.raster:
        height, step = read_patch(asked.raster, tuple(asked.centre or (0, 0)),
                                  asked.across, asked.most)
        morphology, surveyed = None, True
        survey_note = None
    else:
        raise SystemExit("give it a --raster to cut from, or a --build to construct")

    textured, photograph = False, False
    if asked.photograph:
        # The reef, surfaced with a photograph of itself. A stock seabed tiled
        # over a real reef is the thing that makes a site look invented: the
        # shape is right and the surface is somebody else's sand, repeating.
        # A ten-metre satellite pixel is coarse for a close-up, and it is the
        # actual colour of the actual coral in the actual place.
        import numpy as np
        from PIL import Image
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
        import zonation

        into = where / "textures"
        into.mkdir(exist_ok=True)
        # Roughness and bumps still come from the stock seabed: at arm's length
        # a reef has a grain a ten-metre pixel cannot know about, and borrowing
        # it is honest as long as the ground's colour is the ground's own.
        fetch_texture(where, asked.texture)
        seen = np.asarray(Image.open(asked.photograph).convert("RGB"), dtype="float64")
        # Not the photograph. A picture of a reef taken through fifteen metres
        # of water is not the reef's albedo, and handing it to a renderer as
        # one gets it attenuated twice — the ground goes black under lit coral.
        # The picture says where the sand and the pavement are; what colour
        # those are is a property of what they are.
        Image.fromarray(zonation.substrate_colour(height, asked.across, picture=seen)).save(
            into / "seabed_colour.jpg", quality=94)
        textured, asked.tile, photograph = True, asked.across, True
    elif asked.texture:
        textured = fetch_texture(where, asked.texture)

    # The ground of this place, if somebody built one. tools/ground turns a
    # reference directory into a colour map of the actual seabed: the survey's
    # orthomosaic where there is one, and habitat class laid down from the
    # satellite's pattern everywhere else. It has existed for Looe Key since
    # the second of September and nothing has ever drawn it.
    ground = ground_said = None
    if asked.ground:
        import numpy as np
        from PIL import Image
        into = where / "textures"
        into.mkdir(exist_ok=True)
        for role, surface in SURFACES.items():
            if not fetch_texture(where, surface, prefix=role, disp=True):
                raise SystemExit(f"the ground needs {surface}'s maps and they "
                                 f"did not arrive")

        reference = pathlib.Path(asked.ground).expanduser()
        colour = reference / "colour_4096.png" if reference.is_dir() else reference
        classes = reference / "habitat_4096.npy" if reference.is_dir() else None
        surveyed_ground = colour.is_file()
        # Where the hard ground is. From the habitat polygons a survey drew,
        # if there are any; from the shape of the seabed if not.
        #
        # It used to be pavement everywhere when there was no map, on the
        # grounds that sand where there is reef reads as a reef somebody
        # dredged. That is true and it left four of five places as one flat
        # grey plane at close range, which is the thing A3 exists to stop.
        if classes is not None and classes.is_file():
            kinds = np.load(classes)
            hard = np.zeros(kinds.shape, dtype="float32")
            for kind, how_hard in HARDNESS.items():
                hard[kinds == kind] = how_hard
            # Where nobody mapped it, the inference — not a constant.
            #
            # Class 0 is "unmapped" and `HARDNESS` gives it 0.5, which is an
            # honest "don't know" for one polygon and is the can't-be-wrong
            # default over a large area: it says the same thing about every
            # square metre of it. The Atlas maps Al Fahal's flat and lagoon
            # and not its fore-reef slope, so a quarter of that site was
            # taking a flat half and dominating the habitat figure.
            #
            # A guess that varies with the ground beats a constant that does
            # not. Measurement where there is one, inference where there is
            # not, and a number picked out of the air nowhere.
            nobody_looked = kinds == 0
            if nobody_looked.any():
                guessed = derived_hardness(height, asked.across,
                                           n=kinds.shape[0])
                hard = np.where(nobody_looked, guessed, hard).astype("float32")

            # Softened to the map's own resolution, where it says what that is.
            #
            # The Allen Coral Atlas is a ten-metre raster vectorised into
            # polygons, so its boundaries are stacks of ten-metre rectangles —
            # and drawn as a step, a boundary known to ten metres is a claim
            # of precision the map does not have. Kāne'ohe's derived colour
            # came out visibly tiled. A boundary known to ten metres is drawn
            # over ten metres.
            #
            # Only where the reference says its resolution. A survey that
            # mapped a reef at a metre should keep its edges.
            told = (pathlib.Path(asked.ground).expanduser() / "coral-atlas.json"
                    if asked.ground else None)
            if told and told.is_file():
                try:
                    coarse = float(json.loads(told.read_text())["resolutionM"])
                except Exception:
                    coarse = 0.0
                # A step softened with a Gaussian of sigma s transitions
                # over about two and a half s, so a boundary known to ten
                # metres wants a four-metre sigma. Taking sigma as the full
                # ten spread the influence over forty metres and grew
                # Kāne'ohe's habitat by two fifths — which is not softening a
                # boundary, it is moving one.
                texels = coarse / (asked.across / max(1, hard.shape[0] - 1))
                if texels >= 2.5:
                    was = float((hard > 0.1).mean())
                    hard = _soften(hard, texels / 2.5)
                    print(f"  habitat: boundaries softened over {coarse:.0f} m, "
                          f"which is what that map resolves "
                          f"({100 * was:.0f}% hard before, "
                          f"{100 * float((hard > 0.1).mean()):.0f}% after)")
            named = ", ".join(f"{HABITAT_NAMES.get(k, k)} {100 * (kinds == k).mean():.0f}%"
                              for k in sorted(set(np.unique(kinds).tolist())))
            print(f"  habitat: surveyed polygons: {named}")
            hardness_from = ("habitat polygons from a survey of this place"
                             + (", and the slope and relief of the seabed "
                                "where the survey did not reach"
                                if nobody_looked.any() else ""))
        elif morphology and morphology.get("hard") is not None:
            # A composed place knows, because it laid its own parts down by
            # name. Reading it back out of the shape is guessing at something
            # this pipeline decided itself an hour earlier — and it guessed
            # wrong: the rugosity a fringing reef gets is applied everywhere,
            # so the sand terrace came back textured enough to be rock and
            # Red Sea was called 98.5% reef habitat.
            said = np.asarray(morphology["hard"], dtype="float32")
            at = (np.linspace(0, said.shape[0] - 1, 1024).astype(int)[:, None],
                  np.linspace(0, said.shape[1] - 1, 1024).astype(int)[None, :])
            hard = said[at]
            print(f"  habitat: from the composition itself, "
                  f"{100 * float(hard.mean()):.0f}% hard")
            hardness_from = morphology.get("hardFrom", "the composition itself")
        else:
            hard = derived_hardness(height, asked.across)
            print(f"  habitat: derived from slope and relief, "
                  f"{100 * float(hard.mean()):.0f}% hard")
            hardness_from = ("derived from the slope and relief of the seabed, "
                             "not from any survey: sediment collects where the "
                             "water is slow and the ground is flat")

        # Ground that `tools/past-the-limit` built is sediment, and is known
        # to be rather than inferred.
        #
        # It has to be said, because the inference reads it as rock. The flank
        # is continued at the gradient it was last measured falling at — 1.77°
        # at Al Fahal — and `zonation` calls anything with a slope on it hard,
        # so a quarter of that site went from 0.5% hard as a flat plateau to
        # 30% hard as a ramp, and its reef habitat went *up* from 67% of the
        # site to 93%. Fixing the geometry made the habitat worse, which is
        # what inferring a thing you already know looks like.
        #
        # What that ground is is not in doubt: it is the sediment apron off
        # the toe of a reef, running out to the shelf. The reef stops where
        # the sensor stopped seeing it, and everything past that is sand.
        past_the_sensor = ((survey_note or {}).get("constructedPastTheSensor")
                           if survey_note else None)
        if past_the_sensor:
            bits = (pathlib.Path(asked.heights).parent
                    / past_the_sensor.get("mask", "constructed.bits"))
            if bits.is_file():
                built_ground = np.unpackbits(
                    np.fromfile(bits, dtype="uint8"))[:height.size].reshape(
                        height.shape).astype(bool)
                at = (np.linspace(0, height.shape[0] - 1, hard.shape[0]).astype(int)[:, None],
                      np.linspace(0, height.shape[1] - 1, hard.shape[1]).astype(int)[None, :])
                hard = np.where(built_ground[at], SEDIMENT_APRON, hard
                                ).astype("float32")
                print(f"  habitat: and the {100 * float(built_ground.mean()):.0f}% "
                      f"of it built past the sensor is sediment, which is "
                      f"known rather than inferred")
                hardness_from += ("; and the ground continued past the sensor's "
                                  "limit is sediment apron off the toe of the "
                                  "reef, which is what it is by construction "
                                  "rather than something read off its shape")
        Image.fromarray((np.flipud(hard) * 255).astype("uint8")).save(
            into / "hardness.png")

        # And what the bottom looks like from above.
        #
        # North is at the top of a map and v = 0 is the south edge of the mesh,
        # so a fetched map is flipped on the way in. tools/ground says this
        # about its own output and it is the kind of thing that is invisible
        # until a reef is a mile from where the survey put it.
        if surveyed_ground:
            Image.open(colour).convert("RGB").transpose(
                Image.FLIP_TOP_BOTTOM).save(into / "site_colour.jpg", quality=95)
            colour_from = "orthomosaic and habitat classes from a survey"
        else:
            Image.fromarray(np.flipud(derived_colour(height, hard, asked.across))).save(
                into / "site_colour.jpg", quality=95)
            colour_from = ("derived: carbonate sand and turf-grown rock at "
                           "their own reflectances, dimmed and reddened out "
                           "with depth. Not a photograph of this place")
            print("  colour: derived from depth and hardness, not photographed")

        # And what the soft half of the ground is.
        #
        # A photograph of wet rippled sand, everywhere the waves reach. Below
        # that, mud that nothing has stirred but animals — because the ripples
        # in every soft-seabed texture in every library were made by surface
        # waves, and a regular directional corrugation half a kilometre down is
        # not a small error. It is the single thing a diver would name first.
        under_the_waves = -float(np.median(height)) >= sediment.BELOW_THE_WAVES_M
        soft_files = {role: f"soft_{role}.jpg" for role in
                      ("colour", "normal", "rough")}
        soft_files["height"] = "soft_disp.jpg"
        soft_named = SURFACES["soft"]
        soft_said = None
        if under_the_waves:
            soft_said = sediment.write_into(into, tile_metres=asked.tile,
                                            seed=abs(hash(asked.name)) % (2 ** 31))
            soft_files = {role: f"soft_{role}.png" for role in
                          ("colour", "normal", "rough", "height")}
            soft_named = "bioturbated mud, generated"
            print("  sediment: bioturbated mud, not rippled sand — %.0f m down "
                  "is below the reach of the waves (%.0f%% of the surface "
                  "worked, %.0f mm of relief)"
                  % (-float(np.median(height)),
                     100 * soft_said["workedFraction"],
                     1000 * soft_said["reliefM"]))

        ground = {
            "soft": soft_named, "hard": SURFACES["hard"],
            "soft_average": (", ".join(f"{c:.4f}" for c in soft_said["average"])
                             if soft_said else average_of(into / "soft_colour.jpg")),
            "hard_average": average_of(into / "hard_colour.jpg"),
            **{f"soft_{role}_file": name for role, name in soft_files.items()},
        }
        ground_said = {"hardnessFrom": hardness_from, "colourFrom": colour_from,
                       "surveyed": bool(surveyed_ground),
                       # Whether this place is telling us what it is made of
                       # rather than being guessed at. True for a survey's
                       # habitat polygons and for a composed reef's own parts.
                       # Whether this place is telling us what *all* of it is
                       # made of rather than being guessed at. True for a
                       # survey's habitat polygons and for a composed reef's
                       # own parts.
                       #
                       # Not for Al Fahal, which knows only the quarter of
                       # itself that was built past the sensor. That quarter
                       # is passed to the reef so nothing is planted on it,
                       # and the other three quarters are still an inference —
                       # so the guard that asks whether the inference has
                       # stopped discriminating must still run. Folding the
                       # two together silenced it on a site where 72% of the
                       # ground is a guess.
                       "knowsItsOwn": bool(
                           (classes is not None and classes.is_file())
                           or (morphology and morphology.get("hard") is not None)),
                       "knowsPartOfItself": bool(past_the_sensor),
                       "softFrom": (
                           "bioturbated mud, generated: trails, burrow mouths, "
                           "mounds and casts. The kinds of trace are what a "
                           "bathyal seabed photograph shows and what the Red "
                           "Sea Decade Expedition's transects show on this "
                           "slope; how many of each is chosen, not counted. "
                           "Used because this place is below %.0f m, where the "
                           "waves do not reach the bottom and a rippled sand "
                           "texture is a lie about where the place is"
                           % sediment.BELOW_THE_WAVES_M) if soft_said else
                       ("%s, photographed wet rippled sand"
                        % SURFACES["soft"]),
                       **({"soft": soft_said} if soft_said else {})}

        # The material lives with the place, not in this checkout: a published
        # package has to carry everything it is drawn from.
        mdl = (pathlib.Path(__file__).resolve().parent.parent
               / "catalog" / "materials" / "coral_ground.mdl")
        shutil.copy(mdl, where / "coral_ground.mdl")
        # `soft_named`, not SURFACES["soft"]: this line said
        # "damp_beach_sand_02" directly underneath the line saying the place
        # was floored with mud instead, which is a report that contradicts the
        # report above it.
        print(f"  ground: {colour.name} as the site colour, "
              f"{soft_named} and {SURFACES['hard']} every {asked.tile:.0f} m")

    made = write_usd(where, asked.name, height, asked.across, asked.tile,
                     asked.texture if textured else None, photograph=photograph,
                     ground=ground)

    # A place with no coral on it still has to say why it has none. Thuwal
    # Deep is 520 m down and below the light, which is a measurement rather
    # than an absence of one — and until this was written it came back from
    # tools/check-places as a density nobody could account for.
    reef = {"colonies": 0, "cover": {
        "colonies": 0, "perSquareKm": 0,
        "from": asked.cover_from or "no coral was asked for at this place",
        "measured": False}}
    if asked.coral > 0:
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
        import reef as grow_reef
        seen_from_above = None
        if asked.photograph:
            from PIL import Image
            seen_from_above = np.asarray(
                Image.open(asked.photograph).convert("RGB"), dtype="float64")
        # A place's own corpus, if it has one. Where it holds a scan of a
        # colony, the reef stands scans rather than grown shapes.
        corpus = pathlib.Path.home() / "coral-city" / "reference" / asked.name
        reef = grow_reef.plant(where, height, asked.across, asked.seed, asked.coral,
                               cover_from=asked.cover_from,
                               assemblage=asked.assemblage,
                               picture=seen_from_above,
                               # The same ground this seabed is painted with,
                               # The same ground this seabed is painted with,
                               # wherever the place knows it — all of it for a
                               # survey or a composition, and the sediment
                               # apron alone for a seabed continued past its
                               # sensor. Either way the coral does not grow on
                               # ground the pipeline itself called sand.
                               hard=hard if ground_said and (
                                   ground_said.get("knowsItsOwn")
                                   or ground_said.get("knowsPartOfItself")
                               ) else None,
                               # And whether *all* of it is known, which is a
                               # different question and the one the habitat
                               # guard turns on.
                               knows_its_own=bool(
                                   ground_said
                                   and ground_said.get("knowsItsOwn")),
                               reference=corpus if corpus.is_dir() else None)

    import numpy as np
    depth = -height
    wet = depth[depth > 0]

    site = {
        "name": asked.name,
        # Where this ground came from, and whether anybody measured it.
        #
        # The same distinction this platform already makes about water:
        # observed conditions name the instant they were measured and
        # constructed ones may not, because saying when would claim a
        # provenance they lack. It applies exactly as much to the ground, and a
        # result from a constructed seabed is a real result about a place that
        # was never surveyed.
        "from": {
            "surveyed": surveyed,
            **({"raster": pathlib.Path(asked.raster).name}
               if surveyed and asked.raster else {}),
            # Which surveys the ground was actually drawn from. "Real
            # bathymetry" is a claim, and the difference between a lidar flown
            # over a reef and a global grid interpolated across it is the
            # difference between a site and a smooth ramp — so the site names
            # the surveys rather than asserting the adjective.
            **({"surveys": survey_note.get("surveys", []),
                "source": survey_note.get("source"),
                "surveyedFraction": survey_note.get("surveyedFraction")}
               if survey_note else {}),
            **({k: survey_note[k] for k in
                ("method", "observedAt", "opticalLimitM", "bottomVisibleFraction",
                 "beyondOpticalDepthFraction", "medianDetailM", "toCalibrate",
                 # Where the sensor that measured this ground went blind and
                 # the flank was continued instead. Carried through rather
                 # than left in the reference, because the place is the thing
                 # somebody flies and the place has to say which of its
                 # seabed is a measurement. A quarter of Al Fahal is not.
                 "constructedPastTheSensor", "fittedAgainst")
                if survey_note and k in survey_note}),
            # Without the hardness map itself, which is an array and belongs
            # in hardness.png beside the place rather than in its record.
            **({"constructed": {k: v for k, v in morphology.items()
                                if k != "hard"}} if morphology else {}),
            **({"centre": {"latitude": asked.centre[0],
                           "longitude": asked.centre[1]}} if asked.centre else {}),
            "acrossMetres": asked.across,
            "sampleMetres": round(asked.across / max(1, height.shape[0] - 1), 2),
            "decimatedBy": step,
        },
        "datum": "mean sea level; z = 0 is the surface and depth is negative z",
        "deepestM": round(float(wet.max()) if wet.size else 0.0, 2),
        "shallowestM": round(float(wet.min()) if wet.size else 0.0, 2),
        "underwater": round(float((depth > 0).mean()), 3),
        "mesh": made,
        "reef": reef,
        # What this place is made of, named rather than guessed at. A runner
        # picking "the first USD that is not obviously water" would load
        # coral.usda as the world, because c sorts before s.
        # Where a dive begins here, when the place has an opinion about it.
        # Where a dive should begin. A constructed site knows because it was
        # built to a plan; a surveyed one has to be read off its own ground, and
        # the reef says where the reef is. Either way the middle of the site is
        # the wrong answer — at Looe Key the middle is three metres of surf.
        # The band is said rather than written in, because it is not always
        # eight to eighteen: a place below the light has no cell in that band
        # at all and uses its own depths instead, and a record that claims
        # "between eight and eighteen metres" for a start at five hundred and
        # fifty-six is a record that is wrong about the one thing it is for.
        **({"beginAt": reef["beginAt"]["at"],
            "beginBecause": "the best reef within %s, three metres off the "
                            "bottom (%.0f%% cover at %.0f m)"
                            % (reef["beginAt"].get(
                                   "within",
                                   "the band a vehicle works a reef in"),
                               100 * reef["beginAt"]["coverThere"],
                               reef["beginAt"]["depthM"])}
           if reef.get("beginAt") and not (morphology and "beginAt" in morphology)
           else {}),
        **({"beginAt": morphology["beginAt"],
            "beginBecause": morphology.get("beginBecause", "")}
           if morphology and "beginAt" in morphology else {}),
        # And where a dive begins on ground with no reef on it.
        #
        # Every other place gets its start from its coral: the best reef in
        # the working band. Thuwal Deep has no coral — it is five hundred
        # metres down, which is the point of it — so nothing ever chose one,
        # `beginAt` stayed null, and the consequences were quiet and total.
        # No anchor for the stills, so no camera; no camera, so no medium to
        # bake; and every sheet of the place came back a dark rectangle that
        # looked like a rendering fault.
        #
        # A place that cannot be flown is not a place. So ground with nothing
        # growing on it gets a start read off the ground itself: somewhere
        # flat, at the depth most of the site is at, far enough from the edge
        # to fly in any direction.
        **(where_a_dive_begins(height, asked.across)
           if not reef.get("beginAt")
           and not (morphology and "beginAt" in morphology) else {}),
        "layers": {
            "terrain": "seabed.usda",
            "heightfield": "seabed.f32",
            **({"coral": "coral.usda"} if reef.get("colonies") else {}),
        },
        # What the bottom is made of, and where that came from. A sand patch
        # worked out from the slope and a sand patch somebody mapped look the
        # same in a frame and are not the same claim.
        **({"ground": ground_said} if ground is not None else {}),
    }
    if asked.water:
        site["water"] = {"type": asked.water, "from": asked.water_from}
    if asked.assemblage:
        site.setdefault("reef", {})["assemblage"] = {
            "name": asked.assemblage, "from": asked.assemblage_from}
    built.carry_the_record_forward(site, where / "site.json")
    built.record_call(site, "make-site")
    (where / "site.json").write_text(json.dumps(site, indent=2) + "\n")
    # Finished. Nothing above this line may be trusted if it is still there.
    torn.unlink(missing_ok=True)

    print(f"  {asked.name}"
          f"{'' if surveyed else '  (terrain constructed, not surveyed)'}")
    print(f"    {asked.across:.0f} m across at {site['from']['sampleMetres']} m samples")
    print(f"    {made['points']:,} points, {made['triangles']:,} triangles")
    print(f"    depth {site['shallowestM']} to {site['deepestM']} m, "
          f"{site['underwater']*100:.0f}% underwater")
    if reef["colonies"]:
        print(f"    {reef['colonies']:,} coral colonies from "
              f"{reef['prototypes']} grown prototypes")
        print(f"    {reef['coverWhereItGrows']*100:.0f}% cover where it grows, "
              f"over {reef['reefAreaM2']:,} m²; "
              f"{reef['denseAreaM2']:,} m² of thicket")
    print(f"    {where}/seabed.usda")
    return 0


if __name__ == "__main__":
    sys.exit(main())
