# What the two surfaces of a reef are, in the CC0 library that has them.
#
# Not a beach. The seabed used to be `coast_sand_03`, which is a shingle bank
# in Normandy, and tiled over a Caribbean fore reef it made the whole place a
# gravel pit. These are what they say they are: Poly Haven's `coral_ground_02`
# is photographed coral rubble and pavement, and `damp_beach_sand_02` is wet
# rippled sand, which is what the bottom of a groove is.
SURFACES = {"soft": "damp_beach_sand_02", "hard": "coral_ground_02"}

# Sand, pavement, and how hard each habitat class the survey mapped is. Class 0
# is ground nobody mapped, so it is given the middle: neither claimed as reef
# nor claimed as sand.
HARDNESS = {0: 0.5, 1: 0.0, 2: 0.15, 3: 0.10, 4: 0.60, 5: 0.90, 6: 1.0, 7: 1.0}
HABITAT_NAMES = {0: "unmapped", 1: "sediment", 2: "seagrass (patchy)",
                 3: "seagrass", 4: "rubble", 5: "pavement",
                 6: "aggregate reef", 7: "spur and groove"}


def fetch_texture(where: pathlib.Path, name: str, prefix: str = "seabed",
                  disp: bool = False) -> bool:
    """The CC0 maps a seabed is surfaced with, from Poly Haven."""
    import urllib.request

    maps = {"colour": "diff", "rough": "rough", "normal": "nor_gl"}
    if disp:
        # The height a surface stands at, which is what the two surfaces of a
        # reef are blended by.
        maps["disp"] = "disp"
    into = where / "textures"
    into.mkdir(exist_ok=True)
    base = "https://dl.polyhaven.org/file/ph-assets/Textures/jpg/2k"
    for local, kind in maps.items():
        target = into / f"{prefix}_{local}.jpg"
        if target.exists():
            continue
        url = f"{base}/{name}/{name}_{kind}_2k.jpg"
        try:
            with urllib.request.urlopen(url, timeout=120) as answer:
                target.write_bytes(answer.read())
        except Exception as exc:
            print(f"    could not fetch {name} {kind}: {exc}")
            return False
    return True



def derived_hardness(height, across: float, n: int = 1024):
    """Where the hard ground is, worked out from the shape of the seabed.

    For the four places with no habitat map. Sediment collects where the water
    is slow and the ground is flat; rock stays bare where it is steep or
    standing proud. So: slope makes ground hard, and sitting in a hollow makes
    it soft.

    This is a model, not a survey, and the difference matters — it is written
    into the record as derived so that nobody reads a sand patch here as a
    sand patch somebody mapped. What it buys is a seabed that is two surfaces
    instead of one flat grey plane, everywhere rather than at the one site
    that has polygons.
    """
    import numpy as np
    from scipy import ndimage

    rows, columns = height.shape
    step = across / max(1, columns - 1)
    dy, dx = np.gradient(height.astype("float64"), step, step)
    slope = np.hypot(dx, dy)

    # How far this ground stands above the ground around it. A hollow fills
    # with sand; a rise is scoured.
    wide = max(3, int(round(25.0 / step)))
    around = ndimage.uniform_filter(height.astype("float64"), wide)
    stands = height - around

    # Both to nought-to-one on their own spread, because a reef flat and a
    # continental slope have nothing in common but the shape of the histogram.
    def spread(field, gentle=0.8):
        middle = np.median(field)
        scale = np.median(np.abs(field - middle)) * 1.4826
        return 1.0 / (1.0 + np.exp(-(field - middle) / max(scale * gentle, 1e-6)))

    hard = np.clip(0.62 * spread(slope) + 0.38 * spread(stands), 0.0, 1.0)
    # And the shallowest water is scoured whatever the shape: a reef crest in
    # the surf holds no sediment.
    crest = np.clip((height + 4.0) / 3.0, 0.0, 1.0)
    hard = np.clip(hard + 0.35 * crest, 0.0, 1.0)

    at = (np.linspace(0, rows - 1, n).astype(int)[:, None],
          np.linspace(0, columns - 1, n).astype(int)[None, :])
    return hard[at].astype("float32")


def derived_colour(height, hard, across: float, n: int = 1024):
    """What the bottom looks like from above, where nobody has photographed it.

    Carbonate sand is pale and nearly white in the shallows; rock under turf
    algae is dark olive-brown; everything goes bluer and darker with depth
    because that is what the water takes. These are reflectances, not pixels
    off a photograph — a picture of a reef through ten metres of water is not
    the reef's albedo, and this platform has made that mistake once already.
    """
    import numpy as np

    rows, columns = height.shape
    at = (np.linspace(0, rows - 1, n).astype(int)[:, None],
          np.linspace(0, columns - 1, n).astype(int)[None, :])
    deep = -height[at]

    sand = np.array([0.74, 0.71, 0.62])
    rock = np.array([0.20, 0.21, 0.16])
    colour = (sand[None, None, :] * (1 - hard[..., None])
              + rock[None, None, :] * hard[..., None])
    # Deeper ground is dimmer ground, and loses its red first.
    dim = np.exp(-np.clip(deep, 0, None)[..., None]
                 / np.array([26.0, 55.0, 70.0])[None, None, :])
    return np.clip(colour * (0.45 + 0.55 * dim) * 255, 0, 255).astype("uint8")


def average_of(path: pathlib.Path) -> str:
    """What a texture's own colour is, so a material can divide it out.

    In linear, because that is the space the renderer multiplies in. Left in,
    a grain tints the whole seabed towards whatever beach it was photographed
    on, which is a thing nobody notices until the reef is the wrong colour and
    nobody can say why.
    """
    import numpy as np
    from PIL import Image

    grain = np.asarray(Image.open(path).convert("RGB"), dtype="float64") / 255.0
    linear = np.where(grain <= 0.04045, grain / 12.92,
                      ((grain + 0.055) / 1.055) ** 2.4)
    return ", ".join(f"{c:.4f}" for c in linear.reshape(-1, 3).mean(axis=0))


def write_usd(where: pathlib.Path, name: str, height, across: float,
              tile: float, texture: str | None, photograph: bool = False,
              ground: dict | None = None) -> dict:
    """The seabed, as a mesh, in a USD anybody can open."""
    import numpy as np

    rows, columns = height.shape
    # Spaced so the patch spans exactly what was asked for, centred on nothing:
    # the origin is the middle of the site, which is where a dive begins.
    ys = np.linspace(-across / 2, across / 2, rows, dtype="float32")
    xs = np.linspace(-across / 2, across / 2, columns, dtype="float32")
    grid_x, grid_y = np.meshgrid(xs, ys)

    points = np.stack([grid_x, grid_y, height], axis=-1).reshape(-1, 3)

    # Normals from the surface itself rather than from the triangles, so that a
    # seabed reads as a surface with slopes on it instead of a field of facets.
    dy, dx = np.gradient(height.astype("float64"),
                         across / max(1, rows - 1), across / max(1, columns - 1))
    normals = np.stack([-dx, -dy, np.ones_like(dx)], axis=-1)
    normals /= np.linalg.norm(normals, axis=-1, keepdims=True)
    normals = normals.reshape(-1, 3).astype("float32")

    # Two triangles per cell, wound so the outside is up.
    top_left = (np.arange(rows - 1)[:, None] * columns + np.arange(columns - 1)[None, :])
    a = top_left.ravel()
    b, c, d = a + 1, a + columns, a + columns + 1
    faces = np.empty((a.size * 2, 3), dtype="int32")
    faces[0::2] = np.stack([a, c, b], axis=-1)
    faces[1::2] = np.stack([b, c, d], axis=-1)

    # Texture coordinates in metres over a tile, not zero-to-one over the site.
    #
    # A photograph of sand stretched across a kilometre is a kilometre-wide
    # photograph of sand: every grain is three metres across and the seabed
    # reads as a painted backdrop. Repeating it every few metres is what makes
    # it ground.
    #
    # The ground material is the exception, and it is zero-to-one over the
    # site: it has a map of this particular seabed to lay down, which only
    # goes on once, and it does its own tiling of the detail on top. Doing the
    # tiling here and the site map in the shader would work equally well until
    # somebody changed the tile size and moved the reef.
    if ground is not None:
        u = (grid_x / across + 0.5).reshape(-1).astype("float32")
        v = (grid_y / across + 0.5).reshape(-1).astype("float32")
    else:
        u = (grid_x / tile).reshape(-1).astype("float32")
        v = (grid_y / tile).reshape(-1).astype("float32")

    def numbers(values, per):
        out, row = [], []
        for i, value in enumerate(values.reshape(-1)):
            row.append(f"{value:.4g}")
            if (i + 1) % per == 0:
                out.append(", ".join(row)); row = []
        if row:
            out.append(", ".join(row))
        return "\n        ".join(out)

    def triples(values):
        return ", ".join(f"({x:.4g}, {y:.4g}, {z:.4g})" for x, y, z in values)

    def pairs(us, vs):
        return ", ".join(f"({a:.5g}, {b:.5g})" for a, b in zip(us, vs))

    lowest, highest = float(height.min()), float(height.max())
    if ground is not None:
        # A reef photographed through ten metres of water comes back flat and
        # blue-grey; tools/ground has already taken the water out of the
        # orthomosaic, so this only lifts it, and gently.
        material = GROUND_MATERIAL % dict(
            ground, tile=tile, across=across, repeats=across / max(tile, 1e-6),
            grain=0.85, relief=1.0, lift=1.05)
    elif texture:
        material = SEABED_MATERIAL
    else:
        material = UNTEXTURED_MATERIAL
    if photograph and ground is None:
        # The sand correction exists because a dry beach photographed in
        # sunlight is the brightest thing in any scene. This is a reef
        # photographed through twenty metres of water, which is the opposite
        # problem, and correcting it again takes it further from the truth.
        material = material.replace("float4 inputs:scale = (1.05, 1.0, 0.92, 1)",
                                    "float4 inputs:scale = (1.25, 1.2, 1.1, 1)")
        material = material.replace('token inputs:wrapS = "repeat"',
                                    'token inputs:wrapS = "clamp"')
        material = material.replace('token inputs:wrapT = "repeat"',
                                    'token inputs:wrapT = "clamp"')
    body = f'''#usda 1.0
(
    doc = "{name}: real seafloor, from a bathymetric survey. Metres, Z up, z=0 at the water surface."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{{
    def Mesh "Seabed" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {{
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [{", ".join(["3"] * len(faces))}]
        int[] faceVertexIndices = [{", ".join(str(i) for i in faces.reshape(-1))}]
        point3f[] points = [{triples(points)}]
        normal3f[] normals = [{triples(normals)}] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st = [{pairs(u, v)}] (
            interpolation = "vertex"
        )
        float3[] extent = [({-across/2:.1f}, {-across/2:.1f}, {lowest:.2f}), ({across/2:.1f}, {across/2:.1f}, {highest:.2f})]
        rel material:binding = </World/Looks/Seabed>
    }}
{material}
}}
'''
    (where / "seabed.usda").write_text(body)

    # The same heights again, as numbers rather than as a mesh.
    #
    # A dive needs to know how deep the bottom is under the vehicle — to land on
    # it, to hold an altitude above it, to score a transect that was supposed to
    # stay two metres off it. Asking the renderer would mean a ray cast into
    # geometry that exists only when somebody is watching; asking physics would
    # mean colliders on a scene that has none. The site knows, so the site says,
    # and a batch dive with nothing drawn gets exactly the same answer as a
    # dive somebody is flying.
    height.astype("<f4").tofile(where / "seabed.f32")
    return {"lowest": lowest, "highest": highest,
            "points": int(points.shape[0]), "triangles": int(faces.shape[0]),
            "heightfield": {"rows": rows, "columns": columns,
                            "format": "little-endian float32, row major, "
                                      "south to north then west to east",
                            "file": "seabed.f32"}}


def main() -> int:
    parse = argparse.ArgumentParser(description="make a place out of seafloor")
    parse.add_argument("name")
    parse.add_argument("--raster",
                       help="a bathymetric survey to cut the terrain from")
    parse.add_argument("--heights",
                       help="a square already cut by tools/get-bathymetry — "
                            "its .json, with the .f32 beside it")
    parse.add_argument("--build", choices=("fringing-reef",),
                       help="construct the terrain instead, where no survey exists")
    parse.add_argument("--centre", nargs=2, type=float,
                       metavar=("LAT", "LON"),
                       help="where this place is, whether surveyed or not")
    parse.add_argument("--across", type=float, default=1000.0,
                       help="metres across, square")
    parse.add_argument("--most", type=int, default=512,
                       help="most samples along a side")
    # Outside the source tree by default. A place is built from public
    # bathymetry and published to object storage by digest; a copy in the
    # repository would be a second origin for the same bytes, and a large one —
    # and an eleven megabyte generated file appearing in a checkout is enough to
    # stop a deploy, which is exactly what it did.
    # A ceiling, not a target. How many colonies a reef needs is decided by the
    # cover the ground can hold and the size the colonies came out at; this is
    # only how many the pipeline is willing to write.
    parse.add_argument("--coral", type=int, default=2400000,
                       help="most coral colonies to write")
    parse.add_argument("--seed", type=int, default=1,
                       help="the same seed grows the same reef")
    parse.add_argument("--cover-from",
                       help="where this reef's density comes from: name the "
                            "survey, or say it was chosen. Required whenever "
                            "coral is grown, because a density with no source "
                            "is a number somebody will cite as a measurement")
    parse.add_argument("--ground",
                       help="a reference directory built by tools/ground, or its "
                            "colour_4096.png: the colour of this actual seabed, "
                            "laid under tiled relief")
    parse.add_argument("--photograph",
                       help="an image of this square to surface it with, "
                            "instead of a tiled stock seabed")
    parse.add_argument("--texture", default="coast_sand_03",
                       help="a Poly Haven CC0 texture to surface the seabed with")
    # Ten metres, not four. A photograph of sand repeating every four metres
    # over a kilometre of seabed reads as a checkerboard — the eye finds the
    # period long before it stops seeing the grain, and once seen it is all
    # anybody sees.
    parse.add_argument("--tile", type=float, default=10.0,
                       help="metres the seabed texture repeats over")
    parse.add_argument("--into",
                       default=str(pathlib.Path.home() / "coral-city" / "places"))
    asked = parse.parse_args()

    where = pathlib.Path(asked.into) / asked.name
    where.mkdir(parents=True, exist_ok=True)

    if asked.build:
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
        import fringing
        height, morphology = fringing.build(asked.across, asked.most, asked.seed)
        step, surveyed = 1, False
        survey_note = None
    elif asked.heights:
        # Already centred, already cut, already square. Nothing here has to know
        # about projections or geotransforms, which is the difference between
        # this and --raster: that path wants a GDAL build on whatever machine
        # runs it, and this one wants numpy.
        import numpy as np
        note = json.loads(pathlib.Path(asked.heights).read_text())
        # tools/get-bathymetry wraps the field; tools/ground writes its 1 m
        # seabed with the same keys at the top level. Both are a square of
        # float32 with a note beside it, and the one worth building from is
        # the second: it has the survey's own metre feathered into the
        # mosaic's two.
        field = note.get("heightfield", note)
        beside = pathlib.Path(asked.heights).parent / field["file"]
        height = np.fromfile(beside, dtype="<f4").reshape(
            field["rows"], field["columns"])
        asked.across = float(note["acrossMetres"])
        if asked.centre is None:
            asked.centre = (note["centre"]["latitude"], note["centre"]["longitude"])
        # What the heights say about themselves, rather than an assumption.
        # This was hardcoded True, which meant a square derived from a
        # satellite picture — shape from the light coming off the bottom,
        # depths scaled against the reef's own geomorphology — was recorded as
        # a survey. It is not one, it says so, and the site has to carry that
        # through rather than launder it.
        morphology, step = None, 1
        surveyed = bool(note.get("surveyed", True))
        survey_note = note
    elif asked.raster:
        height, step = read_patch(asked.raster, tuple(asked.centre or (0, 0)),
                                  asked.across, asked.most)
        morphology, surveyed = None, True
        survey_note = None
    else:
        raise SystemExit("give it a --raster to cut from, or a --build to construct")

    textured, photograph = False, False
    if asked.photograph:
        # The reef, surfaced with a photograph of itself. A stock seabed tiled
        # over a real reef is the thing that makes a site look invented: the
        # shape is right and the surface is somebody else's sand, repeating.
        # A ten-metre satellite pixel is coarse for a close-up, and it is the
        # actual colour of the actual coral in the actual place.
        import numpy as np
        from PIL import Image
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
        import zonation

        into = where / "textures"
        into.mkdir(exist_ok=True)
        # Roughness and bumps still come from the stock seabed: at arm's length
        # a reef has a grain a ten-metre pixel cannot know about, and borrowing
        # it is honest as long as the ground's colour is the ground's own.
        fetch_texture(where, asked.texture)
        seen = np.asarray(Image.open(asked.photograph).convert("RGB"), dtype="float64")
        # Not the photograph. A picture of a reef taken through fifteen metres
        # of water is not the reef's albedo, and handing it to a renderer as
        # one gets it attenuated twice — the ground goes black under lit coral.
        # The picture says where the sand and the pavement are; what colour
        # those are is a property of what they are.
        Image.fromarray(zonation.substrate_colour(height, asked.across, picture=seen)).save(
            into / "seabed_colour.jpg", quality=94)
        textured, asked.tile, photograph = True, asked.across, True
    elif asked.texture:
        textured = fetch_texture(where, asked.texture)

    # The ground of this place, if somebody built one. tools/ground turns a
    # reference directory into a colour map of the actual seabed: the survey's
    # orthomosaic where there is one, and habitat class laid down from the
    # satellite's pattern everywhere else. It has existed for Looe Key since
    # the second of September and nothing has ever drawn it.
    ground = ground_said = None
    if asked.ground:
        import numpy as np
        from PIL import Image
        into = where / "textures"
        into.mkdir(exist_ok=True)
        for role, surface in SURFACES.items():
            if not fetch_texture(where, surface, prefix=role, disp=True):
                raise SystemExit(f"the ground needs {surface}'s maps and they "
                                 f"did not arrive")

        reference = pathlib.Path(asked.ground).expanduser()
        colour = reference / "colour_4096.png" if reference.is_dir() else reference
        classes = reference / "habitat_4096.npy" if reference.is_dir() else None
        surveyed_ground = colour.is_file()
        # Where the hard ground is. From the habitat polygons a survey drew,
        # if there are any; from the shape of the seabed if not.
        #
        # It used to be pavement everywhere when there was no map, on the
        # grounds that sand where there is reef reads as a reef somebody
        # dredged. That is true and it left four of five places as one flat
        # grey plane at close range, which is the thing A3 exists to stop.
        if classes is not None and classes.is_file():
            kinds = np.load(classes)
            hard = np.zeros(kinds.shape, dtype="float32")
            for kind, how_hard in HARDNESS.items():
                hard[kinds == kind] = how_hard
            named = ", ".join(f"{HABITAT_NAMES.get(k, k)} {100 * (kinds == k).mean():.0f}%"
                              for k in sorted(set(np.unique(kinds).tolist())))
            print(f"  habitat: surveyed polygons: {named}")
            hardness_from = "habitat polygons from a survey of this place"
        else:
            hard = derived_hardness(height, across)
            print(f"  habitat: derived from slope and relief, "
                  f"{100 * float(hard.mean()):.0f}% hard")
            hardness_from = ("derived from the slope and relief of the seabed, "
                             "not from any survey: sediment collects where the "
                             "water is slow and the ground is flat")
        Image.fromarray((np.flipud(hard) * 255).astype("uint8")).save(
            into / "hardness.png")

        # And what the bottom looks like from above.
        #
        # North is at the top of a map and v = 0 is the south edge of the mesh,
        # so a fetched map is flipped on the way in. tools/ground says this
        # about its own output and it is the kind of thing that is invisible
        # until a reef is a mile from where the survey put it.
        if surveyed_ground:
            Image.open(colour).convert("RGB").transpose(
                Image.FLIP_TOP_BOTTOM).save(into / "site_colour.jpg", quality=95)
            colour_from = "orthomosaic and habitat classes from a survey"
        else:
            Image.fromarray(np.flipud(derived_colour(height, hard, across))).save(
                into / "site_colour.jpg", quality=95)
            colour_from = ("derived: carbonate sand and turf-grown rock at "
                           "their own reflectances, dimmed and reddened out "
                           "with depth. Not a photograph of this place")
            print("  colour: derived from depth and hardness, not photographed")

        ground = {
            "soft": SURFACES["soft"], "hard": SURFACES["hard"],
            "soft_average": average_of(into / "soft_colour.jpg"),
            "hard_average": average_of(into / "hard_colour.jpg"),
        }
        ground_said = {"hardnessFrom": hardness_from, "colourFrom": colour_from,
                       "surveyed": bool(surveyed_ground)}

        # The material lives with the place, not in this checkout: a published
        # package has to carry everything it is drawn from.
        mdl = (pathlib.Path(__file__).resolve().parent.parent
               / "catalog" / "materials" / "coral_ground.mdl")
        shutil.copy(mdl, where / "coral_ground.mdl")
        print(f"  ground: {colour.name} as the site colour, "
              f"{SURFACES['soft']} and {SURFACES['hard']} every {asked.tile:.0f} m")

    made = write_usd(where, asked.name, height, asked.across, asked.tile,
                     asked.texture if textured else None, photograph=photograph,
                     ground=ground)

    reef = {"colonies": 0}
    if asked.coral > 0:
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
        import reef as grow_reef
        seen_from_above = None
        if asked.photograph:
            from PIL import Image
            seen_from_above = np.asarray(
                Image.open(asked.photograph).convert("RGB"), dtype="float64")
        # A place's own corpus, if it has one. Where it holds a scan of a
        # colony, the reef stands scans rather than grown shapes.
        corpus = pathlib.Path.home() / "coral-city" / "reference" / asked.name
        reef = grow_reef.plant(where, height, asked.across, asked.seed, asked.coral,
                               cover_from=asked.cover_from,
                               picture=seen_from_above,
                               reference=corpus if corpus.is_dir() else None)

    import numpy as np
    depth = -height
    wet = depth[depth > 0]

    site = {
        "name": asked.name,
        # Where this ground came from, and whether anybody measured it.
        #
        # The same distinction this platform already makes about water:
        # observed conditions name the instant they were measured and
        # constructed ones may not, because saying when would claim a
        # provenance they lack. It applies exactly as much to the ground, and a
        # result from a constructed seabed is a real result about a place that
        # was never surveyed.
        "from": {
            "surveyed": surveyed,
            **({"raster": pathlib.Path(asked.raster).name}
               if surveyed and asked.raster else {}),
            # Which surveys the ground was actually drawn from. "Real
            # bathymetry" is a claim, and the difference between a lidar flown
            # over a reef and a global grid interpolated across it is the
            # difference between a site and a smooth ramp — so the site names
            # the surveys rather than asserting the adjective.
            **({"surveys": survey_note.get("surveys", []),
                "source": survey_note.get("source"),
                "surveyedFraction": survey_note.get("surveyedFraction")}
               if survey_note else {}),
            **({k: survey_note[k] for k in
                ("method", "observedAt", "opticalLimitM", "bottomVisibleFraction",
                 "beyondOpticalDepthFraction", "medianDetailM", "toCalibrate")
                if survey_note and k in survey_note}),
            **({"constructed": morphology} if morphology else {}),
            **({"centre": {"latitude": asked.centre[0],
                           "longitude": asked.centre[1]}} if asked.centre else {}),
            "acrossMetres": asked.across,
            "sampleMetres": round(asked.across / max(1, height.shape[0] - 1), 2),
            "decimatedBy": step,
        },
        "datum": "mean sea level; z = 0 is the surface and depth is negative z",
        "deepestM": round(float(wet.max()) if wet.size else 0.0, 2),
        "shallowestM": round(float(wet.min()) if wet.size else 0.0, 2),
        "underwater": round(float((depth > 0).mean()), 3),
        "mesh": made,
        "reef": reef,
        # What this place is made of, named rather than guessed at. A runner
        # picking "the first USD that is not obviously water" would load
        # coral.usda as the world, because c sorts before s.
        # Where a dive begins here, when the place has an opinion about it.
        # Where a dive should begin. A constructed site knows because it was
        # built to a plan; a surveyed one has to be read off its own ground, and
        # the reef says where the reef is. Either way the middle of the site is
        # the wrong answer — at Looe Key the middle is three metres of surf.
        **({"beginAt": reef["beginAt"]["at"],
            "beginBecause": "the best reef between eight and eighteen metres, "
                            "three metres off the bottom (%.0f%% cover at %.0f m)"
                            % (100 * reef["beginAt"]["coverThere"],
                               reef["beginAt"]["depthM"])}
           if reef.get("beginAt") and not (morphology and "beginAt" in morphology)
           else {}),
        **({"beginAt": morphology["beginAt"],
            "beginBecause": morphology.get("beginBecause", "")}
           if morphology and "beginAt" in morphology else {}),
        "layers": {
            "terrain": "seabed.usda",
            "heightfield": "seabed.f32",
            **({"coral": "coral.usda"} if reef.get("colonies") else {}),
        },
        # What the bottom is made of, and where that came from. A sand patch
        # worked out from the slope and a sand patch somebody mapped look the
        # same in a frame and are not the same claim.
        **({"ground": ground_said} if ground is not None else {}),
    }
    (where / "site.json").write_text(json.dumps(site, indent=2) + "\n")

    print(f"  {asked.name}"
          f"{'' if surveyed else '  (terrain constructed, not surveyed)'}")
    print(f"    {asked.across:.0f} m across at {site['from']['sampleMetres']} m samples")
    print(f"    {made['points']:,} points, {made['triangles']:,} triangles")
    print(f"    depth {site['shallowestM']} to {site['deepestM']} m, "
          f"{site['underwater']*100:.0f}% underwater")
    if reef["colonies"]:
        print(f"    {reef['colonies']:,} coral colonies from "
              f"{reef['prototypes']} grown prototypes")
        print(f"    {reef['coverWhereItGrows']*100:.0f}% cover where it grows, "
              f"over {reef['reefAreaM2']:,} m²; "
              f"{reef['denseAreaM2']:,} m² of thicket")
    print(f"    {where}/seabed.usda")
    return 0


if __name__ == "__main__":
    sys.exit(main())
