#!/usr/bin/env python3
"""Fly a mission against everything that could go wrong with it.

A dive that works is not the question. Ship time is the scarce thing, weather
windows close, and a season's outplanting happens or does not; what somebody
planning a mission wants to know is not whether it works but *what breaks it*,
and there is no way to find that out except by going and finding out. Once.

So: a mission, and a list of the things nobody is sure about — how hard the
current will be running and from where, whether the water will still be clear
after the weather, whether the array gets laid, whether a thruster gives out an
hour in. Each of those is a dimension, every combination is a dive, and the
whole cross product is flown overnight.

    tools/what-if missions/outplant-b7.json
    tools/what-if missions/outplant-b7.json --show     (read the last one)

**This is a client now.** The sweep belongs to the platform: it expands the
cross product, asks for the dives, keeps which scenario each run answers, and
works out what the answers mean. That was written here first and moved, because
two implementations of one piece of arithmetic are two answers waiting to
disagree — and because a sweep that only a terminal could run was a sweep
nobody could look at, share, resume, or put on a screen.

What is left here is the file format, the asking, and the printing.

The mission file names the place, the vehicle, the objective, the water that is
not in doubt, and the doubts:

    {"name": "outplant B7",
     "place": "al-fahal", "vehicle": "bluerov2",
     "objective": {...},
     "water": {"salinityPsu": 40.6, "temperatureC": 29.0},
     "good": 0.8,
     "doubts": {
       "current":  {"still": {}, "half a knot": {"currentMetresPerSecond": 0.26}},
       "fix":      {"array": {"positioning": {"kind": "lbl", "everyS": 3}},
                    "none":  {"positioning": {"kind": "none"}}}}}
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys
import time

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))


def platform():
    from importlib.machinery import SourceFileLoader
    return SourceFileLoader("matrix", str(HERE / "matrix")).load_module()


def slug_of(name: str) -> str:
    made = "".join(c if c.isalnum() else "-" for c in name.lower()).strip("-")
    while "--" in made:
        made = made.replace("--", "-")
    return made[:62] or "a-mission"


def mission_version(p, m, said: dict) -> str:
    """The plan of work, kept on the platform, so a sweep can doubt it.

    A sweep doubts a *mission* and not a dive, because the whole point is that
    one plan is flown many ways — and a plan that was not kept could not be
    flown twice by two people, let alone ninety times by a machine.
    """
    city = m.newest_version(p, "cities", said["place"])
    where = next(one for one in p.call("GET", "/api/v1/cities")["cities"]
                 if one["slug"] == said["place"])
    slug = slug_of(said["name"])
    found = [one for one in p.call("GET", f"/api/v1/cities/{where['id']}/missions")["missions"]
             if one["slug"] == slug]
    mission = found[0] if found else p.call(
        "POST", f"/api/v1/cities/{where['id']}/missions",
        {"slug": slug, "name": said["name"], "summary": said.get("note", "")})
    document = {"describedBy": "coral-city/mission/v1",
                "cityVersionId": city,
                "stages": said.get("stages") or [said["objective"]]}
    if said.get("layoutVersionId"):
        document["layoutVersionId"] = said["layoutVersionId"]
    saved = p.call("POST", f"/api/v1/missions/{mission['id']}/versions",
                   {"label": "as the mission file says", "document": document})
    return saved["id"]


def start(said: dict, name: str):
    m = platform()
    p = m.Platform()
    queue = p.call("GET", "/api/v1/queues")["queues"][0]
    sweep = p.call("POST", f"/api/v1/organisations/{p.org}/sweeps", {
        "name": name,
        "missionVersionId": mission_version(p, m, said),
        "vehicleVersionId": m.newest_version(p, "vehicles", said["vehicle"]),
        "water": said.get("water") or {},
        "doubts": said["doubts"],
        "good": float(said.get("good", 0.8)),
        "queueId": queue["id"], "runtimeVersion": queue["runtimes"][0]})
    print(f"{sweep['scenarios']} scenarios, asked for as {sweep['id']}", flush=True)
    return p, sweep["id"]


def newest(p, name: str):
    """The last sweep of this mission, for --show."""
    for one in p.call("GET", f"/api/v1/organisations/{p.org}/sweeps")["sweeps"]:
        if one["name"].startswith(name):
            return one["id"]
    return None


def wait_for(p, sweep: str) -> None:
    was = None
    while True:
        one = p.call("GET", f"/api/v1/sweeps/{sweep}")
        at = (one["flown"], one["scenarios"])
        if at != was:
            print(f"  {at[0]}/{at[1]} flown, {one['flying']} in the water", flush=True)
            was = at
        if one["flying"] == 0 and one["flown"] >= one["scenarios"]:
            return
        time.sleep(20)


BAR = 20


def say(found: dict) -> None:
    """The point of the whole thing, printed.

    The arithmetic is the platform's; this is the reading of it. Ranked by how
    much a thing *changes* the outcome rather than by how often it was present
    when the mission failed, because those are different and the second one is
    misleading — and a dimension that made no difference is said once, quietly,
    and not ranked.
    """
    if found["flown"] == 0:
        print("nothing flown yet")
        return
    print(f"\nSurvives {found['survived']} of {found['flown']} scenarios "
          f"(a mission counts as done at {found['good']:.0%}).\n")
    if len(found.get("physics") or []) > 1:
        print("These were not all computed by the same simulator — physics "
              + " and ".join(str(v) for v in found["physics"])
              + ". A change to the physics changes the answer, so this table is\n"
                "not one table.\n")
    if found["survived"] == found["flown"]:
        print("Nothing in the doubt list breaks it.")
        return

    for one in found["matters"]:
        print(f"{one['name']}  (changes the outcome by {one['changes']:.0%})")
        for rate in one["rates"]:
            bar = "█" * int(round(rate["failedShare"] * BAR)) or "·"
            print(f"    {rate['value']:<16} {rate['survived']:2d}/{rate['of']:<2d} survive   {bar}")
        print()

    if found["madeNoDifference"]:
        print("Made no difference: " + ", ".join(found["madeNoDifference"]) + ".\n")

    if not found["matters"]:
        print("Nothing in the doubt list explains the failures on its own.")
        return

    failed, of = found["failsOf"]
    print(f"The mission turns on {found['turnsOn']}. At {found['at']} it fails "
          f"{failed} times out of {of}.")
    if found.get("rescue"):
        saved, tried = found["rescueOf"]
        print(f"Setting {found['rescue']} saves {saved} of those {tried}.")
    elif found.get("noRescue"):
        print("Nothing else in the doubt list rescues them: "
              f"if the {found['turnsOn']} is {found['at']}, do not go.")

    if found.get("heldBack"):
        print(f"\n{found['heldBack']} of the failures were the vehicle held back by its "
              "own hull rather than by the plan — a better plan will not fix those.")


def main() -> int:
    parse = argparse.ArgumentParser(description="fly a mission against what could go wrong")
    parse.add_argument("mission")
    parse.add_argument("--show", action="store_true", help="read what has already been flown")
    parse.add_argument("--sweep", help="a sweep to read by identifier")
    asked = parse.parse_args()

    said = json.loads(pathlib.Path(asked.mission).read_text())
    if asked.sweep:
        p, sweep = platform().Platform(), asked.sweep
    elif asked.show:
        p = platform().Platform()
        sweep = newest(p, said["name"])
        if sweep is None:
            print(f"nothing swept for {said['name']} yet")
            return 1
    else:
        p, sweep = start(said, said["name"] + " ~ " + time.strftime("%d %B, %H:%M"))
        wait_for(p, sweep)
    say(p.call("GET", f"/api/v1/sweeps/{sweep}/findings"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
