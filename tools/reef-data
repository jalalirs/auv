#!/usr/bin/env bash
# Fetch and prepare the first traceable reef asset on the GPU host.
# Usage: ./tools/reef-data {fetch|prepare|status|all}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${REPO_ROOT}/.env" ]; then
    set -a
    source "${REPO_ROOT}/.env"
    set +a
fi

REMOTE_REPO="/home/jalalirs/code/auv"
DATA_ROOT="${AUV_DATA_DIR:-/home/jalalirs/code/auv-data}/red-sea-twin"
SOURCE_DIR="${DATA_ROOT}/assets/source/reefs4d/zenodo-14616671"
DERIVED_DIR="${DATA_ROOT}/assets/derived/reefs4d/c2-2019/lod0"
IMAGE="auv-reef-ingest:pymeshlab-2025.7-usd-25.11"
PIPELINE="projects/002_red_sea_digital_twin/pipelines/reef_ingest"

if [[ ! "${DATA_ROOT}" =~ ^/[A-Za-z0-9._/-]+$ ]] \
    || [[ "${DATA_ROOT}" == *..* ]]; then
    printf 'Refusing unsafe AUV_DATA_DIR: %s\n' "${DATA_ROOT}" >&2
    exit 1
fi

remote() {
    "${SCRIPT_DIR}/gpu" "$1"
}

require_synced_checkout() {
    local local_head remote_head
    if [ -n "$(git -C "${REPO_ROOT}" status --porcelain --untracked-files=all | grep -v '^?? \.env$' || true)" ]; then
        printf 'Local tracked files are not synchronized. Run tools/gpu sync first.\n' >&2
        exit 1
    fi
    local_head="$(git -C "${REPO_ROOT}" rev-parse HEAD)"
    remote_head="$(remote "git -C '${REMOTE_REPO}' rev-parse HEAD")"
    if [ "${local_head}" != "${remote_head}" ]; then
        printf 'Mac and GPU commits differ. Run tools/gpu sync first.\n' >&2
        exit 1
    fi
}

fetch() {
    remote "set -e; \
        mkdir -p '${SOURCE_DIR}'; \
        cd '${SOURCE_DIR}'; \
        curl -fsSL 'https://zenodo.org/api/records/14616671' -o record.json; \
        curl -fsSL 'https://zenodo.org/api/records/14616671/files/C22019.jpg/content' -o C22019.jpg; \
        if ! test -f C22019.ply; then \
            curl --fail --location --continue-at - \
                'https://zenodo.org/api/records/14616671/files/C22019.ply/content' \
                -o C22019.ply.part; \
            printf '71c328e0e991078ac12507af83a971e2  C22019.ply.part\\n' | md5sum --check; \
            mv C22019.ply.part C22019.ply; \
        fi; \
        printf '71c328e0e991078ac12507af83a971e2  C22019.ply\\n9cd616911394a0a8298703ec158296d3  C22019.jpg\\n' | md5sum --check"
}

prepare() {
    require_synced_checkout
    remote "set -e; \
        test -f '${SOURCE_DIR}/C22019.ply'; \
        test -f '${SOURCE_DIR}/C22019.jpg'; \
        mkdir -p '${DERIVED_DIR}'; \
        docker build --tag '${IMAGE}' '${REMOTE_REPO}/${PIPELINE}'; \
        docker run --rm \
            --user 1000:1000 \
            --env HOME=/tmp \
            --volume '${REMOTE_REPO}:/workspace:ro' \
            --volume '${DATA_ROOT}:/data:rw' \
            '${IMAGE}' \
            --input '/data/assets/source/reefs4d/zenodo-14616671/C22019.ply' \
            --texture '/data/assets/source/reefs4d/zenodo-14616671/C22019.jpg' \
            --output-dir '/data/assets/derived/reefs4d/c2-2019/lod0' \
            --target-faces 450000"
}

status() {
    remote "set -e; \
        printf 'Source:\\n'; \
        ls -lh '${SOURCE_DIR}/C22019.ply' '${SOURCE_DIR}/C22019.jpg'; \
        if test -f '${DERIVED_DIR}/derived.json'; then \
            printf '\\nDerived:\\n'; \
            cat '${DERIVED_DIR}/derived.json'; \
            ls -lh '${DERIVED_DIR}/C22019_visual_lod0.usdc' '${DERIVED_DIR}/C22019.jpg'; \
        else \
            printf '\\nDerived asset not prepared yet.\\n'; \
        fi"
}

case "${1:-status}" in
    fetch)
        fetch
        ;;
    prepare)
        prepare
        ;;
    status)
        status
        ;;
    all)
        fetch
        prepare
        status
        ;;
    *)
        printf 'Usage: %s {fetch|prepare|status|all}\n' "$0" >&2
        exit 2
        ;;
esac
