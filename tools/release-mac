#!/usr/bin/env bash
# Build the Mac apps (Apple Silicon and Intel), sign them, and have Apple
# notarise them. Windows and Linux are built on the box by tools/release-box.
#
#   APPLE_NOTARY_PROFILE=arc tools/release-mac   build, sign, notarise both
#   tools/release-mac --unsigned                 build only, to try the packaging
#   tools/release-mac --stage                    build the app and stage it, no packaging
#
# The installers land in apps/client/release/out as iocean-mac-arm64.dmg and
# iocean-mac-x64.dmg, with their sha256 in SHA256SUMS. The hotspot uploads too
# slowly to send them to the box, so they go through Drive: replace each file
# in Drive under its link, then tools/publish-downloads fetches them onto the
# box, checks them against SHA256SUMS and lists them for the site.
#
# Signed as Developer ID Application: WASLAT ALTIQNIAH COMPANY (B35AK98DRA).
# Notarised through a notarytool keychain profile. Petro's `arc` profile is
# WASLAT's; a fresh one is made from WASLAT's App Store Connect API key (kept
# outside the repo, never printed):
#
#   xcrun notarytool store-credentials iocean-waslat --key ~/.iocean/AuthKey_<key id>.p8 \
#     --key-id <key id> --issuer <issuer id>
#
# As in petro's release-desktop.sh, each app is notarised and stapled before
# its DMG is made, then the DMG is notarised too, so the app a person drags out
# carries its own ticket.
#
# Packaged from a folder holding only the built app and a package.json without
# dependencies: everything is bundled by Vite, and electron-builder otherwise
# walks the pnpm workspace looking for node_modules to copy and fails.
set -euo pipefail
MODE="${1:-}"
case "${MODE}" in ""|--unsigned|--stage) ;; *) echo "unknown option ${MODE}" >&2; exit 2 ;; esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLIENT="${ROOT}/apps/client"
IDENTITY="${APPLE_SIGNING_IDENTITY:-Developer ID Application: WASLAT ALTIQNIAH COMPANY (B35AK98DRA)}"
PROFILE="${APPLE_NOTARY_PROFILE:-iocean-waslat}"
PLATFORM="${IOCEAN_PLATFORM_URL:-https://iocean.areen.ai}"
BUILDER="electron-builder@26.0.12"
MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"
VERSION="$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "${CLIENT}/package.json")"
ELECTRON="$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "${CLIENT}/node_modules/electron/package.json")"
WORK="${CLIENT}/release"

say() { echo "-> $(date -u +%H:%M:%S) $*"; }
die() { echo "error: $*" >&2; exit 1; }
notarise() {
    local log="$1.notary.log"
    xcrun notarytool submit "$1" --keychain-profile "${PROFILE}" --wait >"${log}" 2>&1 || true
    grep -q "status: Accepted" "${log}" || die "Apple did not accept $(basename "$1"); see ${log}"
}

if [ -z "${MODE}" ]; then
    say "checking what signing needs"
    security find-identity -v -p codesigning | grep -qF "${IDENTITY}" \
        || die "no signing identity '${IDENTITY}' in the keychain"
    # Read the output, not the exit code: notarytool prints an error and exits 0.
    case "$(xcrun notarytool history --keychain-profile "${PROFILE}" 2>&1 || true)" in
        *rror*) die "no usable notarytool profile '${PROFILE}'; make it with the store-credentials line at the top of this script" ;;
    esac
fi

say "building iOcean ${VERSION} against ${PLATFORM}"
(cd "${CLIENT}" && IOCEAN_RELEASE=1 VITE_IOCEAN_PLATFORM="${PLATFORM}" "${MISE}" exec -- pnpm build >/dev/null)
grep -qlF "${PLATFORM}" "${CLIENT}"/dist/renderer/assets/*.js || die "the build does not name ${PLATFORM}"
# No developer's sign-in in what goes out: any email or secret in the local env
# files must be absent from the build (checked without printing them).
for env in "${CLIENT}"/.env*; do
    sed -nE 's/^VITE_[A-Z_]*(EMAIL|SECRET)=(.+)$/\2/p' "${env}" 2>/dev/null
done | while read -r value; do
    ! grep -qrF -- "${value}" "${CLIENT}/dist" || die "the build carries a sign-in from apps/client/.env*"
done

# A Finder window open on the old output writes .DS_Store while it is being
# removed, so try twice.
rm -rf "${WORK:?}/stage" "${WORK:?}/out" 2>/dev/null || { sleep 1; rm -rf "${WORK:?}/stage" "${WORK:?}/out"; }
mkdir -p "${WORK}/stage" "${WORK}/out"
cp -R "${CLIENT}/dist" "${CLIENT}/assets" "${CLIENT}/electron-builder.yml" "${WORK}/stage/"
cat >"${WORK}/stage/package.json" <<EOF
{
  "name": "iocean",
  "version": "${VERSION}",
  "description": "Dive a vehicle you brought, in water we keep",
  "author": "iOcean <noreply@areen.ai>",
  "homepage": "https://iocean.areen.ai",
  "main": "dist/main/main.js",
  "type": "module"
}
EOF
[ "${MODE}" != --stage ] || { say "staged ${WORK}/stage"; exit 0; }

SIGN=(-c.mac.identity=null)
[ "${MODE}" = --unsigned ] || SIGN=(-c.mac.identity="${IDENTITY#Developer ID Application: }")
# The Electron in node_modules is this Mac's own (arm64); for Intel,
# electron-builder downloads the x64 one into its cache.
builder() {
    local arch="$1"; shift
    local dist=()
    [ "${arch}" != arm64 ] || dist=(-c.electronDist="${CLIENT}/node_modules/electron/dist")
    (cd "${WORK}/stage" && CSC_IDENTITY_AUTO_DISCOVERY=false npx -y "${BUILDER}" --mac "$@" "--${arch}" \
        "${dist[@]}" -c.electronVersion="${ELECTRON}" -c.npmRebuild=false \
        -c.directories.output="${WORK}/out/${arch}" -c.mac.notarize=false "${SIGN[@]}" 2>&1 \
        | grep -v '^npm warn') || die "electron-builder failed for ${arch}"
}

for ARCH in arm64 x64; do
    FILE="iocean-mac-${ARCH}.dmg"
    say "packaging and signing the ${ARCH} app"
    builder "${ARCH}" dir
    APP="$(find "${WORK}/out/${ARCH}" -maxdepth 2 -name '*.app' -type d | head -1)"
    [ -d "${APP}" ] || die "no ${ARCH} app in ${WORK}/out/${ARCH}"

    if [ -z "${MODE}" ]; then
        codesign --verify --deep --strict "${APP}" || die "the ${ARCH} app's signature does not verify"
        say "notarising the ${ARCH} app (Apple usually takes a few minutes)"
        ditto -c -k --keepParent "${APP}" "${WORK}/out/${ARCH}/app.zip"
        notarise "${WORK}/out/${ARCH}/app.zip"
        xcrun stapler staple "${APP}" >/dev/null
        xcrun stapler validate "${APP}" >/dev/null || die "the ${ARCH} app has no stapled ticket"
    fi

    say "making the ${ARCH} installer from the stapled app"
    builder "${ARCH}" dmg --prepackaged "${APP}"
    DMG="$(find "${WORK}/out/${ARCH}" -maxdepth 1 -name '*.dmg' | head -1)"
    [ -f "${DMG}" ] || die "no ${ARCH} installer in ${WORK}/out/${ARCH}"
    mv "${DMG}" "${WORK}/out/${FILE}"
    DMG="${WORK}/out/${FILE}"

    if [ -z "${MODE}" ]; then
        codesign --sign "${IDENTITY}" --timestamp "${DMG}"
        say "notarising the ${ARCH} installer"
        notarise "${DMG}"
        xcrun stapler staple "${DMG}" >/dev/null
        xcrun stapler validate "${DMG}" >/dev/null || die "the ${ARCH} installer has no stapled ticket"
        spctl --assess --type open --context context:primary-signature "${DMG}" \
            || die "Gatekeeper refuses the ${ARCH} installer"
    fi
done

(cd "${WORK}/out" && shasum -a 256 iocean-mac-*.dmg >SHA256SUMS && echo "${VERSION}" >VERSION)
say "built iOcean ${VERSION} for Mac:"
(cd "${WORK}/out" && ls -lh iocean-mac-*.dmg | awk '{print "   " $NF " " $5}')
say "next: replace both files in Drive, then tools/publish-downloads <arm64 drive link> <x64 drive link>"
