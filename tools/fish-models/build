def reduce_on_the_box(source: pathlib.Path, into: pathlib.Path) -> None:
    """Blender's collapse decimation, on the box, which has Blender."""
    box = "jalalirs@100.76.65.1"
    there = f"/tmp/fish-models/{source.name}"
    subprocess.run(["ssh", "-o", "BatchMode=yes", box, "mkdir -p /tmp/fish-models"], check=True)
    subprocess.run(["scp", "-q", str(source), f"{box}:{there}"], check=True)
    subprocess.run(["scp", "-q", str(HERE / "reduce.py"), f"{box}:/tmp/fish-models/reduce.py"], check=True)
    subprocess.run(["ssh", "-o", "BatchMode=yes", box,
                    # The box's /usr/local/lib/libsqlite3 lacks a symbol its
                    # GDAL wants, and Blender links GDAL: the system's first.
                    f"LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libsqlite3.so.0 "
                    f"blender -b -P /tmp/fish-models/reduce.py -- {there} {there}.small.glb {FACES} {PIXELS}"
                    f" > /tmp/fish-models/{source.stem}.log 2>&1"
                    f" && ls {there}.small.glb"], check=True)
    subprocess.run(["scp", "-q", f"{box}:{there}.small.glb", str(into)], check=True)


def load(path: pathlib.Path):
    """One mesh: points, faces, uv per point, and the texture as an image."""
    import trimesh

    scene = trimesh.load(str(path), force="scene")
    pts, fcs, uvs, image, base = [], [], [], None, 0
    for name, geometry in scene.geometry.items():
        node = scene.graph.geometry_nodes[name][0]
        m = geometry.copy()
        m.apply_transform(scene.graph[node][0])
        uv = getattr(m.visual, "uv", None)
        if uv is None:
            uv = np.zeros((len(m.vertices), 2))
        material = getattr(m.visual, "material", None)
        if image is None and material is not None:
            image = getattr(material, "baseColorTexture", None) or getattr(material, "image", None)
        pts.append(np.asarray(m.vertices, float))
        fcs.append(np.asarray(m.faces, int) + base)
        uvs.append(np.asarray(uv, float))
        base += len(m.vertices)
    return np.vstack(pts), np.vstack(fcs), np.vstack(uvs), image


def the_fish(points, faces, uv):
    """Only the fish: a scan carries what was on the table with it — a scale
    bar, a label, a pin — as pieces not joined to the body. Keep the pieces
    that hold most of the faces."""
    from scipy.sparse import coo_matrix
    from scipy.sparse.csgraph import connected_components

    n = len(points)
    edges = np.vstack([faces[:, [0, 1]], faces[:, [1, 2]], faces[:, [2, 0]]])
    graph = coo_matrix((np.ones(len(edges)), (edges[:, 0], edges[:, 1])), shape=(n, n))
    count, label = connected_components(graph, directed=False)
    if count == 1:
        return points, faces, uv
    per = np.bincount(label[faces[:, 0]], minlength=count)
    keep = per >= 0.02 * per.max()
    faces = faces[keep[label[faces[:, 0]]]]
    used = np.unique(faces)
    index = -np.ones(n, dtype=int)
    index[used] = np.arange(len(used))
    return points[used], index[faces], uv[used]


def orient(points, faces, uv, image, ray: bool = False, wide: bool = False, flip: bool = False):
    """Nose to +x, back to +z, a metre long, centred.

    The long axis is the fish's length. Across it, a fish is deeper than it is
    wide; a ray is wider than it is deep, so for a ray the axes are the other
    way round. The head is the end with more of the body in it; the back is
    the darker side, because almost every fish is countershaded."""
    centre = points.mean(axis=0)
    p = points - centre
    _, _, axes = np.linalg.svd(p, full_matrices=False)
    along, second, third = axes                 # largest spread first
    # A fish: depth is the second axis, width the third. A ray: the wings are
    # the second axis and its depth the third.
    up = third if (ray or wide) else second
    side = np.cross(up, along)
    frame = np.vstack([along, side, up])
    q = p @ frame.T
    # Head forward: the end whose half holds more of the cross-section.
    x = q[:, 0]
    front = np.ptp(q[x > np.percentile(x, 75)][:, 1:], axis=0).prod()
    back = np.ptp(q[x < np.percentile(x, 25)][:, 1:], axis=0).prod()
    if (back > front) != flip:
        q[:, 0] *= -1
        q[:, 1] *= -1
    # Back up: the darker half, by the texture under each point.
    if image is not None and len(uv):
        rgb = np.asarray(image.convert("RGB"), float) / 255.0
        h, w = rgb.shape[:2]
        u = np.clip((uv[:, 0] % 1.0) * (w - 1), 0, w - 1).astype(int)
        v = np.clip((1.0 - uv[:, 1] % 1.0) * (h - 1), 0, h - 1).astype(int)
        light = rgb[v, u].mean(axis=1)
        z = q[:, 2]
        if not ray and light[z > np.median(z)].mean() > light[z < np.median(z)].mean():
            q[:, 2] *= -1
            q[:, 1] *= -1
    # A metre nose to tail, centred on its own length.
    low, high = q.min(axis=0), q.max(axis=0)
    q = (q - (low + high) / 2.0) / (high[0] - low[0])
    # Winding: a mirrored frame turns faces inside out.
    if np.linalg.det(np.vstack([frame])) < 0:
        faces = faces[:, ::-1]
    return q.astype("float32"), faces.astype("int32"), uv.astype("float32")


def pack(species: str, entry, small: pathlib.Path) -> dict:
    uid, what, close, licence, author, extra = entry
    points, faces, uv, image = load(small)
    points, faces, uv = the_fish(points, faces, uv)
    points, faces, uv = orient(points, faces, uv, image, ray=bool(extra.get("ray")),
                               wide=bool(extra.get("wide")), flip=bool(extra.get("flip")))
    out = INTO / species
    out.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(out / "model.npz", points=points, faces=faces, uv=uv)
    if image is not None:
        buf = io.BytesIO()
        image.convert("RGB").save(buf, "JPEG", quality=88)
        (out / "texture.jpg").write_bytes(buf.getvalue())
    said = {"species": species, "model": what, "standsFor": close,
            "licence": licence, "author": author,
            "url": f"https://sketchfab.com/3d-models/{uid}",
            "via": "Objaverse (allenai/objaverse, Hugging Face), the Sketchfab file as published",
            "faces": int(len(faces)), "points": int(len(points))}
    (out / "source.json").write_text(json.dumps(said, indent=1, ensure_ascii=False) + "\n")
    return said


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("scans", help="the directory the .glb files were downloaded into")
    ap.add_argument("--only", help="comma-separated species")
    args = ap.parse_args(argv)
    scans = pathlib.Path(args.scans)
    small_dir = scans / "small"
    small_dir.mkdir(exist_ok=True)
    wanted = set(args.only.split(",")) if args.only else set(MODELS)
    credits = []
    for species, entry in MODELS.items():
        if species not in wanted:
            continue
        uid = entry[0]
        source = scans / f"{uid}.glb"
        if not source.exists():
            print(f"{species}: no {source.name}, skipped")
            continue
        small = small_dir / f"{uid}.glb"
        if not small.exists():
            reduce_on_the_box(source, small)
        said = pack(species, entry, small)
        credits.append(said)
        print(f"{species}: {said['model']} ({said['standsFor']}), {said['faces']} faces, {said['licence']}")
    write_credits()
    return 0


def write_credits() -> None:
    """Who made each model, from every source.json there is: what CC-BY asks
    for, and what CC0 does not ask for and gets anyway."""
    rows = []
    for one in sorted(INTO.glob("*/source.json")):
        said = json.loads(one.read_text())
        rows.append(f"| {said['species']} | {said['model']} | {said['standsFor']} | {said['author']} | "
                    f"{said['licence']} | {said['url']} |")
    (INTO / "CREDITS.md").write_text(
        "# The fish's models\n\nScanned or modelled fish drawn by the simulator, each standing for a species "
        "sheet in fish_species.py. Built by tools/fish-models/build from Sketchfab models fetched through "
        "Objaverse (allenai/objaverse). Each was reduced and its colour re-baked; none is otherwise changed.\n\n"
        "| species | model | stands for it as | author | licence | source |\n|---|---|---|---|---|---|\n"
        + "\n".join(rows) + "\n")


if __name__ == "__main__":
    sys.exit(main())
