#!/usr/bin/env python3
"""The Jeddah airport tank, as a place: a ten-metre cylinder of Red Sea water.

    tools/make-jeddah-tank jeddah-airport-tank --into ~/iocean/places/jeddah-airport-tank

King Abdulaziz International Airport, Terminal 1: a cylindrical aquarium
fourteen metres tall and ten across, its glass thirty centimetres thick, a
million litres of Red Sea water and some two thousand animals of sixty-five
Red Sea species (the airport's and the press's published figures, 2023–24).
Round a column of rock that stands up out of the water in the middle.

What is **published** is the size: the cylinder, its glass, its volume. What
is **read off footage** (two phone videos from the airport floor, 3 October
2026) is the rest: the column stepping down in ledges, coral on them, sand and
boulders round its foot, which fish, and roughly how many of each. What is
**chosen** is everything a camera does not show plainly — the ledges' heights,
the coral's kinds and places — and the record says which is which.

The runtime keeps everything inside round glass (systems/glass.py): the
interior carries `round`. Metres, Z up, z = 0 at the water surface, origin on
the tank's axis.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import math
import pathlib
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import built  # noqa: E402

import numpy as np

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
_loader = importlib.machinery.SourceFileLoader("make_aquarium", str(HERE / "make-aquarium"))
_spec = importlib.util.spec_from_loader("make_aquarium", _loader)
aq = importlib.util.module_from_spec(_spec)
_loader.exec_module(aq)
import coral  # noqa: E402

# ── the tank: published ──────────────────────────────────────────────────────
RADIUS = 5.0              # inside the glass: ten metres across
GLASS = 0.30
FREEBOARD = 0.40
FLOOR_Z = -13.4           # the sand: fourteen metres of tank less the base and the freeboard
BASE_Z = -14.4            # the airport floor the tank stands on

# ── what the footage shows, and what is chosen to fill it in ─────────────────
GRID = 401                # heightfield samples each way over the tank's square
ACROSS = 2 * RADIUS + 0.4
# The column: ledges stepping down from the top, (outer radius, height). Each
# ring of the column out to its radius stands at its height; the top stands
# out of the water.
LEDGES = [(1.9, 0.6), (2.25, -3.0), (2.65, -6.0), (3.05, -9.5), (3.45, -12.2)]
BOULDERS = [(3.9, 0.3, 0.55, 0.9), (4.1, 1.5, 0.40, 0.6), (3.8, 2.6, 0.65, 1.0), (4.2, 3.7, 0.35, 0.5),
            (3.9, 4.6, 0.50, 0.8), (4.0, 5.6, 0.45, 0.7)]          # (radius from axis, angle, r, height)
CORAL_KINDS = [("branching", 0.55), ("massive", 0.7), ("brain", 0.5), ("plume", 0.6), ("fan", 0.9),
               ("finger", 0.45), ("sponge", 0.35), ("encrusting", 0.5), ("branching", 0.4), ("massive", 0.5),
               ("table", 0.45)]
CORAL_COLOURS = [(0.62, 0.48, 0.38), (0.48, 0.36, 0.52), (0.70, 0.55, 0.42), (0.40, 0.52, 0.42),
                 (0.78, 0.50, 0.52), (0.55, 0.45, 0.30), (0.35, 0.40, 0.55), (0.80, 0.70, 0.45)]
# Who lives in it, from the footage: the species named in fish_species.py
# from it, and roughly how many of each a viewer sees — the big schools of
# seabream counted in the hundreds, the sharks and rays by the handful.
# The column's dressing, from the footage: arches near the top, then panels
# with LED strips down to where the rock begins.
ARCH_Z = -1.4
ARCHES = 8
PANELS_FROM, PANELS_TO = 0.5, -3.05
STRIPS = 14
FISH = {"rhabdosargus_haffara": 160, "abudefduf_vaigiensis": 60, "platax_teira": 24,
        "acanthopagrus_bifasciatus": 20, "plectorhinchus_gaterinus": 14, "naso_hexacanthus": 10,
        "carcharhinus_melanopterus": 6, "chaetodon_auriga": 6, "pomacanthus_maculosus": 4,
        "aetobatus_ocellatus": 3, "epinephelus_lanceolatus": 2}


def edge_of(k, theta, phase):
    """How far out ledge k reaches, all round: rough, not a circle."""
    reach = LEDGES[k][0]
    return reach * (1.0 + 0.07 * np.sin(3 * theta + phase[k, 0]) + 0.05 * np.sin(7 * theta + phase[k, 1]))


def top_of(k, x, y, theta):
    """Ledge k's surface: its height, with lumps."""
    return LEDGES[k][1] + 0.12 * np.sin(x * 5.3 + k) * np.sin(y * 4.7 - k) + 0.06 * np.sin(theta * 13 + k)


def column_and_sand(rng):
    """The column, its ledges, the sand and the boulders, as one heightfield:
    what the vehicle and the fish meet. What is drawn of the column is its own
    mesh (`column_mesh`), from the same edges: a heightfield cannot draw a
    wall, and drawn from it the column was streaks and gaps."""
    line = np.linspace(-ACROSS / 2, ACROSS / 2, GRID)
    X, Y = np.meshgrid(line, line)
    r, theta = np.hypot(X, Y), np.arctan2(Y, X)
    sand = FLOOR_Z + 0.04 * np.sin(X * 3.1 + 0.6 * np.sin(Y * 1.7)) + 0.03 * np.sin(Y * 2.3 + 1.1)
    z = sand.copy()
    phase = rng.uniform(0, 2 * np.pi, (len(LEDGES), 2))
    # From the outside in, so that each ledge stands on the one below it.
    for k in range(len(LEDGES) - 1, -1, -1):
        z = np.where(r < edge_of(k, theta, phase), np.maximum(z, top_of(k, X, Y, theta)), z)
    for at, angle, rad, h in BOULDERS:
        bx, by = at * math.cos(angle), at * math.sin(angle)
        d = np.hypot(X - bx, Y - by)
        top = sand + h * np.sqrt(np.clip(1 - (d / rad) ** 2, 0, 1)) * (1 + 0.12 * np.sin(X * 9 + Y * 7))
        z = np.where(d < rad, np.maximum(z, top), z)
    return line, z, phase


def column_mesh(phase, rng, around: int = 360):
    """The column as rock: for each ledge, its wall down to the ledge below
    (or the sand) and its top, lathed round the axis from the same rough
    edges the heightfield has, the wall's face pitted and bulged so that it
    reads as stacked rock and not as a turned post."""
    theta = np.linspace(-np.pi, np.pi, around, endpoint=False)
    pts, faces, uvs = [], [], []

    def add(p, f, uv):
        base = sum(len(x) for x in pts)
        pts.append(p)
        faces.append(f + base)
        uvs.append(uv)

    # The top tier is not rock but the panels (`build`); rock begins below it.
    for k in range(1, len(LEDGES)):
        edge = edge_of(k, theta, phase)
        top = LEDGES[k][1]
        bottom = LEDGES[k + 1][1] if k + 1 < len(LEDGES) else FLOOR_Z - 0.05
        # Fine enough to hold the bumps below: at 180 round and 25 cm rows
        # their finest terms were sampled three times a wave round and twice
        # up it, and came out as vertical ridges that smeared the texture.
        rows = max(4, int((top - bottom) / 0.1))
        zs = np.linspace(top, bottom, rows)
        ring = []
        uv = []
        # Bulges and pits on the wall face: rock, not a lathe. Many waves in
        # every direction at random phases, larger for longer ones, so no one
        # of them shows: three regular terms were tried first and drew the
        # column as a screw thread of diagonal grooves. Whole numbers of waves
        # round, so the face closes on itself without a seam.
        # Directions drawn evenly round the compass of the face and lengths
        # log-evenly from 4 m to 30 cm; drawing waves-round and waves-up
        # separately leaned most of them upright and the rock ran in drips.
        waves = 48
        reach = np.exp(rng.uniform(np.log(1.5), np.log(20.0), waves))   # radians a metre
        towards = rng.uniform(0.0, np.pi, waves)
        m = np.maximum(1, np.round(reach * np.abs(np.cos(towards)) * LEDGES[k][0])).astype(int)
        w = reach * np.sin(towards) * np.sign(np.cos(towards) + 1e-9)
        a = 1.0 / np.maximum(reach, 1.0) ** 1.3
        a *= 0.06 / np.sqrt(0.5 * (a ** 2).sum())            # 6 cm, one standard deviation
        phi = rng.uniform(0, 2 * np.pi, waves)
        for i, z in enumerate(zs):
            bump = (a[:, None] * np.sin(m[:, None] * theta[None, :] + w[:, None] * z + phi[:, None])).sum(axis=0)
            rr = edge * (1.0 + 0.02 * np.sin(z * 4.0 + k)) + bump
            ring.append(np.column_stack([rr * np.cos(theta), rr * np.sin(theta), np.full(len(theta), z)]))
            uv.append(np.column_stack([(theta + np.pi) * LEDGES[k][0] / 1.5, np.full(len(theta), z / 1.5)]))
        p = np.vstack(ring)
        f = []
        n = len(theta)
        for i in range(rows - 1):
            for j in range(n):
                a, b = i * n + j, i * n + (j + 1) % n
                c, d = (i + 1) * n + j, (i + 1) * n + (j + 1) % n
                f += [(a, c, b), (b, c, d)]
        add(p, np.array(f), np.vstack(uv))
        # The ledge's top: from the edge of the tier above in to this one's.
        inner = edge_of(k - 1, theta, phase) * 0.9 if k > 0 else np.zeros_like(theta)
        steps = 6
        ring, uv = [], []
        for i in range(steps + 1):
            t = i / steps
            rr = inner + (edge - inner) * t
            x, y = rr * np.cos(theta), rr * np.sin(theta)
            ring.append(np.column_stack([x, y, top_of(k, x, y, theta)]))
            uv.append(np.column_stack([x / 1.5, y / 1.5]))
        p = np.vstack(ring)
        f = []
        for i in range(steps):
            for j in range(n):
                a, b = i * n + j, i * n + (j + 1) % n
                c, d = (i + 1) * n + j, (i + 1) * n + (j + 1) % n
                f += [(a, c, b), (b, c, d)]
        add(p, np.array(f), np.vstack(uv))
    return np.vstack(pts), np.vstack(faces), np.vstack(uvs)


def ring(r_in, r_out, z0, z1, sides=160):
    """A thick-walled cylinder: inner and outer walls, top and bottom rims."""
    a = np.linspace(0, 2 * np.pi, sides, endpoint=False)
    pts = []
    for rr in (r_in, r_out):
        for zz in (z0, z1):
            pts += [(rr * math.cos(t), rr * math.sin(t), zz) for t in a]
    pts = np.array(pts)
    n = sides
    faces = []
    for i in range(n):
        j = (i + 1) % n
        ib, it, ob, ot = i, n + i, 2 * n + i, 3 * n + i
        jb, jt, ob2, ot2 = j, n + j, 2 * n + j, 3 * n + j
        faces += [(ib, jt, jb), (ib, it, jt)]            # inner wall
        faces += [(ob, ob2, ot2), (ob, ot2, ot)]         # outer wall
        faces += [(it, ot, ot2), (it, ot2, jt)]          # top rim
        faces += [(ib, jb, ob2), (ib, ob2, ob)]          # bottom rim
    return pts, np.array(faces)


def build(name: str, into: pathlib.Path, seed: int = 11) -> dict:
    rng = np.random.default_rng(seed)
    s = aq.Scene()
    tex = aq.textures(into)
    pbr = lambda colour, rough=0.5, metal=0.0, **more: ("OmniPBR", dict(  # noqa: E731
        diffuse_color_constant=tuple(colour), reflection_roughness_constant=rough, metallic_constant=metal, **more))
    glass = s.look("Glass", (0.02, 0.03, 0.03), rough=0.0, opacity=0.06, clearcoat=1.0, ior=1.49,
                   mdl=("OmniGlass", dict(glass_color=(0.93, 0.97, 0.96), glass_ior=1.49, thin_walled=False,
                                          frosting_roughness=0.0)))
    steel = s.look("Steel", (0.55, 0.56, 0.58), rough=0.3, metal=0.9, mdl=pbr((0.6, 0.6, 0.62), 0.25, 1.0))
    marble = s.look("Marble", (0.86, 0.85, 0.82), rough=0.25, mdl=pbr((0.85, 0.84, 0.80), 0.18))
    darkstone = s.look("DarkStone", (0.30, 0.30, 0.32), rough=0.35, mdl=pbr((0.28, 0.28, 0.30), 0.3))
    ceiling = s.look("Ceiling", (0.92, 0.90, 0.86), rough=0.6, mdl=pbr((0.90, 0.88, 0.84), 0.6))
    sand = s.look("Sand", (0.86, 0.82, 0.72), rough=0.95, mdl=("OmniPBR", dict(
        diffuse_texture=tex["sand"][0], normalmap_texture=tex["sand"][1], reflectionroughness_texture=tex["sand"][2],
        reflection_roughness_texture_influence=1.0, bump_factor=0.6)))
    rock = s.look("LiveRock", (0.48, 0.42, 0.42), rough=0.9, mdl=("OmniPBR", dict(
        diffuse_texture=tex["rock"][0], normalmap_texture=tex["rock"][1], reflectionroughness_texture=tex["rock"][2],
        reflection_roughness_texture_influence=1.0, bump_factor=1.4,
        # The footage's rock is dark and grey under its encrusting life; the
        # shared texture alone drew it pink and pale.
        diffuse_tint=(0.50, 0.53, 0.58))))

    # The building round it: the floor it stands on, its steel plinth, a
    # mezzanine ring with its railing, and the atrium's ceiling.
    s.add("Hall/Floor", *aq.box((-30, -30, BASE_Z - 0.05), (30, 30, BASE_Z)), marble)
    s.add("Tank/Plinth", *ring(RADIUS, RADIUS + GLASS + 0.35, BASE_Z, FLOOR_Z - 0.2), steel)
    s.add("Tank/Base", *ring(0.0, RADIUS, BASE_Z, FLOOR_Z - 0.2), darkstone)
    s.add("Hall/Mezzanine", *ring(6.6, 14.0, -7.5, -7.2), marble)
    s.add("Hall/Railing", *ring(6.6, 6.64, -7.2, -6.1), glass)
    s.add("Hall/RailingTop", *ring(6.58, 6.68, -6.12, -6.06), steel)
    s.add("Hall/Ceiling", *ring(6.0, 16.0, 2.6, 2.9), ceiling)
    s.add("Tank/Glass", *ring(RADIUS, RADIUS + GLASS, FLOOR_Z - 0.2, FREEBOARD), glass)
    s.add("Tank/Rim", *ring(RADIUS - 0.05, RADIUS + GLASS + 0.05, FREEBOARD, FREEBOARD + 0.15), steel)

    # The column and the sand: one heightfield, drawn inside the glass, the
    # rock wrapped round the column and the sand laid flat.
    line, heights, phase = column_and_sand(rng)
    # The sand and the boulders, from the heightfield: the ring between the
    # column's foot and the glass.
    pts, faces = aq.field_mesh(line, line, heights)
    r = np.hypot(pts[:, 0], pts[:, 1])
    theta = np.arctan2(pts[:, 1], pts[:, 0])
    foot = edge_of(len(LEDGES) - 1, theta, phase)
    keep = ((r < RADIUS + 0.02) & (r > foot - 0.15))[faces].all(axis=1)
    f = faces[keep]
    used = np.unique(f)
    index = -np.ones(len(pts), dtype=int)
    index[used] = np.arange(len(used))
    p = pts[used]
    tri = index[f]
    boulder = (p[tri][:, :, 2] > FLOOR_Z + 0.2).any(axis=1)
    for name_, part, look, scale in (("Sand", ~boulder, sand, 0.6), ("Boulders", boulder, rock, 0.7)):
        g = tri[part]
        keep_pts = np.unique(g)
        again = -np.ones(len(p), dtype=int)
        again[keep_pts] = np.arange(len(keep_pts))
        q = p[keep_pts]
        s.add(f"Tank/{name_}", q, again[g], look, smooth=True, uv=q[:, :2] * scale)
    # The column, drawn as rock.
    cp, cf, cu = column_mesh(phase, rng)
    s.add("Tank/Column", cp, cf, rock, smooth=True, uv=cu)

    # What the footage shows at the column's top, under the surface: a ring of
    # terracotta arches, and below them dark wooden panels with white LED
    # strips running down them, before the rock begins.
    wood = s.look("Wood", (0.18, 0.12, 0.08), rough=0.6, mdl=pbr((0.16, 0.10, 0.07), 0.55))
    clay = s.look("Terracotta", (0.72, 0.42, 0.26), rough=0.7, mdl=pbr((0.70, 0.40, 0.24), 0.65))
    strip = s.look("LedStrip", (0.95, 0.95, 0.92), rough=0.3, emissive=(4.0, 4.0, 3.8),
                   mdl=("OmniPBR", dict(diffuse_color_constant=(0.95, 0.95, 0.92), enable_emission=True,
                                        emissive_color=(1.0, 0.98, 0.92), emissive_intensity=6000)))
    panel_r = LEDGES[0][0] + 0.05
    s.add("Column/Panels", *ring(panel_r - 0.05, panel_r, PANELS_FROM, PANELS_TO, sides=48), wood)
    strips = []
    for k in range(STRIPS):
        a = 2 * math.pi * (k + 0.5) / STRIPS
        cx, cy = (panel_r + 0.012) * math.cos(a), (panel_r + 0.012) * math.sin(a)
        strips.append(aq.box((cx - 0.02, cy - 0.02, PANELS_TO + 0.2), (cx + 0.02, cy + 0.02, PANELS_FROM - 0.2)))
    s.add("Column/LedStrips", *aq.join(*strips), strip)
    arches = []
    for k in range(ARCHES):
        a = 2 * math.pi * k / ARCHES
        centre = np.array([(panel_r + 0.35) * math.cos(a), (panel_r + 0.35) * math.sin(a), ARCH_Z])
        along = np.array([-math.sin(a), math.cos(a), 0.0])
        # An arch: a half-ring standing on two legs, in the plane round the column.
        bend = [centre + 0.55 * (math.cos(t) * along) + np.array([0, 0, 0.55 * math.sin(t)])
                for t in np.linspace(0, math.pi, 12)]
        arches.append(aq.tube(bend, 0.09, sides=10))
        for side in (-1, 1):
            foot = centre + side * 0.55 * along
            arches.append(aq.cylinder(foot - np.array([0, 0, 1.1]), foot, 0.09, sides=10))
    s.add("Column/Arches", *aq.join(*arches), clay)

    # Coral: on the ledges, at the column's foot and among the boulders.
    def ground_at(x, y):
        i = int(np.clip((x + ACROSS / 2) / ACROSS * (GRID - 1), 0, GRID - 1))
        j = int(np.clip((y + ACROSS / 2) / ACROSS * (GRID - 1), 0, GRID - 1))
        return float(heights[j, i])

    placed = []
    spots = []
    for k in range(1, len(LEDGES)):
        inner, outer = LEDGES[k - 1][0], LEDGES[k][0]
        for _ in range(26 if k < len(LEDGES) - 1 else 22):
            a = rng.uniform(0, 2 * np.pi)
            rr = rng.uniform(inner + 0.15, outer - 0.05)
            spots.append((rr * math.cos(a), rr * math.sin(a)))
    for _ in range(14):
        a = rng.uniform(0, 2 * np.pi)
        rr = rng.uniform(LEDGES[-1][0] + 0.1, RADIUS - 0.6)
        spots.append((rr * math.cos(a), rr * math.sin(a)))
    for i, (x, y) in enumerate(spots):
        kind, size = CORAL_KINDS[int(rng.integers(len(CORAL_KINDS)))]
        size *= rng.uniform(0.6, 1.2)
        p, f = coral.grow_one(kind, rng, size)
        if not len(p):
            continue
        p = p + np.array([x, y, ground_at(x, y) - 0.02])
        tint = CORAL_COLOURS[int(rng.integers(len(CORAL_COLOURS)))]
        look = s.look(f"Coral{i}", tint, rough=0.6, mdl=pbr(tint, 0.55))
        s.add(f"Tank/Coral{i}", p, f, look, smooth=True)
        placed.append({"kind": kind, "sizeM": round(float(size), 3), "at": [round(x, 3), round(y, 3)],
                       "prim": f"Tank/Coral{i}"})

    # Light: over the water from the tank's top, and the atrium's daylight.
    for k in range(6):
        a = 2 * math.pi * k / 6
        s.extra.append(
            '    def RectLight "TankLight%d"\n    {\n        float inputs:width = 1.6\n        float inputs:height = 1.6\n'
            '        float inputs:intensity = 9000\n        color3f inputs:color = (0.82, 0.90, 1.0)\n'
            '        bool visibleInPrimaryRay = 0\n'
            '        double3 xformOp:translate = (%.3f, %.3f, %.3f)\n        uniform token[] xformOpOrder = ["xformOp:translate"]\n    }\n'
            % (k, 3.6 * math.cos(a), 3.6 * math.sin(a), FREEBOARD + 1.2))
    s.extra.append('    def DomeLight "Daylight"\n    {\n        float inputs:intensity = 700\n'
                   '        color3f inputs:color = (1.0, 0.98, 0.95)\n    }\n')
    # The hall's fills, a quarter-metre across at sixteen times the radiance
    # (the same power), and hidden from the camera: at a metre across and in
    # view they were drawn as two glowing white discs hanging in the atrium.
    for name_, at in (("FillGround", (0.0, -12.0, -10.0)), ("FillMezzanine", (9.0, 8.0, -4.5))):
        s.extra.append(
            '    def SphereLight "%s"\n    {\n        float inputs:radius = 0.25\n        float inputs:intensity = 64000\n'
            '        bool visibleInPrimaryRay = 0\n'
            '        color3f inputs:color = (1.0, 0.97, 0.92)\n        double3 xformOp:translate = (%.3f, %.3f, %.3f)\n'
            '        uniform token[] xformOpOrder = ["xformOp:translate"]\n    }\n' % (name_, *at))

    into.mkdir(parents=True, exist_ok=True)
    s.write(into / "tank.usda", f"{name}: the Jeddah airport tank, a {2 * RADIUS:g} m cylinder of Red Sea water. "
                                "Metres, Z up, z = 0 at the water surface.")
    heights.astype("<f4").tofile(into / "seabed.f32")
    return {"corals": placed, "lowest": float(heights.min()), "highest": float(heights.max()),
            "meshes": len(s.meshes)}


def a_place(name: str, made: dict) -> dict:
    return {
        "name": name,
        "from": {"surveyed": False, "measured": False, "fetched": True,
                 "source": ("published: King Abdulaziz International Airport Terminal 1's aquarium, a cylinder 14 m tall and "
                            "10 m across, 30 cm glass, 1,000,000 L of Red Sea water, ~2,000 animals of 65 species "
                            "(KAIA and press, 2023-24); read off two phone videos of it (3 October 2026): the column and its "
                            "ledges, the sand, which fish and roughly how many; chosen: the ledges' heights, the coral"),
                 "acrossMetres": ACROSS, "radiusM": RADIUS, "depthM": round(-FLOOR_Z, 2),
                 "sampleMetres": round(ACROSS / (GRID - 1), 4), "decimatedBy": 1},
        "datum": "still water; z = 0 is the free surface and depth is negative z",
        "enclosed": True,
        "interior": {"min": [-RADIUS, -RADIUS, FLOOR_Z], "max": [RADIUS, RADIUS, 0.0],
                     "round": {"centre": [0.0, 0.0], "radiusM": RADIUS},
                     "why": "the glass is a wall, and it is round: a vehicle stops at it rather than passing through"},
        "deepestM": round(-made["lowest"], 3),
        "shallowestM": round(max(0.0, -made["highest"]), 3),
        "underwater": 1.0,
        "mesh": {"heightfield": {"file": "seabed.f32", "rows": GRID, "columns": GRID,
