#!/usr/bin/env bash
# End-to-end check against a running Coral City deployment.
#
# This exercises the journey a person actually takes and the invariants the
# platform promises: that access is decided in one place, that an asset nobody
# has granted you is indistinguishable from one that does not exist, that a
# grant is what changes that, and that work is admitted or refused with a
# reason.
#
# Usage:
#   ./tools/e2e                       # against the local deployment
#   CORAL_CITY_API=… ./tools/e2e      # against another deployment

set -euo pipefail

API="${CORAL_CITY_API:-http://localhost:18080}"
ADMIN_EMAIL="${CORAL_CITY_ADMIN_EMAIL:-admin@coral.local}"
ADMIN_SECRET="${CORAL_CITY_ADMIN_SECRET:-development-secret}"

passed=0
failed=0

pass() { printf '  \033[32m✓\033[0m %s\n' "$1"; passed=$((passed + 1)); }
fail() { printf '  \033[31m✗\033[0m %s\n' "$1"; failed=$((failed + 1)); }
step() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# check <description> <actual> <expected>
check() {
    if [ "$2" = "$3" ]; then pass "$1"; else fail "$1 (got '$2', expected '$3')"; fi
}

# json <path> reads a value from stdin, e.g. json '["principal"]["id"]'
json() {
    python3 -c "
import json,sys
try:
    document = json.load(sys.stdin)
except Exception:
    print(''); raise SystemExit
try:
    print(document$1)
except Exception:
    print('')
"
}

# api <token> <method> <path> [body] — prints the body, sets STATUS
api() {
    local token="$1" method="$2" path="$3" body="${4:-}"
    local response
    if [ -n "$body" ]; then
        response=$(curl -sS -w '\n%{http_code}' -X "$method" "$API$path" \
            ${token:+-H "Authorization: Bearer $token"} \
            -H 'content-type: application/json' -d "$body")
    else
        response=$(curl -sS -w '\n%{http_code}' -X "$method" "$API$path" \
            ${token:+-H "Authorization: Bearer $token"})
    fi
    STATUS="${response##*$'\n'}"
    printf '%s' "${response%$'\n'*}"
}

status() { api "$@" >/dev/null; printf '%s' "$STATUS"; }

digest() { python3 -c "
import hashlib,sys
print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())
" "$1"; }

# ---------------------------------------------------------------------------
step "The deployment answers"

check "the build identifies itself" \
    "$(api '' GET /api/v1/platform | json "['name']")" "Coral City"
check "it reports itself ready" "$(status '' GET /health/ready)" "200"
check "it reports itself live" "$(status '' GET /health/live)" "200"

# ---------------------------------------------------------------------------
step "Nothing is readable without signing in"

check "the catalogue of places refuses an anonymous caller" \
    "$(status '' GET /api/v1/cities)" "401"
check "the catalogue of vehicles refuses an anonymous caller" \
    "$(status '' GET /api/v1/vehicles)" "401"
check "one's own identity refuses an anonymous caller" \
    "$(status '' GET /api/v1/me)" "401"

# ---------------------------------------------------------------------------
step "Signing in"

ADMIN=$(api '' POST /api/v1/sessions \
    "{\"email\":\"$ADMIN_EMAIL\",\"secret\":\"$ADMIN_SECRET\"}" | json "['token']")
[ -n "$ADMIN" ] && pass "the administrator signs in" || { fail "the administrator could not sign in"; exit 1; }

check "a wrong secret is refused" \
    "$(status '' POST /api/v1/sessions "{\"email\":\"$ADMIN_EMAIL\",\"secret\":\"wrong-secret-here\"}")" "401"
check "an unknown address is refused the same way, saying no more" \
    "$(status '' POST /api/v1/sessions '{"email":"nobody@coral.local","secret":"wrong-secret-here"}')" "401"

# ---------------------------------------------------------------------------
step "What the platform publishes"

RUN=$(date +%s)

CITY=$(api "$ADMIN" POST /api/v1/cities \
    "{\"slug\":\"tank-$RUN\",\"name\":\"Test Tank\",\"summary\":\"A tow tank\",\"verticalDatum\":\"tank floor\",\"discoverable\":false}" \
    | json "['id']")
[ -n "$CITY" ] && pass "a place is founded" || fail "could not found a place"

check "a place without a vertical datum is refused, because a depth without one is not a measurement" \
    "$(status "$ADMIN" POST /api/v1/cities "{\"slug\":\"nodatum-$RUN\",\"name\":\"No datum\"}")" "400"

VEHICLE=$(api "$ADMIN" POST /api/v1/vehicles \
    "{\"slug\":\"rov-$RUN\",\"name\":\"Observation ROV\",\"manufacturer\":\"Blue Robotics\",\"discoverable\":false}" \
    | json "['id']")
[ -n "$VEHICLE" ] && pass "a vehicle is published" || fail "could not publish a vehicle"

check "a second vehicle cannot take the same handle" \
    "$(status "$ADMIN" POST /api/v1/vehicles "{\"slug\":\"rov-$RUN\",\"name\":\"Impostor\"}")" "400"

# ---------------------------------------------------------------------------
step "An asset nobody granted you is indistinguishable from one that does not exist"

OTHER_ORG=$(api "$ADMIN" POST /api/v1/organisations \
    "{\"slug\":\"other-$RUN\",\"name\":\"Other Institute\"}" | json "['id']")
OUTSIDER=$(api "$ADMIN" POST /api/v1/people \
    "{\"displayName\":\"Outsider\",\"email\":\"outsider-$RUN@example.org\",\"secret\":\"outsider-secret-value\"}" \
    | json "['id']")
api "$ADMIN" POST "/api/v1/organisations/$OTHER_ORG/members" \
    "{\"principalId\":\"$OUTSIDER\"}" >/dev/null

GUEST=$(api '' POST /api/v1/sessions \
    "{\"email\":\"outsider-$RUN@example.org\",\"secret\":\"outsider-secret-value\"}" | json "['token']")
[ -n "$GUEST" ] && pass "the outsider signs in" || fail "the outsider could not sign in"

check "the outsider's catalogue of places is empty" \
    "$(api "$GUEST" GET /api/v1/cities | json "['cities']")" "[]"
check "the outsider's catalogue of vehicles is empty" \
    "$(api "$GUEST" GET /api/v1/vehicles | json "['vehicles']")" "[]"
check "reading the vehicle directly reports absence, not refusal" \
    "$(status "$GUEST" GET "/api/v1/vehicles/$VEHICLE")" "404"
check "reading the place directly reports absence, not refusal" \
    "$(status "$GUEST" GET "/api/v1/cities/$CITY")" "404"

# ---------------------------------------------------------------------------
step "A grant is what changes that"

check "granting the institution the vehicle" \
    "$(status "$ADMIN" POST "/api/v1/vehicles/$VEHICLE/grants" \
        "{\"subjectKind\":\"org\",\"subjectId\":\"$OTHER_ORG\",\"role\":\"viewer\"}")" "201"
check "granting the institution the place" \
    "$(status "$ADMIN" POST "/api/v1/cities/$CITY/grants" \
        "{\"subjectKind\":\"org\",\"subjectId\":\"$OTHER_ORG\",\"role\":\"viewer\"}")" "201"

check "the vehicle now appears to the outsider" \
    "$(api "$GUEST" GET /api/v1/vehicles | json "['vehicles'][0]['id']")" "$VEHICLE"
check "the place now appears to the outsider" \
    "$(api "$GUEST" GET /api/v1/cities | json "['cities'][0]['id']")" "$CITY"
check "and can be read directly" \
    "$(status "$GUEST" GET "/api/v1/vehicles/$VEHICLE")" "200"

check "a member of the institution inherits the grant without being named" \
    "$(api "$GUEST" GET "/api/v1/vehicles/$VEHICLE" | json "['slug']")" "rov-$RUN"

# ---------------------------------------------------------------------------
step "A grant can be withdrawn"

BINDING=$(api "$ADMIN" GET "/api/v1/cities/$CITY/grants" | json "['grants'][0]['id']")
check "withdrawing it" \
    "$(status "$ADMIN" DELETE "/api/v1/cities/$CITY/grants/$BINDING")" "204"
check "the place is hidden again" \
    "$(api "$GUEST" GET /api/v1/cities | json "['cities']")" "[]"
check "and the vehicle, granted separately, is untouched" \
    "$(api "$GUEST" GET /api/v1/vehicles | json "['vehicles'][0]['id']")" "$VEHICLE"

# ---------------------------------------------------------------------------
step "The outsider may not publish"

check "founding a place needs authority at the platform" \
    "$(status "$GUEST" POST /api/v1/cities \
        "{\"slug\":\"sneak-$RUN\",\"name\":\"Sneak\",\"verticalDatum\":\"x\"}")" "403"
check "publishing a vehicle needs authority at the platform" \
    "$(status "$GUEST" POST /api/v1/vehicles "{\"slug\":\"sneak-$RUN\",\"name\":\"Sneak\"}")" "403"
check "granting what one was merely given is refused" \
    "$(status "$GUEST" POST "/api/v1/vehicles/$VEHICLE/grants" \
        "{\"subjectKind\":\"org\",\"subjectId\":\"$OTHER_ORG\",\"role\":\"admin\"}")" "403"

# ---------------------------------------------------------------------------
step "A refusal is recorded and can be read back"

REFUSED=$(api "$GUEST" GET /api/v1/me/denials | json "['denials'][0]['action']")
[ -n "$REFUSED" ] && pass "the outsider's refusals were recorded, with the action that was refused" \
    || fail "no refusal was recorded for the outsider"

# ---------------------------------------------------------------------------
step "Work"

check "a place work can run is recorded" \
    "$(status "$ADMIN" GET /api/v1/targets)" "200"

# ---------------------------------------------------------------------------
printf '\n\033[1m%d passed, %d failed\033[0m\n' "$passed" "$failed"
[ "$failed" -eq 0 ]
