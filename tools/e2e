#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compose_file="${repository_root}/deployments/local/compose.yaml"
web_port="${CORAL_CITY_WEB_PORT:-18088}"

cleanup() {
  CORAL_CITY_WEB_PORT="${web_port}" docker compose -f "${compose_file}" down --volumes --remove-orphans
}
trap cleanup EXIT

CORAL_CITY_WEB_PORT="${web_port}" docker compose -f "${compose_file}" up --build --detach --wait

platform_response="$(curl --fail --silent --show-error "http://127.0.0.1:${web_port}/api/v1/platform")"
homepage_response="$(curl --fail --silent --show-error "http://127.0.0.1:${web_port}/")"

if [[ "${platform_response}" != *'"name":"Coral City"'* ]] || \
   [[ "${platform_response}" != *'"service":"control-plane"'* ]]; then
  echo "Public web ingress did not return the control-plane platform contract." >&2
  exit 1
fi

if [[ "${homepage_response}" != *'<title>Coral City</title>'* ]]; then
  echo "Public web ingress did not return the Coral City application." >&2
  exit 1
fi

echo "Coral City end-to-end ingress check passed on port ${web_port}."
