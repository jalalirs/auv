#!/usr/bin/env bash
# Download immutable runtime assets on the Mac and transfer them over Tailscale.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${REPO_ROOT}/.env" ]; then
    set -a
    source "${REPO_ROOT}/.env"
    set +a
fi

GPU_HOST="${AUV_GPU_HOST:-jalalirs@100.76.65.1}"
DATA_DIR="${AUV_DATA_DIR:-/home/jalalirs/auv-data}"
ASSET_SET="${1:-first-dive}"
MANIFEST_ID="first-dive-fuel-2026-08-05-v2"
REMOTE_ASSET_DIR="${DATA_DIR}/gazebo/first_dive"

if [ "${ASSET_SET}" != "first-dive" ]; then
    printf 'Usage: %s first-dive\n' "$0" >&2
    exit 2
fi

if [[ ! "${DATA_DIR}" =~ ^/[A-Za-z0-9._/-]+$ ]] || [[ "${DATA_DIR}" == *..* ]]; then
    printf 'Refusing unsafe AUV_DATA_DIR: %s\n' "${DATA_DIR}" >&2
    exit 1
fi

if ssh -o BatchMode=yes "${GPU_HOST}" \
    "test -f '${REMOTE_ASSET_DIR}/manifest' && grep -qx '${MANIFEST_ID}' '${REMOTE_ASSET_DIR}/manifest'"; then
    printf 'First Dive assets are already cached on the GPU.\n'
    exit 0
fi

for command_name in curl shasum tar unzip; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
        printf 'Missing local command: %s\n' "${command_name}" >&2
        exit 1
    fi
done

STAGING_DIR="$(mktemp -d /tmp/auv-first-dive-assets.XXXXXX)"
trap 'rm -rf -- "${STAGING_DIR}"' EXIT
mkdir -p "${STAGING_DIR}/models"

download_model() {
    local owner="$1"
    local encoded_name="$2"
    local directory_name="$3"
    local expected_sha="$4"
    local archive="${STAGING_DIR}/${directory_name}.zip"

    printf 'Downloading %s...\n' "${directory_name}"
    curl --fail --location --silent --show-error \
        "https://fuel.gazebosim.org/1.0/${owner}/models/${encoded_name}.zip" \
        --output "${archive}"
    printf '%s  %s\n' "${expected_sha}" "${archive}" | shasum -a 256 --check --status
    mkdir -p "${STAGING_DIR}/models/${directory_name}"
    unzip -q "${archive}" -d "${STAGING_DIR}/models/${directory_name}"
    test -f "${STAGING_DIR}/models/${directory_name}/model.config"
    test -f "${STAGING_DIR}/models/${directory_name}/model.sdf"
}

download_model \
    OpenRobotics Coast%20Water coast_water \
    41235ac0fec648ef6e31f392c06400daa39177eb5a5e5fa26bc346b93142059d
download_model \
    hmoyen Sunken%20Ship%20Distorted sunken_ship_distorted \
    107e99c9feb5e2419d0ae807a79d5856b458328625e605e9ee0c6917a3fa18c9
download_model \
    hmoyen Sand%20Heightmap sand_heightmap \
    f5f9ed93bd5baa78cb79f2e909da5b545193c4579655a4b7d74ba16f59ac2064

# The upstream sand model references model://materials instead of its own
# model directory. Preserve that expected alias without duplicating files.
ln -s sand_heightmap/materials "${STAGING_DIR}/models/materials"

printf '%s\n' "${MANIFEST_ID}" > "${STAGING_DIR}/manifest"

printf 'Transferring verified assets to %s:%s...\n' "${GPU_HOST}" "${REMOTE_ASSET_DIR}"
COPYFILE_DISABLE=1 tar -C "${STAGING_DIR}" -czf - models manifest \
    | ssh -o BatchMode=yes "${GPU_HOST}" \
        "set -e; mkdir -p '${REMOTE_ASSET_DIR}'; tar -xzf - -C '${REMOTE_ASSET_DIR}'"

printf 'First Dive assets are ready.\n'
