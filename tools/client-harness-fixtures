#!/usr/bin/env bash
# The client's development harness draws real places and flies real hulls:
# copy two places and two vehicles' dynamics in.
#
#   tools/client-harness-fixtures
#
# Copied from ~/iocean/places into apps/client/src/renderer/harness/fixtures,
# which is gitignored: the seabeds are a megabyte and already published.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
into="${here}/apps/client/src/renderer/harness/fixtures"
mkdir -p "${into}"
for place in iocean-tank-1 looe-key; do
    mkdir -p "${into}/${place}"
    cp "${HOME}/iocean/places/${place}/site.json" "${HOME}/iocean/places/${place}/seabed.f32" "${into}/${place}/"
done
for vehicle in mini-hoot boxfish-luna; do
    mkdir -p "${into}/${vehicle}"
    cp "${here}/catalog/vehicles/${vehicle}/dynamics.json" "${into}/${vehicle}/"
done
echo "fixtures in ${into}"
