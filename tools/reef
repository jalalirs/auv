#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${REPO_ROOT}/.env" ]; then
    set -a
    source "${REPO_ROOT}/.env"
    set +a
fi

REMOTE_DIR="${AUV_REMOTE_DIR:-code/auv}"
DATA_DIR="${AUV_DATA_DIR:-/home/jalalirs/code/auv-data}"
GPU_DEVICE="${AUV_GPU_DEVICE:-0}"
DOMAIN_ID="${ROS_DOMAIN_ID:-42}"
USER_UID_VALUE="${AUV_USER_UID:-1000}"
USER_GID_VALUE="${AUV_USER_GID:-1000}"
GPU_HOST="${AUV_GPU_HOST:-jalalirs@100.76.65.1}"
RUNTIME_DIR="${REPO_ROOT}/.runtime"
CONTROL_SOCKET="${RUNTIME_DIR}/reef-ssh.sock"
XPRA_LOCAL_PORT="${REEF_LOCAL_PORT:-19877}"
XPRA_REMOTE_PORT="${REEF_REMOTE_PORT:-9877}"
FOXGLOVE_LOCAL_PORT="${REEF_FOXGLOVE_LOCAL_PORT:-18767}"
FOXGLOVE_REMOTE_PORT="${REEF_FOXGLOVE_REMOTE_PORT:-8767}"

if [[ ! "${REMOTE_DIR}" =~ ^[A-Za-z0-9._/-]+$ ]] \
    || [[ "${REMOTE_DIR}" = /* ]] \
    || [[ "${REMOTE_DIR}" == *..* ]]; then
    printf 'Refusing unsafe AUV_REMOTE_DIR: %s\n' "${REMOTE_DIR}" >&2
    exit 1
fi

for numeric_value in \
    "${GPU_DEVICE}" "${DOMAIN_ID}" "${USER_UID_VALUE}" "${USER_GID_VALUE}" \
    "${XPRA_LOCAL_PORT}" "${XPRA_REMOTE_PORT}" \
    "${FOXGLOVE_LOCAL_PORT}" "${FOXGLOVE_REMOTE_PORT}"; do
    if [[ ! "${numeric_value}" =~ ^[0-9]+$ ]]; then
        printf 'GPU, ROS domain, UID/GID, and ports must be integers.\n' >&2
        exit 1
    fi
done

printf -v COMPOSE_ENV \
    'AUV_DATA_DIR=%q AUV_GPU_DEVICE=%q ROS_DOMAIN_ID=%q AUV_USER_UID=%q AUV_USER_GID=%q' \
    "${DATA_DIR}" "${GPU_DEVICE}" "${DOMAIN_ID}" "${USER_UID_VALUE}" "${USER_GID_VALUE}"
printf -v QUOTED_DATA_DIR '%q' "${DATA_DIR}"

remote() {
    "${SCRIPT_DIR}/gpu" "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} $1"
}

require_synced_checkout() {
    local local_head remote_head
    if [ -n "$(git -C "${REPO_ROOT}" status --porcelain)" ]; then
        printf 'Local files are not synchronized. Run tools/gpu sync first.\n' >&2
        exit 1
    fi
    local_head="$(git -C "${REPO_ROOT}" rev-parse HEAD)"
    remote_head="$("${SCRIPT_DIR}/gpu" "git -C '${REMOTE_DIR}' rev-parse HEAD")"
    if [ "${local_head}" != "${remote_head}" ]; then
        printf 'Mac and GPU commits differ. Run tools/gpu sync first.\n' >&2
        exit 1
    fi
}

tunnel_running() {
    [ -S "${CONTROL_SOCKET}" ] \
        && ssh -S "${CONTROL_SOCKET}" -O check "${GPU_HOST}" >/dev/null 2>&1
}

start_view() {
    mkdir -p "${RUNTIME_DIR}"
    if ! tunnel_running; then
        rm -f "${CONTROL_SOCKET}"
        ssh -M -S "${CONTROL_SOCKET}" -fNT \
            -o ExitOnForwardFailure=yes \
            -L "${XPRA_LOCAL_PORT}:127.0.0.1:${XPRA_REMOTE_PORT}" \
            -L "${FOXGLOVE_LOCAL_PORT}:127.0.0.1:${FOXGLOVE_REMOTE_PORT}" \
            "${GPU_HOST}"
    fi
    printf 'Living Reef: http://localhost:%s/index.html\n' "${XPRA_LOCAL_PORT}"
    printf 'Reef Foxglove: ws://localhost:%s\n' "${FOXGLOVE_LOCAL_PORT}"
    if command -v open >/dev/null 2>&1; then
        open "http://localhost:${XPRA_LOCAL_PORT}/index.html"
    fi
}

stop_view() {
    if tunnel_running; then
        ssh -S "${CONTROL_SOCKET}" -O exit "${GPU_HOST}" >/dev/null
    else
        rm -f "${CONTROL_SOCKET}"
    fi
}

case "${1:-status}" in
    build)
        require_synced_checkout
        remote "docker compose build reef"
        ;;
    up)
        require_synced_checkout
        remote "mkdir -p ${QUOTED_DATA_DIR}/logs/reef ${QUOTED_DATA_DIR}/runtime/reef/xdg && { docker compose stop first-dive >/dev/null 2>&1 || true; } && docker compose up --build --detach reef"
        ;;
    stop)
        remote "docker compose stop reef"
        ;;
    status)
        remote "docker compose ps reef"
        ;;
    logs)
        "${SCRIPT_DIR}/gpu" -s "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose logs --follow reef"
        ;;
    keyboard)
        require_synced_checkout
        "${SCRIPT_DIR}/gpu" -s "cd '${REMOTE_DIR}' && ${COMPOSE_ENV} docker compose exec reef bash -lc 'source /opt/ros/jazzy/setup.bash && source /opt/reef_ws/install/setup.bash && exec python3 /workspace/auv/ros2_ws/src/auv_control/auv_control/reef_keyboard_teleop.py'"
        ;;
    view)
        start_view
        ;;
    view-stop)
        stop_view
        ;;
    *)
        printf 'Usage: %s {build|up|stop|status|logs|keyboard|view|view-stop}\n' "$0" >&2
        exit 2
        ;;
esac
