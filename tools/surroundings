#!/usr/bin/env python3
"""The seabed around a place, from GEBCO 2026: what lies beyond its own survey.

    hardware/.venv/bin/python tools/surroundings <place dir> [--half-degrees 0.1]

A place's own heightfield is a kilometre or a few: the survey, or the derived
seabed. Past its edge the dive had nothing — a sonar looked into a void and a
long transect ran off the map. GEBCO (General Bathymetric Chart of the Oceans,
2026 release, 15 arc-second grid, public domain) is the whole ocean floor at
about 460 m a cell, and its Type Identifier Grid says, cell by cell, what each
depth came from: a multibeam survey, a single beam, an interpolation, a
satellite-derived guess. That is the surroundings, and each cell keeps its TID.

Not downloaded whole (7.5 GB): the netCDF is HDF5 with the elevation as one
contiguous int16 array, so each row of the box is a byte range of the file at
CEDA's archive, read with HTTP range requests — a few hundred kilobytes a place.

And where ships have surveyed it, the multibeam itself: NOAA NCEI's mosaic of
the IHO Data Centre for Digital Bathymetry's multibeam (3 arc-seconds, about
90 m), cut to the same box by its image service. NaN where no ship has been —
none at all round the Red Sea places, a fifth to a quarter round Looe Key and
Kaneohe.

Writes into the place: surroundings.f32 (metres, negative under the sea, rows
south to north, columns west to east), surroundings_tid.u8, multibeam.f32 when
there is any, and a "surroundings" record in site.json saying where each came
from.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

import numpy as np

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import built  # noqa: E402

# The fetch lives in the places module now (iocean_places/fetch/gebco.py).
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "packages" / "places"))
from iocean_places.fetch.gebco import fetch_box  # noqa: E402

def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("place", type=pathlib.Path)
    ap.add_argument("--half-degrees", type=float, default=0.1)
    args = ap.parse_args(argv)
    site = json.loads((args.place / "site.json").read_text())
    centre = site["from"]["centre"]
    lat, lon = float(centre["latitude"]), float(centre["longitude"])
    site["surroundings"] = fetch_box(lat, lon, args.half_degrees, args.place)
    said = site["surroundings"]
    height = np.fromfile(args.place / "surroundings.f32", dtype="<f4").reshape(said["rows"], said["columns"])
    # How it was called, so tools/rebuild fetches the surroundings again.
    built.record_call(site, "surroundings")
    (args.place / "site.json").write_text(json.dumps(site, indent=1) + "\n")
    print(f"{args.place.name}: {height.shape[0]} x {height.shape[1]} cells, "
          f"{height.min():.0f}..{height.max():.0f} m, {site['surroundings']['whatEachCellIs']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
