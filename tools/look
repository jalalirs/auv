#!/usr/bin/env bash
# The same four views of every place, for comparing one week against the next.
#
# Every judgement in docs/plan/r2.md's first phase is a judgement about an
# image, and a judgement made against memory is not a judgement. `fly-over`
# flies a path and hands back whatever it passed: two runs of it are not
# comparable, and neither is a before and an after.
#
# So this holds the camera still, at four named viewpoints, in every place, and
# writes what made each frame beside it. What differs between two sheets is
# what somebody changed.
#
# Runs on the box, where the GPUs are.
#
#   tools/look                       # the five real places
#   tools/look al-fahal looe-key     # or the ones named
#
# Frames land in ~/coral-city/work/looks/<place>/ and the sheet beside them.

set -euo pipefail

# Which of Jerlov's waters. One name, and every number in the medium comes
# off it: I is the clearest open ocean, 9C a turbid harbour.
WATER="${WATER:-1C}"

PLACES=("$@")
[ ${#PLACES[@]} -eq 0 ] && PLACES=(al-fahal looe-key kaneohe red-sea thuwal-deep)

CITY="${HOME}/coral-city"
work="${CITY}/work"
looks="${work}/looks"
# One working directory per place, not one shared by all of them.
#
# Shared, a run that fails part way leaves its frames behind and the next place
# copies them out under its own name — which is how a six-hundred-metre site
# came back as a pink shallow reef, with a record beside it saying it was the
# deep one. Every guard in this file was about stale *builds*; this is stale
# *places*, and it is worse, because the picture looks fine.
here_for() { printf '%s/look-%s' "${work}" "$(basename "$1" | tr -c 'A-Za-z0-9._-' '-')"; }
image="127.0.0.1:18081/sim-runtime:r1"

mkdir -p "${looks}"

one_place() {
    local place="$1"
    local city vehicle here
    here="$(here_for "${place}")"
    # A place, or a directory somebody is trying something in. The second is
    # how a change to a package is judged before it is published: a package is
    # immutable once it is, and looking at a change after publishing it is
    # looking at it too late.
    if [ -d "${place}" ] && [ -f "${place}/site.json" ]; then
        city="${place}"
    else
        city="$("$(dirname "$0")/newest-place" "${place}")"
    fi
    [ -n "${city}" ] || { echo "  no published place called '${place}'" >&2; return 1; }

    # A vehicle package, the same way a place can be one: a directory to try
    # before it is published. VEHICLE=./catalog/vehicles/bluerov2 is how a
    # change to what a vehicle carries gets looked at.
    vehicle="${VEHICLE:-}"
    if [ -n "${vehicle}" ]; then
        [ -f "${vehicle}/dynamics.json" ] || { echo "  ${vehicle} has no dynamics.json" >&2; return 1; }
        vehicle="$(cd "${vehicle}" && pwd)"
    else
        for d in "${work}"/packages/*/; do
            [ -f "${d}/dynamics.json" ] && vehicle="${d%/}"
        done
    fi
    [ -n "${vehicle}" ] || { echo "  no vehicle package to open the scene with" >&2; return 1; }

    # Pulled, not assumed. `fly-over` has always done this and this did not,
    # which is how an afternoon went: every build was pushed to the registry
    # and every run used whatever image happened to be sitting on the box, so
    # the code under test and the code that ran were different for hours.
    docker pull -q "${image}" >/dev/null 2>&1 \
        || { echo "  the registry has no ${image}" >&2; return 1; }

    rm -rf "${here}"; mkdir -p "${here}/frames"; chmod -R 777 "${here}"
    # Which water to look through. A place has no opinion of its own yet, so
    # this is how one is tried: the same reef through clear ocean and through a
    # turbid bay is the comparison the water types exist to make.
    cat > "${here}/dive.json" <<JSON
{"cityPath": "/dive/city", "vehiclePath": "/dive/vehicle",
 "durationSeconds": 600, "autonomy": false,
 "conditions": {"kind": "constructed",
                "parameters": {"waterType": "${WATER:-1C}"}}}
JSON
    chmod 666 "${here}/dive.json"

    docker rm -f coral-look >/dev/null 2>&1 || true
    docker run -d --name coral-look --gpus '"device=0"' \
        -e ACCEPT_EULA=Y -e PRIVACY_CONSENT=Y -e ROS_LOG_DIR=/tmp/ros \
        -e CORAL_CITY_SEED=1 \
        -e CORAL_CITY_BRIEF=/dive/dive.json \
        -e CORAL_CITY_TOUR=stills \
        -e CORAL_CITY_LAMP_CONE="${LAMP_CONE:-0}" \
        -e CORAL_CITY_TEST_LAMP="${TEST_LAMP:-}" \
        -e CORAL_CITY_LAMP_SIZE="${LAMP_SIZE:-0.08}" \
        -e CORAL_CITY_TWIN="${TWIN:-}" \
        -e CORAL_CITY_CLEAR="${CLEAR:-0}" \
        -e CORAL_CITY_ISO="${ISO:-}" \
        -e CORAL_CITY_METER="${METER:-1}" \
        -e CORAL_CITY_LAMP_INTENSITY="${LAMP_INTENSITY:-}" \
        -e CORAL_CITY_TOUR_INTO=/dive/frames \
        -v "${here}:/dive:rw" \
        -v "${city}:/dive/city:ro" \
        -v "${vehicle}:/dive/vehicle:ro" \
        --entrypoint /isaac-sim/kit/kit \
        "${image}" /isaac-sim/apps/coral_city.kit --no-window >/dev/null

    # Opening the scene takes minutes; four stills after that take seconds.
    local n=0
    # Kit does not exit when the tour is done, so finishing is something the
    # log says rather than something the container does.
    local finished=""
    for _ in $(seq 1 150); do
        sleep 10
        n="$(find "${here}/frames" -name '*.png' 2>/dev/null | wc -l | tr -d ' ')"
        printf '\r  %s frames' "${n}"
        docker logs coral-look 2>&1 | grep -q '"event": "tour_done"' && { finished=1; break; }
        docker logs coral-look 2>&1 | grep -qE '"event": "(tour_failed|failed)"' && break
        docker ps --format '{{.Names}}' | grep -q '^coral-look$' || break
    done
    printf '\n'

    # The log is taken while the container is still there, and the container is
    # stopped here rather than left to time out. Reading it after it is gone is
    # how the previous run's log gets read as though it were this one, which is
    # a whole afternoon of conclusions about code that never ran.
    docker logs coral-look > "${here}/look.log" 2>&1 || true
    docker rm -f coral-look >/dev/null 2>&1 || true
    [ -n "${finished}" ] || echo "  the tour did not report finishing" >&2
    # And it has to be the build the working tree has, not whatever the box
    # happened to be running. A warning is not enough here: a stale image looks
    # exactly like a change that did nothing, and the whole point of this tool
    # is telling those two apart.
    local wanted said
    wanted="$(grep -o 'BUILD = "[^"]*"' "$(dirname "$0")/../services/sim-runtime/coral/water.py" \
              | head -1 | cut -d'"' -f2)"
    said="$(grep -o '"build": "[^"]*"' "${here}/look.log" | head -1 | cut -d'"' -f4)"
    if [ -n "${wanted}" ] && [ "${said}" != "${wanted}" ]; then
        echo "  STALE: the log says build '${said}', the tree says '${wanted}'" >&2
        echo "  (build and push the image before looking)" >&2
        rm -rf "${looks:?}/$(basename "${place}")-${WATER}"
        return 1
    fi
    grep -E '"event": "(stills_|place_open|water_is|failed)' "${here}/look.log" \
        | tail -4 | sed 's/^/    /' || true

    local as="$(basename "${place}")-${WATER}"
    n="$(find "${here}/frames" -name '*.png' 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${n}" -eq 0 ]; then
        # And take the last run's frames away with it. Leaving them is how a
        # failed run gets compared as though it had succeeded: the pictures are
        # there, they are just from an hour ago.
        echo "  ${place} produced nothing to look at — clearing the old frames" >&2
        rm -rf "${looks:?}/${as}"
        grep -iE 'could not open|Traceback' "${here}/look.log" | head -3 | sed 's/^/    /' >&2
        return 1
    fi
    docker run --rm -u 0 -v "${here}/frames:/w" --entrypoint chmod "${image}" -R a+r /w

    # What made these frames, beside them — so a sheet can say what it is a
    # sheet of, and two of them can be told apart a month later.
    rm -rf "${looks:?}/${as}"; mkdir -p "${looks}/${as}"
    # If the frames do not arrive, nothing else should either. A directory
    # holding a record of what made it and no pictures is worse than an empty
    # one: it reads as a run that happened.
    if ! cp "${here}"/frames/*.png "${looks}/${as}/"; then
        echo "  the frames could not be kept" >&2
        rm -rf "${looks:?}/${as}"
        return 1
    fi
    cp "${here}/look.log" "${looks}/${as}/look.log" 2>/dev/null || true
    {
        printf '{"place": "%s", "package": "%s", "at": "%s",\n' \
            "${place}" "$(basename "${city}")" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf ' "runtime": "%s", "commit": "%s"}\n' \
            "${image}" "$(git -C "$(dirname "$0")/.." rev-parse --short HEAD 2>/dev/null || echo unknown)"
    } > "${looks}/${as}/made.json"
    echo "  ${n} frames → ${looks}/${as}"
}

for place in "${PLACES[@]}"; do
    echo "=== ${place}"
    one_place "${place}" || true
done

echo
echo "Sheets in ${looks}. Pull them with:"
echo "  scp -r <box>:${looks} ."
