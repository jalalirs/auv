{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coral-city.local/contracts/reef-survey-manifest.schema.json",
  "title": "Coral City reef survey manifest",
  "type": "object",
  "required": ["schema_version", "asset_id", "truth_class", "source", "license", "site", "files", "geometry", "known_limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "asset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "truth_class": { "enum": ["observation", "analysis", "forecast", "scenario", "simulation"] },
    "source": {
      "type": "object",
      "required": ["title", "record_url", "version", "retrieval_date", "creators"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "record_url": { "type": "string", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1 },
        "retrieval_date": { "type": "string", "format": "date" },
        "creators": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "license": {
      "type": "object",
      "required": ["record_identifier", "project_use", "redistribution", "commercial_use"],
      "properties": {
        "record_identifier": { "type": "string", "minLength": 1 },
        "project_use": { "type": "string", "minLength": 1 },
        "redistribution": { "type": "string", "minLength": 1 },
        "commercial_use": { "type": "string", "minLength": 1 }
      }
    },
    "site": {
      "type": "object",
      "required": ["name", "locality", "survey_period", "depth_range_m", "wgs84_anchor", "vertical_datum"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "locality": { "type": "string", "minLength": 1 },
        "survey_period": { "type": "string", "minLength": 1 },
        "depth_range_m": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "wgs84_anchor": {
          "type": "object",
          "required": ["latitude_deg", "longitude_deg", "method", "horizontal_uncertainty_m", "survey_grade"],
          "properties": {
            "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
            "method": { "type": "string", "minLength": 1 },
            "horizontal_uncertainty_m": { "type": "number", "minimum": 0 },
            "survey_grade": { "type": "boolean" }
          }
        },
        "vertical_datum": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "url", "bytes", "md5", "format"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "bytes": { "type": "integer", "minimum": 1 },
          "md5": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
          "format": { "type": "string", "minLength": 1 }
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["units", "up_axis", "bounds_min_m", "bounds_max_m", "extent_m"],
      "properties": {
        "units": { "const": "meters" },
        "up_axis": { "enum": ["X", "Y", "Z"] },
        "bounds_min_m": { "$ref": "#/$defs/vector3" },
        "bounds_max_m": { "$ref": "#/$defs/vector3" },
        "extent_m": { "$ref": "#/$defs/positiveVector3" }
      }
    },
    "known_limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
