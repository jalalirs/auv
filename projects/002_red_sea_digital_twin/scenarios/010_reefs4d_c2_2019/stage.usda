#usda 1.0
(
    defaultPrim = "RedSeaTwin"
    doc = "First measured Red Sea reef inspection scene: Reefs4D C2, 2019"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RedSeaTwin" (
    kind = "assembly"
)
{
    custom string redsea:frame = "source_local_z_up"
    custom string redsea:scenarioId = "redsea.reefs4d.c2.2019.inspection.v1"
    custom string redsea:site = "Princess Beach C2"
    custom string redsea:truthClass = "scenario"

    def Scope "Site"
    {
        def Xform "MeasuredReef" (
            prepend references = @/data/red-sea-twin/assets/derived/reefs4d/c2-2019/lod0/C22019_visual_lod0.usdc@
        )
        {
            custom string redsea:assetId = "reefs4d.c2.2019.visual.lod0"
            custom string redsea:sourceDoi = "10.5281/zenodo.14616671"
            custom string redsea:truthClass = "derived_observation"
        }
    }

    def Scope "SyntheticContext"
    {
        custom string redsea:truthClass = "scenario"

        def Cube "SandSeabed"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.30, 0.25, 0.17)]
            double3 xformOp:scale = (20, 20, 0.12)
            double3 xformOp:translate = (0, 0, -5.24)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WaterVolume"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.015, 0.17, 0.23)]
            float[] primvars:displayOpacity = [0.035]
            double3 xformOp:scale = (20, 20, 8)
            double3 xformOp:translate = (0, 0, -4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WaterSurface"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.03, 0.42, 0.55)]
            float[] primvars:displayOpacity = [0.18]
            double3 xformOp:scale = (20, 20, 0.015)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Xform "PeripheralRocks"
        {
            def Sphere "Rock01"
            {
                double radius = 1
                color3f[] primvars:displayColor = [(0.19, 0.16, 0.12)]
                double3 xformOp:scale = (0.9, 0.6, 0.35)
                double3 xformOp:translate = (-3.2, 2.4, -4.95)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Sphere "Rock02"
            {
                double radius = 1
                color3f[] primvars:displayColor = [(0.24, 0.20, 0.14)]
                double3 xformOp:scale = (0.65, 0.9, 0.28)
                double3 xformOp:translate = (3.4, 1.8, -5.0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Sphere "Rock03"
            {
                double radius = 1
                color3f[] primvars:displayColor = [(0.17, 0.20, 0.15)]
                double3 xformOp:scale = (0.7, 0.55, 0.4)
                double3 xformOp:translate = (2.8, 4.2, -4.9)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Sphere "Rock04"
            {
                double radius = 1
                color3f[] primvars:displayColor = [(0.22, 0.18, 0.13)]
                double3 xformOp:scale = (0.5, 0.8, 0.3)
                double3 xformOp:translate = (-2.7, -2.6, -5.0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

    def Scope "Render"
    {
        def DomeLight "OceanAmbient"
        {
            color3f color = (0.035, 0.17, 0.25)
            float intensity = 520
        }

        def DistantLight "FilteredSun"
        {
            float angle = 0.7
            color3f color = (0.52, 0.78, 0.82)
            float intensity = 1350
            double3 xformOp:rotateXYZ = (24, -32, -18)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def SphereLight "CameraFill"
        {
            color3f color = (0.22, 0.56, 0.62)
            float intensity = 1800
            float radius = 1.2
            double3 xformOp:translate = (2.5, -2.2, -2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Camera "Overview"
        {
            float2 clippingRange = (0.03, 1000)
            float focalLength = 32
            float horizontalAperture = 20.955
            float verticalAperture = 15.2908
            matrix4d xformOp:transform = ((0.77111276, 0.63669861, 0, 0), (-0.23087453, 0.27961471, 0.93194021, 0), (0.59336504, -0.71863099, 0.36261197, 0), (4.2, -4.5, -1.5, 1))
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def Camera "CloseInspection"
        {
            float2 clippingRange = (0.02, 1000)
            float focalLength = 28
            float horizontalAperture = 20.955
            float verticalAperture = 15.2908
            matrix4d xformOp:transform = ((0.77339210, 0.63392795, 0, 0), (-0.13356674, 0.16295142, 0.97755141, 0), (0.61969717, -0.75603054, 0.21069704, 0), (2.2, -2.1, -3.4, 1))
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def Camera "TopSurvey"
        {
            float2 clippingRange = (0.03, 1000)
            float focalLength = 42
            float horizontalAperture = 20.955
            float verticalAperture = 15.2908
            double3 xformOp:translate = (-0.3, 0.95, 2.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
