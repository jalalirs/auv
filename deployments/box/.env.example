# The box environment.
#
# Copy to `.env` beside this file and fill in. Every value without a default is
# required, and compose will refuse to start rather than invent one, because a
# platform that silently runs on a guessed password is worse than one that does
# not run.
#
#   cp deployments/box/.env.example deployments/box/.env
#   ./tools/box up

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
CORAL_CITY_DATABASE_PASSWORD=
CORAL_CITY_STORAGE_ACCESS_KEY=
CORAL_CITY_STORAGE_SECRET_KEY=

# ── The first administrator ──────────────────────────────────────────────────
# Created once, on first start. Changing these afterwards does nothing: the
# bootstrap is idempotent and leaves an installation that already has an
# administrator alone.
CORAL_CITY_ADMIN_EMAIL=
CORAL_CITY_ADMIN_SECRET=
CORAL_CITY_ADMIN_NAME=
CORAL_CITY_ADMIN_ORG=coral
# Quoted because a value with a space in it is fine for compose but not for
# a shell that sources this file.
CORAL_CITY_ADMIN_ORG_NAME="Coral City"

# ── Stored bytes ─────────────────────────────────────────────────────────────
# Cities, vehicles and recorded dives live here and grow without bound. This
# host's root filesystem is shared with other people's work, so choose a path
# whose exhaustion is this platform's problem alone.
CORAL_CITY_STORAGE_PATH=/home/jalalirs/coral-city/storage

# Where the agent stages a job's inputs. The container runtime resolves bind
# mounts on the host, so this is a host path, not a path inside the agent. It
# sits under the operator's home rather than /var/lib so that bringing the
# environment up needs no privilege it would not otherwise have.
CORAL_CITY_AGENT_HOST_WORKDIR=/home/jalalirs/coral-city/work

# ── Network ──────────────────────────────────────────────────────────────────
# Loopback by default. Reach it over the tailnet with `./tools/box tunnel`,
# which forwards these ports rather than exposing them. Set to 0.0.0.0 only
# once there is TLS and the cookie can go back to being secure.
CORAL_CITY_BIND_ADDRESS=127.0.0.1
CORAL_CITY_API_PORT=18080
CORAL_CITY_REGISTRY_PORT=18081
CORAL_CITY_CONSOLE_PORT=18082
CORAL_CITY_STORAGE_PORT=19000
CORAL_CITY_STORAGE_CONSOLE_PORT=19001

# A presigned URL is signed over the host it names, so this must be the address
# whoever follows the URL will actually use — not the address inside the
# compose network.
CORAL_CITY_STORAGE_PUBLIC_ENDPOINT=127.0.0.1:19000

# ── This host as a compute target ────────────────────────────────────────────
# The name the agent claims work under. A second GPU host joins by running the
# agent with a different name and being granted a queue.
CORAL_CITY_AGENT_TARGET=box

# Where somebody watching an interactive dive connects. The address of this
# machine as the people who use it reach it — a Tailscale address, a LAN
# address, whatever they actually type. The control plane cannot know this;
# only the host does.
CORAL_CITY_STREAM_HOST=127.0.0.1

# Where the platform listens on this host.
#
# Loopback by default, because a platform reachable from every network a machine
# happens to be on is a platform somebody else can find. Set it to a single
# address — a Tailscale address is the usual one — so the application on your own
# machine can reach it and nothing else can.
CORAL_CITY_BIND_ADDRESS=127.0.0.1
