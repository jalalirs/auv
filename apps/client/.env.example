# Copy to .env.local to skip signing in by hand while working on the
# application. The real file is ignored by git; this one is the record of what
# it may contain.
#
# With all three set the application signs in on launch. With none of them it
# shows the form, which is what anybody who is not building it will see.
VITE_IOCEAN_PLATFORM=http://127.0.0.1:18080
VITE_IOCEAN_EMAIL=
VITE_IOCEAN_SECRET=
