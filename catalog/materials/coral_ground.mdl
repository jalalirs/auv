/*
 * The seabed of a place that has a record.
 *
 * Two scales at once, which is the whole reason this file exists: no material
 * in OpenUSD can multiply a map of one particular seabed by a tiled photograph
 * of a real surface, and a seabed needs both.
 *
 *   The low frequency is the place. tools/ground builds it from a reference
 *   directory: the survey's orthomosaic where somebody flew one, and habitat
 *   class laid down from the satellite's pattern everywhere else. Over a
 *   kilometre at 4096 pixels it is 24 cm a texel, so on its own it is a smear
 *   the moment a vehicle is near the bottom.
 *
 *   The high frequency is a tiled photograph of sand or rock, repeating every
 *   few metres. On its own it is the same few metres of somebody else's beach
 *   over the whole reef.
 *
 * Multiplied, with the detail divided through by its own average, the detail
 * contributes variation and no colour of its own, and the site map contributes
 * colour and no detail. Neither one pretends to be the other. The average is
 * passed in because it is a property of the texture, computed once where the
 * place is built rather than guessed at here.
 *
 * And there are two grains, not one, because a reef is not one surface. Sand
 * in the grooves and carbonate pavement on the spurs, chosen by the habitat
 * map the survey drew. They are blended by height rather than mixed: at the
 * edge of a sand patch the pavement shows through the gaps between the grains,
 * which is what it does, instead of the two fading through a grey halfway
 * surface that is neither one.
 *
 * Licence: the same as the platform. The textures it reads are CC0.
 */

mdl 1.7;

import ::anno::*;
import ::base::*;
import ::df::*;
import ::math::*;
import ::state::*;
import ::tex::*;

export material coral_ground(
    uniform texture_2d site_colour = texture_2d()
    [[
        anno::display_name("Colour of this seabed"),
        anno::description("From tools/ground: the orthomosaic where there is "
                          "one, habitat class elsewhere. Laid once over the "
                          "whole site."),
        anno::in_group("Ground")
    ]],
    uniform texture_2d hardness = texture_2d()
    [[
        anno::display_name("Where the hard ground is"),
        anno::description("Nought is sediment, one is reef pavement. Drawn "
                          "from the habitat map a survey made, laid over the "
                          "site the same way the colour is."),
        anno::in_group("Ground")
    ]],

    uniform texture_2d soft_colour = texture_2d()
    [[
        anno::display_name("Sand"),
        anno::description("A tiled photograph of a real surface. Divided "
                          "through by its own average, so it carries variation "
                          "and not colour."),
        anno::in_group("Sand")
    ]],
    uniform texture_2d soft_normal = texture_2d()
    [[ anno::display_name("Sand relief"), anno::in_group("Sand") ]],
    uniform texture_2d soft_rough = texture_2d()
    [[ anno::display_name("Sand roughness"), anno::in_group("Sand") ]],
    uniform texture_2d soft_height = texture_2d()
    [[ anno::display_name("Sand height"), anno::in_group("Sand") ]],
    uniform color soft_average = color(0.5)
    [[ anno::display_name("Average of the sand"), anno::in_group("Sand") ]],

    uniform texture_2d hard_colour = texture_2d()
    [[ anno::display_name("Pavement"), anno::in_group("Pavement") ]],
    uniform texture_2d hard_normal = texture_2d()
    [[ anno::display_name("Pavement relief"), anno::in_group("Pavement") ]],
    uniform texture_2d hard_rough = texture_2d()
    [[ anno::display_name("Pavement roughness"), anno::in_group("Pavement") ]],
    uniform texture_2d hard_height = texture_2d()
    [[ anno::display_name("Pavement height"), anno::in_group("Pavement") ]],
    uniform color hard_average = color(0.5)
    [[ anno::display_name("Average of the pavement"), anno::in_group("Pavement") ]],

    uniform float blend_depth = 0.12
    [[
        anno::display_name("How sharp the join is"),
        anno::description("The band of height over which the two surfaces "
                          "interleave. Small is a hard edge with grains of one "
                          "showing through the other; large is a fade."),
        anno::in_group("Ground")
    ]],
    uniform float repeats = 100.0
    [[
        anno::display_name("Repeats across the site"),
        anno::description("Site metres divided by tile metres. Ten metres a "
                          "repeat over a kilometre is a hundred."),
        anno::in_group("Grain")
    ]],
    uniform float grain = 1.0
    [[
        anno::display_name("How much grain"),
        anno::description("Nought is the site map alone, one is full contrast."),
        anno::in_group("Grain")
    ]],
    uniform float relief = 1.0
    [[ anno::display_name("How much relief"), anno::in_group("Grain") ]],
    uniform float lift = 1.0
    [[
        anno::display_name("Lift"),
        anno::description("The site map is already dehazed; this is the last "
                          "small correction, and it should stay small."),
        anno::in_group("Ground")
    ]],
    uniform float smoothest = 0.55
    [[ anno::display_name("Roughness, wettest"), anno::in_group("Ground") ]],
    uniform float roughest = 0.95
    [[ anno::display_name("Roughness, driest"), anno::in_group("Ground") ]],

    // ── the water between here and the camera ────────────────────────────────
    //
    // Done in the material because the renderer has nowhere else to put it.
    // `/rtx/fog` adds veiling light and never absorbs, so a reef stays sharp to
    // the horizon; the ray-traced volumetric effects want a volume prim this
    // scene has no way to author. What is left is the surface's own distance
    // from the camera, which the surface knows.
    //
    // And doing it here buys the thing the renderer's fog could never do: the
    // attenuation is **per channel**. Red dies in four metres of this water and
    // green takes seventeen, which is why everything below ten metres is blue,
    // and a single fog distance cannot say it.
    uniform float3 eye = float3(0.0)
    [[
        anno::display_name("Where the camera is"),
        anno::description("World metres. Set by the runtime as the vehicle "
                          "moves; a stale one puts the water in the wrong "
                          "place, not nowhere."),
        anno::in_group("Water")
    ]],
    uniform color attenuation = color(4.0, 17.0, 13.0)
    [[
        anno::display_name("Attenuation lengths"),
        anno::description("Metres to 1/e, per channel, off the Jerlov type. "
                          "Not tuned: measured."),
        anno::in_group("Water")
    ]],
    uniform color veiling = color(0.24, 0.55, 0.45)
    [[
        anno::display_name("The colour of the water itself"),
        anno::in_group("Water")
    ]],
    uniform float veil = 1.0
    [[
        anno::display_name("How bright the water is"),
        anno::description("Nought turns the medium off, which is what the "
                          "water-taken-away view wants."),
        anno::in_group("Water")
    ]],
    uniform float site_across = 1000.0
    [[
        anno::display_name("How wide this site is"),
        anno::description("Metres. The texture coordinates run nought to one "
                          "over it, so this turns them back into a place."),
        anno::in_group("Water")
    ]],
    uniform float floor_at_m = -9.0
    [[
        anno::display_name("About how deep this seabed is"),
        anno::description("One number for the site. The horizontal distance "
                          "dominates everything but a view straight down."),
        anno::in_group("Water")
    ]],
    uniform float show_distance = 0.0
    [[
        anno::display_name("Paint the distance instead"),
        anno::description("Metres at white. Nought is off. There is no way to "
                          "print a number out of a shader, so the only way to "
                          "find out what a shader thinks a distance is, is to "
                          "look at it."),
        anno::in_group("Water")
    ]]
)
[[
    anno::display_name("Coral City seabed"),
    anno::description("A site colour map at low frequency, a tiled surface at "
                      "high frequency, and neither pretending to be the other.")
]]
= let {
    base::texture_coordinate_info here = base::coordinate_source(
        coordinate_system: base::texture_coordinate_uvw, texture_space: 0);

    // The site map goes on once, so it is clamped: a seabed that wrapped
    // would put the reef back on at the far edge of the site.
    base::texture_coordinate_info wide = here;
    base::texture_coordinate_info fine = base::texture_coordinate_info(
        position: here.position * repeats,
        tangent_u: here.tangent_u,
        tangent_v: here.tangent_v);

    // How far the light off this surface has to swim to reach the camera.
    //
    // NOT YET RIGHT, and the medium is held at veil = 0 until it is.
    //
    // `state::position()` here is **object space**, and the transform through
    // `coordinate_internal -> coordinate_world` does not move it. The proof is
    // in the pictures: a coral prototype is a fifth of a metre across, so its
    // positions are tiny and it renders unattenuated, while this seabed mesh
    // spans a kilometre, so its positions run to five hundred and it renders
    // fully absorbed. What this measures is distance from the middle of the
    // site, which is why the first attempt veiled the ground under the lens
    // and left the horizon clear.
    //
    // What it needs is the distance from the camera, per pixel. `eye` is set
    // by the runtime and is right; the position is not. Until that is settled,
    // the fog does the airlight and the far clip does the absorbing.
    // Two candidates, and `show_distance` is how they are told apart.
    //
    //   `state::position()` transformed to world is the position in the
    //   site, and its length is the distance from the middle of the site.
    //   `eye` then has to be subtracted to get the distance from the camera.
    //
    // Which of those this renderer actually gives has never been established,
    // because the tool for establishing it was painting black.
    // With the diagnostic finally painting the distance, `transform_point`
    // to world came back a **constant** — the whole seabed saturated, and the
    // constant is |eye|, which is what `distance(0, eye)` is. So that call
    // does return zero here, which was guessed before and is now seen.
    //
    // This is the raw position, untransformed, which is the other candidate.
    // Raw position, minus where the camera is.
    //
    // Painting `length(state::position())` could not settle it: the camera is
    // a hundred metres from the middle of the site, so every pixel in frame is
    // past a forty metre scale whether the position is measured from the site
    // or from the lens, and both saturate to the same white. The test that
    // separates them is the one that is wanted anyway.
    // Where this pixel is, from the texture coordinates.
    //
    // Not from `state::position()`. Six attempts to read a position out of
    // this renderer produced six frames that were either the ordinary seabed
    // or a constant, and the one thing every one of them established is that
    // this route does not work here and is not worth a seventh.
    //
    // The seabed already carries what is needed. Its `st` runs nought to one
    // over the site — that is how the colour map is laid on — so the world
    // position is the texture coordinate times the width of the site, which
    // is a number this file can simply be told. It costs nothing, it uses only
    // the lookup that already works, and it cannot be a constant because the
    // colour map is not a constant.
    float3 here_is = float3((wide.position.x - 0.5) * site_across,
                            (wide.position.y - 0.5) * site_across,
                            floor_at_m);
    float swum = math::distance(here_is, eye);
    color low = base::file_texture(
        texture: site_colour, uvw: wide,
        wrap_u: tex::wrap_clamp, wrap_v: tex::wrap_clamp).tint;

    float hard_here = base::file_texture(
        texture: hardness, uvw: wide,
        wrap_u: tex::wrap_clamp, wrap_v: tex::wrap_clamp,
        mono_source: base::mono_average).mono;

    // Height blend. Each surface gets its own bed height plus the share of the
    // ground the habitat map gives it; whichever stands higher wins, and
    // within `blend_depth` of the top both show. That is why a sand patch on
    // pavement has pavement between its grains at the edge instead of a grey
    // band.
    float soft_up = base::file_texture(
        texture: soft_height, uvw: fine,
        wrap_u: tex::wrap_repeat, wrap_v: tex::wrap_repeat,
        mono_source: base::mono_average).mono * 0.6 + (1.0 - hard_here);
    float hard_up = base::file_texture(
        texture: hard_height, uvw: fine,
        wrap_u: tex::wrap_repeat, wrap_v: tex::wrap_repeat,
        mono_source: base::mono_average).mono * 0.6 + hard_here;
    float top = math::max(soft_up, hard_up) - math::max(blend_depth, 0.001);
    float soft_weight = math::max(soft_up - top, 0.0);
    float hard_weight = math::max(hard_up - top, 0.0);
    float pick = hard_weight / math::max(soft_weight + hard_weight, 0.000001);

    color soft_high = base::file_texture(
        texture: soft_colour, uvw: fine,
        wrap_u: tex::wrap_repeat, wrap_v: tex::wrap_repeat).tint / soft_average;
    color hard_high = base::file_texture(
        texture: hard_colour, uvw: fine,
        wrap_u: tex::wrap_repeat, wrap_v: tex::wrap_repeat).tint / hard_average;

    // Variation about one, not colour. Faded towards one by `grain`, so that
    // turning the grain down leaves the site's own colour rather than turning
    // the seabed black.
    color variation = math::lerp(color(1.0),
                                 math::lerp(soft_high, hard_high, pick), grain);
    // Painted as emission and not as albedo, so that nothing shines on it.
    // The first version made it the albedo, and what came back was a picture
    // of the lighting: bright where the sun hit the near ground, dark at the
    // horizon where everything is at a grazing angle. Which reads exactly like
    // a distance field pointing the wrong way, and was read as one.
    // `show_distance` paints what the shader thinks the distance is, instead
    // of the ground. It paints the *distance*: this line said `color(0.0)`
    // for two whole investigations, so the diagnostic painted black whatever
    // the distance was, and both runs of it were the diagnostic reporting on
    // itself. A test whose failure mode looks like its success mode is not a
    // test, which is a sentence already written elsewhere in this project by
    // somebody who then wrote this.
    // Pure red when the diagnostic is on, and the default is on.
    //
    // Four expressions produced four byte-identical frames. Either the
    // material is not being recompiled, or `show_distance` never arrives and
    // every one of those frames was the ordinary ground. Red settles it
    // without depending on the runtime for anything: if the seabed is not red,
    // this file is not what is drawing it.
    // The red test passed: this file draws the ground and is recompiled when
    // it changes. So the four identical frames before it were not four
    // readings of a distance — `show_distance` never arrived from the runtime,
    // and every one of them was the ordinary seabed. The default is on here
    // so the diagnostic depends on nothing outside this file.
    // The position painted as colour, not as brightness.
    //
    // Brightness cannot be read off a lit frame: a grey albedo and a dim light
    // look the same, which is why four greyscale attempts said nothing and the
    // red one said everything. Hue survives lighting. So east goes in red,
    // north in green, and up in blue: if this comes back a smooth two-colour
    // ramp across the seabed, the position is a position. If it comes back one
    // flat colour, it is a constant.

    float wet = math::lerp(
        base::file_texture(texture: soft_rough, uvw: fine,
                           wrap_u: tex::wrap_repeat, wrap_v: tex::wrap_repeat,
                           mono_source: base::mono_average).mono,
        base::file_texture(texture: hard_rough, uvw: fine,
                           wrap_u: tex::wrap_repeat, wrap_v: tex::wrap_repeat,
                           mono_source: base::mono_average).mono,
        pick);
    float rough = math::lerp(smoothest, roughest, wet);

    // What the water takes from the surface it replaces with itself, which is
    // why a distant reef does not go black, it goes the colour of the sea.
    // Nought veil means no medium at all, so nothing is taken either. The
    // first version gated only the light the water adds and left the light it
    // takes, so turning the water off multiplied every surface by
    // exp(-distance) and the seabed came back black.
    color survives = veil <= 0.0
        ? color(1.0)
        : math::exp(color(-swum) / math::max(attenuation, color(0.01)));
    // The water's own light, which is what a distant reef turns into. It is
    // added rather than lit because it does not depend on anything shining on
    // this surface: it is the column in front of it.
    color water = veiling * veil * (color(1.0) - survives);

    // What the surface reflects, dimmed by the water it has to swim through,
    // plus the water's own light in front of it. Per channel, so red is gone
    // in four metres of this water while green takes seventeen — which is the
    // thing the renderer's own fog could never say.
    color albedo = show_distance > 0.0
        ? color(math::saturate(swum / show_distance))
        : math::saturate(low * lift * variation * survives + water);

    float3 bumped = math::normalize(math::lerp(
        base::tangent_space_normal_texture(
            texture: soft_normal, factor: relief, uvw: fine, flip_tangent_v: true),
        base::tangent_space_normal_texture(
            texture: hard_normal, factor: relief, uvw: fine, flip_tangent_v: true),
        pick));
} in material(
    surface: material_surface(
        // Wet rock under water: a weak specular over a diffuse base. Not a
        // mirror, and not chalk either, which is what a seabed with no
        // specular at all reads as.
        scattering: df::weighted_layer(
            weight: 0.05,
            normal: bumped,
            layer: df::microfacet_ggx_smith_bsdf(
                roughness_u: rough * rough, roughness_v: rough * rough),
            base: df::diffuse_reflection_bsdf(tint: albedo * survives,
                                              roughness: 0.0)),
        // The water's own light, which is what a distant reef turns into. It
        // is emission because it does not depend on anything shining on this
        // surface: it is the column in front of it, lit.
        emission: material_emission(
            emission: df::diffuse_edf(),
            intensity: water)
    ),
    geometry: material_geometry(normal: bumped)
);
