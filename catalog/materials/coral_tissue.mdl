/*
 * Living coral: tissue over aragonite.
 *
 * A coral is not a coloured stone, and `UsdPreviewSurface` can only make it
 * one. Three things it cannot express, and they are most of the difference
 * between a photograph of a reef and a render of one:
 *
 *   **Light goes into it.** A polyp's tissue is a translucent film a
 *   millimetre thick over a skeleton of white aragonite. Light enters, scatters
 *   in the white, and comes back out through the colour, which is why living
 *   coral glows from inside and a bleached head — the same skeleton with the
 *   tissue gone — is flat chalk. A diffuse surface with a colour on it is the
 *   bleached one.
 *
 *   **Some of it is lit from behind.** A branch tip or the edge of a plate is
 *   thin enough to pass light, and that rim is the first thing an eye uses to
 *   tell coral from rock.
 *
 *   **It fluoresces.** Reef corals carry GFP-like proteins that absorb blue
 *   and re-emit green and orange. Ten metres down, where most of what is left
 *   is blue, that re-emission is a large part of what a camera records, and
 *   it is most of why reef footage looks the way it does.
 *
 * On the fluorescence, plainly: this is **not** a fluorescence model. A real
 * one re-emits in proportion to the blue light arriving, and a material here
 * cannot ask what light is arriving. What this does is add emission of the
 * fluorescent colour at a strength somebody sets, and the thing that sets it
 * is the water: `coral/water.py` knows how blue-shifted the light is at a
 * given depth, so the strength is driven from there and it rises with depth
 * for the right reason even though the mechanism is faked. Anything stronger
 * than that claim is not supported by what is here.
 *
 * The corallites come from tools/corallite.py, projected triplanar in world
 * space. Triplanar because the prototypes have no texture coordinates at all
 * and unwrapping a blob would give seams down every colony; world space
 * because then a corallite is two and a half millimetres on a colony of any
 * size, which is what a corallite is.
 */

mdl 1.7;

import ::anno::*;
import ::base::*;
import ::df::*;
import ::math::*;
import ::state::*;
import ::tex::*;

export material coral_tissue(
    uniform color tissue = color(0.72, 0.58, 0.22)
    [[
        anno::display_name("Tissue colour"),
        anno::description("From the photographs of the place, not from a "
                          "museum specimen: a dry skeleton is the colour of "
                          "bone."),
        anno::in_group("Tissue")
    ]],
    uniform color aragonite = color(0.88, 0.87, 0.84)
    [[
        anno::display_name("Skeleton"),
        anno::description("What is under the tissue, and what is left when it "
                          "dies. Near white, and never quite white."),
        anno::in_group("Tissue")
    ]],
    uniform float alive = 0.85
    [[
        anno::display_name("How much tissue"),
        anno::description("One is a healthy colony, nought is bare skeleton. "
                          "Between them is what a bleaching looks like."),
        anno::in_group("Tissue")
    ]],
    uniform float through = 0.0
    [[
        anno::display_name("How much light passes right through"),
        anno::description("What makes a branch tip and the edge of a plate "
                          "glow when the light is behind them. Nought for a "
                          "boulder, which passes no light at all: on a closed "
                          "solid this is energy going in and not coming back, "
                          "so a massive coral given it just goes dark."),
        anno::in_group("Tissue")
    ]],
    uniform float scatter = 0.15
    [[
        anno::display_name("How much the skeleton lifts the colour"),
        anno::description("Light scattering in the white aragonite under the "
                          "tissue and leaving through the colour again. This "
                          "is the subsurface term, and it brightens without "
                          "desaturating. Small: it is a millimetre of tissue, "
                          "and at 0.35 it lifted a colony a third of a stop, "
                          "which on a reef already reading pale is the wrong "
                          "direction."),
        anno::in_group("Tissue")
    ]],

    uniform color fluoresces = color(0.30, 1.0, 0.45)
    [[
        anno::display_name("Fluorescent colour"),
        anno::description("GFP-like: green, and orange in some genera."),
        anno::in_group("Fluorescence")
    ]],
    uniform float fluorescence = 0.0
    [[
        anno::display_name("How much fluorescence"),
        anno::description("Set from the water: how blue-shifted the light is "
                          "at this depth. Nought at the surface. This is not a "
                          "fluorescence model, it is emission at a strength "
                          "something else decided; see the note at the top."),
        anno::in_group("Fluorescence")
    ]],

    uniform texture_2d corallites = texture_2d()
    [[
        anno::display_name("Corallites"),
        anno::description("A normal map of the surface at polyp scale, from "
                          "tools/corallite.py."),
        anno::in_group("Corallites")
    ]],
    uniform float tile_metres = 0.04
    [[
        anno::display_name("What one tile covers"),
        anno::description("In metres of the world, so a corallite is the size "
                          "a corallite is however big the colony is."),
        anno::in_group("Corallites")
    ]],
    uniform float relief = 2.5
    [[
        anno::display_name("How much relief"),
        anno::description("More than one. The map holds the true gradient of a "
                          "0.75 mm cup across 2.6 mm, which is a shallow slope, "
                          "and a shallow slope under water two metres away is "
                          "nothing at all."),
        anno::in_group("Corallites")
    ]],

    uniform float wet = 0.42
    [[
        anno::display_name("Roughness"),
        anno::description("Coral tissue underwater is wet by definition and "
                          "still not a mirror."),
        anno::in_group("Tissue")
    ]]
,

    // ── the water between here and the camera ────────────────────────────────
    //
    // The same medium the ground carries, and it has to be the same or a
    // colony at twenty metres is sharp against a seabed that has gone. Done in
    // the material because the renderer has nowhere else to put it, and done
    // per channel because red dies in four metres of this water and green
    // takes seventeen.
    // Not `uniform`, and that one word cost a day.
    //
    // A uniform parameter in MDL is baked when the material is compiled, so
    // the compiled shader kept the nought it was born with and every
    // per-frame update went into a USD attribute nothing read. The attribute
    // was set correctly the whole time — asked for (5, -105, -5.2), read back
    // (5, -105, -5.2) — which is why reading it back was not enough on its
    // own and the picture had to be measured as well.
    //
    // Dropping the keyword makes it an argument the renderer passes in rather
    // than a constant it compiles in.
    float3 eye = float3(0.0)
    [[ anno::display_name("Where the camera is"), anno::in_group("Water") ]],
    uniform color attenuation = color(4.0, 17.0, 13.0)
    [[ anno::display_name("Attenuation lengths"), anno::in_group("Water") ]],
    uniform color veiling = color(0.24, 0.55, 0.45)
    [[ anno::display_name("The colour of the water itself"), anno::in_group("Water") ]],
    uniform float veil = 1.0
    [[ anno::display_name("How bright the water is"), anno::in_group("Water") ]],
    uniform texture_2d swum_map = texture_2d()
    [[
        anno::display_name("What survives the swim to the camera"),
        anno::description("Per channel, baked over the site by "
                          "tools/aim-water from where dives begin. The same "
                          "map the seabed uses, looked up here through world "
                          "position so a colony gets the water its own place "
                          "on the site says it should."),
        anno::in_group("Water")
    ]],
    uniform float show_distance = 0.0
    [[
        anno::display_name("Paint the medium instead of the coral"),
        anno::description("A shader cannot print. Above nought this paints "
                          "what the survival lookup returns, unlit, instead "
                          "of the colony — the only way to find out whether a "
                          "coordinate varies in this renderer or comes back "
                          "the same number everywhere."),
        anno::in_group("Water")
    ]],
    uniform float site_across = 1000.0
    [[
        anno::display_name("How wide this site is"),
        anno::description("Metres, so world position can be turned into the "
                          "survival map's own coordinates. Set by the runtime "
                          "as a dive opens."),
        anno::in_group("Water")
    ]])
[[
    anno::display_name("Coral City living coral"),
    anno::description("Translucent tissue over white aragonite, with "
                      "corallites and a stand-in for fluorescence.")
]]
= let {
    // Triplanar, in metres of the world. The prototypes carry no texture
    // coordinates and a blob has no good unwrapping; this needs neither.
    base::texture_coordinate_info here = base::coordinate_projection(
        coordinate_system: base::texture_coordinate_world,
        texture_space: 0,
        projection_type: base::projection_tri_planar,
        projection_transform: base::rotation_translation_scale(
            scaling: float3(1.0 / math::max(tile_metres, 0.001))));

    float3 bumped = base::tangent_space_normal_texture(
        texture: corallites, factor: relief, uvw: here, flip_tangent_v: true);

    // What comes back out.
    //
    // Light enters the tissue, scatters in the white aragonite about a
    // millimetre down, and leaves through the colour again. That brightens
    // what comes back; it does not wash it towards white. The first version
    // mixed the skeleton's colour in directly and an olive colony rendered as
    // a pale grey pebble — which is the bleached one, and is exactly the thing
    // this material exists to stop.
    //
    // A boulder coral is not translucent at the scale of a boulder. This is
    // scattering under a millimetre of tissue, not light through a head.
    color lit_from_under = tissue * math::lerp(
        color(1.0), aragonite * 2.2, math::saturate(scatter));
    // And as the tissue goes, so does the colour: `alive` at nought is the
    // same skeleton with nothing on it, which is what a bleached colony is.
    color under = math::lerp(aragonite, lit_from_under, math::saturate(alive));

    // What survives the swim to the camera, and the water in front of it.
    //
    // Looked up, not computed. `state::position()` reads back as a constant
    // when it is used in an expression in this renderer, so the distance this
    // used to work out was the same number for every colony on the reef —
    // which is exactly what the frames showed: a colony at the horizon lit
    // like a colony at arm's length, the whole reef reading as cutouts pasted
    // onto the water. The seabed had the same bug and the same fix.
    //
    // The coordinate is world position turned into the site's own square, and
    // the arithmetic for that is done *inside* a `texture_coordinate_info`
    // that feeds a lookup. That distinction is the whole trick: the same
    // `.position` read into a float and used in arithmetic comes back
    // constant, while built into a coordinate and handed to `file_texture` it
    // varies per pixel. The tiled grain on the seabed has been sampled this
    // way since September, which is how we know it works.
    base::texture_coordinate_info world = base::coordinate_source(
        coordinate_system: base::texture_coordinate_world, texture_space: 0);
    base::texture_coordinate_info site = base::texture_coordinate_info(
        position: world.position / math::max(site_across, 1.0)
                  + float3(0.5, 0.5, 0.0),
        tangent_u: world.tangent_u,
        tangent_v: world.tangent_v);
    // Nought veil means no medium at all, so nothing is taken either. The
    // first version gated only the light the water adds and left the light it
    // takes, so turning the water off multiplied every surface by
    // exp(-distance) and the seabed came back black.
    color survives = veil <= 0.0
        ? color(1.0)
        : base::file_texture(texture: swum_map, uvw: site,
                             wrap_u: tex::wrap_clamp,
                             wrap_v: tex::wrap_clamp).tint;
    color water = veiling * veil * (color(1.0) - survives);
} in material(
    surface: material_surface(
        // Wet, so there is a sheen on it, and more of one at a grazing angle:
        // the first thing you see on a reef at distance is the specular off
        // the tops of the colonies.
        scattering: df::custom_curve_layer(
            normal_reflectivity: 0.02,
            // Gently. At 0.30 a small dome seen from above is mostly grazing
            // angle and the sheen alone washed the colour out.
            grazing_reflectivity: 0.12,
            layer: df::microfacet_ggx_smith_bsdf(
                roughness_u: wet * wet, roughness_v: wet * wet),
            // Some of the light passes through rather than bouncing off,
            // which is what lights a branch tip from behind.
            base: df::weighted_layer(
                weight: math::saturate(through * alive),
                layer: df::diffuse_transmission_bsdf(tint: tissue),
                base: df::diffuse_reflection_bsdf(
                tint: show_distance > 0.0 ? color(0.0) : under * survives)),
            normal: bumped),
        // Inside the surface, not beside it. `material()` has no `emission`
        // of its own — its parameters are thin_walled, surface, backface, ior,
        // volume, geometry and hair — and passing one gets "no overloaded
        // version of function 'material' matches calling parameters", which
        // names the line and not the parameter.
        emission: material_emission(
            emission: df::diffuse_edf(),
            intensity: show_distance > 0.0 ? survives
                       : fluoresces * fluorescence * math::saturate(alive) + water)
    ),
    geometry: material_geometry(normal: bumped)
);
