  "topicContract": {
    "publishes": [
      { "topic": "/camera/image_raw", "type": "sensor_msgs/msg/Image" },
      { "topic": "/sonar/image",      "type": "sensor_msgs/msg/Image" },
      { "topic": "/imu/data",         "type": "sensor_msgs/msg/Imu" },
