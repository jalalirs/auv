<?xml version="1.0"?>
<!--
  Adapted from Project DAVE's dave_ocean_waves_sonar.world.
  Copyright (c) 2016 The UUV Simulator Authors, Apache License 2.0.

  Fuel URLs are replaced by model:// references because the GPU network cannot
  reach Fuel's object storage. tools/assets installs the pinned models in /data.
-->
<sdf version="1.9">
  <world name="first_dive">
    <scene>
      <ambient>0.01 0.01 0.01 1.0</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>true</shadows>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-dvl-system" name="gz::sim::systems::DopplerVelocityLogSystem"/>
    <plugin filename="multibeam_sonar_system" name="custom::MultibeamSonarSystem"/>

    <spherical_coordinates>
      <latitude_deg>35.074823</latitude_deg>
      <longitude_deg>129.084798</longitude_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="directional" name="fill_light">
      <pose>-50 0 -150 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-0.3 -0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <include>
      <uri>model://Coast Water</uri>
    </include>
    <include>
      <uri>model://Sunken Ship Distorted</uri>
      <pose>15 2 -16 0 0 1</pose>
    </include>
    <include>
      <uri>model://Sand Heightmap</uri>
      <pose>0 0 -16 0 0 0</pose>
    </include>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
  </world>
</sdf>
