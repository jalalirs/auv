# Remote execution
AUV_GPU_HOST=jalalirs@100.76.65.1
AUV_REMOTE_DIR=code/auv
AUV_REMOTE_GIT_DIR=code/.git-mirrors/auv.git
AUV_DATA_DIR=/home/jalalirs/code/auv-data
AUV_GPU_DEVICE=0

# NVIDIA Isaac Sim 6.0.1
# Set to Y only after accepting the NVIDIA Omniverse EULA.
ISAAC_ACCEPT_EULA=N
ISAAC_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.1
ISAAC_CONTAINER=auv-isaac-sim
ISAAC_GPU_DEVICE=1
ISAAC_RUNTIME_DIR=/home/jalalirs/code/auv/.runtime/isaac-sim
ISAACSIM_HOST=100.76.65.1
ISAACSIM_SIGNAL_PORT=49100
ISAACSIM_STREAM_PORT=47998
ISAAC_STAGE=projects/002_red_sea_digital_twin/scenarios/000_platform_calibration/stage.usda

# ROS and visualization
ROS_DOMAIN_ID=42
FOXGLOVE_LOCAL_PORT=18765
FOXGLOVE_REMOTE_PORT=8765
JOYSTICK_LOCAL_PORT=18766
JOYSTICK_REMOTE_PORT=8766
REEF_LOCAL_PORT=19877
REEF_REMOTE_PORT=9877
REEF_FOXGLOVE_LOCAL_PORT=18767
REEF_FOXGLOVE_REMOTE_PORT=8767

# Container identity; the GPU-box user currently uses UID/GID 1000.
AUV_USER_UID=1000
AUV_USER_GID=1000
